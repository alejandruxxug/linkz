-~> trace_score: scores the tracer on a set of pictures, one row each.
-~>
-~>   lizardscript tools/trace_score.liz [options] [images...]
-~>   scripts/trace_score.sh [options] [images...]      (the same, from anywhere)
-~>
-~> Without images it takes every PNG and JPEG of docs/Art/References/trace/.
-~> Each picture is traced with the default options, the traced code is drawn
-~> at the picture's size, and the row says:
-~>   err     the mean color error: |dR|+|dG|+|dB| / 3 over every pixel
-~>           (0 to 255), original against the drawing.
-~>   iou     ink IoU: the ink of the original and the ink of the drawing,
-~>           overlap over union (1 is the same lines in the same places).
-~>   fills, strokes   shapes in the code (photo mode has no strokes).
-~>   bytes   the length of the code.
-~>   ms      the tracer's own time (loading and drawing are not in it).
-~> then a summary line (means of err and iou, sums of the rest).
-~>
-~> Options:
-~>   --mode lineart|photo   the tracer's mode (lineart by default; photo
-~>                          traces at 256 px, its own default size).
-~>   --set key=value        a tracer option instead of its default (value is
-~>                          JSON: --set colors=32 --set detail=0.4); max_side
-~>                          also sets the size the picture is loaded at.
-~>   --quality NAME        a quality preset (light, balanced, detailed, max;
-~>                          lineart only), under any --set.
-~>   --json                 print the result as JSON on stdout instead of the
-~>                          table (progress and the table go to stderr).
-~>   --masks DIR            save the ink masks of every picture there to look at.
-~>   --out FILE.json        also save the JSON; --md FILE.md a markdown table.
-~>   --compare before.json  print the change of every row against an earlier
-~>                          --json result, and mark with a warning sign a row
-~>                          whose error rose by more than 0.3 or whose IoU fell
-~>                          by more than 0.01 (the gate of Tracing v3). The
-~>                          exit code is 1 when some row is marked.
-~> Progress goes to stderr: tracing can take minutes.
-~>
-~> The yardstick (the error, and the ink rule behind the IoU) is
-~> lib/trace/trace_measure.liz; it is the same one the Auto quality uses.

use "../lib/app/drawing"
use "../lib/app/host"
use "../lib/draw/geometry"
use "../lib/app/host_img"
use "../lib/app/libs"
use "../lib/trace/trace"
use "../lib/trace/trace_measure"
use "../lib/trace/trace_quality"

let score_refs = "docs/Art/References/trace"
-~> The file name of a path, without its folders.
function score_name(path) {
  let parts = text.split(path, "/")
  parts[len(parts) - 1]
}

-~> The images of the references folder, by name.
function score_default_images() {
  let out = []
  let names = list.sort(fs.list(score_refs))
  for (let i = 0; i < len(names); i += 1) {
    let n = text.lower(names[i])
    if (text.slice(n, -4, len(n)) == ".png" || text.slice(n, -4, len(n)) == ".jpg" || text.slice(n, -5, len(n)) == ".jpeg") {
      push(out, fs.join(score_refs, names[i]))
    }
  }
  out
}

-~> Saves the two ink masks as PNGs in `dir` (black ink on white; red where
-~> only the original has ink, blue where only the drawing has), to look at.
function score_save_masks(dir, name, size, a, b) {
  fs.mkdir(dir)
  let px = []
  for (let i = 0; i < len(a); i += 1) {
    if (a[i] == 1 && b[i] == 1) {
      push(px, #000000)
    } elif (a[i] == 1) {
      push(px, #e03030)
    } elif (b[i] == 1) {
      push(px, #3030e0)
    } else {
      push(px, #ffffff)
    }
  }
  img.save(img.from_pixels(size, px), fs.join(dir, name + "-ink.png"))
}

-~> Scores one picture: {"image", "err", "iou", "fills", "strokes", "bytes",
-~> "ms"}.
function score_one(path, mode, masks, set = {}) {
  let side = 1024
  if (mode == "photo") {
    side = 256
  }
  let options = quality_resolve(hash.merge({"mode": mode}, set))
  if (options.max_side !== null) {
    side = options.max_side
  }
  let loaded = host_img().load(path, side)
  let size = loaded.size
  let t = trace_pixels(size, loaded.pixels, options, path)
  let m = measure_code(t.code, size, loaded.pixels)
  let iou = m.iou
  let ink_a = m.ink_original
  let ink_b = m.ink_drawing
  if (masks !== null) {
    score_save_masks(masks, score_name(path), size, ink_a, ink_b)
  }
  let fills = t.stats.fills
  let strokes = t.stats.strokes
  if (mode == "photo") {
    fills = t.stats.regions
    strokes = 0
  }
  {
    "image": score_name(path),
    "err": measure_round(m.err, 2),
    "iou": measure_round(iou, 3),
    "fills": fills,
    "strokes": strokes,
    "bytes": len(t.code),
    "ms": math.round(t.stats.ms)
  }
}

-~> Spaces added on the right of s up to n characters.
function score_left(s, n) {
  let out = str(s)
  while (len(out) < n) {
    out = out + " "
  }
  out
}

-~> Spaces added on the left of s up to n characters.
function score_right(s, n) {
  let out = str(s)
  while (len(out) < n) {
    out = " " + out
  }
  out
}

-~> The +/- change text of a number, "" when there is no earlier one.
function score_delta(now, before, places) {
  if (before === null) {
    return ""
  }
  let d = measure_round(now - before, places)
  if (d > 0) {
    return "+" + str(d)
  }
  str(d)
}

-~> Whether a row got worse than its earlier self by the gate's line.
function score_worse(row, before) {
  before !== null && (row.err - before.err > 0.3 || row.iou - before.iou < -0.01)
}

-~> The earlier row for an image name, or null.
function score_find(rows, name) {
  for (let i = 0; i < len(rows); i += 1) {
    if (rows[i].image == name) {
      return rows[i]
    }
  }
  null
}

-~> The summary of the rows: means of err and iou, sums of the rest.
function score_summary(rows) {
  let s = {"images": len(rows), "err": 0.0, "iou": 0.0, "fills": 0, "strokes": 0, "bytes": 0, "ms": 0}
  for (let i = 0; i < len(rows); i += 1) {
    s.err = s.err + rows[i].err
    s.iou = s.iou + rows[i].iou
    s.fills += rows[i].fills
    s.strokes += rows[i].strokes
    s.bytes += rows[i].bytes
    s.ms += rows[i].ms
  }
  if (len(rows) > 0) {
    s.err = measure_round(s.err / len(rows), 2)
    s.iou = measure_round(s.iou / len(rows), 3)
  }
  s
}

-~> The text table of the rows (and of the change against `before`, when
-~> given). Returns {"text", "worse": rows marked}.
function score_table(rows, summary, before) {
  let lines = []
  let worse = 0
  let head = score_left("image", 34) + score_right("err", 7) + score_right("iou", 7) +
    score_right("fills", 7) + score_right("strokes", 8) + score_right("bytes", 9) + score_right("ms", 8)
  if (before !== null) {
    head = head + "   change (err, iou, bytes, ms)"
  }
  push(lines, head)
  for (let i = 0; i < len(rows); i += 1) {
    let r = rows[i]
    let line = score_left(r.image, 34) + score_right(r.err, 7) + score_right(r.iou, 7) +
      score_right(r.fills, 7) + score_right(r.strokes, 8) + score_right(r.bytes, 9) + score_right(r.ms, 8)
    if (before !== null) {
      let b = score_find(before.rows, r.image)
      if (b === null) {
        line = line + "   (new)"
      } else {
        line = line + "   " + score_delta(r.err, b.err, 2) + ", " + score_delta(r.iou, b.iou, 3) + ", " +
          score_delta(r.bytes, b.bytes, 0) + ", " + score_delta(r.ms, b.ms, 0)
        if (score_worse(r, b)) {
          line = line + "  ⚠"
          worse += 1
        }
      }
    }
    push(lines, line)
  }
  let tail = score_left("all " + str(summary.images) + " (mean err, iou; sums)", 34) + score_right(summary.err, 7) +
    score_right(summary.iou, 7) + score_right(summary.fills, 7) + score_right(summary.strokes, 8) +
    score_right(summary.bytes, 9) + score_right(summary.ms, 8)
  if (before !== null) {
    tail = tail + "   " + score_delta(summary.err, before.summary.err, 2) + ", " +
      score_delta(summary.iou, before.summary.iou, 3) + ", " + score_delta(summary.bytes, before.summary.bytes, 0) +
      ", " + score_delta(summary.ms, before.summary.ms, 0)
  }
  push(lines, tail)
  {"text": text.join(lines, "\n"), "worse": worse}
}

-~> The same rows as a markdown table.
function score_markdown(result) {
  let lines = ["| image | err | ink IoU | fills | strokes | bytes | ms |", "|---|---:|---:|---:|---:|---:|---:|"]
  for (let i = 0; i < len(result.rows); i += 1) {
    let r = result.rows[i]
    push(lines, "| " + r.image + " | " + str(r.err) + " | " + str(r.iou) + " | " + str(r.fills) + " | " +
      str(r.strokes) + " | " + str(r.bytes) + " | " + str(r.ms) + " |")
  }
  let s = result.summary
  push(lines, "| **all " + str(s.images) + "** (mean err, iou; sums) | " + str(s.err) + " | " + str(s.iou) + " | " +
    str(s.fills) + " | " + str(s.strokes) + " | " + str(s.bytes) + " | " + str(s.ms) + " |")
  text.join(lines, "\n") + "\n"
}

function score_main(args) {
  drawing_steps = 200000000
  let mode = "lineart"
  let json_out = false
  let out_file = null
  let md_file = null
  let compare = null
  let masks = null
  let set = {}
  let images = []
  let i = 0
  while (i < len(args)) {
    let a = args[i]
    if (a == "--mode") {
      mode = args[i + 1]
      i += 1
    } elif (a == "--json") {
      json_out = true
    } elif (a == "--out") {
      out_file = args[i + 1]
      i += 1
    } elif (a == "--md") {
      md_file = args[i + 1]
      i += 1
    } elif (a == "--masks") {
      masks = args[i + 1]
      i += 1
    } elif (a == "--compare") {
      compare = args[i + 1]
      i += 1
    } elif (a == "--quality") {
      set.quality = args[i + 1]
      i += 1
    } elif (a == "--set") {
      let kv = text.split(args[i + 1], "=")
      set[kv[0]] = json.parse(kv[1])
      i += 1
    } elif (text.slice(a, 0, 2) == "--") {
      io.error("unknown option " + a + "\n")
      os.exit(2)
    } else {
      push(images, a)
    }
    i += 1
  }
  if (mode != "lineart" && mode != "photo") {
    io.error("--mode is lineart or photo\n")
    os.exit(2)
  }
  if (len(images) == 0) {
    images = score_default_images()
  }
  let before = null
  if (compare !== null) {
    before = json.parse(fs.read(compare))
  }
  let rows = []
  for (let k = 0; k < len(images); k += 1) {
    io.error("[" + str(k + 1) + "/" + str(len(images)) + "] " + images[k] + " ...\n")
    let row = score_one(images[k], mode, masks, set)
    io.error("    err " + str(row.err) + " iou " + str(row.iou) + " " + str(row.ms) + " ms\n")
    push(rows, row)
  }
  let result = {"mode": mode, "rows": rows, "summary": score_summary(rows)}
  let table = score_table(rows, result.summary, before)
  if (json_out) {
    io.error(table.text + "\n")
    puts(json.write(result, 2))
  } else {
    puts(table.text)
  }
  if (out_file !== null) {
    fs.write(out_file, json.write(result, 2) + "\n")
  }
  if (md_file !== null) {
    fs.write(md_file, score_markdown(result))
  }
  if (table.worse > 0) {
    io.error(str(table.worse) + " row(s) got worse than the gate allows\n")
    os.exit(1)
  }
}

score_main(os.args())
