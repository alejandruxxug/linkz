-~> trace_score: scores the tracer on a set of pictures, one row each.
-~>
-~>   lizardscript tools/trace_score.liz [options] [images...]
-~>   scripts/trace_score.sh [options] [images...]      (the same, from anywhere)
-~>
-~> Without images it takes every PNG and JPEG of docs/Art/References/trace/.
-~> Each picture is traced with the default options, the traced code is drawn
-~> at the picture's size, and the row says:
-~>   err     the mean color error: |dR|+|dG|+|dB| / 3 over every pixel
-~>           (0 to 255), original against the drawing.
-~>   iou     ink IoU: the ink of the original and the ink of the drawing,
-~>           overlap over union (1 is the same lines in the same places).
-~>   fills, strokes   shapes in the code (photo mode has no strokes).
-~>   bytes   the length of the code.
-~>   ms      the tracer's own time (loading and drawing are not in it).
-~> then a summary line (means of err and iou, sums of the rest).
-~>
-~> Options:
-~>   --mode lineart|photo   the tracer's mode (lineart by default; photo
-~>                          traces at 256 px, its own default size).
-~>   --json                 print the result as JSON on stdout instead of the
-~>                          table (progress and the table go to stderr).
-~>   --masks DIR            save the ink masks of every picture there to look at.
-~>   --out FILE.json        also save the JSON; --md FILE.md a markdown table.
-~>   --compare before.json  print the change of every row against an earlier
-~>                          --json result, and mark with a warning sign a row
-~>                          whose error rose by more than 0.3 or whose IoU fell
-~>                          by more than 0.01 (the gate of Tracing v3). The
-~>                          exit code is 1 when some row is marked.
-~> Progress goes to stderr: tracing can take minutes.
-~>
-~> THE INK RULE. "Ink" of a picture is decided by one fixed rule, the same
-~> for the original and for the drawing, and written here so the tracer can
-~> change without moving the yardstick (it is not the tracer's own mask, and
-~> not the frozen one from before B062, which sees no ink in blue lines):
-~>   1. Paper: the picture is cut into cells of `cell` pixels (the longer
-~>      side / 128, at least 4). The paper of a cell is its lightest pixel
-~>      (by r+g+b), and the paper of a pixel is the lightest paper among its
-~>      cell and the 8 around it. So a colored line on white has white paper
-~>      and a line on a pale tint has the tint.
-~>   2. Far: a pixel is far when its CIE Lab distance from its paper is 25
-~>      or more. That is how a blue, red or gray line on white qualifies; a
-~>      pale shadow (distance under 25) does not.
-~>   3. Thin: a far pixel is ink only when its run of far pixels, along the
-~>      row or along the column, is at most `thin` pixels (the longer side
-~>      / 100, at least 5). Wide dark areas (hair, a navy skirt) are fills,
-~>      not ink; a line is thin on at least one axis whatever its slope.
-~> The Lab here is D65 Lab with gamma 2 for the linear light, written out in
-~> this file (distances are within a few percent of exact sRGB).

use "../lib/app/drawing"
use "../lib/app/paint"
use "../lib/app/host"
use "../lib/draw/geometry"
use "../lib/app/host_img"
use "../lib/app/libs"
use "../lib/trace/trace"

let score_refs = "docs/Art/References/trace"
let score_far = 25.0

-~> The cube root of t, by Newton steps (t from 0 to 1.1).
function score_cbrt(t) {
  if (t <= 0.0) {
    return 0.0
  }
  let x = 0.7
  for (let k = 0; k < 8; k += 1) {
    x = (2.0 * x + t / (x * x)) / 3.0
  }
  x
}

-~> One channel (0 to 255) as linear light, with gamma 2 (close to sRGB).
function score_linear(v) {
  let c = v / 255.0
  c * c
}

-~> The Lab color [L, a, b] of an r, g, b color (D65 white).
function score_lab(r, g, b) {
  let lr = score_linear(r)
  let lg = score_linear(g)
  let lb = score_linear(b)
  let fx = score_cbrt((0.4124 * lr + 0.3576 * lg + 0.1805 * lb) / 0.95047)
  let fy = score_cbrt(0.2126 * lr + 0.7152 * lg + 0.0722 * lb)
  let fz = score_cbrt((0.0193 * lr + 0.1192 * lg + 0.9505 * lb) / 1.08883)
  [116.0 * fy - 16.0, 500.0 * (fx - fy), 200.0 * (fy - fz)]
}

-~> The ink of a picture (flat list of colors, w by h) by the rule in the
-~> header: a list of 0 and 1, row by row.
function score_ink(pixels, w, h) {
  let cell = math.max(4, math.round(math.max(w, h) / 128.0))
  let thin = math.max(5, math.round(math.max(w, h) / 100.0))
  let cw = math.ceil(w * 1.0 / cell)
  let ch = math.ceil(h * 1.0 / cell)
  -~> the lightest pixel of every cell
  let best = []
  for (let c = 0; c < cw * ch; c += 1) {
    push(best, -1)
  }
  for (let y = 0; y < h; y += 1) {
    for (let x = 0; x < w; x += 1) {
      let c = math.floor(y / cell) * cw + math.floor(x / cell)
      let p = pixels[y * w + x]
      let b = best[c]
      if (b < 0 || p.r + p.g + p.b > pixels[b].r + pixels[b].g + pixels[b].b) {
        best[c] = y * w + x
      }
    }
  }
  -~> the paper of every cell: the lightest of it and its 8 neighbours
  let paper = []
  for (let cy = 0; cy < ch; cy += 1) {
    for (let cx = 0; cx < cw; cx += 1) {
      let top = -1
      let sum = -1
      for (let dy = -1; dy <= 1; dy += 1) {
        for (let dx = -1; dx <= 1; dx += 1) {
          let nx = cx + dx
          let ny = cy + dy
          if (nx >= 0 && ny >= 0 && nx < cw && ny < ch) {
            let p = pixels[best[ny * cw + nx]]
            if (p.r + p.g + p.b > sum) {
              sum = p.r + p.g + p.b
              top = best[ny * cw + nx]
            }
          }
        }
      }
      let p = pixels[top]
      push(paper, {"r": p.r, "g": p.g, "b": p.b, "lab": score_lab(p.r, p.g, p.b)})
    }
  }
  -~> far pixels
  let far = []
  for (let y = 0; y < h; y += 1) {
    let cy = math.floor(y / cell)
    for (let x = 0; x < w; x += 1) {
      let q = paper[cy * cw + math.floor(x / cell)]
      let p = pixels[y * w + x]
      let is_far = 0
      if (math.abs(p.r - q.r) + math.abs(p.g - q.g) + math.abs(p.b - q.b) >= 24) {
        let lab = score_lab(p.r, p.g, p.b)
        let d0 = lab[0] - q.lab[0]
        let d1 = lab[1] - q.lab[1]
        let d2 = lab[2] - q.lab[2]
        if (d0 * d0 + d1 * d1 + d2 * d2 >= score_far * score_far) {
          is_far = 1
        }
      }
      push(far, is_far)
    }
  }
  -~> thin: the run of far pixels is short along the row or along the column
  let across = []
  for (let i = 0; i < w * h; i += 1) {
    push(across, 0)
  }
  for (let y = 0; y < h; y += 1) {
    let x = 0
    while (x < w) {
      if (far[y * w + x] == 0) {
        x += 1
        continue
      }
      let e = x
      while (e < w && far[y * w + e] == 1) {
        e += 1
      }
      if (e - x <= thin) {
        for (let k = x; k < e; k += 1) {
          across[y * w + k] = 1
        }
      }
      x = e
    }
  }
  for (let x = 0; x < w; x += 1) {
    let y = 0
    while (y < h) {
      if (far[y * w + x] == 0) {
        y += 1
        continue
      }
      let e = y
      while (e < h && far[e * w + x] == 1) {
        e += 1
      }
      if (e - y <= thin) {
        for (let k = y; k < e; k += 1) {
          across[k * w + x] = 1
        }
      }
      y = e
    }
  }
  across
}

-~> Ink IoU of two masks, 0 to 1 (1 when neither has any ink).
function score_iou(a, b) {
  let both = 0
  let either = 0
  for (let i = 0; i < len(a); i += 1) {
    if (a[i] == 1 && b[i] == 1) { both += 1 }
    if (a[i] == 1 || b[i] == 1) { either += 1 }
  }
  if (either == 0) {
    return 1.0
  }
  both * 1.0 / either
}

-~> Rounds x to `places` decimals.
function score_round(x, places) {
  let k = 1
  for (let i = 0; i < places; i += 1) {
    k = k * 10
  }
  if (places == 0) {
    return math.round(x)
  }
  math.round(x * k) / (k * 1.0)
}

-~> The file name of a path, without its folders.
function score_name(path) {
  let parts = text.split(path, "/")
  parts[len(parts) - 1]
}

-~> The images of the references folder, by name.
function score_default_images() {
  let out = []
  let names = list.sort(fs.list(score_refs))
  for (let i = 0; i < len(names); i += 1) {
    let n = text.lower(names[i])
    if (text.slice(n, -4, len(n)) == ".png" || text.slice(n, -4, len(n)) == ".jpg" || text.slice(n, -5, len(n)) == ".jpeg") {
      push(out, fs.join(score_refs, names[i]))
    }
  }
  out
}

-~> Saves the two ink masks as PNGs in `dir` (black ink on white; red where
-~> only the original has ink, blue where only the drawing has), to look at.
function score_save_masks(dir, name, size, a, b) {
  fs.mkdir(dir)
  let px = []
  for (let i = 0; i < len(a); i += 1) {
    if (a[i] == 1 && b[i] == 1) {
      push(px, #000000)
    } elif (a[i] == 1) {
      push(px, #e03030)
    } elif (b[i] == 1) {
      push(px, #3030e0)
    } else {
      push(px, #ffffff)
    }
  }
  img.save(img.from_pixels(size, px), fs.join(dir, name + "-ink.png"))
}

-~> Scores one picture: {"image", "err", "iou", "fills", "strokes", "bytes",
-~> "ms"}.
function score_one(path, mode, masks) {
  let side = 1024
  if (mode == "photo") {
    side = 256
  }
  let loaded = host_img().load(path, side)
  let size = loaded.size
  let t = trace_pixels(size, loaded.pixels, {"mode": mode}, path)
  let run = drawing_run(t.code)
  let bg = run.canvas.background
  let buf = paint_run(t.code + "\nraster.paint(drawing, (0, 0))\n", size)
  let px = img.pixels(buf)
  let flat = []
  let err = 0.0
  for (let i = 0; i < len(px); i += 1) {
    let c = px[i]
    let a = c.a / 255.0
    let r = math.round(c.r * a + bg.r * (1 - a))
    let g = math.round(c.g * a + bg.g * (1 - a))
    let b = math.round(c.b * a + bg.b * (1 - a))
    push(flat, rgb(r, g, b))
    let o = loaded.pixels[i]
    err = err + (math.abs(r - o.r) + math.abs(g - o.g) + math.abs(b - o.b)) / 3.0
  }
  let ink_a = score_ink(loaded.pixels, size.x, size.y)
  let ink_b = score_ink(flat, size.x, size.y)
  let iou = score_iou(ink_a, ink_b)
  if (masks !== null) {
    score_save_masks(masks, score_name(path), size, ink_a, ink_b)
  }
  let fills = t.stats.fills
  let strokes = t.stats.strokes
  if (mode == "photo") {
    fills = t.stats.regions
    strokes = 0
  }
  {
    "image": score_name(path),
    "err": score_round(err / len(px), 2),
    "iou": score_round(iou, 3),
    "fills": fills,
    "strokes": strokes,
    "bytes": len(t.code),
    "ms": math.round(t.stats.ms)
  }
}

-~> Spaces added on the right of s up to n characters.
function score_left(s, n) {
  let out = str(s)
  while (len(out) < n) {
    out = out + " "
  }
  out
}

-~> Spaces added on the left of s up to n characters.
function score_right(s, n) {
  let out = str(s)
  while (len(out) < n) {
    out = " " + out
  }
  out
}

-~> The +/- change text of a number, "" when there is no earlier one.
function score_delta(now, before, places) {
  if (before === null) {
    return ""
  }
  let d = score_round(now - before, places)
  if (d > 0) {
    return "+" + str(d)
  }
  str(d)
}

-~> Whether a row got worse than its earlier self by the gate's line.
function score_worse(row, before) {
  before !== null && (row.err - before.err > 0.3 || row.iou - before.iou < -0.01)
}

-~> The earlier row for an image name, or null.
function score_find(rows, name) {
  for (let i = 0; i < len(rows); i += 1) {
    if (rows[i].image == name) {
      return rows[i]
    }
  }
  null
}

-~> The summary of the rows: means of err and iou, sums of the rest.
function score_summary(rows) {
  let s = {"images": len(rows), "err": 0.0, "iou": 0.0, "fills": 0, "strokes": 0, "bytes": 0, "ms": 0}
  for (let i = 0; i < len(rows); i += 1) {
    s.err = s.err + rows[i].err
    s.iou = s.iou + rows[i].iou
    s.fills += rows[i].fills
    s.strokes += rows[i].strokes
    s.bytes += rows[i].bytes
    s.ms += rows[i].ms
  }
  if (len(rows) > 0) {
    s.err = score_round(s.err / len(rows), 2)
    s.iou = score_round(s.iou / len(rows), 3)
  }
  s
}

-~> The text table of the rows (and of the change against `before`, when
-~> given). Returns {"text", "worse": rows marked}.
function score_table(rows, summary, before) {
  let lines = []
  let worse = 0
  let head = score_left("image", 34) + score_right("err", 7) + score_right("iou", 7) +
    score_right("fills", 7) + score_right("strokes", 8) + score_right("bytes", 9) + score_right("ms", 8)
  if (before !== null) {
    head = head + "   change (err, iou, bytes, ms)"
  }
  push(lines, head)
  for (let i = 0; i < len(rows); i += 1) {
    let r = rows[i]
    let line = score_left(r.image, 34) + score_right(r.err, 7) + score_right(r.iou, 7) +
      score_right(r.fills, 7) + score_right(r.strokes, 8) + score_right(r.bytes, 9) + score_right(r.ms, 8)
    if (before !== null) {
      let b = score_find(before.rows, r.image)
      if (b === null) {
        line = line + "   (new)"
      } else {
        line = line + "   " + score_delta(r.err, b.err, 2) + ", " + score_delta(r.iou, b.iou, 3) + ", " +
          score_delta(r.bytes, b.bytes, 0) + ", " + score_delta(r.ms, b.ms, 0)
        if (score_worse(r, b)) {
          line = line + "  ⚠"
          worse += 1
        }
      }
    }
    push(lines, line)
  }
  let tail = score_left("all " + str(summary.images) + " (mean err, iou; sums)", 34) + score_right(summary.err, 7) +
    score_right(summary.iou, 7) + score_right(summary.fills, 7) + score_right(summary.strokes, 8) +
    score_right(summary.bytes, 9) + score_right(summary.ms, 8)
  if (before !== null) {
    tail = tail + "   " + score_delta(summary.err, before.summary.err, 2) + ", " +
      score_delta(summary.iou, before.summary.iou, 3) + ", " + score_delta(summary.bytes, before.summary.bytes, 0) +
      ", " + score_delta(summary.ms, before.summary.ms, 0)
  }
  push(lines, tail)
  {"text": text.join(lines, "\n"), "worse": worse}
}

-~> The same rows as a markdown table.
function score_markdown(result) {
  let lines = ["| image | err | ink IoU | fills | strokes | bytes | ms |", "|---|---:|---:|---:|---:|---:|---:|"]
  for (let i = 0; i < len(result.rows); i += 1) {
    let r = result.rows[i]
    push(lines, "| " + r.image + " | " + str(r.err) + " | " + str(r.iou) + " | " + str(r.fills) + " | " +
      str(r.strokes) + " | " + str(r.bytes) + " | " + str(r.ms) + " |")
  }
  let s = result.summary
  push(lines, "| **all " + str(s.images) + "** (mean err, iou; sums) | " + str(s.err) + " | " + str(s.iou) + " | " +
    str(s.fills) + " | " + str(s.strokes) + " | " + str(s.bytes) + " | " + str(s.ms) + " |")
  text.join(lines, "\n") + "\n"
}

function score_main(args) {
  drawing_steps = 200000000
  let mode = "lineart"
  let json_out = false
  let out_file = null
  let md_file = null
  let compare = null
  let masks = null
  let images = []
  let i = 0
  while (i < len(args)) {
    let a = args[i]
    if (a == "--mode") {
      mode = args[i + 1]
      i += 1
    } elif (a == "--json") {
      json_out = true
    } elif (a == "--out") {
      out_file = args[i + 1]
      i += 1
    } elif (a == "--md") {
      md_file = args[i + 1]
      i += 1
    } elif (a == "--masks") {
      masks = args[i + 1]
      i += 1
    } elif (a == "--compare") {
      compare = args[i + 1]
      i += 1
    } elif (text.slice(a, 0, 2) == "--") {
      io.error("unknown option " + a + "\n")
      os.exit(2)
    } else {
      push(images, a)
    }
    i += 1
  }
  if (mode != "lineart" && mode != "photo") {
    io.error("--mode is lineart or photo\n")
    os.exit(2)
  }
  if (len(images) == 0) {
    images = score_default_images()
  }
  let before = null
  if (compare !== null) {
    before = json.parse(fs.read(compare))
  }
  let rows = []
  for (let k = 0; k < len(images); k += 1) {
    io.error("[" + str(k + 1) + "/" + str(len(images)) + "] " + images[k] + " ...\n")
    let row = score_one(images[k], mode, masks)
    io.error("    err " + str(row.err) + " iou " + str(row.iou) + " " + str(row.ms) + " ms\n")
    push(rows, row)
  }
  let result = {"mode": mode, "rows": rows, "summary": score_summary(rows)}
  let table = score_table(rows, result.summary, before)
  if (json_out) {
    io.error(table.text + "\n")
    puts(json.write(result, 2))
  } else {
    puts(table.text)
  }
  if (out_file !== null) {
    fs.write(out_file, json.write(result, 2) + "\n")
  }
  if (md_file !== null) {
    fs.write(md_file, score_markdown(result))
  }
  if (table.worse > 0) {
    io.error(str(table.worse) + " row(s) got worse than the gate allows\n")
    os.exit(1)
  }
}

score_main(os.args())
