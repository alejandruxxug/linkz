-~> The editor's speed on big drawings (docs/Batches/fixtures, made by the
-~> old Go host's perf test): a full repaint, a small edit, one frame of dragging
-~> a shape, one keystroke, and the edits that add or take away lines, each
-~> timed as whole frames (events, run, paint); then artist mode's repaint,
-~> drag, property scrub in the context bar and layer row reorder. Run it alone to see the
-~> table: lizardscript tests/editor/editor_bench.liz [rounds]
-~> (lizardscript test --bench runs it as part of the tests, once each).
-~> A zoom change shows the old picture scaled at once and becomes sharp a few
-~> frames later: "_set" is the first frame after the change, "_sharp" the frames
-~> until the picture is sharp; "_back" is the same going back to a zoom seen a moment ago.

use "../../lib/app/libs"
use "../../lib/app/paint"
use "rig"

let rounds = 1
if (len(os.args()) > 0) {
  rounds = text.number(os.args()[0])
}

-~> The line of the first shape row, and of a shape row in the middle of a
-~> drawing of n shapes (one layer line per 50 shapes).
let first_shape = 5
function middle(n) {
  let i = n // 2 + 10
  first_shape + i + i // 50
}

-~> Runs f, then a frame with the events f gives, rounds times; reports the
-~> frame's milliseconds and the editor's phases (perf.liz) per round.
function bench(rig, name, f, undo = null) {
  let total = 0
  let phases = {}
  for (let i = 0; i < rounds; i += 1) {
    let events = f(i)
    let start = time.ms()
    rig_frame(rig, events)
    total += time.ms() - start
    let p = rig.ed.app.debug_perf()
    let ks = keys(p)
    for (let k = 0; k < len(ks); k += 1) {
      if (phases[ks[k]] == null) {
        phases[ks[k]] = 0
      }
      phases[ks[k]] += p[ks[k]]
    }
    if (undo != null) {
      undo()
    }
  }
  let parts = []
  let ks = list.sort(keys(phases))
  for (let k = 0; k < len(ks); k += 1) {
    push(parts, ks[k] + " " + str(math.round(phases[ks[k]] / rounds * 10) / 10.0))
  }
  puts(name, str(math.round(total / rounds * 10) / 10.0) + " ms", "(" + text.join(parts, ", ") + ")")
  if (rig.ed.error != "") {
    puts("  error:", rig.ed.error)
  }
}

-~> Runs frames until the scene for the new zoom is ready (the picture is sharp, see
-~> view_scene_zoom.liz) and reports how many it took and how long they all took.
function sharp(rig, name) {
  let frames = 0
  let start = time.ms()
  let worst = 0
  while (rig.names.zoom_busy() && frames < 5000) {
    let t = time.ms()
    rig_frame(rig)
    worst = math.max(worst, time.ms() - t)
    frames += 1
  }
  puts(name, str(frames) + " frames", str(math.round(time.ms() - start)) + " ms", "(slowest frame " + str(math.round(worst * 10) / 10.0) + " ms)")
}

-~> The modules the artist cases reach into, besides the rig's.
let bench_modules = rig_modules + ["ui/artist_route", "ui/artist_layers", "ui/view_panels", "ui/view_canvas", "ui/canvas_zoom", "ui/view_scene_zoom"]

let sizes = [2000, 10000]
for (let s = 0; s < len(sizes); s += 1) {
  let count = sizes[s]
  let k = str(count // 1000) + "k/"
  let t0 = time.ms()
  let code = fs.read(fs.join(libs_root(), "docs", "Batches", "fixtures", "shapes-" + str(count // 1000) + "k.lzdraw"))
  let rig = rig_open(fs.join(fs.home(), "bench-" + str(count)), code, (800, 500), bench_modules)
  let n = rig.names
  puts(k + "open", str(math.round(time.ms() - t0)) + " ms")

  bench(rig, k + "full_repaint", function(_i) {
    if (n.V.scene != null) {
      n.tiles_mark_all(n.V.scene.tiles)
    }
    n.view_force_all()
    n.app.needs_paint = true
    []
  })

  -~> zoomed in, panning: every frame moves the drawing 48 window pixels, back
  -~> and forth along the drawing (zoom, repaint the visible part, tiles)
  let steps = [["zoom_400", 4.0], ["zoom_1600", 16.0]]
  for (let z = 0; z < len(steps); z += 1) {
    let dir = 1
    bench(rig, k + steps[z][0] + "_set", function(_i) {
      n.canvas_zoom_set(steps[z][1], n.canvas_zoom_centre())
      []
    })
    sharp(rig, k + steps[z][0] + "_sharp")
    bench(rig, k + steps[z][0] + "_pan", function(_i) {
      let before = n.view_canvas_layout().wx
      n.canvas_pan_by(-48 * dir, -20 * dir)
      if (n.view_canvas_layout().wx == before) {
        dir = -dir
      }
      []
    })
  }
  n.canvas_zoom_fit()
  rig_frame(rig)
  sharp(rig, k + "fit_sharp")

  -~> and back to a zoom visited before: its scene was kept (view_scene_zoom.liz)
  bench(rig, k + "zoom_400_back_set", function(_i) {
    n.canvas_zoom_set(4.0, n.canvas_zoom_centre())
    []
  })
  sharp(rig, k + "zoom_400_back_sharp")
  n.canvas_zoom_fit()
  rig_frame(rig)
  sharp(rig, k + "fit_back_sharp")

  n.ed_select(first_shape)
  n.view_after()
  rig_frame(rig)
  bench(rig, k + "small_edit", function(i) {
    n.ed_set_prop("r", str(10 + i % 2))
    n.view_after()
    []
  })

  let at = n.view_to_window(n.view_canvas_layout(), (400, 300)) * 0.5
  rig_frame(rig, [{"type": "down", "pos": at}])
  bench(rig, k + "drag_frame", function(i) {
    let d = 2 + i % 8
    [{"type": "move", "pos": at + (d, d / 2.0)}]
  })
  rig_frame(rig, [{"type": "up", "pos": at}])
  n.ed_undo()
  n.view_after()
  rig_frame(rig)

  n.ed_select(first_shape)
  n.ed_set_prop("r", "20")
  n.ed_set_caret(first_shape, 23)
  n.view_after()
  rig_frame(rig)
  bench(rig, k + "keystroke", function(i) {
    if (i % 2 == 0) {
      return [{"type": "type", "text": "1"}]
    }
    [{"type": "key", "key": "Backspace"}]
  })
  if (rounds % 2 == 1) {
    rig_frame(rig, [{"type": "key", "key": "Backspace"}])
  }

  let mid = middle(count)
  let undo = function() {
    n.ed_undo()
    n.view_after()
    rig_frame(rig)
  }
  bench(rig, k + "enter", function(_i) {
    n.ed_set_caret(mid, 1000)
    n.view_after()
    rig_frame(rig)
    [{"type": "key", "key": "Enter"}]
  }, undo)
  bench(rig, k + "delete_line", function(_i) {
    n.ed_select_range(mid, mid)
    n.view_after()
    rig_frame(rig)
    [{"type": "key", "key": "Backspace"}]
  }, undo)
  bench(rig, k + "paste_20", function(_i) {
    rig_clip.set(n.edit_rows_text(n.ed_model(), mid + 3, mid + 22))
    n.ed_set_caret(mid, 0)
    n.view_after()
    rig_frame(rig)
    [{"type": "key", "key": "V", "mods": {"shift": false, "alt": false, "cmd": true, "ctrl": false}}]
  }, undo)

  n.ed_set_caret(mid, 1000)
  n.view_after()
  rig_frame(rig)
  bench(rig, k + "broken_keystroke", function(i) {
    if (i % 2 == 0) {
      return [{"type": "key", "key": "Backspace"}]
    }
    [{"type": "type", "text": ")"}]
  })
  if (rounds % 2 == 1) {
    rig_frame(rig, [{"type": "type", "text": ")"}])
  }

  -~> artist mode: the same drag, a property scrubbed in the context bar
  -~> (an edit per frame, like a keystroke) and a layer row dragged below
  -~> the next one (the release is the frame)
  n.art_set_mode(true)
  n.ed_select(first_shape)
  n.view_after()
  rig_frame(rig)
  -~> the layout changed, so did the fit zoom: let the picture become sharp
  sharp(rig, k + "artist_sharp")
  bench(rig, k + "artist_repaint", function(_i) {
    if (n.V.scene != null) {
      n.tiles_mark_all(n.V.scene.tiles)
    }
    n.view_force_all()
    n.app.needs_paint = true
    []
  })
  at = n.view_to_window(n.view_canvas_layout(), (400, 300)) * 0.5
  rig_frame(rig, [{"type": "down", "pos": at}])
  bench(rig, k + "artist_drag_frame", function(i) {
    let d = 2 + i % 8
    [{"type": "move", "pos": at + (d, d / 2.0)}]
  })
  rig_frame(rig, [{"type": "up", "pos": at}])
  n.ed_undo()
  n.view_after()
  n.ed_select(first_shape)
  n.view_after()
  rig_frame(rig)
  let r_box = null
  let lay = n.view_props_cached()
  for (let i = 0; i < len(lay.boxes); i += 1) {
    if (lay.boxes[i].field == "r") {
      r_box = lay.boxes[i]
    }
  }
  let rp = (r_box.x + 4, r_box.y + 8)
  rig_frame(rig, [{"type": "down", "pos": rp}])
  bench(rig, k + "artist_prop_edit", function(i) {
    [{"type": "move", "pos": rp + (3 + i % 2, 0)}]
  })
  rig_frame(rig, [{"type": "up", "pos": rp}])
  n.ed_undo()
  n.view_after()
  n.ed_toggle_fold(first_shape - 1)
  n.view_select_line(first_shape - 1)
  n.view_after()
  rig_frame(rig)
  let vis = n.la_visible()
  let lx = n.la_rect()[0] + 80
  let from = (lx, vis[0].y + 9)
  let to = (lx, vis[1].y + 16)
  bench(rig, k + "artist_reorder", function(_i) {
    rig_frame(rig, [{"type": "down", "pos": from}])
    rig_frame(rig, [{"type": "move", "pos": to}])
    [{"type": "up", "pos": to}]
  }, undo)
  n.art_set_mode(false)
  rig_frame(rig)
  sharp(rig, k + "back_sharp")
}

-~> a stamped brush stroke: 300 points, about 2000 stamps (lib/gfx/tests/stamped_bench.liz)
puts("stamped brush, 300 points:")
paint_run(fs.read(fs.join(libs_dir(), "gfx", "tests", "stamped_bench.liz")), (640, 400))
