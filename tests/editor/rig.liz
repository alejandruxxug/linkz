-~> rig: the editor in a headless window, for the tests and benchmarks: it
-~> opens a drawing, runs frames with the events given, and reaches into the
-~> editor's own functions (rig.names) like the old Go host's tests did.

use "../../lib/app/editor"

-~> The modules the tests reach into, besides the app.
let rig_modules = editor_modules + ["ui/view_layout", "ui/view_input", "ui/view_main", "ui/editor_state",
  "ui/editor_undo", "ui/editor_edit", "ui/editor_doc", "ui/editor_rows", "gfx/tiles"]

-~> A clipboard of the rig's own, so nothing touches the system's.
let rig_clip_text = {"text": ""}
let rig_clip = {"get": function() { rig_clip_text.text }, "set": function(s) { rig_clip_text.text = s }}

-~> The system dialogs of the rig: none opens. choose_file and choose_save record their
-~> options in rig_dialog_calls and rig_save_calls; a test then injects the "chosen" event itself.
let rig_dialog_calls = []
let rig_save_calls = []
let rig_dialog = {
  "choose_file": function(options) { push(rig_dialog_calls, options) },
  "choose_save": function(options) { push(rig_save_calls, options) }
}

-~> The settings a rig's editor starts with: the first-run tutorial already
-~> seen, so it doesn't cover the editor (tests/editor/tutorial.liz passes {}).
let rig_settings = {"tutorial_done": true}

-~> The editor on the text code (written to a file in dir), in a headless
-~> window of size: {"win", "ed", "names", "path"}. modules: what rig.names
-~> has; settings: the editor's settings.
function rig_open(dir, code, size = editor_size, modules = rig_modules, settings = rig_settings) {
  let path = fs.join(dir, "drawing.lzdraw")
  fs.mkdir(dir)
  fs.write(path, code)
  let win = window.open(size.x, size.y, "Linkz", hash.merge(editor_options(), {"headless": true}))
  let ed = editor_load(win, path, settings, {}, modules, {"clip": rig_clip, "dialog": rig_dialog})
  let rig = {"win": win, "ed": ed, "names": ed.names, "path": path}
  rig_frame(rig)
  rig
}

-~> One frame with the events given (each injected like real input).
function rig_frame(rig, events = []) {
  for (let i = 0; i < len(events); i += 1) {
    window.inject(rig.win, events[i])
  }
  let done = false
  window.needs_paint(rig.win)
  window.run(rig.win, function(evs) {
    if (done) {
      return false
    }
    done = true
    editor_tick(rig.ed, evs)
    true
  })
  rig.ed.error
}

-~> The window as it shows, every pixel of the screen (the interface at its
-~> scale, the canvas at its own), as PNG text (rect: the part to keep).
function rig_shot(rig, rect = null) {
  let shot = window.screenshot(rig.win, {"full": true})
  if (rect == null) {
    return img.png_base64(shot)
  }
  img.png_base64(shot, rect)
}
