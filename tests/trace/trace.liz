-~> The tracer on tiny pictures made here (grid(w, h, f) calls f(x, y) for
-~> every pixel, row by row): how many colors, regions and holes it finds,
-~> that its code runs, how many shapes it draws, that it makes an SVG, and
-~> the net area of its first path (holes taken away) where it is known. Then
-~> the code of a ring against a golden file, and the checks of the options.

use "../../lib/app/drawing"
use "../../lib/app/libs"
use "../../lib/draw/geometry"
use "../../lib/draw/svg"
use "../../lib/trace/trace"

let red = #c82828
let white = #f0f0e6
let green = #2d8a3e
let blue = #2850c8

function grid(w, h, f) {
  let px = []
  for (let y = 0; y < h; y = y + 1) {
    for (let x = 0; x < w; x = x + 1) {
      push(px, f(x, y))
    }
  }
  {"size": (w, h), "pixels": px}
}

-~> The net area of a path shape, holes taken away, from its outlines.
function net_area(shape) {
  let subs = flatten_path(shape.path, 0.05)
  let sum = 0.0
  for (let i = 0; i < len(subs); i = i + 1) {
    sum = sum + polygon_area2(subs[i].points)
  }
  math.abs(sum) / 2.0
}

let square = function(x, y) { if (x >= 4 && x < 8 && y >= 4 && y < 8) { red } else { white } }
let ring = function(x, y) {
  if (x >= 5 && x < 9 && y >= 5 && y < 9) { white } elif (x >= 2 && x < 12 && y >= 2 && y < 12) { red } else { white }
}

-~> [name, picture, options, area (0 to skip)]
let cases = [
  ["two colors, a square", grid(12, 12, square), {"colors": 2, "min_area": 0}, 16],
  ["a square with a hole", grid(14, 14, ring), {"colors": 2, "min_area": 0}, 84],
  ["three colors in bands", grid(12, 6, function(x, y) { if (x < 4) { red } elif (x < 8) { green } else { blue } }),
    {"colors": 3, "min_area": 0}, 0],
  ["three colors, nested", grid(15, 15, function(x, y) {
    if (x >= 5 && x < 10 && y >= 5 && y < 10) { blue } elif (x >= 2 && x < 13 && y >= 2 && y < 13) { green } else { white }
  }), {"colors": 3, "min_area": 0}, 0],
  ["corners only touching are two regions", grid(2, 2, function(x, y) { if (x == y) { red } else { white } }),
    {"colors": 2, "min_area": 0}, 0],
  ["a speck is merged", grid(12, 12, function(x, y) { if (x == 6 && y == 6) { red } else { white } }),
    {"colors": 2, "min_area": 4}, 0],
  ["no background rectangle", grid(12, 12, square), {"colors": 2, "min_area": 0, "background": false}, 16]
]

for (let i = 0; i < len(cases); i += 1) {
  let c = cases[i]
  let result = trace_pixels(c[1].size, c[1].pixels, c[2], "test")
  let st = result.stats
  let run = drawing_run(result.code)
  let svg = svg_document(run.canvas, run.shapes)
  let area = "-"
  if (c[3] > 0) {
    let found = null
    for (let k = 0; k < len(run.shapes); k += 1) {
      if (found === null && run.shapes[k].kind == "path") {
        found = run.shapes[k]
      }
    }
    area = str(math.abs(net_area(found) - c[3]) < 0.01)
  }
  puts(c[0] + ":", [st.colors, st.regions, st.holes], "errors", run.errors, "shapes", len(run.shapes),
    "svg", text.find(svg, "<path") >= 0, "area", area)
}

let golden = fs.read(fs.join(libs_dir(), "trace", "tests", "ring.lzdraw.expected"))
let pic = grid(14, 14, ring)
puts("ring golden:", trace_pixels(pic.size, pic.pixels, {"colors": 2, "min_area": 0}, "ring").code == golden)

let bad = [{"colours": 4}, {"colors": 1}, 5]
let tiny = grid(2, 2, function(x, y) { red })
for (let i = 0; i < len(bad); i += 1) {
  try {
    trace_pixels(tiny.size, tiny.pixels, bad[i])
    puts("no error for", bad[i])
  } catch (e) {
    puts(text.starts(e.message, "trace:"), e.message)
  }
}
