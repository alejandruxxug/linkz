-~> The parallel option of the line-art tracer: the pieces of work run in
-~> tasks (or here when there are none) give exactly what they give run
-~> here, the mask and the shapes included, and the option is checked.

use "../../lib/trace/trace"
use "../../lib/trace/lineart_mask"
use "../../lib/trace/lineart_parallel"
use "../../lib/trace/lineart_task"

-~> A picture of w by h: a dark ring on a light ground with a red patch, from
-~> a function of the pixel position (no randomness, so every run is the same).
function ring_picture(w, h) {
  let px = []
  for (let y = 0; y < h; y += 1) {
    for (let x = 0; x < w; x += 1) {
      let dx = x - w / 2.0
      let dy = y - h / 2.0
      let d = math.sqrt(dx * dx + dy * dy)
      if (d > 18 && d < 22) {
        push(px, rgb(20, 20, 30))
      } elif (d < 10) {
        push(px, rgb(220, 60, 50))
      } else {
        push(px, rgb(235, 235, 225))
      }
    }
  }
  {"size": (w, h), "pixels": px}
}

let values = []
for (let i = 0; i < 40 * 30; i += 1) {
  push(values, (i * 37 % 101) * 0.37)
}
let here = lineart_jobs(false).run([["box_sums", [values, 40, 30, 3]], ["box_sums", [values, 40, 30, 1]]])
let side = lineart_jobs(true).run([["box_sums", [values, 40, 30, 3]], ["box_sums", [values, 40, 30, 1]]])
puts("sums side by side are the sums here:", here == side, len(here), len(here[0]) == 1200)
puts("jobs false never use tasks:", lineart_jobs(false).parallel)

let pic = ring_picture(70, 70)
let a = trace_pixels(pic.size, pic.pixels, {"mode": "lineart", "parallel": false}, "ring")
let b = trace_pixels(pic.size, pic.pixels, {"mode": "lineart", "parallel": true}, "ring")
puts("the same code with and without tasks:", a.code == b.code, a.stats.strokes == b.stats.strokes)

let m = lineart_mask(pic.pixels, 70, 70, 0.5, 4)
let mp = lineart_mask(pic.pixels, 70, 70, 0.5, 4, lineart_jobs(true))
puts("the mask is the same:", m.mask == mp.mask, m.ink == mp.ink)

let regions = lineart_task_run("shapes", [[], {"order": []}, [], [], 1, 1, {}])
puts("no regions, no shapes:", regions)
let bad = false
try {
  trace_pixels(pic.size, pic.pixels, {"mode": "lineart", "parallel": "yes"}, "ring")
} catch (e) {
  bad = true
  puts(e.message)
}
puts("parallel must be true or false:", bad)
