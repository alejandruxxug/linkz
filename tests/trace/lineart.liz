-~> The line-art tracer on stroke pictures made here (ink(w, h, parts) draws
-~> antialiased segments [a, b, half-width at a, half-width at b], black on
-~> white): how many strokes it finds, their tips and junctions, that its
-~> code runs and draws one brush per stroke, and how close the strokes stay
-~> to the lines drawn. Then the fills (cel(w, h, f) paints a picture from a
-~> function of the pixel center): how many, their colors' names, that they
-~> reach under the lines with no seam, that a solid dark area becomes a fill
-~> and not strokes. Then the photo mode by name, and the option checks.

use "../../lib/app/drawing"
use "../../lib/app/paint"
use "../../lib/draw/geometry"
use "../../lib/trace/trace"
use "../../lib/trace/lineart_mask"

-~> The distance from p to the segment a-b, and how far along it (0 to 1).
function seg_dist(p, a, b) {
  let ab = b - a
  let t = ((p.x - a.x) * ab.x + (p.y - a.y) * ab.y) / float(ab.x * ab.x + ab.y * ab.y)
  t = math.max(0.0, math.min(1.0, t))
  [math.dist(p, a + ab * t), t]
}

function ink(w, h, parts) {
  let px = []
  for (let y = 0; y < h; y += 1) {
    for (let x = 0; x < w; x += 1) {
      let cover = 0.0
      for (let k = 0; k < len(parts); k += 1) {
        let s = parts[k]
        let d = seg_dist((x + 0.5, y + 0.5), s[0], s[1])
        let half = s[2] + (s[3] - s[2]) * d[1]
        cover = math.max(cover, math.max(0.0, math.min(1.0, half - d[0] + 0.5)))
      }
      let v = math.round(250 - 230 * cover)
      push(px, rgb(v, v, v))
    }
  }
  {"size": (w, h), "pixels": px, "parts": parts}
}

-~> The points a stroke is drawn through: a brush's on-curve points, or a
-~> line's two ends.
function stroke_points(shape) {
  if (shape.kind == "line") {
    return [shape.args[0], shape.args[1]]
  }
  let out = []
  for (let i = 0; i < len(shape.args[0]); i += 1) {
    push(out, item_end(shape.args[0][i]))
  }
  out
}

-~> The farthest any stroke point is from the segments drawn.
function worst_drift(shapes, parts) {
  let worst = 0.0
  for (let i = 0; i < len(shapes); i += 1) {
    let pts = stroke_points(shapes[i])
    for (let k = 0; k < len(pts); k += 1) {
      let best = 1000.0
      for (let j = 0; j < len(parts); j += 1) {
        best = math.min(best, seg_dist(pts[k], parts[j][0], parts[j][1])[0])
      }
      worst = math.max(worst, best)
    }
  }
  worst
}

let ring = []
for (let i = 0; i < 24; i += 1) {
  let a = i / 24.0 * math.tau
  let b = (i + 1) / 24.0 * math.tau
  push(ring, [(30 + 20 * math.cos(a), 30 + 20 * math.sin(a)), (30 + 20 * math.cos(b), 30 + 20 * math.sin(b)), 2.0, 2.0])
}

-~> [name, picture, options]
let cases = [
  ["a tapered line, one spiky tip", ink(80, 30, [[(8, 15), (72, 12), 3.5, 0.4]]), {"mode": "lineart"}],
  ["a line with a branch: the line goes straight on", ink(60, 60, [[(30, 6), (30, 54), 2.0, 2.0], [(30, 30), (52, 8), 2.0, 2.0]]),
    {"mode": "lineart"}],
  ["a symmetric Y: three strokes", ink(60, 60, [[(30, 30), (30, 56), 2.0, 2.0], [(30, 30), (10, 8), 2.0, 2.0], [(30, 30), (50, 8), 2.0, 2.0]]),
    {"mode": "lineart"}],
  ["two strands crossing stay two strokes", ink(60, 60, [[(6, 8), (54, 52), 2.0, 2.0], [(6, 50), (54, 12), 2.0, 2.0]]),
    {"mode": "lineart"}],
  ["a ring is one closed stroke", ink(60, 60, ring), {"mode": "lineart"}],
  ["continuation 0: only a dead-straight way goes on", ink(60, 60, [[(6, 8), (54, 52), 2.0, 2.0], [(6, 50), (54, 12), 2.0, 2.0]]),
    {"mode": "lineart", "continuation": 0}],
  ["a speck under line_min is dropped", ink(30, 30, [[(15, 15), (16, 15), 0.8, 0.8]]), {"mode": "lineart"}],
  ["scale doubles the canvas", ink(40, 20, [[(5, 10), (35, 10), 2.0, 2.0]]), {"mode": "lineart", "scale": 2}]
]

for (let i = 0; i < len(cases); i += 1) {
  let c = cases[i]
  let result = trace_pixels(c[1].size, c[1].pixels, c[2], "test")
  let st = result.stats
  let run = drawing_run(result.code)
  let brushes = 0
  let lines = 0
  for (let k = 0; k < len(run.shapes); k += 1) {
    if (run.shapes[k].kind == "brush") {
      brushes += 1
    } elif (run.shapes[k].kind == "line") {
      lines += 1
    }
  }
  let drift = "-"
  if (len(run.shapes) > 0 && c[2].scale === null) {
    drift = str(worst_drift(run.shapes, c[1].parts) < 1.5)
  }
  puts(c[0] + ":", "strokes", st.strokes, "tips", st.tips, "junctions", st.junctions, "errors", run.errors, "brushes",
    brushes, "lines", lines, "close", drift, "canvas", run.canvas.size)
}

-~> A picture from a function of the pixel center, 4 samples per pixel
-~> (soft edges, like a drawn picture).
function cel(w, h, f) {
  let px = []
  for (let y = 0; y < h; y += 1) {
    for (let x = 0; x < w; x += 1) {
      let s = [0, 0, 0]
      for (let k = 0; k < 4; k += 1) {
        let c = f((x + 0.25 + 0.5 * (k % 2), y + 0.25 + 0.5 * (k // 2)))
        s = [s[0] + c.r, s[1] + c.g, s[2] + c.b]
      }
      push(px, rgb(math.round(s[0] / 4.0), math.round(s[1] / 4.0), math.round(s[2] / 4.0)))
    }
  }
  {"size": (w, h), "pixels": px}
}

let disc = cel(60, 60, function(p) {
  let d = math.dist(p, (30, 30))
  if (d >= 17 && d <= 20) { #141414 } elif (d < 17) { #d23c32 } else { #fafaf5 }
})
let halves = cel(64, 40, function(p) {
  let inside = p.x > 6 && p.x < 58 && p.y > 6 && p.y < 34
  if (!inside) {
    return #ffffff
  }
  if (p.x < 9 || p.x > 55 || p.y < 9 || p.y > 31 || math.abs(p.x - 32) < 1.5) {
    return #101010
  }
  if (p.x < 32) { #3c64c8 } else { #f0d23c }
})
let pupil = cel(60, 40, function(p) {
  if (math.dist(p, (18, 20)) < 9 || (p.x > 34 && p.x < 56 && math.abs(p.y - 20) < 1.2)) { #0a0a0a } else { #ffffff }
})

-~> [name, picture, options]
let fill_cases = [
  ["a red disc in a black ring", disc, {"mode": "lineart"}],
  ["two colors parted by a line", halves, {"mode": "lineart"}],
  ["a solid dark disc is a fill, the thin line a stroke", pupil, {"mode": "lineart"}],
  ["fills false: lines only", disc, {"mode": "lineart", "fills": false}]
]

-~> How many pixels inside the box [x0, y0, x1, y1] are left the canvas color
-~> by the fills alone (a seam shows the canvas).
function bare(code, size, b) {
  let rows = text.lines(code)
  let kept = []
  let skip = false
  for (let i = 0; i < len(rows); i += 1) {
    if (rows[i] == "layer lines") {
      skip = true
    } elif (rows[i] == "layer fills") {
      skip = false
    }
    if (!skip) {
      push(kept, rows[i])
    }
  }
  let px = img.pixels(paint_run(text.join(kept, "\n") + "\nraster.paint(drawing, (0, 0))\n", size))
  let n = 0
  for (let y = b[1]; y <= b[3]; y += 1) {
    for (let x = b[0]; x <= b[2]; x += 1) {
      let c = px[y * size.x + x]
      if (c.r + c.g + c.b > 700) {
        n += 1
      }
    }
  }
  n
}

for (let i = 0; i < len(fill_cases); i += 1) {
  let c = fill_cases[i]
  let result = trace_pixels(c[1].size, c[1].pixels, c[2], "test")
  let st = result.stats
  let run = drawing_run(result.code)
  let paths = []
  let prims = []
  for (let k = 0; k < len(run.shapes); k += 1) {
    let kind = run.shapes[k].kind
    if (kind == "path") {
      push(paths, run.shapes[k])
    } elif (kind == "circle" || kind == "ellipse" || kind == "rect" || kind == "polygon") {
      push(prims, kind)
    }
  }
  let palette = text.lines(result.code)[2]
  let all = text.split(text.slice(palette, 14, len(palette) - 1), ", ")
  let names = list.slice(all, 2, len(all))
  let named = []
  for (let k = 0; k < len(names); k += 1) {
    push(named, text.replace(text.split(names[k], ":")[0], "\"", ""))
  }
  puts(c[0] + ":", "fills", st.fills, "strokes", st.strokes, "solid", st.solid > 0, "errors", run.errors, "paths", len(paths),
    "primitives", prims, "colors", named)
}

-~> The disc's fill reaches the middle of the ring (radius 18.5), not just
-~> its inner edge (17), and (not snapped) is a curve with points between
-~> pixel corners. Its outline is written as exact Bezier items; the points
-~> checked for the grid are all of them, controls included; the reach is
-~> measured along the curve.
let disc_code = trace_pixels(disc.size, disc.pixels, {"mode": "lineart", "snap": 0}, "disc").code
let disc_fill = null
let disc_curve = null
let shapes = drawing_run(disc_code).shapes
for (let k = 0; k < len(shapes); k += 1) {
  if (shapes[k].kind == "path") {
    disc_fill = []
    disc_curve = flatten_path(shapes[k].path, 0.25)[0].points
    let items = shapes[k].args[0]
    for (let i = 0; i < len(items); i += 1) {
      if (type(items[i]) == "POINT") {
        push(disc_fill, items[i])
      } else {
        for (let q = 1; q < len(items[i]); q += 1) {
          push(disc_fill, items[i][q])
        }
      }
    }
  }
}
let reach = 0.0
let off_grid = 0
for (let k = 0; k < len(disc_fill); k += 1) {
  let fx = disc_fill[k].x * 2
  let fy = disc_fill[k].y * 2
  if (fx != math.round(fx) || fy != math.round(fy)) {
    off_grid += 1
  }
}
for (let k = 0; k < len(disc_curve); k += 1) {
  reach += math.dist(disc_curve[k], (30, 30))
}
reach = reach / len(disc_curve)
puts("the fill grows under the ring:", reach > 17.8 && reach < 19.2, "| off the pixel grid:", off_grid > len(disc_fill) / 2)
let halves_code = trace_pixels(halves.size, halves.pixels, {"mode": "lineart"}, "halves").code
puts("no seam between the halves:", bare(halves_code, halves.size, [8, 8, 55, 31]) == 0)
puts("no seam under the ring:", bare(disc_code, disc.size, [14, 14, 46, 46]) == 0)
let order = text.lines(halves_code)
puts("layers: lines in front of fills:", list.index(order, "layer lines") < list.index(order, "layer fills"))

let tapered = ink(80, 30, [[(8, 15), (72, 12), 3.5, 0.4]])
let code = trace_pixels(tapered.size, tapered.pixels, {"mode": "lineart"}, "tapered").code
let lines = text.lines(code)
puts("header:", lines[0], "|", text.slice(lines[2], 0, 23), "|", text.slice(lines[3], 0, 31), "|", lines[6])

let square = function(x, y) { if (x >= 4 && x < 8 && y >= 4 && y < 8) { #c82828 } else { #f0f0e6 } }
let squares = []
for (let y = 0; y < 12; y += 1) {
  for (let x = 0; x < 12; x += 1) {
    push(squares, square(x, y))
  }
}
let plain = trace_pixels((12, 12), squares, {"colors": 2, "min_area": 0}, "sq").code
puts("photo by name is the same:", trace_pixels((12, 12), squares, {"mode": "photo", "colors": 2, "min_area": 0}, "sq").code == plain)

let bad = [{"mode": "lineart", "refine": 4}, {"mode": "lineart", "line_threshold": 1.5}, {"mode": "lineart", "colors": 1},
  {"mode": "vector"}, {"mode": "lineart", "flow": 2}, {"mode": "lineart", "corner": 0}, {"mode": "lineart", "snap": -1}]
for (let i = 0; i < len(bad); i += 1) {
  try {
    trace_pixels((12, 12), squares, bad[i])
    puts("no error for", bad[i])
  } catch (e) {
    puts(text.starts(e.message, "trace:"), e.message)
  }
}

-~> Corners, curves and primitives (Tracing v2 stages 10 to 12). Flat light
-~> shapes (too light to be ink) on white snap to the primitive that fits them; a tuft of three spikes
-~> keeps a sharp point at each tip (within 2 px of it); a stroke with a sharp turn is cut there
-~> into two pieces that meet at the corner; a gap of 2 px between two
-~> line ends that face each other is bridged, a wider one is not.

-~> Where a path item ends: the point itself, or the last point of a curve item.
function item_end(it) {
  if (type(it) == "POINT") {
    return it
  }
  it[len(it) - 1]
}

-~> The point p turned by `deg` degrees round c.
function spin(p, c, deg) {
  let a = deg * math.pi / 180.0
  let d = p - c
  (c.x + d.x * math.cos(a) - d.y * math.sin(a), c.y + d.x * math.sin(a) + d.y * math.cos(a))
}

-~> The top of a tuft of three spikes at x: curved sides (a square fall
-~> off) that meet in a sharp point at each tip.
function tuft_top(x) {
  let rise = 0.0
  let tips = [20, 40, 60]
  for (let i = 0; i < 3; i += 1) {
    let t = math.max(0.0, 1 - math.abs(x - tips[i]) / 14.0)
    rise = math.max(rise, t * t)
  }
  50 - 42 * rise
}

let tuft = [(20, 8), (40, 8), (60, 8)]
let shapes_7c = [
  ["an ellipse", cel(80, 60, function(p) {
    if (((p.x - 40) / 30.0) * ((p.x - 40) / 30.0) + ((p.y - 30) / 18.0) * ((p.y - 30) / 18.0) < 1) { #b4d2f0 } else { #ffffff }
  })],
  ["an upright rectangle", cel(80, 60, function(p) {
    if (p.x > 12 && p.x < 66 && p.y > 15 && p.y < 44) { #b4e6b4 } else { #ffffff }
  })],
  ["a rotated rectangle", cel(80, 70, function(p) {
    let q = spin(p, (40, 35), -25)
    if (q.x > 14 && q.x < 66 && q.y > 22 && q.y < 48) { #f0b4b4 } else { #ffffff }
  })],
  ["a tuft of three spikes", cel(80, 60, function(p) {
    if (p.x > 6 && p.x < 74 && p.y < 54 && p.y > tuft_top(p.x)) { #b4c8f0 } else { #ffffff }
  })]
]
for (let i = 0; i < len(shapes_7c); i += 1) {
  let c = shapes_7c[i]
  let result = trace_pixels(c[1].size, c[1].pixels, {"mode": "lineart"}, "shape")
  let run = drawing_run(result.code)
  let kinds = []
  let sharp = []
  for (let k = 0; k < len(run.shapes); k += 1) {
    let sh = run.shapes[k]
    push(kinds, sh.kind)
    if (sh.kind == "path") {
      for (let t = 0; t < 3; t += 1) {
        let near = 100.0
        for (let q = 0; q < len(sh.args[0]); q += 1) {
          near = math.min(near, math.dist(item_end(sh.args[0][q]), tuft[t]))
        }
        push(sharp, near < 2.0)
      }
    } elif (sh.kind == "polygon") {
      push(sharp, len(sh.args[0]))
    }
  }
  puts(c[0] + ":", kinds, "primitives", result.stats.primitives, "errors", run.errors, "tips/corners", sharp)
}

let ellipse_shape = null
let e_shapes = drawing_run(trace_pixels(shapes_7c[0][1].size, shapes_7c[0][1].pixels, {"mode": "lineart"}, "e").code).shapes
for (let k = 0; k < len(e_shapes); k += 1) {
  if (e_shapes[k].kind == "ellipse") {
    ellipse_shape = e_shapes[k]
  }
}
puts("the ellipse fits:", math.dist(ellipse_shape.args[0], (40, 30)) < 0.5, math.abs(ellipse_shape.args[1].x - 30) < 0.8,
  math.abs(ellipse_shape.args[1].y - 18) < 0.8)
let snap_off = trace_pixels(shapes_7c[0][1].size, shapes_7c[0][1].pixels, {"mode": "lineart", "snap": 0}, "e")
puts("snap 0 keeps a path:", drawing_run(snap_off.code).shapes[0].kind, snap_off.stats.primitives)

-~> [name, picture, the gap's segment when the stroke may cross it]
let stroke_cases = [
  ["a V: cut at its corner", ink(60, 60, [[(10, 8), (30, 50), 2.0, 2.0], [(30, 50), (50, 8), 2.0, 2.0]])],
  ["a gap of 2 px is bridged", ink(70, 30, [[(6, 15), (27.5, 15), 1.5, 1.5], [(32.5, 15), (64, 15), 1.5, 1.5]])],
  ["a gap of 4 px is not", ink(70, 30, [[(6, 15), (26.5, 15), 1.5, 1.5], [(33.5, 15), (64, 15), 1.5, 1.5]])],
  ["a gap of 2 px on a curve is bridged", ink(70, 40, [[(6, 32), (18, 20), 1.5, 1.5], [(18, 20), (28.4, 15.3), 1.5, 1.5],
    [(33.2, 14.2), (48, 15), 1.5, 1.5], [(48, 15), (64, 24), 1.5, 1.5]]), [[(28.4, 15.3), (33.2, 14.2), 1.5, 1.5]]],
  ["two ends side by side are not bridged", ink(70, 30, [[(6, 12), (40, 12), 1.5, 1.5], [(30, 17.5), (64, 17.5), 1.5, 1.5]])]
]
for (let i = 0; i < len(stroke_cases); i += 1) {
  let c = stroke_cases[i]
  let result = trace_pixels(c[1].size, c[1].pixels, {"mode": "lineart"}, "stroke")
  let run = drawing_run(result.code)
  let kinds = []
  for (let k = 0; k < len(run.shapes); k += 1) {
    push(kinds, run.shapes[k].kind)
  }
  let parts = c[1].parts
  if (len(c) > 2) {
    parts = parts + c[2]
  }
  puts(c[0] + ":", "strokes", result.stats.strokes, "bridged", result.stats.bridged, kinds, "close",
    worst_drift(run.shapes, parts) < 1.5, "errors", run.errors)
}
let vee = stroke_cases[0][1]
let vee_shapes = drawing_run(trace_pixels(vee.size, vee.pixels, {"mode": "lineart"}, "v").code).shapes
let apex = 100.0
for (let k = 0; k < len(vee_shapes); k += 1) {
  let pts = stroke_points(vee_shapes[k])
  for (let q = 0; q < len(pts); q += 1) {
    apex = math.min(apex, math.dist(pts[q], (30, 50)))
  }
}
puts("the V's pieces meet near its apex:", apex < 2.5)

-~> The fills are written as exact curves: path() gets ["c", c1, c2, p] items
-~> (the first item a point), the drawing keeps C commands for them, and
-~> redrawing the points they end at stays within a pixel of the fit.
let curved = drawing_run(disc_code).shapes
let items_seen = 0
let c_cmds = 0
for (let k = 0; k < len(curved); k += 1) {
  if (curved[k].kind == "path") {
    let items = curved[k].args[0]
    items_seen += len(items)
    for (let i = 0; i < len(items); i += 1) {
      if (type(items[i]) == "ARRAY" && items[i][0] != "c") {
        puts("unexpected item", items[i][0])
      }
    }
    for (let i = 0; i < len(curved[k].path); i += 1) {
      if (curved[k].path[i][0] == "C") {
        c_cmds += 1
      }
    }
  }
}
puts("curved fill:", text.find(disc_code, "[\"c\", (") >= 0, items_seen == 4, c_cmds == 3)

-~> A thin colored band crossing a fill, outlined in ink (a belt on trousers).
-~> The band and the trousers are both dark (below the absolute dark limit)
-~> but colored, so they are fills: only the outline of the band and the edge
-~> of the trousers are ink, the band keeps its own color between its two
-~> outlines, and the outlines are strokes along both edges of the band.
let belt = cel(80, 50, function(p) {
  let inside = p.x > 8 && p.x < 72 && p.y > 4 && p.y < 46
  if (!inside) {
    return #fafaf5
  }
  let edge = p.x < 10 || p.x > 70 || p.y < 6 || p.y > 44
  if (edge || math.abs(p.y - 18) < 1 || math.abs(p.y - 32) < 1) {
    return #0a0a0a
  }
  if (p.y > 18 && p.y < 32) { #6e1428 } else { #1e2346 }
})
let belt_mask = lineart_mask(belt.pixels, 80, 50, 0.5, 4)
function belt_ink(x, y) {
  belt_mask.mask[(y + 1) * 82 + x + 1] == 1
}
puts("band and trousers are not ink:", !belt_ink(40, 25), !belt_ink(40, 11), !belt_ink(40, 40))
puts("the band's outline is ink:", belt_ink(40, 18), belt_ink(40, 32))
let belt_code = trace_pixels(belt.size, belt.pixels, {"mode": "lineart"}, "belt").code
let belt_run = drawing_run(belt_code)
let top_edge = 0
let bottom_edge = 0
for (let k = 0; k < len(belt_run.shapes); k += 1) {
  if (belt_run.shapes[k].kind != "brush" && belt_run.shapes[k].kind != "line") {
    continue
  }
  let pts = stroke_points(belt_run.shapes[k])
  let first = pts[0]
  let last = pts[len(pts) - 1]
  if (math.abs(first.y - 18) < 2 && math.abs(last.y - 18) < 2 && math.abs(last.x - first.x) > 30) {
    top_edge += 1
  }
  if (math.abs(first.y - 32) < 2 && math.abs(last.y - 32) < 2 && math.abs(last.x - first.x) > 30) {
    bottom_edge += 1
  }
}
puts("a long stroke along each edge of the band:", top_edge >= 1, bottom_edge >= 1, "errors", belt_run.errors)
let belt_px = img.pixels(paint_run(belt_code + "\nraster.paint(drawing, (0, 0))\n", belt.size))
let band_c = belt_px[25 * 80 + 40]
let trouser_c = belt_px[11 * 80 + 40]
puts("the band is maroon, the trousers navy:", band_c.r > 80 && band_c.b < 70, trouser_c.b > trouser_c.r + 20)

-~> Colored line art: thin blue lines (luma about 0.5) on white are ink and
-~> become strokes, though no pixel is dark enough on its own; a flat block of
-~> the same blue is a fill, its inside is not ink.
let blue = cel(90, 60, function(p) {
  let line = (math.abs(p.y - 10) < 2 && p.x > 6 && p.x < 84) || (math.abs(p.x - 12) < 2 && p.y > 6 && p.y < 54)
  let block = p.x > 40 && p.x < 80 && p.y > 22 && p.y < 54
  if (line || block) { #3c8ce6 } else { #ffffff }
})
let blue_mask = lineart_mask(blue.pixels, 90, 60, 0.5, 4)
function blue_ink(x, y) {
  blue_mask.mask[(y + 1) * 92 + x + 1] == 1
}
puts("blue lines are ink, the inside of the blue block is not:", blue_ink(50, 10), blue_ink(12, 40), !blue_ink(60, 38), !blue_ink(45, 28))
let blue_run = drawing_run(trace_pixels(blue.size, blue.pixels, {"mode": "lineart"}, "blue").code)
let blue_strokes = 0
for (let k = 0; k < len(blue_run.shapes); k += 1) {
  if (blue_run.shapes[k].kind == "brush" || blue_run.shapes[k].kind == "line") {
    blue_strokes += 1
  }
}
puts("the blue lines become strokes:", blue_strokes >= 2, "errors", blue_run.errors)

-~> Strokes as curves: a wavy tapered line is written as one brush() whose
-~> points are a first point and curve items, with one pressure for each, and
-~> its drawing still covers the original (the share of the original's dark
-~> pixels the drawing's ink covers, and the other way round, stay high).
let wave_parts = []
for (let i = 0; i < 40; i += 1) {
  let a = 8 + i * 2.0
  let b = a + 2.0
  let w = 3.0 - 1.8 * i / 40.0
  push(wave_parts, [(a, 25 + 10 * math.sin(a / 9.0)), (b, 25 + 10 * math.sin(b / 9.0)), w, w - 0.045])
}
let wave = ink(100, 50, wave_parts)
let wave_code = trace_pixels(wave.size, wave.pixels, {"mode": "lineart"}, "wave").code
let wave_run = drawing_run(wave_code)
let wave_brush = null
for (let k = 0; k < len(wave_run.shapes); k += 1) {
  if (wave_run.shapes[k].kind == "brush") {
    wave_brush = wave_run.shapes[k]
  }
}
let items_c = 0
for (let i = 0; i < len(wave_brush.args[0]); i += 1) {
  if (type(wave_brush.args[0][i]) == "ARRAY") {
    items_c += 1
  }
}
puts("a wavy line: curve items", items_c >= 1, "first is a point", type(wave_brush.args[0][0]) == "POINT",
  "one pressure each", len(wave_brush.args[1]) == len(wave_brush.args[0]), "errors", wave_run.errors)
let wave_px = img.pixels(paint_run(wave_code + "\nraster.paint(drawing, (0, 0))\n", wave.size))
let both = 0
let dark = 0
let drawn = 0
for (let i = 0; i < len(wave_px); i += 1) {
  let o = wave.pixels[i].r < 135
  let d = wave_px[i].a > 0 && wave_px[i].r < 135
  if (o) { dark += 1 }
  if (d) { drawn += 1 }
  if (o && d) { both += 1 }
}
puts("the look is the same:", both / float(dark) > 0.7, both / float(drawn) > 0.9)
