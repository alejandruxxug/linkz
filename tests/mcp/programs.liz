-~> The MCP server's test programs (lib/mcp/tests): the json_ ones with the
-~> JSON library alone, the server_ ones with the host's primitives and the
-~> settings around the server's libraries, as `linkz mcp` has them, but
-~> with the server's log in the output (the Go host's runner had it there). Run
-~> the tests with HOME in a folder of their own (scripts/test.sh does): the
-~> server_ programs save files there, shown as $HOME.

use "../../lib/app/host"
use "../../lib/app/libs"
use "../harness"

let dir = fs.join(libs_dir(), "mcp", "tests")
let files = harness_programs(dir)
for (let i = 0; i < len(files); i += 1) {
  let name = harness_name(files[i])
  let around = {}
  if (text.find(name, "/server_") >= 0) {
    around = hash.merge(host_globals(img.new(1, 1)), {"settings": {}})
    around.io.log = function(line) { puts(line) }
  }
  let got = text.replace(harness_output(harness_run(files[i], around)), fs.home(), "$HOME")
  harness_check(name, got, harness_expected(files[i]))
}
