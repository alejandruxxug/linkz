-~> lzbrush 1
-~> star_trail: a brush saved from Linkz.
let brush = {
  "name": "star_trail",
  "render": "stamped",
  "min": 8,
  "max": 22,
  "taper": 0.25,
  "opacity": [0.8, 1],
  "nib": null,
  "spacing": 1.1,
  "shape": "star",
  "rotation": "follow",
  "angle": 1.5707963267948966,
  "grain": 0,
  "size_jitter": 0.25,
  "color_jitter": [25, 0.1, 0.1],
  "speed": {"size": -0.4, "opacity": 0},
  "pressure": {
    "curve": [[0, 0], [1, 1]],
    "smoothing": 0.3,
    "speed": 0,
    "inputs": {"trackpad": {"floor": 0.1}, "tablet": {}, "mouse": {"speed": 0.8}}
  }
}

-- a bitmap shape and grain as runs
null [] false false true
-- a set
null [] 2 true false
[]
-- unknown keys dropped, values clamped, wrong types dropped
null {"count": 3, "max": 500, "min": 0, "name": "messy", "opacity": [0.5, 1], "pressure": {"floor": 0.9, "inputs": {"mouse": {"speed": 1}}}, "taper": 0}
glitter: unknown key, dropped
max: 900 is outside 0 to 500; used 500
min: -5 is outside 0 to 500; used 0
opacity[1]: 3 is outside 0 to 1; used 1
pressure.curve: want 2 to 32 points like [[0, 0], [1, 1]]; dropped
pressure.floor: 2 is outside 0 to 0.9; used 0.9
pressure.inputs.mouse.speed: 5 is outside 0 to 1; used 1
pressure.inputs.mouse.zip: unknown key, dropped
rotation: "spin" is not one of fixed, follow, random; dropped
shape: want a shape name or a bitmap hash; dropped
{"render": "stamped", "name": "imported", "min": 1, "max": 8, "taper": 0, "opacity": [1, 1]} ["name: missing; used imported", "min: missing; used 1", "max: missing; used 8"]
