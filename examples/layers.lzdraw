-~> lzdraw 1
-~> A sunset in layers. Layers higher in the file are in front, and so are
-~> the objects higher inside a layer. The loop is one object.

canvas = {"size": (480, 320), "background": #f6d9a8}

let horizon = 200

layer sun
  circle((360, 90), 34, #fff3c4)
  circle((360, 90), 56, #f2a65a66)

layer boat
  polygon([(120, 214), (180, 214), (165, 232), (135, 232)], #3b2a6b)
  line((150, 214), (150, 170), #3b2a6b, 3)
  polygon([(152, 174), (152, 208), (182, 208)], #fbf8ef)

layer sea
  layer waves
    for (let i = 0; i < 5; i = i + 1) {
      stroke([(40 + i * 20, horizon + 30 + i * 18), (140 + i * 30, horizon + 24 + i * 18), (240 + i * 20, horizon + 32 + i * 18), (440 - i * 10, horizon + 26 + i * 18)], #a9d3e4, 3)
    }
  rect((0, horizon), (480, 120), #2d6a8f)

layer sky
  rect((0, 0), (480, horizon), #f2a65a)
