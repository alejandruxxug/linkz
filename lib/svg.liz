-~> svg: turns the drawing into SVG text.
-~> Strings can't hold a " yet, so attributes use single quotes, and the new
-~> line below is a real line break inside the string.

let canvas = {"width": 512, "height": 512, "background": "#ffffff"}

let newline = "
"

function attr(name, value) {
  " " + name + "='" + str(value) + "'"
}

function svg_paint(shape) {
  let out = ""
  if (shape["fill"]) {
    out = out + attr("fill", shape["fill"])
  }
  if (shape["stroke"]) {
    out = out + attr("stroke", shape["stroke"]) + attr("stroke-width", shape["width"])
  }
  out
}

function svg_shape(shape) {
  let kind = shape["type"]
  if (kind == "circle") {
    "<circle" + attr("cx", shape["x"]) + attr("cy", shape["y"]) + attr("r", shape["r"]) + svg_paint(shape) + "/>"
  } elif (kind == "rect") {
    "<rect" + attr("x", shape["x"]) + attr("y", shape["y"]) + attr("width", shape["w"]) + attr("height", shape["h"]) + svg_paint(shape) + "/>"
  } elif (kind == "line") {
    "<line" + attr("x1", shape["x1"]) + attr("y1", shape["y1"]) + attr("x2", shape["x2"]) + attr("y2", shape["y2"]) + svg_paint(shape) + "/>"
  } else {
    "<!-- unknown shape: " + str(kind) + " -->"
  }
}

function svg_document(canvas, shapes) {
  let w = canvas["width"]
  let h = canvas["height"]
  let out = "<svg xmlns='http://www.w3.org/2000/svg'" + attr("width", w) + attr("height", h) + attr("viewBox", "0 0 " + str(w) + " " + str(h)) + ">" + newline
  out = out + "  <rect" + attr("width", w) + attr("height", h) + attr("fill", canvas["background"]) + "/>" + newline
  for (let i = 0; i < len(shapes); i = i + 1) {
    out = out + "  " + svg_shape(shapes[i]) + newline
  }
  out + "</svg>" + newline
}
