-~> lineart_mask: which pixels of a picture are ink. A pixel is ink when it is
-~> clearly darker than the paper around it (the mean of the lighter pixels
-~> of a square around it) or very dark on its own. Strong ink pixels seed the
-~> mask and weak ones join only when they touch it (hysteresis), so faint
-~> smudges far from a line stay out while the soft edge of a line stays in.
-~>
-~> A dark colored area (a maroon belt, navy trousers) is a fill, not ink,
-~> however dark it is or near the paper: a colored pixel is ink only where
-~> it is darker than the pixels right next to it, so the outline round a
-~> band is ink and the band between its outlines is not. Gray pixels (black
-~> ink) are judged as before.
-~>
-~> Colored line art (blue lines of luma 0.5 on white) is ink too: a colored
-~> pixel also counts when its color is far from the local paper color (the
-~> Lab distance, which sees hue and not only brightness) and it is thin.
-~>
-~> The grids here are padded like trace_pad: (w + 2) by (h + 2), with a
-~> border of 0 all round, so a neighbour read never needs a bounds test.
-~> The pixel (x, y) is at (y + 1) * (w + 2) + x + 1.

-~> The brightness (0 to 1) of every pixel, in the order of the pixels.
function lineart_luma(pixels) {
  let out = []
  for (let i = 0; i < len(pixels); i += 1) {
    let c = pixels[i]
    push(out, (0.299 * c.r + 0.587 * c.g + 0.114 * c.b) / 255.0)
  }
  out
}

-~> The sum of some values (one per pixel) over the square of side 2r + 1
-~> around every pixel, cut at the picture's edges, from a summed-area table:
-~> two passes over the picture, whatever r is.
function lineart_box_sums(values, w, h, r) {
  let w1 = w + 1
  let sums = []
  for (let i = 0; i < w1; i += 1) {
    push(sums, 0.0)
  }
  for (let y = 0; y < h; y += 1) {
    push(sums, 0.0)
    let row = 0.0
    let up = y * w1 + 1
    let src = y * w
    for (let x = 0; x < w; x += 1) {
      row = row + values[src + x]
      push(sums, sums[up + x] + row)
    }
  }
  let left = []
  let right = []
  for (let x = 0; x < w; x += 1) {
    push(left, math.max(0, x - r))
    push(right, math.min(w, x + r + 1))
  }
  let out = []
  for (let y = 0; y < h; y += 1) {
    let top = math.max(0, y - r) * w1
    let bottom = math.min(h, y + r + 1) * w1
    for (let x = 0; x < w; x += 1) {
      let x0 = left[x]
      let x1 = right[x]
      push(out, sums[bottom + x1] - sums[top + x1] - sums[bottom + x0] + sums[top + x0])
    }
  }
  out
}

-~> The sums of lists of values (each one per pixel) over the squares of side
-~> 2r + 1, as lineart_box_sums gives them: through `jobs` (see
-~> lineart_parallel) when there are some, so the sums run side by side, else
-~> one after another here.
function lineart_box_sums_of(lists, w, h, r, jobs) {
  if (jobs === null || !jobs.parallel || w * h < jobs.pixels) {
    let out = []
    for (let i = 0; i < len(lists); i += 1) {
      push(out, lineart_box_sums(lists[i], w, h, r))
    }
    return out
  }
  let calls = []
  for (let i = 0; i < len(lists); i += 1) {
    push(calls, ["box_sums", [lists[i], w, h, r]])
  }
  jobs.run(calls)
}

-~> The paper around every pixel, from the pixels and their `luma`, over the
-~> square of side 2r + 1. A pixel is on the lighter side when it is at least
-~> as bright as the mean around it; the paper is the mean, over the square,
-~> of the pixels on the lighter side. Comparing a pixel with this rather than
-~> with the plain mean keeps a line next to a dark area (an eye, a black
-~> ribbon) dark against its paper.
-~> Returns {"level": the brightness of the paper, "rgb": [reds, greens,
-~> blues] of the paper color (255 where no pixel there is on the lighter
-~> side)}.
function lineart_paper(pixels, luma, w, h, r, jobs = null) {
  let sum = lineart_box_sums(luma, w, h, r)
  let wide = []
  for (let x = 0; x < w; x += 1) {
    push(wide, math.min(w, x + r + 1) - math.max(0, x - r))
  }
  let area = []
  let light = []
  let count = []
  let reds = []
  let greens = []
  let blues = []
  for (let y = 0; y < h; y += 1) {
    let rows = math.min(h, y + r + 1) - math.max(0, y - r)
    for (let x = 0; x < w; x += 1) {
      let i = y * w + x
      let a = rows * wide[x]
      push(area, a)
      if (luma[i] * a >= sum[i]) {
        let c = pixels[i]
        push(light, luma[i])
        push(count, 1.0)
        push(reds, c.r + 0.0)
        push(greens, c.g + 0.0)
        push(blues, c.b + 0.0)
      } else {
        push(light, 0.0)
        push(count, 0.0)
        push(reds, 0.0)
        push(greens, 0.0)
        push(blues, 0.0)
      }
    }
  }
  let sums = lineart_box_sums_of([light, count, reds, greens, blues], w, h, r, jobs)
  let lsum = sums[0]
  let cs = sums[1]
  let level = []
  let rgb = [[], [], []]
  for (let i = 0; i < len(luma); i += 1) {
    if (cs[i] > 0) {
      push(level, lsum[i] / cs[i])
      push(rgb[0], sums[2][i] / cs[i])
      push(rgb[1], sums[3][i] / cs[i])
      push(rgb[2], sums[4][i] / cs[i])
    } else {
      push(level, sum[i] / area[i])
      push(rgb[0], 255.0)
      push(rgb[1], 255.0)
      push(rgb[2], 255.0)
    }
  }
  {"level": level, "rgb": rgb}
}

-~> How much lighter than a pixel the lighter ones of the square of side
-~> 2r + 1 round it are, on average (0 when it is as light as its neighbours:
-~> the inside of a band or of a flat area). A thin line, colored or not, has
-~> lighter pixels on both sides, and r reaches past half its width.
function lineart_lighter_gap(luma, w, h, x, y, r) {
  let x0 = math.max(0, x - r)
  let x1 = math.min(w - 1, x + r)
  let y0 = math.max(0, y - r)
  let y1 = math.min(h - 1, y + r)
  let sum = 0.0
  let count = 0
  for (let yy = y0; yy <= y1; yy += 1) {
    for (let xx = x0; xx <= x1; xx += 1) {
      sum = sum + luma[yy * w + xx]
      count += 1
    }
  }
  let light = 0.0
  let lighter = 0
  for (let yy = y0; yy <= y1; yy += 1) {
    for (let xx = x0; xx <= x1; xx += 1) {
      if (luma[yy * w + xx] * count >= sum - 0.000001) {
        light = light + luma[yy * w + xx]
        lighter += 1
      }
    }
  }
  light / lighter - luma[y * w + x]
}

-~> The least lighter_gap a colored pixel needs to be ink.
let lineart_thin_gap = 0.06

-~> The cube root of t (0 to 1.1), by Newton steps.
function lineart_cbrt(t) {
  if (t <= 0.0) {
    return 0.0
  }
  let x = 0.7
  for (let k = 0; k < 6; k += 1) {
    x = (2.0 * x + t / (x * x)) / 3.0
  }
  x
}

-~> One channel (0 to 255) as linear light (gamma 2, close to sRGB).
function lineart_linear(v) {
  let c = v / 255.0
  c * c
}

-~> The Lab color [L, a, b] of an r, g, b color (D65 white).
function lineart_lab(r, g, b) {
  let lr = lineart_linear(r)
  let lg = lineart_linear(g)
  let lb = lineart_linear(b)
  let fx = lineart_cbrt((0.4124 * lr + 0.3576 * lg + 0.1805 * lb) / 0.95047)
  let fy = lineart_cbrt(0.2126 * lr + 0.7152 * lg + 0.0722 * lb)
  let fz = lineart_cbrt((0.0193 * lr + 0.1192 * lg + 0.9505 * lb) / 1.08883)
  [116.0 * fy - 16.0, 500.0 * (fx - fy), 200.0 * (fy - fz)]
}

-~> The Lab distance between a color and the paper [reds, greens, blues] at i.
function lineart_color_gap(c, paper, i) {
  let a = lineart_lab(c.r, c.g, c.b)
  let b = lineart_lab(paper[0][i], paper[1][i], paper[2][i])
  math.sqrt((a[0] - b[0]) * (a[0] - b[0]) + (a[1] - b[1]) * (a[1] - b[1]) + (a[2] - b[2]) * (a[2] - b[2]))
}

-~> Whether a color is gray (black ink, dark gray): the spread of its
-~> channels is under about a tenth. A dark red belt or navy trousers are not.
function lineart_is_neutral(c) {
  math.max(c.r, c.g, c.b) - math.min(c.r, c.g, c.b) < 26
}

-~> The ink mask of a picture. `threshold` (0 to 1) is how much darker than
-~> its surroundings a pixel must be to seed a line (0.5: half as bright);
-~> half of it lets a pixel join a line it touches. `radius` is the half side
-~> of the neighbourhood, in pixels. `jobs`, when given, runs the sums behind
-~> the paper in tasks (lineart_parallel); the mask is the same either way.
-~> Returns {"mask": padded grid of 0 and 1, "ink": the list of padded
-~> positions that are 1 (in raster order), "ink_color": the mean color of
-~> the strong ink, "paper": the mean color of the rest, "luma": the
-~> brightness of every pixel, 0 to 1, row by row, "stages": the
-~> milliseconds of luma, paper, classify and flood}.
function lineart_mask(pixels, w, h, threshold, radius, jobs = null) {
  let t0 = time.ms()
  let luma = lineart_luma(pixels)
  let t1 = time.ms()
  let around = lineart_paper(pixels, luma, w, h, radius, jobs)
  let mean = around.level
  let paper_rgb = around.rgb
  let t2 = time.ms()
  let w2 = w + 2
  let state = []
  for (let i = 0; i < w2 * (h + 2); i += 1) {
    push(state, 0)
  }
  let weak = threshold * 0.5
  let dark = (1.0 - threshold) * 0.4
  let todo = []
  for (let y = 0; y < h; y += 1) {
    for (let x = 0; x < w; x += 1) {
      let i = y * w + x
      let m = mean[i]
      let l = luma[i]
      let gap = m - l
      let neutral = lineart_is_neutral(pixels[i])
      if (neutral && gap < 0.05 && l >= dark) {
        -~> A gray pixel as light as its paper: the most of the picture.
        continue
      }
      let rel = gap / math.max(m, 0.05)
      let strong = (rel >= threshold && gap >= 0.1) || (l < dark && neutral)
      let faint = rel >= weak && gap >= 0.05
      if (!neutral && !((strong || faint) && lineart_lighter_gap(luma, w, h, x, y, 1) >= lineart_thin_gap)) {
        -~> Not a dark thin pixel by brightness: maybe a colored line, which
        -~> is as far from the paper in color as a line is, and as thin as
        -~> one (a line wider than 3 pixels needs the wider look). It must
        -~> still be clearly darker than the paper, so pale shading is not ink, and not a dark
        -~> fill (navy, maroon), whose edge would pass for a thick line.
        if (gap < 0.25 || l < 0.3) {
          continue
        }
        let far = lineart_color_gap(pixels[i], paper_rgb, i)
        strong = far >= threshold * 90.0
        faint = far >= threshold * 80.0
        if (!faint || lineart_lighter_gap(luma, w, h, x, y, radius) < lineart_thin_gap) {
          continue
        }
      } elif (!strong && !faint) {
        continue
      }
      let p = (y + 1) * w2 + x + 1
      if (strong) {
        state[p] = 1
        push(todo, p)
      } else {
        state[p] = 2
      }
    }
  }
  let t3 = time.ms()
  let ink_sum = lineart_color_sum(pixels, todo, w)
  let steps = [-1, 1, -w2, w2, -w2 - 1, -w2 + 1, w2 - 1, w2 + 1]
  while (len(todo) > 0) {
    let q = pop(todo)
    for (let s = 0; s < 8; s += 1) {
      let r = q + steps[s]
      if (state[r] == 2) {
        state[r] = 1
        push(todo, r)
      }
    }
  }
  let ink = []
  let paper = [0.0, 0.0, 0.0, 0]
  for (let y = 0; y < h; y += 1) {
    for (let x = 0; x < w; x += 1) {
      let p = (y + 1) * w2 + x + 1
      if (state[p] == 1) {
        push(ink, p)
      } else {
        state[p] = 0
        let c = pixels[y * w + x]
        paper[0] = paper[0] + c.r
        paper[1] = paper[1] + c.g
        paper[2] = paper[2] + c.b
        paper[3] = paper[3] + 1
      }
    }
  }
  {
    "mask": state,
    "ink": ink,
    "ink_color": lineart_mean_color(ink_sum, #000000),
    "paper": lineart_mean_color(paper, #ffffff),
    "luma": luma,
    "stages": {"luma": t1 - t0, "paper": t2 - t1, "classify": t3 - t2, "flood": time.ms() - t3}
  }
}

-~> [r, g, b, count] summed over some padded positions.
function lineart_color_sum(pixels, positions, w) {
  let w2 = w + 2
  let sum = [0.0, 0.0, 0.0, 0]
  for (let i = 0; i < len(positions); i += 1) {
    let p = positions[i]
    let c = pixels[(p // w2 - 1) * w + p % w2 - 1]
    sum[0] = sum[0] + c.r
    sum[1] = sum[1] + c.g
    sum[2] = sum[2] + c.b
    sum[3] = sum[3] + 1
  }
  sum
}

-~> The color of a [r, g, b, count] sum, or `none` when it counts nothing.
function lineart_mean_color(sum, none) {
  if (sum[3] == 0) {
    return none
  }
  rgb(math.round(sum[0] / sum[3]), math.round(sum[1] / sum[3]), math.round(sum[2] / sum[3]))
}
