-~> lineart: the "lineart" mode of trace, for inked drawings and cel art. The
-~> ink becomes brush() strokes along its centerlines, their pressures
-~> following the width of the ink, instead of filled outlines. The steps:
-~>   1. lineart_mask      which pixels are ink (dark against their
-~>                        neighbourhood, with hysteresis)
-~>   2. lineart_distance  how far each ink pixel is from the paper: the
-~>                        half-width of the line at its centerline
-~>   3. lineart_thin      the centerlines, one pixel wide (Zhang-Suen)
-~>   4. lineart_graph     ends, junctions and the edges between them; spurs
-~>                        pruned, near junctions joined
-~>   5. lineart_pair, lineart_chains  edges joined through junctions where
-~>                        the line goes straight on and along the flow (the
-~>                        orientation field, lineart_flow), and across gaps
-~>                        of up to 2 px between line ends facing each other
-~>   6. lineart_split, lineart_stroke  chains cut at their corners; points
-~>                        and widths along each piece, tips spiky or blunt,
-~>                        fitted with Bezier curves (lineart_curves); a
-~>                        straight one of even width snaps to a line
-~>   7. lineart_code      one brush() (or line()) per stroke, pen widths from
-~>                        the thinnest and thickest ink; a brush's items are the
-~>                        fitted curves (a width at each end) when they take
-~>                        no more code than the plain points, else the points
-~> and, for the fills (lineart_fills, lineart_outline), before the thinning:
-~>   a. lineart_solid     ink wide all round (a pupil, dark trousers) leaves
-~>                        the mask, to be a fill instead of a stroke
-~>   b. lineart_regions   the colors away from the ink, reduced in Lab and
-~>                        cut into regions grown under the lines
-~>   c. lineart_region_shapes  a sub-pixel outline per region, its corners
-~>                        sharpened (spikes drawn out along the flow), fitted
-~>                        with Bezier curves, snapped to a circle, ellipse,
-~>                        rect or polygon when one fits within `snap`;
-~>                        written in `layer fills`, before (so behind)
-~>                        `layer lines`

use "../draw/svg"
use "lineart_mask"
use "lineart_skeleton"
use "lineart_graph"
use "lineart_strokes"
use "lineart_flow"
use "lineart_snap"
use "lineart_fills"
use "lineart_palette"
use "lineart_merge"
use "lineart_gradient"
use "lineart_detail"
use "lineart_parallel"

-~> The options of trace(path, {"mode": "lineart", ...}). Anything left out
-~> takes the value shown.
-~>   line_threshold  how much darker than its surroundings a pixel must be
-~>                   to start a line, 0 to 1 (0.5: half as bright). Lower
-~>                   finds fainter lines.
-~>   line_min        strokes shorter than this many pixels (length plus
-~>                   width) are dropped, so specks don't become strokes.
-~>   continuation    the largest turn, in degrees, a line may make at a
-~>                   junction and still go on as the same stroke.
-~>   flow            how much the direction the picture flows in (hair
-~>                   strands, parallel lines) steers a stroke through a
-~>                   junction and across a gap, and draws out spikes; 0 is
-~>                   off, 1 is strong.
-~>   corner          the turn, in degrees, from which a point of a line or
-~>                   an outline is a sharp corner (seen at two scales).
-~>   snap            how far, in pixels, an outline or a stroke may be from
-~>                   a circle, ellipse, rect, polygon or line to be written
-~>                   as one; 0 never snaps.
-~>   radius          the half side, in pixels, of the neighbourhood a pixel is
-~>                   compared with; 0 picks it from the picture's size.
-~>   fills           false to trace only the lines, on the paper color.
-~>   colors          the most fill colors (2 to 64), picked in Lab. Fewer
-~>                   gives a simpler drawing, more keeps more cel shades.
-~>   min_area        color regions smaller than this many pixels are given
-~>                   to their neighbours; 0 picks it from the picture's size.
-~>   solid           ink at least this far (px) from the paper all round is
-~>                   a solid fill, not a stroke; 0 picks it from the size.
-~>   merge           true or false for the five merge steps (lineart_merge)
-~>                   together, or a hash to pick: {"snap": true, "join": true,
-~>                   "stack": true, "absorb": true, "cover": true}, a step
-~>                   left out of the hash staying on.
-~>                     snap    palette colors under 2 apart (Lab) become one
-~>                     join    touching regions of one color become one shape
-~>                     stack   a region with islands is drawn whole and the
-~>                             islands on top, not with holes cut out
-~>                     absorb  a region of the color of the shape under it
-~>                             is given to that shape
-~>                     cover   shapes that later shapes hide are dropped
-~>   gradients       true to turn groups of neighbouring regions whose colors
-~>                   ramp smoothly into one shape with a linear or radial
-~>                   gradient fill (lineart_gradient), or with `steps` when
-~>                   the bands are few and even. A hard cel shadow (two flat
-~>                   tones) stays flat. false keeps every band flat.
-~>   gradient_error  the most a gradient may differ from the picture, on
-~>                   average, in color levels (0 to 255), for a group to
-~>                   become one. Higher makes more gradients.
-~>   detail          how far, in pixels, a fill outline may drift from the
-~>                   Bezier curves fitted to it.
-~>   adaptive        true to spend detail where the picture has it: a coarse
-~>                   map of local contrast and ink (lineart_detail) makes
-~>                   the fills keep smaller regions and fit their outlines
-~>                   tighter in busy places (eyes, mouths, hands), and merge
-~>                   more and fit looser in big flat areas. false treats the
-~>                   whole picture alike, by `min_area` and `detail`.
-~>   adaptive_strength  how far adaptive goes, 0 to 1: at 1 the smallest
-~>                   region and the fit tolerance are a quarter in the
-~>                   busiest places and four times in the flattest; 0 is
-~>                   the same as adaptive off.
-~>   focus           boxes where the user wants more or less detail:
-~>                   [{"box": [x, y, w, h], "detail": f}...], in pixels of
-~>                   the picture as traced (after max_side). f above 1 is
-~>                   more detail, below 1 less, kept between 0.25 and 4.
-~>                   Inside a box the smallest region is 1/f squared and the
-~>                   fit tolerance 1/f times what they would be (a later
-~>                   box wins where two meet). Works with adaptive off.
-~>   parallel        true to run the independent per-pixel and per-region work
-~>                   (the sums behind the mask, the outline of each fill
-~>                   region) side by side in tasks, which gives the same
-~>                   drawing sooner; false to run it all here. Where tasks
-~>                   aren't there (inside a task, a sandbox without them) it
-~>                   is false whatever is asked.
-~>   scale           multiplies every coordinate, to make a bigger drawing.
-~>   max_side        the picture is shrunk until its longer side is at most
-~>                   this many pixels.
let lineart_options = {
  "mode": "lineart",
  "line_threshold": 0.5,
  "line_min": 6,
  "continuation": 35,
  "flow": 0.6,
  "corner": 55,
  "snap": 1.5,
  "radius": 0,
  "fills": true,
  "colors": 16,
  "min_area": 0,
  "solid": 0,
  "merge": true,
  "gradients": true,
  "gradient_error": 4,
  "detail": 0.8,
  "adaptive": true,
  "adaptive_strength": 0.2,
  "focus": [],
  "parallel": true,
  "scale": 1,
  "max_side": 1024
}

-~> The line-art options with the defaults filled in. An unknown name is an
-~> error, so a typo doesn't pass silently.
function lineart_settings(options) {
  let names = keys(options)
  for (let i = 0; i < len(names); i += 1) {
    if (!hash.has(lineart_options, names[i])) {
      error("trace: unknown option \"" + names[i] + "\" for line art (known: " +
        text.join(keys(lineart_options), ", ") + ")")
    }
  }
  let out = hash.merge(lineart_options, options)
  if (!(out.line_threshold > 0 && out.line_threshold < 1)) {
    error("trace: line_threshold must be between 0 and 1")
  }
  if (out.colors < 2 || out.colors > 64) {
    error("trace: colors must be from 2 to 64")
  }
  if (!(out.flow >= 0 && out.flow <= 1)) {
    error("trace: flow must be between 0 and 1")
  }
  if (!(out.corner > 0 && out.corner < 180)) {
    error("trace: corner must be between 0 and 180 degrees")
  }
  if (!(out.snap >= 0)) {
    error("trace: snap must be 0 or more pixels")
  }
  if (type(out.gradients) != "BOOLEAN") {
    error("trace: gradients must be true or false")
  }
  if (type(out.adaptive) != "BOOLEAN") {
    error("trace: adaptive must be true or false")
  }
  if (type(out.parallel) != "BOOLEAN") {
    error("trace: parallel must be true or false")
  }
  if (!(out.adaptive_strength >= 0 && out.adaptive_strength <= 1)) {
    error("trace: adaptive_strength must be between 0 and 1")
  }
  out.focus = lineart_focus_boxes(out.focus)
  if (!(out.gradient_error > 0)) {
    error("trace: gradient_error must be more than 0")
  }
  out.merge = lineart_merge_steps(out.merge)
  out
}

-~> Traces line art: `size` is (w, h) and `pixels` a flat list of colors, row
-~> by row. Returns {"code", "stats": {mode, strokes, points, tips, junctions,
-~> ink, primitives, bridged, ms, size, stages}}; `stages` has the
-~> milliseconds of each step.
function lineart_pixels(size, pixels, options, name) {
  let opt = lineart_settings(options)
  let w = size.x
  let h = size.y
  let t0 = time.ms()
  let radius = opt.radius
  if (radius <= 0) {
    radius = math.max(4, math.round(math.max(w, h) / 128.0))
  }
  let jobs = lineart_jobs(opt.parallel)
  let m = lineart_mask(pixels, w, h, opt.line_threshold, radius, jobs)
  let t1 = time.ms()
  let dist = lineart_distance(m.mask, m.ink, w)
  let t2 = time.ms()
  let curve = {
    "detail": opt.detail,
    "corner": opt.corner,
    "snap": opt.snap,
    "flow": opt.flow,
    "luma": m.luma,
    "w": w,
    "h": h,
    "r": radius,
    "half": 1.0
  }
  let fills = lineart_trace_fills(pixels, m, dist, w, h, opt, curve, jobs)
  if (fills.solid > 0) {
    dist = lineart_distance(m.mask, m.ink, w)
  }
  let t2f = time.ms()
  let thin = lineart_thin(m.mask, m.ink, w)
  let t3 = time.ms()
  let graph = lineart_graph(m.mask, thin.skeleton, dist, w)
  let pruned = lineart_prune(graph, 3)
  let joined = lineart_merge_junctions(graph, dist, w)
  let t4 = time.ms()
  let luma = m.luma
  let weight = opt.flow
  let cost = function(turn, a, b, node) {
    lineart_flow_turn(turn, a, b, lineart_node_flow(luma, w, h, node, radius, weight), weight)
  }
  let partner = lineart_pair(graph, w, opt.continuation, cost)
  let bridges = lineart_bridges(graph, dist, luma, w, h, radius, opt.continuation, weight)
  lineart_add_bridges(partner, bridges)
  let chains = lineart_chains(graph, partner, w)
  let strokes = []
  for (let i = 0; i < len(chains); i += 1) {
    let pieces = lineart_split(chains[i], w, opt.corner, dist)
    for (let k = 0; k < len(pieces); k += 1) {
      let c = pieces[k]
      let ends = [lineart_is_junction(graph, c.ends[0]) || c.cut[0], lineart_is_junction(graph, c.ends[1]) || c.cut[1]]
      let s = lineart_stroke(c, ends, dist, w, 1.0, 0.75)
      if (c.tip[0] !== null) {
        s.points[0] = c.tip[0]
        if (len(s.curves) > 0) {
          s.curves[0].curve[0] = c.tip[0]
        }
      }
      if (c.tip[1] !== null) {
        s.points[len(s.points) - 1] = c.tip[1]
        if (len(s.curves) > 0) {
          s.curves[len(s.curves) - 1].curve[3] = c.tip[1]
        }
      }
      if (s.length + lineart_widest(s.widths) >= opt.line_min) {
        s.prim = lineart_snap_stroke(s, opt.snap)
        push(strokes, s)
      }
    }
  }
  for (let i = 0; i < len(graph.nodes); i += 1) {
    let node = graph.nodes[i]
    if (node.kind == "dot") {
      let s = lineart_stroke({"pixels": node.pixels, "closed": false}, [false, false], dist, w, 1.0, 0.75)
      if (1 + lineart_widest(s.widths) >= opt.line_min) {
        s.prim = null
        push(strokes, s)
      }
    }
  }
  let t5 = time.ms()
  let made = lineart_code(name, w, h, m, strokes, fills, opt.scale)
  let t6 = time.ms()
  let junctions = 0
  for (let i = 0; i < len(graph.nodes); i += 1) {
    if (graph.nodes[i].kind == "junction") {
      junctions += 1
    }
  }
  {
    "code": made.code,
    "stats": {
      "mode": "lineart",
      "strokes": len(strokes),
      "fills": made.fills,
      "colors": len(made.names),
      "solid": fills.solid,
      "gradients": fills.gradients,
      "merge": fills.merge,
      "points": made.points,
      "primitives": made.primitives,
      "curved": made.curved,
      "bridged": len(bridges),
      "tips": made.tips,
      "junctions": junctions,
      "pruned": pruned,
      "joined": joined,
      "ink": len(m.ink),
      "pen": [made.pen_min, made.pen_max],
      "ms": t6 - t0,
      "size": size,
      "stages": {
        "mask": t1 - t0,
        "mask_stages": m.stages,
        "distance": t2 - t1,
        "fills": t2f - t2 - fills.outline_ms,
        "fill_stages": fills.stages,
        "outlines": fills.outline_ms,
        "thin": t3 - t2f,
        "graph": t4 - t3,
        "strokes": t5 - t4,
        "code": t6 - t5
      }
    }
  }
}

-~> The fills of a picture whose ink is `m` (lineart_mask's result, with
-~> `dist` its distance transform): solid ink taken out of m first, then
-~> the regions, and the shapes of each one to draw, biggest first
-~> (`curve`: the settings of lineart_outline_points; `jobs`: lineart_jobs, which
-~> may cut the outlines among tasks).
-~> Returns {"shapes": [{"color": palette number, "outers", "holes",
-~> "prims"}...], "merge": what each merge step did (lineart_merge),
-~> "colors", "lab", "background" (palette number or -1), "solid": solid
-~> pixels taken, "outline_ms", "stages": the milliseconds of solid,
-~> detail_map, regions, merge and gradients}.
function lineart_trace_fills(pixels, m, dist, w, h, opt, curve, jobs) {
  let none = {"shapes": [], "merge": {}, "colors": [], "lab": [], "background": -1, "solid": 0, "gradients": 0, "outline_ms": 0, "stages": {}}
  let ts = time.ms()
  if (!opt.fills) {
    return none
  }
  let half = lineart_line_half(m, dist, w)
  curve.half = half
  let depth = opt.solid
  if (depth <= 0) {
    depth = math.max(4.0, 4.0 * half)
  }
  let min_area = opt.min_area
  if (min_area <= 0) {
    min_area = math.max(4, math.round(w * h / 40000.0))
  }
  let solid = lineart_solid(m, pixels, dist, w, depth)
  let tp = time.ms()
  let strength = 0.0
  if (opt.adaptive) {
    strength = opt.adaptive_strength
  }
  let map = null
  if (strength > 0 || len(opt.focus) > 0) {
    map = lineart_detail_map(m.luma, m.ink, w, h)
    map.focus = opt.focus
  }
  let tq = time.ms()
  let fill = lineart_regions(pixels, m.mask, w, h, opt.colors, min_area, map, strength)
  let tr = time.ms()
  let merged = lineart_merge_regions(fill, w, h, opt.merge)
  let tm = time.ms()
  let order = merged.order
  let ramps = {"groups": 0, "joined": 0}
  if (opt.gradients) {
    ramps = lineart_gradients(fill, order, m.mask, pixels, w, h, opt.gradient_error)
    if (ramps.joined > 0) {
      order = lineart_order(fill, w, h, order.background)
      if (opt.merge.stack) {
        lineart_merge_stack(order, lineart_enclosers(fill, order, w, h))
      }
    }
  }
  let t0 = time.ms()
  let busy = null
  let focus = null
  if (map !== null) {
    busy = lineart_region_detail(fill, map, w, h)
    focus = lineart_region_focus(fill, opt.focus, w, h)
  }
  let ids = order.order
  let details = []
  for (let k = 0; k < len(ids); k += 1) {
    let own = curve.detail
    if (busy !== null) {
      own = curve.detail * math.min(1.5, lineart_detail_factor(busy[ids[k]], strength)) / focus[ids[k]]
    }
    push(details, own)
  }
  let made = lineart_outline_regions(fill, order, w, h, curve, details, jobs)
  let shapes = []
  for (let k = 0; k < len(ids); k += 1) {
    let s = made[k]
    if (len(s.outers) > 0) {
      s.color = fill.regions[ids[k]].color
      s.paint = lineart_region_paint(fill, ids[k])
      push(shapes, s)
    }
  }
  let merge = merged.stats
  merge.covered = 0
  if (opt.merge.cover) {
    let hidden = lineart_merge_cover(shapes)
    shapes = hidden.shapes
    merge.covered = hidden.covered
  }
  {
    "shapes": shapes,
    "merge": merge,
    "colors": fill.colors,
    "lab": fill.lab,
    "background": order.background,
    "solid": solid,
    "gradients": ramps.groups,
    "outline_ms": time.ms() - t0,
    "stages": {
      "solid": tp - ts,
      "detail_map": tq - tp,
      "regions": tr - tq,
      "merge": tm - tr,
      "gradients": t0 - tm
    }
  }
}

-~> The shapes (lineart_region_shapes) of the regions of order.order, in that
-~> order; details[k] is the fit tolerance of the k-th. With parallel `jobs`
-~> the regions are dealt out among tasks, the big ones first, each to the
-~> piece with the least to do; the shapes are the same either way.
function lineart_outline_regions(fill, order, w, h, curve, details, jobs) {
  let ids = order.order
  let size = []
  let numbers = []
  let work = 0
  for (let k = 0; k < len(ids); k += 1) {
    let b = order.box[ids[k]]
    push(size, (b[2] - b[0] + 5) * (b[3] - b[1] + 5))
    push(numbers, k)
    work += size[k]
  }
  jobs = lineart_jobs_for(jobs, work, jobs.outlines)
  let pieces = jobs.pieces
  let at = []
  let load = []
  for (let p = 0; p < pieces; p += 1) {
    push(at, [])
    push(load, 0)
  }
  let biggest = list.sort(numbers, function(a, b) { size[a] > size[b] || (size[a] == size[b] && a < b) })
  for (let n = 0; n < len(biggest); n += 1) {
    let k = biggest[n]
    let least = 0
    for (let p = 1; p < pieces; p += 1) {
      if (load[p] < load[least]) {
        least = p
      }
    }
    push(at[least], k)
    load[least] += size[k] + 400
  }
  let calls = []
  for (let p = 0; p < pieces; p += 1) {
    if (len(at[p]) == 0) {
      continue
    }
    let pick = []
    let tol = []
    for (let n = 0; n < len(at[p]); n += 1) {
      push(pick, ids[at[p][n]])
      push(tol, details[at[p][n]])
    }
    push(calls, ["shapes", [fill.label, order, pick, tol, w, h, curve]])
  }
  let done = jobs.run(calls)
  let out = []
  for (let k = 0; k < len(ids); k += 1) {
    push(out, null)
  }
  let c = 0
  for (let p = 0; p < pieces; p += 1) {
    if (len(at[p]) == 0) {
      continue
    }
    for (let n = 0; n < len(at[p]); n += 1) {
      out[at[p][n]] = done[c][n]
    }
    c += 1
  }
  out
}

-~> Whether a node number is a junction (-1 is no node).
function lineart_is_junction(graph, id) {
  id >= 0 && graph.nodes[id].kind == "junction"
}

-~> The biggest of some widths.
function lineart_widest(widths) {
  let top = 0.0
  for (let i = 0; i < len(widths); i += 1) {
    top = math.max(top, widths[i])
  }
  top
}

-~> A number rounded to one decimal, as source text.
function lineart_num(n) {
  svg_num(math.round(n * 10) / 10.0)
}

-~> The pen's thinnest and thickest width: the extremes of the stroke widths.
function lineart_pen_range(strokes) {
  let all = []
  for (let i = 0; i < len(strokes); i += 1) {
    for (let k = 0; k < len(strokes[i].widths); k += 1) {
      push(all, strokes[i].widths[k])
    }
  }
  if (len(all) == 0) {
    return [1.0, 1.0]
  }
  let sorted = list.sort(all)
  [math.floor(sorted[0] * 10) / 10.0, math.ceil(sorted[len(sorted) - 1] * 10) / 10.0]
}

-~> The .lzdraw source: the palette (paper, ink and the fill colors by
-~> name), the pen, the canvas, `layer lines` with one brush() per stroke,
-~> then `layer fills` (lower, so behind the lines; left out when there is
-~> none) with one path() per fill shape, the smallest first (in front).
-~> A stroke or a fill shape that snapped to a primitive is written as
-~> that call. The canvas is the background's color. Returns {"code",
-~> "points", "tips": {spiky, blunt, joined}, "pen_min", "pen_max",
-~> "fills", "primitives", "curved" (strokes written with curve items), "names"}.
function lineart_code(source_name, w, h, m, strokes, fills, scale) {
  let range = lineart_pen_range(strokes)
  let lo = range[0] * scale
  let hi = range[1] * scale
  let used = lineart_used_colors(fills)
  let labs = []
  for (let i = 0; i < len(used); i += 1) {
    push(labs, fills.lab[used[i]])
  }
  let names = lineart_color_names(labs, ["paper", "ink"])
  let name_of = {}
  for (let i = 0; i < len(used); i += 1) {
    name_of[used[i]] = names[i]
  }
  let paper = m.paper
  if (len(fills.shapes) > 0 && fills.background >= 0) {
    paper = fills.colors[fills.background]
  }
  let lines = ["-~> lzdraw 1", "-~> Traced from " + source_name + " as line art: " + str(len(strokes)) + " strokes" +
    lineart_fill_count(fills) + "."]
  let palette = ["\"paper\": " + color_hex(paper), "\"ink\": " + color_hex(m.ink_color)]
  for (let i = 0; i < len(used); i += 1) {
    push(palette, "\"" + names[i] + "\": " + color_hex(fills.colors[used[i]]))
  }
  push(lines, "let colors = {" + text.join(palette, ", ") + "}")
  push(lines, "pens.traced = {\"name\": \"traced\", \"min\": " + lineart_num(lo) + ", \"max\": " + lineart_num(hi) +
    ", \"taper\": 0, \"opacity\": [1, 1], \"nib\": null, \"grain\": 0}")
  push(lines, "canvas = {\"size\": (" + svg_num(w * scale) + ", " + svg_num(h * scale) + "), \"background\": colors.paper}")
  push(lines, "")
  let points = 0
  let count = 0
  let prims = 0
  let curved = 0
  push(lines, "layer lines")
  let tips = {"spiky": 0, "blunt": 0, "joined": 0}
  for (let i = 0; i < len(strokes); i += 1) {
    let s = strokes[i]
    let items = lineart_stroke_items(s, scale)
    let ps = []
    for (let k = 0; k < len(items.widths); k += 1) {
      let p = 1.0
      if (range[1] > range[0]) {
        p = math.max(0.0, math.min(1.0, (items.widths[k] - range[0]) / (range[1] - range[0])))
      }
      push(ps, svg_num(p))
    }
    if (!s.closed) {
      tips[s.tips[0]] += 1
      tips[s.tips[1]] += 1
    }
    if (s.prim !== null) {
      push(lines, "  " + lineart_prim_line(s.prim, "colors.ink", scale))
      points += 2
      prims += 1
    } else {
      points += len(ps)
      if (items.curved) {
        curved += 1
      }
      push(lines, "  brush([" + text.join(items.parts, ",") + "],[" + text.join(ps, ",") + "],colors.ink,pens.traced)")
    }
  }
  if (len(fills.shapes) > 0) {
    push(lines, "layer fills")
    for (let i = len(fills.shapes) - 1; i >= 0; i -= 1) {
      let s = fills.shapes[i]
      for (let k = 0; k < len(s.outers); k += 1) {
        let fill = ""
        if (s.paint !== null) {
          fill = lineart_paint_text(s.paint, scale)
        } else {
          fill = "colors." + name_of[s.color]
        }
        if (s.prims[k] !== null) {
          push(lines, "  " + lineart_prim_line(s.prims[k], fill, scale))
          points += lineart_prim_points(s.prims[k])
          prims += 1
        } else {
          push(lines, "  " + lineart_fill_line(s.outers[k], s.holes[k], s.outer_curves[k], s.hole_curves[k], fill, scale))
          points += lineart_ring_points(s.outers[k], s.outer_curves[k])
        }
        count += 1
      }
    }
  }
  {
    "code": text.join(lines, "\n") + "\n",
    "points": points,
    "tips": tips,
    "pen_min": lo,
    "pen_max": hi,
    "fills": count,
    "primitives": prims,
    "curved": curved,
    "names": names
  }
}

-~> A point as compact source text, "(x,y)" at one decimal: strokes are the
-~> bulk of a traced file's lines, and every byte counts there.
function lineart_tuple_text(p, scale) {
  "(" + lineart_num(p.x * scale) + "," + lineart_num(p.y * scale) + ")"
}

-~> The control of the quadratic Bezier that is the cubic [p0, c1, c2, p3] to
-~> within a tenth of a pixel, or null when it is not one: a quadratic item
-~> is a third shorter in the code.
function lineart_as_quad(c) {
  let q = (c[1] * 3.0 + c[2] * 3.0 - c[0] - c[3]) / 4.0
  let up1 = c[0] + (q - c[0]) * (2.0 / 3.0)
  let up2 = c[3] + (q - c[3]) * (2.0 / 3.0)
  if (math.max(math.dist(up1, c[1]), math.dist(up2, c[2])) * 0.75 <= 0.1) {
    return q
  }
  null
}

-~> How much longer than the plain points the fitted curves of a stroke may
-~> be and still get written (see lineart_stroke_items): a curve costs three
-~> points, so a thin line that the points follow well stays points.
let lineart_curve_cost = 1.0

-~> The items of a stroke's brush() as compact source text, with the width at
-~> each on-curve point. The fitted curves (a first point, then ["c",c1,c2,p]
-~> or ["q",c,p] for each piece) are written when they take no more room than
-~> the stroke's plain points (times lineart_curve_cost, each item counting
-~> its pressure too), else the points: a long smooth stroke is the curves,
-~> a short or thin one the points. Returns {"parts": [text...], "widths":
-~> [px...], "curved": whether they are the curves}.
function lineart_stroke_items(s, scale) {
  let plain = {"parts": [], "widths": [], "curved": false}
  for (let k = 0; k < len(s.points); k += 1) {
    push(plain.parts, lineart_tuple_text(s.points[k], scale))
    push(plain.widths, s.widths[k])
  }
  if (len(s.curves) == 0) {
    return plain
  }
  let curved = {"parts": [lineart_tuple_text(s.curves[0].curve[0], scale)], "widths": [s.curves[0].widths[0]], "curved": true}
  for (let k = 0; k < len(s.curves); k += 1) {
    let c = s.curves[k].curve
    let q = lineart_as_quad(c)
    if (q !== null) {
      push(curved.parts, "[\"q\"," + lineart_tuple_text(q, scale) + "," + lineart_tuple_text(c[3], scale) + "]")
    } else {
      push(curved.parts, "[\"c\"," + lineart_tuple_text(c[1], scale) + "," + lineart_tuple_text(c[2], scale) + "," + lineart_tuple_text(c[3], scale) + "]")
    }
    push(curved.widths, s.curves[k].widths[1])
  }
  if (lineart_items_cost(curved) <= lineart_items_cost(plain) * lineart_curve_cost) {
    return curved
  }
  plain
}

-~> The bytes a stroke's items take in the code: their text and a pressure each.
function lineart_items_cost(items) {
  len(text.join(items.parts, ",")) + 5 * len(items.widths)
}

-~> A primitive (see lineart_snap) as a call: circle, ellipse, rect, polygon
-~> filled with `paint`, or line drawn with it.
function lineart_prim_line(p, paint, scale) {
  if (p.kind == "circle") {
    return "circle(" + lineart_point_text(p.center, scale) + ", " + lineart_num(p.r * scale) + ", " + paint + ")"
  }
  if (p.kind == "ellipse") {
    return "ellipse(" + lineart_point_text(p.center, scale) + ", " + lineart_point_text(p.radii, scale) + ", " + paint + ")"
  }
  if (p.kind == "rect") {
    return "rect(" + lineart_point_text(p.pos, scale) + ", " + lineart_point_text(p.size, scale) + ", " + paint + ")"
  }
  if (p.kind == "polygon") {
    return "polygon(" + lineart_points_text(p.points, scale) + ", " + paint + ")"
  }
  "line(" + lineart_point_text(p.a, scale) + ", " + lineart_point_text(p.b, scale) + ", " + paint + ", " +
    lineart_num(math.max(0.1, p.width * scale)) + ")"
}

-~> How many numbers-as-points a primitive is written with (a polygon its
-~> corners, the others 2).
function lineart_prim_points(p) {
  if (p.kind == "polygon") {
    return len(p.points)
  }
  2
}

-~> A point as source text, one decimal: (1.5, 2).
function lineart_point_text(p, scale) {
  "(" + lineart_num(p.x * scale) + ", " + lineart_num(p.y * scale) + ")"
}

-~> ", N fills" for the header comment, or nothing without fills.
function lineart_fill_count(fills) {
  let n = 0
  for (let i = 0; i < len(fills.shapes); i += 1) {
    n += len(fills.shapes[i].outers)
  }
  if (n == 0) {
    return ""
  }
  ", " + str(n) + " fills"
}

-~> The palette numbers the fill shapes use, from the most used.
function lineart_used_colors(fills) {
  let count = {}
  let used = []
  for (let i = 0; i < len(fills.shapes); i += 1) {
    let c = fills.shapes[i].color
    if (fills.shapes[i].paint !== null) {
      continue
    }
    if (count[c] === null) {
      count[c] = 0
      push(used, c)
    }
    count[c] += len(fills.shapes[i].outers)
  }
  list.sort(used, function(a, b) { count[a] > count[b] || (count[a] == count[b] && a < b) })
}

-~> A point as source text, one decimal: (1.5, 2).
function lineart_point_text(p, scale) {
  "(" + lineart_num(p.x * scale) + ", " + lineart_num(p.y * scale) + ")"
}

-~> A list of points as source text, one decimal: [(1.5, 2), (3, 4.2)].
function lineart_points_text(points, scale) {
  let parts = []
  for (let i = 0; i < len(points); i += 1) {
    push(parts, lineart_point_text(points[i], scale))
  }
  "[" + text.join(parts, ", ") + "]"
}

-~> One ring of a path(): the fitted curves as items ["c", c1, c2, p] after
-~> the first point, or the plain points when it has no curves (too small
-~> to fit).
function lineart_ring_text(points, curves, scale) {
  if (len(curves) == 0) {
    return lineart_points_text(points, scale)
  }
  let parts = [lineart_point_text(curves[0][0], scale)]
  for (let i = 0; i < len(curves); i += 1) {
    parts = parts + ["[\"c\", " + lineart_point_text(curves[i][1], scale) + ", " + lineart_point_text(curves[i][2], scale) +
      ", " + lineart_point_text(curves[i][3], scale) + "]"]
  }
  "[" + text.join(parts, ", ") + "]"
}

-~> How many points a ring writes: its points, or one per curve end.
function lineart_ring_points(points, curves) {
  if (len(curves) == 0) {
    return len(points)
  }
  len(curves)
}

-~> One path(...) call for a fill shape, with its holes when it has some.
function lineart_fill_line(outer, holes, outer_curves, hole_curves, fill, scale) {
  let call = "path(" + lineart_ring_text(outer, outer_curves, scale) + ", " + fill
  if (len(holes) > 0) {
    let parts = []
    for (let i = 0; i < len(holes); i += 1) {
      push(parts, lineart_ring_text(holes[i], hole_curves[i], scale))
    }
    call = call + ", true, true, [" + text.join(parts, ", ") + "]"
  }
  call + ")"
}
