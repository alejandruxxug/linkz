-~> lineart: the "lineart" mode of trace, for inked drawings and cel art. The
-~> ink becomes brush() strokes along its centerlines, their pressures
-~> following the width of the ink, instead of filled outlines. The steps:
-~>   1. lineart_mask      which pixels are ink (dark against their
-~>                        neighbourhood, with hysteresis)
-~>   2. lineart_distance  how far each ink pixel is from the paper: the
-~>                        half-width of the line at its centerline
-~>   3. lineart_thin      the centerlines, one pixel wide (Zhang-Suen)
-~>   4. lineart_graph     ends, junctions and the edges between them; spurs
-~>                        pruned, near junctions joined
-~>   5. lineart_pair, lineart_chains  edges joined through junctions where
-~>                        the line goes straight on and along the flow (the
-~>                        orientation field, lineart_flow), and across gaps
-~>                        of up to 2 px between line ends facing each other
-~>   6. lineart_split, lineart_stroke  chains cut at their corners; points
-~>                        and widths along each piece, tips spiky or blunt,
-~>                        fitted with Bezier curves (lineart_curves); a
-~>                        straight one of even width snaps to a line
-~>   7. lineart_code      one brush() (or line()) per stroke, pen widths from
-~>                        the thinnest and thickest ink
-~> and, for the fills (lineart_fills, lineart_outline), before the thinning:
-~>   a. lineart_solid     ink wide all round (a pupil, dark trousers) leaves
-~>                        the mask, to be a fill instead of a stroke
-~>   b. lineart_regions   the colors away from the ink, reduced in Lab and
-~>                        cut into regions grown under the lines
-~>   c. lineart_region_shapes  a sub-pixel outline per region, its corners
-~>                        sharpened (spikes drawn out along the flow), fitted
-~>                        with Bezier curves, snapped to a circle, ellipse,
-~>                        rect or polygon when one fits within `snap`;
-~>                        written in `layer fills`, before (so behind)
-~>                        `layer lines`

use "../draw/svg"
use "lineart_mask"
use "lineart_skeleton"
use "lineart_graph"
use "lineart_strokes"
use "lineart_flow"
use "lineart_snap"
use "lineart_fills"
use "lineart_outline"
use "lineart_palette"

-~> The options of trace(path, {"mode": "lineart", ...}). Anything left out
-~> takes the value shown.
-~>   line_threshold  how much darker than its surroundings a pixel must be
-~>                   to start a line, 0 to 1 (0.5: half as bright). Lower
-~>                   finds fainter lines.
-~>   line_min        strokes shorter than this many pixels (length plus
-~>                   width) are dropped, so specks don't become strokes.
-~>   continuation    the largest turn, in degrees, a line may make at a
-~>                   junction and still go on as the same stroke.
-~>   flow            how much the direction the picture flows in (hair
-~>                   strands, parallel lines) steers a stroke through a
-~>                   junction and across a gap, and draws out spikes; 0 is
-~>                   off, 1 is strong.
-~>   corner          the turn, in degrees, from which a point of a line or
-~>                   an outline is a sharp corner (seen at two scales).
-~>   snap            how far, in pixels, an outline or a stroke may be from
-~>                   a circle, ellipse, rect, polygon or line to be written
-~>                   as one; 0 never snaps.
-~>   radius          the half side, in pixels, of the neighbourhood a pixel is
-~>                   compared with; 0 picks it from the picture's size.
-~>   fills           false to trace only the lines, on the paper color.
-~>   colors          the most fill colors (2 to 64), picked in Lab. Fewer
-~>                   gives a simpler drawing, more keeps more cel shades.
-~>   min_area        color regions smaller than this many pixels are given
-~>                   to their neighbours; 0 picks it from the picture's size.
-~>   solid           ink at least this far (px) from the paper all round is
-~>                   a solid fill, not a stroke; 0 picks it from the size.
-~>   detail          how far, in pixels, a fill outline may drift from the
-~>                   Bezier curves fitted to it.
-~>   scale           multiplies every coordinate, to make a bigger drawing.
-~>   max_side        the picture is shrunk until its longer side is at most
-~>                   this many pixels.
let lineart_options = {
  "mode": "lineart",
  "line_threshold": 0.5,
  "line_min": 6,
  "continuation": 35,
  "flow": 0.6,
  "corner": 55,
  "snap": 1.5,
  "radius": 0,
  "fills": true,
  "colors": 16,
  "min_area": 0,
  "solid": 0,
  "detail": 0.8,
  "scale": 1,
  "max_side": 1024
}

-~> The line-art options with the defaults filled in. An unknown name is an
-~> error, so a typo doesn't pass silently.
function lineart_settings(options) {
  let names = keys(options)
  for (let i = 0; i < len(names); i += 1) {
    if (!hash.has(lineart_options, names[i])) {
      error("trace: unknown option \"" + names[i] + "\" for line art (known: " +
        text.join(keys(lineart_options), ", ") + ")")
    }
  }
  let out = hash.merge(lineart_options, options)
  if (!(out.line_threshold > 0 && out.line_threshold < 1)) {
    error("trace: line_threshold must be between 0 and 1")
  }
  if (out.colors < 2 || out.colors > 64) {
    error("trace: colors must be from 2 to 64")
  }
  if (!(out.flow >= 0 && out.flow <= 1)) {
    error("trace: flow must be between 0 and 1")
  }
  if (!(out.corner > 0 && out.corner < 180)) {
    error("trace: corner must be between 0 and 180 degrees")
  }
  if (!(out.snap >= 0)) {
    error("trace: snap must be 0 or more pixels")
  }
  out
}

-~> Traces line art: `size` is (w, h) and `pixels` a flat list of colors, row
-~> by row. Returns {"code", "stats": {mode, strokes, points, tips, junctions,
-~> ink, primitives, bridged, ms, size, stages}}; `stages` has the
-~> milliseconds of each step.
function lineart_pixels(size, pixels, options, name) {
  let opt = lineart_settings(options)
  let w = size.x
  let h = size.y
  let t0 = time.ms()
  let radius = opt.radius
  if (radius <= 0) {
    radius = math.max(4, math.round(math.max(w, h) / 128.0))
  }
  let m = lineart_mask(pixels, w, h, opt.line_threshold, radius)
  let t1 = time.ms()
  let dist = lineart_distance(m.mask, m.ink, w)
  let t2 = time.ms()
  let curve = {
    "detail": opt.detail,
    "corner": opt.corner,
    "snap": opt.snap,
    "flow": opt.flow,
    "luma": m.luma,
    "w": w,
    "h": h,
    "r": radius,
    "half": 1.0
  }
  let fills = lineart_trace_fills(pixels, m, dist, w, h, opt, curve)
  if (fills.solid > 0) {
    dist = lineart_distance(m.mask, m.ink, w)
  }
  let t2f = time.ms()
  let thin = lineart_thin(m.mask, m.ink, w)
  let t3 = time.ms()
  let graph = lineart_graph(m.mask, thin.skeleton, dist, w)
  let pruned = lineart_prune(graph, 3)
  let joined = lineart_merge_junctions(graph, dist, w)
  let t4 = time.ms()
  let luma = m.luma
  let weight = opt.flow
  let cost = function(turn, a, b, node) {
    lineart_flow_turn(turn, a, b, lineart_node_flow(luma, w, h, node, radius, weight), weight)
  }
  let partner = lineart_pair(graph, w, opt.continuation, cost)
  let bridges = lineart_bridges(graph, dist, luma, w, h, radius, opt.continuation, weight)
  lineart_add_bridges(partner, bridges)
  let chains = lineart_chains(graph, partner, w)
  let strokes = []
  for (let i = 0; i < len(chains); i += 1) {
    let pieces = lineart_split(chains[i], w, opt.corner, dist)
    for (let k = 0; k < len(pieces); k += 1) {
      let c = pieces[k]
      let ends = [lineart_is_junction(graph, c.ends[0]) || c.cut[0], lineart_is_junction(graph, c.ends[1]) || c.cut[1]]
      let s = lineart_stroke(c, ends, dist, w, 1.0, 0.75)
      if (c.tip[0] !== null) {
        s.points[0] = c.tip[0]
      }
      if (c.tip[1] !== null) {
        s.points[len(s.points) - 1] = c.tip[1]
      }
      if (s.length + lineart_widest(s.widths) >= opt.line_min) {
        s.prim = lineart_snap_stroke(s, opt.snap)
        push(strokes, s)
      }
    }
  }
  for (let i = 0; i < len(graph.nodes); i += 1) {
    let node = graph.nodes[i]
    if (node.kind == "dot") {
      let s = lineart_stroke({"pixels": node.pixels, "closed": false}, [false, false], dist, w, 1.0, 0.75)
      if (1 + lineart_widest(s.widths) >= opt.line_min) {
        s.prim = null
        push(strokes, s)
      }
    }
  }
  let t5 = time.ms()
  let made = lineart_code(name, w, h, m, strokes, fills, opt.scale)
  let t6 = time.ms()
  let junctions = 0
  for (let i = 0; i < len(graph.nodes); i += 1) {
    if (graph.nodes[i].kind == "junction") {
      junctions += 1
    }
  }
  {
    "code": made.code,
    "stats": {
      "mode": "lineart",
      "strokes": len(strokes),
      "fills": made.fills,
      "colors": len(made.names),
      "solid": fills.solid,
      "points": made.points,
      "primitives": made.primitives,
      "bridged": len(bridges),
      "tips": made.tips,
      "junctions": junctions,
      "pruned": pruned,
      "joined": joined,
      "ink": len(m.ink),
      "pen": [made.pen_min, made.pen_max],
      "ms": t6 - t0,
      "size": size,
      "stages": {
        "mask": t1 - t0,
        "distance": t2 - t1,
        "fills": t2f - t2 - fills.outline_ms,
        "outlines": fills.outline_ms,
        "thin": t3 - t2f,
        "graph": t4 - t3,
        "strokes": t5 - t4,
        "code": t6 - t5
      }
    }
  }
}

-~> The fills of a picture whose ink is `m` (lineart_mask's result, with
-~> `dist` its distance transform): solid ink taken out of m first, then
-~> the regions, and the shapes of each one to draw, biggest first
-~> (`curve`: the settings of lineart_outline_points).
-~> Returns {"shapes": [{"color": palette number, "outers", "holes",
-~> "prims"}...],
-~> "colors", "lab", "background" (palette number or -1), "solid": solid
-~> pixels taken, "outline_ms"}.
function lineart_trace_fills(pixels, m, dist, w, h, opt, curve) {
  let none = {"shapes": [], "colors": [], "lab": [], "background": -1, "solid": 0, "outline_ms": 0}
  if (!opt.fills) {
    return none
  }
  let half = lineart_line_half(m, dist, w)
  curve.half = half
  let depth = opt.solid
  if (depth <= 0) {
    depth = math.max(4.0, 4.0 * half)
  }
  let min_area = opt.min_area
  if (min_area <= 0) {
    min_area = math.max(4, math.round(w * h / 40000.0))
  }
  let solid = lineart_solid(m, pixels, dist, w, depth)
  let fill = lineart_regions(pixels, m.mask, w, h, opt.colors, min_area)
  let order = lineart_order(fill, w, h)
  let t0 = time.ms()
  let shapes = []
  for (let k = 0; k < len(order.order); k += 1) {
    let id = order.order[k]
    let s = lineart_region_shapes(fill, order, id, w, h, curve)
    if (len(s.outers) > 0) {
      s.color = fill.regions[id].color
      push(shapes, s)
    }
  }
  {
    "shapes": shapes,
    "colors": fill.colors,
    "lab": fill.lab,
    "background": order.background,
    "solid": solid,
    "outline_ms": time.ms() - t0
  }
}

-~> Whether a node number is a junction (-1 is no node).
function lineart_is_junction(graph, id) {
  id >= 0 && graph.nodes[id].kind == "junction"
}

-~> The biggest of some widths.
function lineart_widest(widths) {
  let top = 0.0
  for (let i = 0; i < len(widths); i += 1) {
    top = math.max(top, widths[i])
  }
  top
}

-~> A number rounded to one decimal, as source text.
function lineart_num(n) {
  svg_num(math.round(n * 10) / 10.0)
}

-~> The pen's thinnest and thickest width: the extremes of the stroke widths.
function lineart_pen_range(strokes) {
  let all = []
  for (let i = 0; i < len(strokes); i += 1) {
    for (let k = 0; k < len(strokes[i].widths); k += 1) {
      push(all, strokes[i].widths[k])
    }
  }
  if (len(all) == 0) {
    return [1.0, 1.0]
  }
  let sorted = list.sort(all)
  [math.floor(sorted[0] * 10) / 10.0, math.ceil(sorted[len(sorted) - 1] * 10) / 10.0]
}

-~> The .lzdraw source: the palette (paper, ink and the fill colors by
-~> name), the pen, the canvas, `layer lines` with one brush() per stroke,
-~> then `layer fills` (lower, so behind the lines; left out when there is
-~> none) with one path() per fill shape, the smallest first (in front).
-~> A stroke or a fill shape that snapped to a primitive is written as
-~> that call. The canvas is the background's color. Returns {"code",
-~> "points", "tips": {spiky, blunt, joined}, "pen_min", "pen_max",
-~> "fills", "primitives", "names"}.
function lineart_code(source_name, w, h, m, strokes, fills, scale) {
  let range = lineart_pen_range(strokes)
  let lo = range[0] * scale
  let hi = range[1] * scale
  let used = lineart_used_colors(fills)
  let labs = []
  for (let i = 0; i < len(used); i += 1) {
    push(labs, fills.lab[used[i]])
  }
  let names = lineart_color_names(labs, ["paper", "ink"])
  let name_of = {}
  for (let i = 0; i < len(used); i += 1) {
    name_of[used[i]] = names[i]
  }
  let paper = m.paper
  if (len(fills.shapes) > 0 && fills.background >= 0) {
    paper = fills.colors[fills.background]
  }
  let lines = ["-~> lzdraw 1", "-~> Traced from " + source_name + " as line art: " + str(len(strokes)) + " strokes" +
    lineart_fill_count(fills) + "."]
  let palette = ["\"paper\": " + color_hex(paper), "\"ink\": " + color_hex(m.ink_color)]
  for (let i = 0; i < len(used); i += 1) {
    push(palette, "\"" + names[i] + "\": " + color_hex(fills.colors[used[i]]))
  }
  push(lines, "let colors = {" + text.join(palette, ", ") + "}")
  push(lines, "pens.traced = {\"name\": \"traced\", \"min\": " + lineart_num(lo) + ", \"max\": " + lineart_num(hi) +
    ", \"taper\": 0, \"opacity\": [1, 1], \"nib\": null, \"grain\": 0}")
  push(lines, "canvas = {\"size\": (" + svg_num(w * scale) + ", " + svg_num(h * scale) + "), \"background\": colors.paper}")
  push(lines, "")
  let points = 0
  let count = 0
  let prims = 0
  push(lines, "layer lines")
  let tips = {"spiky": 0, "blunt": 0, "joined": 0}
  for (let i = 0; i < len(strokes); i += 1) {
    let s = strokes[i]
    let pts = []
    let ps = []
    for (let k = 0; k < len(s.points); k += 1) {
      push(pts, "(" + lineart_num(s.points[k].x * scale) + ", " + lineart_num(s.points[k].y * scale) + ")")
      let p = 1.0
      if (range[1] > range[0]) {
        p = math.max(0.0, math.min(1.0, (s.widths[k] - range[0]) / (range[1] - range[0])))
      }
      push(ps, svg_num(p))
    }
    if (!s.closed) {
      tips[s.tips[0]] += 1
      tips[s.tips[1]] += 1
    }
    if (s.prim !== null) {
      push(lines, "  " + lineart_prim_line(s.prim, "colors.ink", scale))
      points += 2
      prims += 1
    } else {
      points += len(pts)
      push(lines, "  brush([" + text.join(pts, ", ") + "], [" + text.join(ps, ", ") + "], colors.ink, pens.traced)")
    }
  }
  if (len(fills.shapes) > 0) {
    push(lines, "layer fills")
    for (let i = len(fills.shapes) - 1; i >= 0; i -= 1) {
      let s = fills.shapes[i]
      for (let k = 0; k < len(s.outers); k += 1) {
        let fill = "colors." + name_of[s.color]
        if (s.prims[k] !== null) {
          push(lines, "  " + lineart_prim_line(s.prims[k], fill, scale))
          points += lineart_prim_points(s.prims[k])
          prims += 1
        } else {
          push(lines, "  " + lineart_fill_line(s.outers[k], s.holes[k], fill, scale))
          points += len(s.outers[k])
        }
        count += 1
      }
    }
  }
  {
    "code": text.join(lines, "\n") + "\n",
    "points": points,
    "tips": tips,
    "pen_min": lo,
    "pen_max": hi,
    "fills": count,
    "primitives": prims,
    "names": names
  }
}

-~> A primitive (see lineart_snap) as a call: circle, ellipse, rect, polygon
-~> filled with `paint`, or line drawn with it.
function lineart_prim_line(p, paint, scale) {
  if (p.kind == "circle") {
    return "circle(" + lineart_point_text(p.center, scale) + ", " + lineart_num(p.r * scale) + ", " + paint + ")"
  }
  if (p.kind == "ellipse") {
    return "ellipse(" + lineart_point_text(p.center, scale) + ", " + lineart_point_text(p.radii, scale) + ", " + paint + ")"
  }
  if (p.kind == "rect") {
    return "rect(" + lineart_point_text(p.pos, scale) + ", " + lineart_point_text(p.size, scale) + ", " + paint + ")"
  }
  if (p.kind == "polygon") {
    return "polygon(" + lineart_points_text(p.points, scale) + ", " + paint + ")"
  }
  "line(" + lineart_point_text(p.a, scale) + ", " + lineart_point_text(p.b, scale) + ", " + paint + ", " +
    lineart_num(math.max(0.1, p.width * scale)) + ")"
}

-~> How many numbers-as-points a primitive is written with (a polygon its
-~> corners, the others 2).
function lineart_prim_points(p) {
  if (p.kind == "polygon") {
    return len(p.points)
  }
  2
}

-~> A point as source text, one decimal: (1.5, 2).
function lineart_point_text(p, scale) {
  "(" + lineart_num(p.x * scale) + ", " + lineart_num(p.y * scale) + ")"
}

-~> ", N fills" for the header comment, or nothing without fills.
function lineart_fill_count(fills) {
  let n = 0
  for (let i = 0; i < len(fills.shapes); i += 1) {
    n += len(fills.shapes[i].outers)
  }
  if (n == 0) {
    return ""
  }
  ", " + str(n) + " fills"
}

-~> The palette numbers the fill shapes use, from the most used.
function lineart_used_colors(fills) {
  let count = {}
  let used = []
  for (let i = 0; i < len(fills.shapes); i += 1) {
    let c = fills.shapes[i].color
    if (count[c] === null) {
      count[c] = 0
      push(used, c)
    }
    count[c] += len(fills.shapes[i].outers)
  }
  list.sort(used, function(a, b) { count[a] > count[b] || (count[a] == count[b] && a < b) })
}

-~> A list of points as source text, one decimal: [(1.5, 2), (3, 4.2)].
function lineart_points_text(points, scale) {
  let parts = []
  for (let i = 0; i < len(points); i += 1) {
    push(parts, "(" + lineart_num(points[i].x * scale) + ", " + lineart_num(points[i].y * scale) + ")")
  }
  "[" + text.join(parts, ", ") + "]"
}

-~> One path(...) call for a fill shape, with its holes when it has some.
function lineart_fill_line(outer, holes, fill, scale) {
  let call = "path(" + lineart_points_text(outer, scale) + ", " + fill
  if (len(holes) > 0) {
    let parts = []
    for (let i = 0; i < len(holes); i += 1) {
      push(parts, lineart_points_text(holes[i], scale))
    }
    call = call + ", true, true, [" + text.join(parts, ", ") + "]"
  }
  call + ")"
}
