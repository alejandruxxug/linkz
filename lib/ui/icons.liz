-~> The spans of an icon at a scale, [y, x0, x1] from its top left, kept.
let icon_cache = {}

function icon_spans(name, sc) {
  let key = name + str(sc)
  let hit = icon_cache[key]
  if (hit != null) {
    return hit
  }
  let out = []
  let art = icon_art[name]
  if (art == null) {
    art = icon_art["dot"]
  }
  let rows = text.split(art, "|")
  for (let r = 0; r < len(rows); r = r + 1) {
    let row = rows[r]
    let c = 0
    while (c < 8) {
      if (row[c] == "#") {
        let e = c
        while (e < 8 && row[e] == "#") {
          e = e + 1
        }
        for (let k = 0; k < sc; k = k + 1) {
          push(out, [r * sc + k, c * sc, e * sc])
        }
        c = e
      } else {
        c = c + 1
      }
    }
  }
  icon_cache[key] = out
  out
}

-~> redo is undo seen in a mirror.
function icon_mirror(art) {
  let rows = text.split(art, "|")
  let out = []
  for (let r = 0; r < len(rows); r = r + 1) {
    let m = ""
    for (let c = 7; c >= 0; c = c - 1) {
      m = m + rows[r][c]
    }
    push(out, m)
  }
  text.join(out, "|")
}

icon_art["redo"] = icon_mirror(icon_art["undo"])
