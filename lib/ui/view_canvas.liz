-~> view_canvas: the canvas area. The surround and the frame are drawn in the UI
-~> buffer; the drawing and the selection (outline, anchors) go into the
-~> full-resolution canvas buffer, where one UI pixel is a 2x2 block so the
-~> overlay looks like the rest of the UI. The drawing itself comes from the
-~> scene's tiles (view_scene.liz), so a paint only repaints what changed.
-~> Errors keep the last good drawing, dimmed, with a badge under it.

use "../draw/geometry"
use "../draw/gradient"
use "../gfx/raster"
use "../gfx/tiles"
use "editor_doc"
use "editor_rows"
use "editor_state"
use "editor_undo"
use "i18n"
use "layer_iso"
use "perf"
use "tool_route"
use "view_gfx"
use "view_layout"
use "view_scene"
use "view_tools"
use "overlay_rules"

-~> A shape with its path and width multiplied by k (the zoom). Shapes at 100%
-~> are used as they are.
function view_scale_shape(s, k) {
  if (k == 1) {
    return s
  }
  let out = hash_copy(s)
  let path = []
  for (let i = 0; i < len(s.path); i = i + 1) {
    let c = s.path[i]
    if (c[0] == "C") {
      push(path, ["C", c[1] * k, c[2] * k, c[3] * k])
    } elif (c[0] == "Q") {
      push(path, ["Q", c[1] * k, c[2] * k])
    } elif (c[0] == "Z") {
      push(path, ["Z"])
    } else {
      push(path, [c[0], c[1] * k])
    }
  }
  out.path = path
  out.fill = scale_paint(s.fill, k)
  out.stroke = scale_paint(s.stroke, k)
  out.paint_cache = null
  if (type(s.width) == "INTEGER" || type(s.width) == "FLOAT") {
    out.width = s.width * k
  }
  if (s.widths != null) {
    let ws = []
    for (let i = 0; i < len(s.widths); i = i + 1) {
      push(ws, s.widths[i] * k)
    }
    out.widths = ws
  }
  out
}

-~> == The selection ==

-~> The shapes of the selected rows, as [{"shape", "line"}].
function view_selected_shapes() {
  -~> while the brush paints nothing shows selected on the canvas (R002 12):
  -~> its rows stay selected in the code and the layers
  if (V.tool == "brush") {
    return []
  }
  let m = ed_model()
  let a = m.line
  let b = m.line
  if (m.sel != null) {
    a = m.sel.from
    b = m.sel.to
  }
  let out = []
  for (let l = a; l <= b; l = l + 1) {
    let list = ed_shapes_of(l)
    for (let i = 0; i < len(list); i = i + 1) {
      push(out, {"shape": list[i], "line": l, "i": i})
    }
  }
  out
}

-~> The dashed box of the selection (3 pixels on, 2 off) around window pixels
-~> x0 y0 x1 y1, snapped to the UI pixels.
function view_sel_box(x0, y0, x1, y1) {
  let ux0 = math.floor(x0 / 2)
  let uy0 = math.floor(y0 / 2)
  let ux1 = math.ceil(x1 / 2)
  let uy1 = math.ceil(y1 / 2)
  let w = ux1 - ux0
  let h = uy1 - uy0
  for (let i = 0; i < w; i = i + 5) {
    let l = math.min(3, w - i)
    g_rect(ux0 + i, uy0, l, 1, P.lizard)
    g_rect(ux0 + i, uy1 - 1, l, 1, P.lizard)
  }
  for (let j = 0; j < h; j = j + 5) {
    let l = math.min(3, h - j)
    g_rect(ux0, uy0 + j, 1, l, P.lizard)
    g_rect(ux1 - 1, uy0 + j, 1, l, P.lizard)
  }
}

-~> A 5x5 anchor with a void outline (7x7 amber when hovered), centered at the UI pixel.
function view_anchor(ux, uy, role, hover) {
  let s = 5
  let c = P.lizard
  if (role == "radius" || role == "corner") {
    c = P.bright
  }
  if (hover) {
    s = 7
    c = P.amber
  }
  let h = s // 2
  g_rect(ux - h - 1, uy - h - 1, s + 2, s + 2, P.void)
  g_rect(ux - h, uy - h, s, s, c)
}

-~> The UI pixel of an anchor.
function view_anchor_ui(cl, pos) {
  let w = view_to_window(cl, pos)
  return [math.round(w.x / 2), math.round(w.y / 2)]
}

function view_paint_selection(cl) {
  ov_paint_layer_box(cl)
  if (route_paint(cl)) {
    return null
  }
  let sel = view_selected_shapes()
  for (let n = 0; n < len(sel); n = n + 1) {
    let s = sel[n].shape
    let b = path_bounds(s.path)
    if (b != null) {
      let lo = view_to_window(cl, b.min)
      let hi = view_to_window(cl, b.max)
      let pad = 0
      if (len(s.anchors) > 0 && s.anchors[0].role == "point") {
        pad = 6
      }
      view_sel_box(lo.x - pad, lo.y - pad, hi.x + pad, hi.y + pad)
    }
  }
  if (!ov_shape_handles()) {
    return null
  }
  for (let n = 0; n < len(sel); n = n + 1) {
    let s = sel[n].shape
    for (let i = 0; i < len(s.anchors); i = i + 1) {
      let a = s.anchors[i]
      let u = view_anchor_ui(cl, a.pos)
      let hover = V.hover_anchor != null && V.hover_anchor.line == sel[n].line && V.hover_anchor.i == sel[n].i && V.hover_anchor.anchor == i
      if (!hover) {
        view_anchor(u[0], u[1], a.role, false)
      }
    }
  }
  if (V.hover_anchor != null) {
    for (let n = 0; n < len(sel); n = n + 1) {
      let s = sel[n].shape
      for (let i = 0; i < len(s.anchors); i = i + 1) {
        let hv = V.hover_anchor
        if (hv.line == sel[n].line && hv.i == sel[n].i && hv.anchor == i) {
          let u = view_anchor_ui(cl, s.anchors[i].pos)
          view_anchor(u[0], u[1], s.anchors[i].role, true)
        }
      }
    }
  }
}

-~> The anchor of a selected shape under a UI pixel (within 4), or null:
-~> {"line", "i", "anchor", "pos", "role"}.
function view_anchor_at(cl, ux, uy) {
  if (route_owns(V.tool) || !ov_shape_handles()) {
    return null
  }
  let sel = view_selected_shapes()
  let best = null
  let best_d = 5
  for (let n = 0; n < len(sel); n = n + 1) {
    let s = sel[n].shape
    for (let i = 0; i < len(s.anchors); i = i + 1) {
      let u = view_anchor_ui(cl, s.anchors[i].pos)
      let d = math.max(math.abs(u[0] - ux), math.abs(u[1] - uy))
      if (d < best_d) {
        best_d = d
        best = {"line": sel[n].line, "i": sel[n].i, "anchor": i, "pos": s.anchors[i].pos, "role": s.anchors[i].role}
      }
    }
  }
  best
}

-~> == The shape under a point of the drawing ==

-~> The topmost visible, unlocked shape at p (drawing pixels), or null. The
-~> scene's index gives the shapes near p, frontmost first.
function view_hit_shape(cl, p) {
  let rows = view_rows()
  let slack = 3 / cl.zoom
  let list = scene_near(scene_sync(cl), p, slack)
  for (let i = 0; i < len(list); i = i + 1) {
    let s = list[i]
    let locked = false
    if (type(s.line) == "INTEGER" && s.line >= 1 && s.line <= len(rows)) {
      locked = row_has_flag(rows, s.line, "locked")
    }
    if (!locked) {
      if (s.fill != null && point_in_path(s.path, p)) {
        return s
      }
      if (s.stroke != null && distance_to_path(s.path, p) <= s.width / 2 + slack) {
        return s
      }
      if (s.kind == "brush" && distance_to_path(s.path, p) <= slack) {
        return s
      }
    }
  }
  null
}

-~> Selects the row of a line and opens the layers around it.
function view_select_line(line) {
  view_open_around(line)
  ed_select(line)
  view_show_line(line)
}

-~> Unfolds the layers (and blocks) a line is inside, so its row shows.
function view_open_around(line) {
  let rows = view_rows()
  if (line < 1 || line > len(rows)) {
    return null
  }
  let r = rows[line - 1]
  let chain = []
  while (r.parent > 0) {
    r = rows[r.parent - 1]
    push(chain, r)
  }
  for (let i = 0; i < len(chain); i = i + 1) {
    if (chain[i].collapsed) {
      ed_toggle_fold(chain[i].line)
    }
  }
}

-~> A line selected on the canvas shows everywhere: its layers unfold, and
-~> the code panel (the drawer) and the layers panel scroll to its row.
function view_show_line(line) {
  view_open_around(line)
  view_touch()
  view_reveal(line)
}

-~> == Painting ==

function view_canvas_key() {
  let cl = view_canvas_layout()
  let m = ed_model()
  let sel = str(m.line)
  if (m.sel != null) {
    sel = str(m.sel.from) + "-" + str(m.sel.to)
  }
  let anchor = ""
  if (V.hover_anchor != null) {
    anchor = str(V.hover_anchor.line) + "." + str(V.hover_anchor.i) + "." + str(V.hover_anchor.anchor)
  }
  str(V.run_id) + "|" + str(ed.runs) + "|" + sel + "|" + str(ed.stale) + "|" + str(len(ed.errors)) + "|" + anchor + "|" + str(cl.zoom) + "|" +
    str(cl.crect) + "|" + str(V.live_n) + str(V.sel_anchor) + "|" + str(V.w) + "x" + str(V.h) + "|" + str(V.pw) + "|" + str(ed_canvas_size()) + "|" + route_canvas_key() + "|" + str(V.tool == "brush") + "|" + iso_key()
}

function view_paint_canvas_ui(cl) {
  let gm = view_geom()
  let pr = view_panel_rects().canvas
  g_clip(pr[0], pr[1], pr[2], pr[3])
  -~> the splitter: left of the canvas, or right of it in artist mode
  let sx = gm.pw
  if (gm.artist == true) {
    sx = gm.cx + gm.cw
  }
  g_rect(sx, pr[1], 1, pr[3], P.void)
  g_rect(sx + 1, pr[1], 1, pr[3], P.bevel)
  g_rect(gm.cx, gm.cy, gm.cw, gm.ch, P.coal)
  g_spans(g_checker_spans(gm.cw, gm.ch), gm.cx, gm.cy, P.checker)
  let fr = cl.frame
  let ix = fr[0]
  g_frame(fr[0], fr[1], fr[2], fr[3], P.void)
  if (ed.stale && len(ed.errors) > 0) {
    let label = t("badge.last_good")
    let bw = g_text_w(label) + 18
    let bx = fr[0]
    let by = fr[1] + fr[3] + 4
    g_frame(bx, by, bw, 16, P.void)
    g_rect(bx + 1, by + 1, bw - 2, 14, P.row)
    g_icon("error", bx + 4, by + 4, P.ember)
    g_text(label, bx + 14, by + 1, P.ember)
    ix = bx + bw + 4
  }
  iso_chip(cl, ix)
}

-~> Paints the canvas panel. Returns the part of it that changed (UI pixels),
-~> or null for all of it. When only the drawing or the selection changed
-~> (same layout, nothing being drawn with the pencil or the brush, not
-~> `forced`), only that part is painted again (view_paint_canvas_part).
function view_paint_canvas(forced) {
  perf_begin("canvas")
  let part = view_paint_canvas_now(forced)
  perf_end()
  part
}

-~> What the canvas panel's look depends on besides the drawing and the
-~> selection: when it changes the whole panel is painted again.
function view_canvas_layout_key(cl) {
  str(cl.zoom) + "|" + str(cl.crect) + "|" + str(cl.wx) + "," + str(cl.wy) + "|" + str(cl.sw) + "x" + str(cl.sh) +
    "|" + str(ed.stale && len(ed.errors) > 0) + "|" + str(ed.canvas.background) + "|" + lang_get() + "|" + iso_key()
}

-~> The part of the canvas buffer the selection and the anchors cover, as
-~> [x0, y0, x1, y1], or null.
function view_overlay_box(cl) {
  let box = null
  let sel = view_selected_shapes()
  for (let n = 0; n < len(sel); n = n + 1) {
    let s = sel[n].shape
    let b = path_bounds(s.path)
    if (b != null) {
      box = tiles_union(box, view_window_box(cl, b.min, b.max))
    }
    for (let i = 0; i < len(s.anchors); i = i + 1) {
      box = tiles_union(box, view_window_box(cl, s.anchors[i].pos, s.anchors[i].pos))
    }
  }
  let a = V.sel_anchor
  if (a != null) {
    let list = ed_shapes_of(a.line)
    if (a.i < len(list) && a.anchor < len(list[a.i].anchors)) {
      let p = list[a.i].anchors[a.anchor].pos
      box = tiles_union(box, view_window_box(cl, p, p))
    }
  }
  box = tiles_union(box, route_overlay_win(cl))
  box = tiles_union(box, ov_layer_box(cl))
  if (box === null) {
    return null
  }
  -~> the dashed box sits 6 pixels out, an anchor reaches 4 UI pixels around its point
  let m = 16
  let cr = cl.crect
  [box[0] - m - cr[0] * 2, box[1] - m - cr[1] * 2, box[2] + m - cr[0] * 2, box[3] + m - cr[1] * 2]
}

-~> The window pixels from drawing point lo to hi.
function view_window_box(cl, lo, hi) {
  let a = view_to_window(cl, lo)
  let b = view_to_window(cl, hi)
  [math.min(a.x, b.x), math.min(a.y, b.y), math.max(a.x, b.x), math.max(a.y, b.y)]
}

function view_paint_canvas_now(forced) {
  raster.new_frame()
  let cl = view_canvas_layout()
  V.cl = cl
  let key = view_canvas_layout_key(cl)
  let last = V.canvas_last
  let live = V.live != null
  let overlay = view_overlay_box(cl)
  let part = null
  if (!forced && !live && last != null && !last.live && last.key == key) {
    part = view_paint_canvas_part(cl, last.overlay, overlay)
  } else {
    view_paint_canvas_all(cl)
  }
  V.canvas_last = {"key": key, "live": live, "overlay": overlay}
  part
}

-~> The whole panel: the surround in the UI buffer, the drawing from the
-~> scene's tiles, the pencil or brush being drawn, the selection.
function view_paint_canvas_all(cl) {
  g_ui()
  view_paint_canvas_ui(cl)
  let cr = cl.crect
  fb.canvas((cr[0], cr[1]), (cr[2], cr[3]))
  V.host_origin = (cr[0], cr[1])
  g_canvas((cr[0], cr[1]))
  fb.unclip()
  let sc = scene_sync(cl)
  fb.clear((0, 0), (cr[2] * 2, cr[3] * 2))
  let off = cl.offset
  fb.clip(off, (cl.sw, cl.sh))
  scene_paint(sc, off)
  iso_paint(cl, off)
  view_tools_paint(cl, off)
  if (ed.stale && len(ed.errors) > 0) {
    fb.fill(off, (cl.sw, cl.sh), P.veil)
  }
  fb.unclip()
  view_paint_selection(cl)
  view_tools_paint_ui(cl)
  g_ui()
}

-~> Only what changed: the part of the drawing the scene repainted and where
-~> the selection was and is now (`was`, `now`: canvas buffer boxes or null).
-~> That part is painted the way view_paint_canvas_all paints it, clipped to
-~> it; the rest of the canvas buffer and the surround stay. Returns the part
-~> in UI pixels ([0, 0, 0, 0] when nothing changed).
function view_paint_canvas_part(cl, was, now) {
  let cr = cl.crect
  g_canvas((cr[0], cr[1]))
  fb.unclip()
  let sc = scene_sync(cl)
  scene_render(sc)
  let off = cl.offset
  let d = tiles_union(was, now)
  let t = sc.tiles.box
  if (t !== null) {
    d = tiles_union(d, [t[0] + off.x, t[1] + off.y, t[2] + off.x, t[3] + off.y])
  }
  if (d !== null) {
    -~> whole UI pixels (2 x 2 blocks), inside the canvas buffer
    d = [math.max(0, math.floor(d[0] / 2) * 2), math.max(0, math.floor(d[1] / 2) * 2),
      math.min(cr[2] * 2, math.ceil(d[2] / 2) * 2), math.min(cr[3] * 2, math.ceil(d[3] / 2) * 2)]
  }
  if (d === null || d[2] <= d[0] || d[3] <= d[1]) {
    g_ui()
    return [0, 0, 0, 0]
  }
  let pos = (d[0], d[1])
  let size = (d[2] - d[0], d[3] - d[1])
  fb.clip(pos, size)
  fb.clear(pos, size)
  -~> the drawing's own clip, within the part
  let x0 = math.max(d[0], off.x)
  let y0 = math.max(d[1], off.y)
  let x1 = math.min(d[2], off.x + cl.sw)
  let y1 = math.min(d[3], off.y + cl.sh)
  if (x1 > x0 && y1 > y0) {
    fb.clip((x0, y0), (x1 - x0, y1 - y0))
    tiles_blit(sc.tiles, off)
    iso_paint(cl, off)
    if (ed.stale && len(ed.errors) > 0) {
      fb.fill(off, (cl.sw, cl.sh), P.veil)
    }
  }
  fb.clip(pos, size)
  view_paint_selection(cl)
  view_tools_paint_ui(cl)
  fb.unclip()
  fb.dirty(pos, size)
  g_ui()
  [cr[0] + d[0] // 2, cr[1] + d[1] // 2, (d[2] - d[0]) // 2, (d[3] - d[1]) // 2]
}
