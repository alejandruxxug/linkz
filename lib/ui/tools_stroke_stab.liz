-~> tools_stroke_stab: the stabilizer of the pencil and the brush on the
-~> canvas (stabilize.liz), applied live: every sample of the drag goes
-~> through it, and only what it lets out is kept and previewed, so the row
-~> written on release is the steadied line. The settings are the tool's
-~> (tool_stabilizer.liz), their length in screen pixels, which the drawing's
-~> zoom turns into drawing units. While the string is in use its tip,
-~> string and circle are drawn over the canvas.

use "editor_undo"
use "home_data"
use "i18n"
use "pen_edit"
use "stabilize"
use "stabilize_view"
use "view_gfx"
use "tool_stabilizer"
use "view_layout"
use "view_tools"

-~> The stabilizer of a new stroke for the current tool and pen.
function tools_stab_begin(g) {
  g.stab = tool_stab_get(tool_stab_key(g.tool, ed.pen))
  g.stab_state = stabilize_new()
  g.ticks = 0
  g.raw = []
  g.pressure_now = null
}

-~> The settings with the length in drawing units at a zoom.
function tools_stab_scaled(g, zoom) {
  {"mode": g.stab.mode, "length": g.stab.length / zoom, "catch_up": g.stab.catch_up}
}

-~> One sample of the drag: through the stabilizer, then kept (tools_stroke_add).
-~> A sample off the canvas is kept as it is (it is skipped on release).
function tools_stab_feed(g, cl, s) {
  if (pw.open) {
    pw.live_p = s.pressure
    pw.live_src = g.source
  }
  g.pressure_now = s.pressure
  if (g.stab != null && g.stab.mode == "string" && s.canvas_pos != null) {
    tools_stab_raw(g, cl, s.canvas_pos)
  }
  if (g.stab == null || g.stab.mode == "off" || s.canvas_pos == null) {
    return tools_stroke_add(g, cl, s)
  }
  let out = stabilize(g.stab_state, {"pos": s.canvas_pos, "ui": s.pos, "pressure": s.pressure, "t": s.t}, tools_stab_scaled(g, cl.zoom))
  for (let i = 0; i < len(out); i = i + 1) {
    tools_stroke_add(g, cl, {"pos": out[i].ui, "canvas_pos": out[i].pos, "pressure": out[i].pressure, "t": out[i].t})
  }
}

-~> Keeps a point of the raw cursor path (the dotted line of the string), not
-~> closer than 3 screen pixels to the last one.
function tools_stab_raw(g, cl, p) {
  let n = len(g.raw)
  if (n == 0 || math.dist(g.raw[n - 1], p) * cl.zoom >= 3) {
    push(g.raw, p)
  }
}

-~> The drag is over: with catch up, the tip runs to the cursor.
function tools_stab_finish(g, cl) {
  if (pw.open) {
    pw.live_p = null
    pw.live_src = null
  }
  if (g.stab == null || g.stab.mode == "off") {
    return null
  }
  let out = stabilize_end(g.stab_state, tools_stab_scaled(g, cl.zoom))
  for (let i = 0; i < len(out); i = i + 1) {
    tools_stroke_add(g, cl, {"pos": out[i].ui, "canvas_pos": out[i].pos, "pressure": out[i].pressure, "t": out[i].t})
  }
}

-~> The raw cursor path, the tip, the string, the circle and the cursor square
-~> of the stroke being drawn, in the canvas buffer, then its tooltip.
function tools_stab_paint(cl) {
  let g = V.live
  if (g == null || g.stab == null || g.stab.mode != "string" || g.stab_state == null || g.stab_state.tip == null) {
    return null
  }
  let st = g.stab_state
  let raw = []
  for (let i = 0; i < len(g.raw); i = i + 1) {
    push(raw, cl.offset + g.raw[i] * cl.zoom)
  }
  stab_paint_raw(raw)
  let cursor = cl.offset + st.cursor * cl.zoom
  stab_paint(cl.offset + st.tip * cl.zoom, cursor, g.stab.length)
  stab_paint_cursor(cursor)
  tools_stab_tip(cl, view_to_window(cl, st.cursor) / 2)
}

-~> "ink follows the string / release: catches up to the cursor", a tooltip
-~> 21 UI pixels above the cursor (below it near the top), kept in the canvas.
function tools_stab_tip(cl, at) {
  let a = t("stab.tip")
  let b = t("stab.tip_catch")
  let cr = cl.crect
  -~> in a narrow canvas the lines are cut to fit it
  let room = (cr[2] - 18) // 7
  a = home_fit(a, room)
  b = home_fit(b, room)
  let w = math.max(g_text_w(a), g_text_w(b)) + 14
  let x = math.max(cr[0] + 2, math.min(math.round(at.x - w / 2), cr[0] + cr[2] - w - 4))
  let y = math.round(at.y) - 57
  if (y < cr[1] + 2) {
    y = math.round(at.y) + 21
  }
  g_box(x, y, w, 36)
  g_text(a, x + 7, y + 4, P.text)
  g_text(b, x + 7, y + 19, P.mute)
}

-~> The status bar's `pressure 0.71` while a stroke is drawn with a pen or a
-~> trackpad (null otherwise): [icon, text, color], like the other parts.
function stab_pressure_part() {
  let g = V.live
  if (g == null || g.source == "mouse" || g.pressure_now == null) {
    return null
  }
  ["", t("stab.pressure") + " " + str(math.round(g.pressure_now * 100) / 100.0), "mute"]
}
