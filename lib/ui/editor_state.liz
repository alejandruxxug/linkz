-~> editor_state: what the user does, applied to the editor's state `ed`.
-~> Each function runs one of the pure model operations, keeps the undo
-~> history and marks the drawing to be run again. The view calls these.

use "doc_cache"
use "editor_create"
use "editor_doc"
use "editor_edit"
use "editor_props"
use "editor_rerun"
use "editor_rows"
use "editor_twoway"
use "editor_undo"
use "i18n"
use "perf"

-~> == Running the drawing ==


-~> A run that stopped at parse time lists every error the parser found, but the
-~> parser's recovery makes the later ones unreliable: a bad row can leave a
-~> valid one after it looking broken. The first error is real; each later one
-~> gets follow = true. A runtime error is always alone, so it is never marked.
function errors_mark_follow(errors) {
  let out = []
  for (let i = 0; i < len(errors); i = i + 1) {
    let e = errors[i]
    let later = i > 0 && text.find(e.message, "runtime error") != 0
    push(out, {"line": e.line, "column": e.column, "message": e.message, "follow": later})
  }
  out
}

-~> Runs the drawing. A run with errors keeps the last good shapes (ed.stale
-~> says they are old) and the errors go to their rows. When only one literal
-~> row changed, only that row runs (editor_rerun.liz) and ed.patch says which
-~> shape it replaced; ed.shapes_ver counts every new list of shapes.
function ed_run() {
  perf_begin("run")
  let r = ed_run_now()
  perf_end()
  r
}

function ed_run_now() {
  let m = ed_model()
  if (ed.ran != null && doc_same_text(ed.ran.model, m)) {
    return ed_run_same(m)
  }
  let patch = rerun_row(ed.ran, m)
  if (patch != null) {
    return ed_run_patch(m, patch)
  }
  patch = rerun_region(ed.ran, m)
  if (patch != null) {
    return ed_run_range(m, patch)
  }
  let r = src.run(doc_text(m))
  if (len(r.errors) == 0 && len(doc_parsed(m).errors) > 0) {
    -~> a spliced parse took the text for broken (see doc_splice.liz)
    doc_cache_rescan(m)
  }
  ed.runs = ed.runs + 1
  ed.errors = errors_mark_follow(r.errors)
  ed.printed = r.printed
  ed.stats = {"ms": r.ms, "steps": r.steps}
  ed.patch = null
  if (len(r.errors) == 0) {
    ed.shapes = r.shapes
    ed.shapes_rising = shapes_rising(r.shapes)
    ed.shapes_ver += 1
    ed.ran = {"model": m, "literal": null, "printed": r.printed}
    if (type(r.canvas) == "HASH" && type(r.canvas.size) == "POINT") {
      ed.canvas = r.canvas
    }
    ed.stale = false
  } else {
    -~> the shapes stay the last good ones, so ed.ran still says what made them
    ed.stale = true
  }
  ed.pending = false
  r
}

-~> The text is the one of the last good run again (an error typed and taken
-~> back): its shapes are the ones on the canvas, nothing runs.
function ed_run_same(m) {
  let printed = ed.ran.printed
  if (printed == null) {
    printed = ""
  }
  ed.ran = {"model": m, "literal": ed.ran.literal, "plain": ed.ran.plain, "printed": printed}
  ed.errors = []
  ed.printed = printed
  ed.stale = false
  ed.pending = false
  {"shapes": ed.shapes, "canvas": ed.canvas, "errors": [], "printed": printed, "ms": 0, "steps": 0, "rerun": true}
}

-~> Puts a patch's shape in place of the old one, like a run that made it.
function ed_run_patch(m, patch) {
  let shapes = list.copy(ed.shapes)
  shapes[patch.index] = patch.new
  ed.shapes = shapes
  -~> the new shape sits where the old one was, on the same line: the index stays right
  let kept = ed.shape_lines != null && ed.shape_lines.ver == ed.shapes_ver
  ed.shapes_ver += 1
  if (kept) {
    ed.shape_lines.ver = ed.shapes_ver
  }
  patch.ver = ed.shapes_ver
  ed.patch = patch
  ed.ran = {"model": m, "literal": true}
  ed.errors = []
  ed.printed = ""
  ed.stale = false
  ed.runs = ed.runs + 1
  ed.stats = {"ms": patch.ms, "steps": patch.steps}
  ed.pending = false
  {"shapes": ed.shapes, "canvas": ed.canvas, "errors": [], "printed": ed.printed, "ms": patch.ms,
   "steps": patch.steps, "rerun": true}
}

-~> Puts the shapes of a region run (rerun_region) in place of the old ones of
-~> those lines; the shapes after them are moved down by the lines the edit
-~> added or took away, where they are (no one keeps the old list).
function ed_run_range(m, patch) {
  let old = ed.shapes
  if (patch.delta != 0) {
    for (let i = patch.after; i < len(old); i += 1) {
      old[i].line += patch.delta
    }
  }
  ed.shapes = list.slice(old, 0, patch.start) + patch.added + list.slice(old, patch.after, len(old))
  ed.shapes_ver += 1
  patch.ver = ed.shapes_ver
  ed.patch = patch
  ed.ran = {"model": m, "literal": true, "plain": true}
  ed.errors = []
  ed.printed = ""
  ed.stale = false
  ed.runs = ed.runs + 1
  ed.stats = {"ms": patch.ms, "steps": patch.steps}
  ed.pending = false
  {"shapes": ed.shapes, "canvas": ed.canvas, "errors": [], "printed": ed.printed, "ms": patch.ms,
   "steps": patch.steps, "rerun": true}
}

-~> Whether every shape has a line and the lines never go down (one shape per
-~> row, top to bottom: the shapes of a literal drawing).
function shapes_rising(shapes) {
  for (let i = 0; i < len(shapes); i += 1) {
    if (type(shapes[i].line) != "INTEGER" || (i > 0 && shapes[i].line < shapes[i - 1].line)) {
      return false
    }
  }
  true
}

-~> Runs the drawing if it changed since the last run. The view calls this once
-~> per paint, so a burst of edits costs one run.
function ed_settle() {
  if (ed.pending) {
    ed_run()
  }
}

function ed_canvas_size() {
  ed.canvas.size
}

function ed_docs() {
  -~> cached per language: a language switch gets the new docs on the next call
  if (ed.docs == null || ed.docs_lang != lang_get()) {
    ed.docs = src.library_docs(lang_get())
    ed.docs_lang = lang_get()
  }
  ed.docs
}

-~> The rows of the layers panel, with the last run's errors and the folds.
function ed_rows() {
  doc_rows(ed_model(), ed.errors, ed.folded)
}

-~> Changes exactly when ed_rows() does.
function ed_rows_key() {
  doc_rows_key(ed_model(), ed.errors, ed.folded)
}

-~> The shapes to paint, back to front, without the hidden ones.
function ed_paint_shapes() {
  shapes_to_paint(ed.shapes, ed_rows())
}

-~> Where the shapes of each line are in ed.shapes: line -> [indexes], made
-~> once per list of shapes.
function ed_shape_lines() {
  if (ed.shape_lines == null || ed.shape_lines.ver != ed.shapes_ver) {
    let lines = {}
    for (let i = 0; i < len(ed.shapes); i += 1) {
      let l = ed.shapes[i].line
      if (type(l) == "INTEGER") {
        if (lines[l] == null) {
          lines[l] = []
        }
        push(lines[l], i)
      }
    }
    ed.shape_lines = {"ver": ed.shapes_ver, "lines": lines}
  }
  ed.shape_lines.lines
}

-~> The indexes in ed.shapes of the shapes made by the call on this line.
-~> When the lines rise through the list it is a binary search, else the
-~> index above.
function ed_shape_indexes(line) {
  if (!ed.shapes_rising) {
    let at = ed_shape_lines()[line]
    if (at == null) {
      return []
    }
    return at
  }
  let out = []
  let shapes = ed.shapes
  for (let i = rerun_first_at(shapes, line); i < len(shapes) && shapes[i].line == line; i += 1) {
    push(out, i)
  }
  out
}

-~> The shapes made by the call on this line.
function ed_shapes_of(line) {
  let out = []
  let at = ed_shape_indexes(line)
  for (let i = 0; i < len(at); i += 1) {
    push(out, ed.shapes[at[i]])
  }
  out
}

-~> The index in ed.shapes of the only shape made by `line`, or -1.
function ed_only_shape(line) {
  let at = ed_shape_indexes(line)
  if (len(at) != 1) {
    return -1
  }
  at[0]
}

-~> What the properties panel shows for the caret's row (or null).
function ed_props() {
  props_of(ed_model(), ed_model().line, ed_docs())
}

-~> == Files ==


function ed_new() {
  ed_reset("", "")
}

-~> Opens a file. False (with a status message) if it isn't there.
function ed_open(path) {
  if (!fs.exists(path)) {
    ed_refuse(t("status.no_file_at", {"file": path}))
    return false
  }
  ed_reset(fs.read(path), path)
  ed.status = t("status.opened", {"file": path})
  true
}

-~> Saves to path, or to the open file when path is null or "".
function ed_save(path) {
  let target = path
  if (target == null || target == "") {
    target = ed.file
  }
  if (target == "") {
    ed_refuse(t("status.no_path"))
    return false
  }
  let body = doc_text(ed_model())
  try {
    fs.write(target, body)
  } catch (e) {
    ed_refuse(t("status.save_failed", {"file": target}))
    return false
  }
  ed.file = target
  ed.saved = body
  ed.status = t("status.saved", {"file": target})
  true
}

-~> Replaces the whole text (one undo step).
function ed_set_code(code) {
  ed_label("set_code")
  ed_apply(doc_new(code), null)
}

-~> == Editing ==


function ed_word_char(ch) {
  text.find("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", ch) >= 0 || text.code(ch, 0) > 127
}

function ed_type(s) {
  ed_apply(ed_insert(ed_model(), s), "type")
  -~> a space or punctuation ends the word: the next typing is a new step
  let last = s[len(s) - 1]
  if (last != null && !ed_word_char(last)) {
    ed.merge = null
  }
}

function ed_move_caret(dir, extend) {
  ed_apply(ed_move(ed_model(), dir, extend), null)
}

function ed_set_caret(line, col) {
  ed_apply(doc_at(ed_model(), line, col), null)
}

function ed_select(n) {
  ed_apply(ed_select_row(ed_model(), n), null)
}

function ed_select_range(a, b) {
  ed_apply(ed_select_rows(ed_model(), a, b), null)
}

function ed_copy_rows() {
  ed_copy(ed_model())
}

-~> Folds or unfolds the layer (or block) on this row. Editor-only state.
function ed_toggle_fold(line) {
  let key = row_fold_key(ed_model(), line)
  if (key == null) {
    return false
  }
  ed.folded[key] = ed.folded[key] != true
  true
}

-~> == Creating and properties ==


function ed_add_shape(kind) {
  ed_try_as("add_shape", {"kind": kind}, add_shape(ed_model(), kind, ed_canvas_size()))
}

function ed_add_layer() {
  ed_try_as("add_layer", null, add_layer(ed_model()))
}

function ed_set_prop(name, value) {
  ed_try_as("prop", {"name": name}, set_prop(ed_model(), ed_model().line, name, value, ed_docs()))
}

function ed_set_layer_name(line, name) {
  ed_try_as("layer_name", null, set_layer_name(ed_model(), line, name))
}

function ed_set_hidden(line, on) {
  let key = "show"
  if (on) {
    key = "hide"
  }
  ed_try_as(key, null, set_row_hidden(ed_model(), line, on))
}

function ed_set_locked(line, on) {
  let key = "unlock"
  if (on) {
    key = "lock"
  }
  ed_try_as(key, null, set_row_locked(ed_model(), line, on))
}

-~> == The canvas editing the code ==


-~> Drag helpers: call ed_begin_gesture on mouse down and ed_end_gesture on
-~> mouse up; in between, each move calls one of these with absolute positions.
function ed_move_anchor(shape, anchor, pos) {
  ed_label("move_point")
  ed_try_at(move_anchor(ed_model(), shape, anchor, pos), null, shape.line)
}

function ed_move_shape(shape, delta) {
  ed_label("move_shape")
  ed_try_at(move_shape(ed_model(), shape, delta), null, shape.line)
}

function ed_insert_point(shape, pos) {
  ed_label("add_point")
  ed_try_at(insert_point_near(ed_model(), shape, pos), null, shape.line)
}

function ed_remove_point(shape, index) {
  ed_label("remove_point")
  ed_try_at(remove_point(ed_model(), shape, index), null, shape.line)
}

-~> The pencil's mouse-up: the recorded move samples become a `stroke` row in
-~> the layer on line `layer` (null: loose, at the top). One undo step.
function pencil_commit(samples, layer) {
  ed_try_as("stroke", null, pencil_insert(ed_model(), samples, layer, ed.color, ed.width))
}

-~> The brush's mouse-up: a `brush` row with the pen's name (such as "ink") and
-~> the pressures. source is the event's pen.source ("mouse", "trackpad", "tablet").
function brush_commit(samples, pen, source, layer) {
  ed_try_as("stroke", null, brush_insert(ed_model(), samples, pen, source, layer, ed.color))
}

-~> == Keyboard ==


-~> Handles a key event's name ("Backspace", "ArrowUp", "Z", ...) and mods
-~> ({"shift", "alt", "cmd", "ctrl"}). True when the editor used the key.
function ed_key(name, mods) {
  let k = text.lower(name)
  let shift = mods != null && mods.shift == true
  let alt = mods != null && mods.alt == true
  let cmd = mods != null && (mods.cmd == true || mods.ctrl == true)
  let m = ed_model()
  if (cmd) {
    if (k == "z" && shift) {
      return ed_redo()
    }
    if (k == "z") {
      return ed_undo()
    }
    if (k == "y") {
      return ed_redo()
    }
    if (k == "c") {
      ed_copy(m)
      return true
    }
    if (k == "x") {
      return ed_try_as("cut", null, ed_cut(m))
    }
    if (k == "v") {
      return ed_try_as("paste", null, ed_paste(m))
    }
    if (k == "s") {
      return ed_save("")
    }
    if (k == "a") {
      ed_apply(ed_select_rows(m, 1, len(m.lines)), null)
      return true
    }
    return false
  }
  if (k == "backspace") {
    ed_apply(ed_backspace(m), "backspace")
    return true
  }
  if (k == "delete") {
    ed_apply(ed_delete(m), "delete")
    return true
  }
  if (k == "enter" || k == "return") {
    ed_label("enter")
    if (shift) {
      ed_apply(ed_enter_above(m), null)
    } else {
      ed_apply(ed_enter(m), null)
    }
    return true
  }
  if (k == "tab") {
    ed_label("indent")
    if (shift) {
      ed_apply(ed_outdent(m), null)
    } else {
      ed_apply(ed_indent(m), null)
    }
    return true
  }
  let dir = text.replace(k, "arrow", "")
  if ((dir == "up" || dir == "down") && alt) {
    ed_label("move_rows")
    ed_apply(ed_move_rows(m, dir), null)
    return true
  }
  if (dir == "left" || dir == "right" || dir == "up" || dir == "down" || dir == "home" || dir == "end") {
    ed_apply(ed_move(m, dir, shift), null)
    return true
  }
  false
}
