-~> pen_props: the brush and pencil inspector, in the properties panel while
-~> one of the two tools is picked: the tool itself, not the selection (its
-~> fields come back with another tool; style guide R003 frame 4). Two rows:
-~>   1  the brush's pen and its gear ("PROPERTIES · brush · pens.ink"), then
-~>      the tool's hint, cut at a word; the pencil has its hint only
-~>   2  the stabilizer: Off / String / Average and its length (drag it
-~>      sideways like a number); a narrow panel shortens the label
-~> The context bar (artist mode) leaves the hint out. The gear opens the pen
-~> settings. The changes are the tool's settings for the session
-~> (tool_stabilizer.liz) and, while the pen settings are open on the same
-~> pen, its draft too.

use "../draw/pens"
use "editor_undo"
use "i18n"
use "mode_state"
use "pen_edit"
use "pen_library"
use "pen_route"
use "tool_stabilizer"
use "view_gfx"
use "view_layout"

-~> The stabilizer key of the tool now, or null when it is neither tool.
function pen_props_key() {
  if (V.tool != "brush" && V.tool != "pencil") {
    return null
  }
  tool_stab_key(V.tool, ed.pen)
}

-~> The panel's layout (view_props_layout_build's) as the tool's inspector
-~> while the brush or the pencil is picked.
function pen_props_wrap(lay) {
  let key = pen_props_key()
  if (key == null) {
    return lay
  }
  let gm = view_geom()
  let y = gm.props_y + 22
  let out = {
    "title": text.upper(t("panel.properties")) + " · " + text.lower(t(prefixed("tool.", V.tool))),
    "labels": [],
    "boxes": [],
    "msg": "",
    "hint": "",
    "props": null,
    "pen_strip": true
  }
  let x = 6
  if (V.tool == "brush") {
    out.title = out.title + " · pens." + ed.pen
    -~> the parameter's name, as the fields say it (the context bar translates it)
    push(out.labels, {"x": x, "y": y + 2, "s": "pen"})
    x = 34
    let txt = pen_display_name(pens[ed.pen])
    let w = g_text_w(txt) + 20
    push(out.boxes, {"field": "pen", "sub": 0, "kind": "pen", "x": x, "y": y, "w": w, "h": 18, "text": txt, "focus": V.picker})
    push(out.boxes, {"field": "pengear", "sub": 0, "kind": "pengear", "x": x + w + 4, "y": y + 2, "w": 14, "h": 14, "text": "", "focus": false})
    x = x + w + 24
  }
  if (!mode_artist()) {
    let hint = g_fit_words(t(prefixed("hint.", V.tool)), V.pw - x - 6)
    if (hint != "") {
      push(out.labels, {"x": x, "y": y + 2, "s": hint, "hint": true})
    }
  }
  out
}

-~> The stabilizer row of the inspector, under its first row. The panel keeps
-~> its two rows (props_extra 0) unless the row can't fit even shortened.
function pen_props_strip_wrap(lay) {
  let key = pen_props_key()
  lay.props_extra = 0
  if (key == null) {
    return lay
  }
  let gm = view_geom()
  let rows = pen_props_strip(lay, gm.props_y + 42, key)
  if (gm.artist != true) {
    lay.props_extra = 20 * math.max(0, rows - 1)
  }
  lay
}

-~> How wide the stabilizer row is with this label.
function pen_props_strip_w(label) {
  let w = 6 + g_text_w(label) + 6
  let modes = ["off", "string", "average"]
  for (let i = 0; i < len(modes); i = i + 1) {
    w = w + g_text_w(t(prefixed("stab.", modes[i]))) + 6
  }
  w + 6 + g_text_w("64 px") + 8
}

-~> The stabilizer row at y: its label, the three modes and the length. A
-~> panel too narrow for the label takes its short form; what still does
-~> not fit goes on a row under (20 px lower). Returns how many rows it took.
function pen_props_strip(lay, y, key) {
  let s = tool_stab_get(key)
  let label = t("stab.label")
  if (pen_props_strip_w(label) > V.pw - 4 && !mode_artist()) {
    label = t("stab.short")
  }
  let row = 0
  let x = 6
  push(lay.labels, {"x": x, "y": y + 1, "s": label})
  x = x + g_text_w(label) + 6
  let modes = ["off", "string", "average"]
  for (let i = 0; i < len(modes); i = i + 1) {
    let txt = t(prefixed("stab.", modes[i]))
    let w = g_text_w(txt) + 6
    if (x + w > V.pw - 4 && x > 6) {
      row = row + 1
      x = 6
    }
    push(lay.boxes, {"field": "stab", "sub": modes[i], "kind": "stabmode", "x": x, "y": y + 20 * row, "w": w, "h": 14, "text": txt, "focus": s.mode == modes[i]})
    x = x + w
  }
  let len_txt = str(math.round(s.length)) + " px"
  let w = g_text_w(len_txt) + 8
  x = x + 6
  if (x + w > V.pw - 4) {
    row = row + 1
    x = 6
  }
  push(lay.boxes, {"field": "stablen", "sub": 0, "kind": "stablen", "x": x, "y": y + 20 * row, "w": w, "h": 14, "text": len_txt, "focus": false})
  row + 1
}

-~> Paints a box of the inspector. True when it was one.
function pen_props_paint_box(b) {
  if (b.kind == "pengear") {
    let state = "normal"
    if (V.hover == "field:pengear:0") {
      state = "hover"
    }
    g_button(b.x, b.y, b.w, b.h, "settings", "", state)
    return true
  }
  if (b.kind == "stabmode") {
    let face = P.raised
    let tc = P.text
    if (b.focus) {
      face = P.moss
      tc = P.bright
    } elif (V.hover == "field:stab:" + b.sub) {
      face = P.bevel
    }
    g_frame(b.x, b.y, b.w, b.h, P.void)
    g_rect(b.x + 1, b.y + 1, b.w - 2, b.h - 2, face)
    g_text(b.text, b.x + 3, b.y, tc)
    return true
  }
  if (b.kind == "stablen") {
    g_text(b.text, b.x + 4, b.y, P.amber)
    return true
  }
  false
}

-~> Puts settings in the session and, when the pen settings show this pen, in its draft.
function pen_props_set(key, s) {
  tool_stab_set(key, s)
  if (pw.open && pw.key == key) {
    pw.draft.stabilizer = pw_stab_hash(s)
    pw_mark("stabilizer")
  }
  view_touch()
}

-~> A press on a box of the inspector. True when it was one.
function pen_props_press(b, e) {
  let key = pen_props_key()
  if (b.kind == "pengear") {
    pen_route_show(ed.pen)
    return true
  }
  if (key == null) {
    return false
  }
  if (b.kind == "stabmode") {
    let s = tool_stab_get(key)
    pen_props_set(key, {"mode": b.sub, "length": s.length, "catch_up": s.catch_up})
    return true
  }
  if (b.kind == "stablen") {
    V.drag = {"kind": "pen_props", "key": key, "x0": e.pos.x, "v0": tool_stab_get(key).length}
    return true
  }
  false
}

-~> Dragging the length sideways: a pixel a step.
function pen_props_drag(e) {
  let d = V.drag
  let s = tool_stab_get(d.key)
  let v = math.max(2, math.min(64, math.round(d.v0 + (e.pos.x - d.x0))))
  pen_props_set(d.key, {"mode": s.mode, "length": v, "catch_up": s.catch_up})
}
