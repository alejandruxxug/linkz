-~> doc_names: the names a document defines, kept in its cache: what the
-~> properties panel and the signature hint know about the drawing's own
-~> functions, and the suggestions autocomplete offers for them. A names hash:
-~>   funcs  name -> {"params", "param_docs", "summary", "example"}: the first
-~>          function with that name, searching layers, blocks and bodies too
-~>   items  the suggestion items for the functions, values and layers (first
-~>          definition of a name wins, see cmp_user_items)
-~>   seen   the names in items, as a hash name -> true
-~> The cache also keeps, per top-level statement, the part of the names it
-~> defines (names_part), so after an edit only the statements scanned again
-~> are looked at: the old names are kept when they define the same names as
-~> the ones they replaced, and else the names are put together again from
-~> the parts.

-~> The model's names, worked out once per text.
function doc_names(m) {
  let c = m.cache
  if (c.names == null) {
    let p = doc_parsed(m)
    perf_begin("complete")
    let sp = c.splice
    let fresh = null
    if (sp != null) {
      fresh = names_parts(list.slice(p.statements, sp.i0, sp.i0 + sp.count))
    }
    if (sp != null && sp.name_parts != null && len(sp.name_parts) == sp.n_old) {
      c.name_parts = list.slice(sp.name_parts, 0, sp.i0) + fresh +
        list.slice(sp.name_parts, sp.i0 + len(sp.old), len(sp.name_parts))
    } else {
      c.name_parts = names_parts(p.statements)
    }
    if (sp != null && sp.names != null && names_part(sp.old) == names_joined(fresh)) {
      c.names = sp.names
    } else {
      c.names = names_merge(c.name_parts)
    }
    doc_cache_tidy(c)
    perf_end()
  }
  c.names
}

function names_build(stmts) {
  names_merge(names_parts(stmts))
}

-~> The names part of each statement, in order.
function names_parts(stmts) {
  let out = []
  for (let i = 0; i < len(stmts); i += 1) {
    push(out, names_part([stmts[i]]))
  }
  out
}

-~> The parts one after another, as one part (what names_part of all their
-~> statements gives).
function names_joined(parts) {
  let fns = []
  let items = []
  for (let i = 0; i < len(parts); i += 1) {
    fns = fns + parts[i][0]
    items = items + parts[i][1]
  }
  [fns, items]
}

-~> The names hash from the parts: the first function and the first
-~> definition of every name win, in the order of the text.
function names_merge(parts) {
  let funcs = {}
  let seen = {}
  let items = []
  for (let i = 0; i < len(parts); i += 1) {
    let fns = parts[i][0]
    for (let k = 0; k < len(fns); k += 1) {
      if (funcs[fns[k][0]] == null) {
        funcs[fns[k][0]] = fns[k][1]
      }
    }
    let its = parts[i][1]
    for (let k = 0; k < len(its); k += 1) {
      if (seen[its[k].name] == null) {
        seen[its[k].name] = true
        push(items, its[k])
      }
    }
  }
  {"funcs": funcs, "items": items, "seen": seen}
}

-~> What a function statement tells about itself.
function names_info(f) {
  {"params": f.params, "param_docs": f.doc.params, "summary": f.doc.summary, "example": f.doc.example}
}

-~> Records the first function of every name, in the order the text has them.
function names_funcs(stmts, funcs) {
  for (let i = 0; i < len(stmts); i = i + 1) {
    let s = stmts[i]
    if (s.kind == "function" && funcs[s.name] == null) {
      funcs[s.name] = names_info(s)
    }
    names_funcs(s.children, funcs)
  }
}

-~> Everything some statements define, in order and with repeats: two lists of
-~> statements with the same part define the same names the same way.
function names_part(stmts) {
  let fns = []
  names_all_funcs(stmts, fns)
  return [fns, cmp_user_items(stmts, [], {})]
}

function names_all_funcs(stmts, out) {
  for (let i = 0; i < len(stmts); i = i + 1) {
    let s = stmts[i]
    if (s.kind == "function") {
      push(out, [s.name, names_info(s)])
    }
    names_all_funcs(s.children, out)
  }
}
