-~> fill_model: a shape's fill (or stroke color) as something the fill editor
-~> can change, and back to the code it writes. Pure functions: they take
-~> values and texts and return new ones; nothing here touches `ed`.
-~>
-~> A fill is a hash:
-~>   kind     "solid", "linear" or "radial"
-~>   color    the color (solid)
-~>   stops    [{"t", "color", "hard"}], in order (linear and radial)
-~>   steps    0 for smooth, or 2 to 16 flat bands
-~>   angle    the direction of a linear gradient, in degrees (0 = left to right)
-~>   center   a radial gradient's middle, as fractions of the shape's box
-~>   r        a radial gradient's reach, as a fraction of the box's larger side
-~>   pinned   null for a gradient that fits each shape (gradient(), radial_gradient()),
-~>            else its numbers in the drawing: {"from", "to"} or {"center", "r"}
-~>
-~> What it writes is what lib/draw reads: a color literal, gradient(stops, angle,
-~> steps), radial_gradient(stops, center, r, steps), or the pinned linear(from,
-~> to, stops, steps) and radial(center, r, stops, steps). A stop is a color
-~> (when it sits where an even spread puts it), hard(color), or [t, color] and
-~> [t, color, "hard"] anywhere else.

use "../draw/gradient"
use "editor_doc"
use "editor_props"
use "view_code"

-~> The most bands the editor offers (lib/draw takes up to 64).
let fill_max_steps = 16

-~> The words a fill literal may use: anything else makes it code.
let fill_words = ["gradient", "radial_gradient", "linear", "radial", "hard", "deg", "turn", "rad"]

-~> == Reading ==

-~> The field of the paint a call row has, or null: `which` is "fill" for the
-~> inside of a shape, "stroke" for the color of a line or a curve.
function fill_field(m, line, docs, which) {
  let props = props_of(m, line, docs)
  if (props == null || props.kind != "call") {
    return null
  }
  let name = "fill"
  if (which == "stroke") {
    name = "color"
  }
  let f = props_field_named(props, name)
  if (f == null || f.missing) {
    return null
  }
  f
}

-~> Whether the code of a fill is a literal the editor may rewrite: a color, or
-~> one of the gradient calls with only numbers, colors and "hard" in it.
function fill_is_literal(s) {
  let toks = code_tokens(text.trim(s))
  if (len(toks) == 0) {
    return false
  }
  let src = text.trim(s)
  for (let i = 0; i < len(toks); i = i + 1) {
    let k = toks[i][0]
    let word = text.slice(src, toks[i][1], toks[i][2])
    if (k == "word" && list.index(fill_words, word) < 0) {
      return false
    }
    if (k == "string" && word != "\"hard\"") {
      return false
    }
    if (k == "comment") {
      return false
    }
  }
  true
}

-~> The degrees of an angle in radians, whole.
function fill_degrees(rad) {
  let d = math.round(rad * 180 / math.pi) % 360
  if (d < 0) {
    d = d + 360
  }
  d
}

-~> The stops of a gradient value ([[t, color], ...], each hard stop written as
-~> two at the same t) as the editor's stops: the second of a pair is hard.
function fill_stops_of(list_in) {
  let out = []
  for (let i = 0; i < len(list_in); i = i + 1) {
    let t = list_in[i][0]
    let c = list_in[i][1]
    let n = len(out)
    if (n > 0 && out[n - 1].t == t) {
      -~> hard(c) is written as [t, the color before] then [t, c]: the first
      -~> of the two only repeats the stop before it
      if (n >= 2 && out[n - 2].color == out[n - 1].color) {
        pop(out)
      }
      push(out, {"t": t, "color": c, "hard": true})
    } else {
      push(out, {"t": t, "color": c, "hard": false})
    }
  }
  out
}

-~> The editor's fill for a paint value (a color or a gradient), or null.
function fill_from_value(v) {
  if (type(v) == "COLOR") {
    return {"kind": "solid", "color": v, "stops": [], "steps": 0, "angle": 90, "center": (0.5, 0.5), "r": 0.5, "pinned": null}
  }
  if (!is_gradient(v)) {
    return null
  }
  let f = {
    "kind": v.kind,
    "color": v.stops[0][1],
    "stops": fill_stops_of(v.stops),
    "steps": v.steps,
    "angle": 90,
    "center": (0.5, 0.5),
    "r": 0.5,
    "pinned": null
  }
  if (v.relative === true) {
    if (v.kind == "linear") {
      f.angle = fill_degrees(v.angle)
    } else {
      f.center = v.center
      f.r = v.r
    }
  } elif (v.kind == "linear") {
    f.pinned = {"from": v.from, "to": v.to}
    f.angle = fill_degrees(math.atan2(v.to.y - v.from.y, v.to.x - v.from.x))
  } else {
    f.pinned = {"center": v.center, "r": v.r}
  }
  f
}

-~> == Writing ==

-~> A number as short as it can be written: whole, else up to 3 decimals.
function fill_num(v) {
  let r = math.round(v * 1000) / 1000.0
  if (r == math.round(r)) {
    return str(int(math.round(r)))
  }
  str(r)
}

function fill_point(p) {
  "(" + fill_num(p.x) + ", " + fill_num(p.y) + ")"
}

-~> One stop as lizard code, for stop i of n.
function fill_stop_code(s, i, n) {
  let even = math.abs(s.t - i / (n - 1.0)) < 0.0005
  let c = str(s.color)
  if (even) {
    if (s.hard && i > 0) {
      return "hard(" + c + ")"
    }
    return c
  }
  if (s.hard && i > 0) {
    return "[" + fill_num(s.t) + ", " + c + ", \"hard\"]"
  }
  "[" + fill_num(s.t) + ", " + c + "]"
}

function fill_stops_code(stops) {
  let parts = []
  for (let i = 0; i < len(stops); i = i + 1) {
    push(parts, fill_stop_code(stops[i], i, len(stops)))
  }
  "[" + text.join(parts, ", ") + "]"
}

-~> The code of a fill: what goes where the fill argument is.
function fill_literal(f) {
  if (f.kind == "solid") {
    return str(f.color)
  }
  let st = fill_stops_code(f.stops)
  let steps = ""
  if (f.steps >= 2) {
    steps = ", " + str(f.steps)
  }
  if (f.pinned != null) {
    if (f.kind == "linear") {
      return "linear(" + fill_point(f.pinned.from) + ", " + fill_point(f.pinned.to) + ", " + st + steps + ")"
    }
    return "radial(" + fill_point(f.pinned.center) + ", " + fill_num(f.pinned.r) + ", " + st + steps + ")"
  }
  if (f.kind == "linear") {
    return "gradient(" + st + ", " + str(f.angle) + "deg" + steps + ")"
  }
  let place = ""
  if (f.steps >= 2 || f.center.x != 0.5 || f.center.y != 0.5 || f.r != 0.5) {
    place = ", " + fill_point(f.center) + ", " + fill_num(f.r)
  }
  "radial_gradient(" + st + place + steps + ")"
}

-~> == Changing ==

function fill_copy(f) {
  let out = hash_copy(f)
  let st = []
  for (let i = 0; i < len(f.stops); i = i + 1) {
    push(st, {"t": f.stops[i].t, "color": f.stops[i].color, "hard": f.stops[i].hard})
  }
  out.stops = st
  out
}

-~> A color between a and b (f from 0 to 1), alpha too.
function fill_mix(a, b, f) {
  rgba(math.round(a.r + (b.r - a.r) * f), math.round(a.g + (b.g - a.g) * f), math.round(a.b + (b.b - a.b) * f),
    math.round(a.a + (b.a - a.a) * f))
}

-~> The color the stops give at t (a hard stop has no blend into it).
function fill_color_at(stops, t) {
  if (len(stops) == 0) {
    return #000000
  }
  if (t <= stops[0].t) {
    return stops[0].color
  }
  for (let i = 1; i < len(stops); i = i + 1) {
    let a = stops[i - 1]
    let b = stops[i]
    if (t < b.t) {
      if (b.hard || b.t <= a.t) {
        return a.color
      }
      return fill_mix(a.color, b.color, (t - a.t) / (b.t - a.t))
    }
  }
  stops[len(stops) - 1].color
}

-~> The same fill as another kind. A solid color becomes a gradient from it to
-~> a lighter one; a gradient becomes the color of its first stop.
function fill_as_kind(f, kind) {
  let out = fill_copy(f)
  if (kind == f.kind) {
    return out
  }
  out.kind = kind
  out.pinned = null
  if (kind == "solid") {
    out.color = f.stops[0].color
    out.stops = []
    out.steps = 0
    return out
  }
  if (f.kind == "solid") {
    out.stops = [{"t": 0, "color": f.color, "hard": false}, {"t": 1, "color": fill_mix(f.color, #ffffff, 0.6), "hard": false}]
  }
  out
}

-~> Puts the stops in order of t; returns where stop `keep` went.
function fill_sort(f, keep) {
  let mark = f.stops[keep]
  f.stops = list.sort(f.stops, function(a, b) { a.t < b.t })
  for (let i = 0; i < len(f.stops); i = i + 1) {
    if (f.stops[i] === mark) {
      return i
    }
  }
  keep
}

-~> A new stop at t with the color already there: [fill, its index].
function fill_add_stop(f, t) {
  let out = fill_copy(f)
  let s = {"t": fill_round_t(t), "color": fill_color_at(f.stops, t), "hard": false}
  push(out.stops, s)
  let at = fill_sort(out, len(out.stops) - 1)
  [out, at]
}

-~> Without stop i; a gradient keeps at least two.
function fill_remove_stop(f, i) {
  if (len(f.stops) <= 2 || i < 0 || i >= len(f.stops)) {
    return null
  }
  let out = fill_copy(f)
  list.remove(out.stops, i)
  out
}

-~> A place on the bar, rounded to whole percents.
function fill_round_t(t) {
  math.round(math.max(0.0, math.min(1.0, t)) * 100) / 100.0
}

-~> Stop i moved to t: [fill, its new index].
function fill_move_stop(f, i, t) {
  let out = fill_copy(f)
  out.stops[i].t = fill_round_t(t)
  let at = fill_sort(out, i)
  [out, at]
}

function fill_set_stop(f, i, key, value) {
  let out = fill_copy(f)
  out.stops[i][key] = value
  out
}

-~> With `n` flat bands (0 or 1 for smooth), kept from 2 to fill_max_steps.
function fill_set_steps(f, n) {
  let out = fill_copy(f)
  if (n < 2) {
    out.steps = 0
  } else {
    out.steps = math.min(fill_max_steps, n)
  }
  out
}

-~> The next number of bands for − (dir -1) and + (dir 1): off, 2, 3, ... 16.
function fill_step_next(steps, dir) {
  if (dir > 0) {
    if (steps < 2) {
      return 2
    }
    return math.min(fill_max_steps, steps + 1)
  }
  if (steps <= 2) {
    return 0
  }
  steps - 1
}

-~> == Where it sits on a shape ==

-~> The pinned numbers of a fill on a box ({"min", "max"}, drawing pixels): the
-~> two ends of a linear one ({"from", "to"}) or the middle and the reach of
-~> a radial one ({"center", "r"}), worked out like lib/draw does.
function fill_geometry(f, box) {
  if (f.pinned != null) {
    return f.pinned
  }
  let g = null
  if (f.kind == "linear") {
    g = resolve_gradient({"kind": "linear", "angle": f.angle * math.pi / 180, "stops": [[0, #000000], [1, #000000]], "steps": 0}, box)
    return {"from": g.from, "to": g.to}
  }
  g = resolve_gradient({"kind": "radial", "center": f.center, "r": f.r, "stops": [[0, #000000], [1, #000000]], "steps": 0}, box)
  {"center": g.center, "r": g.r}
}

-~> The fill with one of its canvas handles dragged to p (drawing pixels):
-~> "from" or "to" of a linear one, "center" or "radius" of a radial one. A
-~> fitted gradient keeps fitting: its angle, center and r change instead.
-~> `snap` keeps the angle to steps of 15 degrees.
function fill_drag_handle(f, box, handle, p, snap) {
  let out = fill_copy(f)
  let w = float(math.max(1, box.max.x - box.min.x))
  let h = float(math.max(1, box.max.y - box.min.y))
  let mid = ((box.min.x + box.max.x) / 2.0, (box.min.y + box.max.y) / 2.0)
  if (f.kind == "linear") {
    if (f.pinned != null) {
      let pin = {"from": f.pinned.from, "to": f.pinned.to}
      pin[handle] = (math.round(p.x), math.round(p.y))
      if (pin.from.x == pin.to.x && pin.from.y == pin.to.y) {
        return f
      }
      out.pinned = pin
      out.angle = fill_degrees(math.atan2(pin.to.y - pin.from.y, pin.to.x - pin.from.x))
      return out
    }
    let d = p - mid
    if (handle == "from") {
      d = mid - p
    }
    if (math.abs(d.x) < 0.5 && math.abs(d.y) < 0.5) {
      return f
    }
    let deg = fill_degrees(math.atan2(d.y, d.x))
    if (snap) {
      deg = (math.round(deg / 15.0) * 15) % 360
    }
    out.angle = deg
    return out
  }
  if (f.pinned != null) {
    let pin = {"center": f.pinned.center, "r": f.pinned.r}
    if (handle == "center") {
      pin.center = (math.round(p.x), math.round(p.y))
    } else {
      pin.r = math.max(1, math.round(math.dist(p, pin.center)))
    }
    out.pinned = pin
    return out
  }
  if (handle == "center") {
    out.center = (math.round((p.x - box.min.x) / w * 100) / 100.0, math.round((p.y - box.min.y) / h * 100) / 100.0)
  } else {
    let c = (box.min.x + f.center.x * w, box.min.y + f.center.y * h)
    out.r = math.max(0.01, math.round(math.dist(p, c) / math.max(w, h) * 100) / 100.0)
  }
  out
}
