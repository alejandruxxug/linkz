-~> == Painting ==

function view_hover_is(prefixes) {
  let k = text.split(V.hover, ":")[0]
  if (list.index(prefixes, k) >= 0) {
    return V.hover
  }
  ""
}

-~> What a panel shows, as a text: when it changes the panel is painted again.
function view_panel_key(name) {
  let common = str(V.w) + "x" + str(V.h) + "|" + str(V.pw) + "|" + lang_get() + "|"
  if (art_owns_panel(name)) {
    return art_panel_key(name)
  }
  if (name == "toolbar") {
    let press = ""
    if (V.drag != null && V.drag.kind == "press") {
      press = V.drag.id
    }
    return common + str(len(ed.undo) > 0) + str(len(ed.redo) > 0) + V.tool + "|" + view_hover_is(["tool", "bar", "mode"]) + "|" + str(V.picker) + "|" + str(view_has_home()) + "|" + press + "|" + str(V.overflow) + art_bar_key()
  }
  if (name == "tabs") {
    return common + view_file_name() + "|" + str(ed_dirty()) + "|" + view_hover_is(["tab", "tool", "bar", "mode"]) + "|" + str(V.overflow) + art_bar_key()
  }
  if (name == "rows") {
    return common + str(V.ver) + "|" + str(V.top) + "|" + str(V.left) + "|" + view_hover_is(["row", "eye", "lock", "fold", "callee", "add", "strip", "dr"]) + "|" + str(V.focus != null) + "|" + route_rows_key() + art_bar_key()
  }
  if (name == "props") {
    return common + str(V.ver) + "|" + str(V.focus) + "|" + view_hover_is(["field"]) + "|" + str(V.picker) + "|" + str(V.hover_anchor)
  }
  if (name == "status") {
    return common + str(V.ver) + "|" + str(V.mouse_draw) + "|" + V.pen_note + "|" + V.tool + "|" + str(ed_note_active()) + "|" + str(view_canvas_layout().zoom)
  }
  if (name == "palette") {
    return common + color_panel_key()
  }
  view_canvas_key()
}

-~> Paints a panel; `forced` when it must be painted whole. Returns the part
-~> that changed (UI pixels), or null for all of it (only the canvas tells).
function view_panel_paint(name, forced) {
  if (art_owns_panel(name)) {
    art_panel_paint(name)
  } elif (name == "toolbar") {
    view_paint_toolbar()
  } elif (name == "tabs") {
    view_paint_tabs()
  } elif (name == "rows") {
    view_paint_rows()
  } elif (name == "props") {
    view_paint_props()
  } elif (name == "status") {
    view_paint_status()
  } elif (name == "palette") {
    color_panel_paint()
  } else {
    return view_paint_canvas(forced)
  }
  null
}

-~> Shows the tooltip once the pointer has rested long enough.
function view_tick() {
  if (ed_note_active()) {
    app.needs_paint = true
  }
  if (V.tip_due > 0) {
    if (time.ms() >= V.tip_due) {
      V.tip_due = 0
      if (V.dialog == null) {
        V.tip = tip_for(V.hover)
      }
    } else {
      app.needs_paint = true
    }
  }
  lc_tick()
}

function view_paint() {
  let t0 = time.ms()
  view_tick()
  tr_editor_frame()
  view_prepare()
  budget_editor_note()
  tut_frame()
  V.cl = view_canvas_layout()
  V.anchor_tip = tip_anchor(V.cl)
  let now = popup_list()
  let shape_key = popup_shape_key(now)
  if (shape_key != V.popup_shape) {
    let old = V.popup_rects
    if (old != null) {
      for (let i = 0; i < len(old); i = i + 1) {
        view_force_rect(old[i][1])
      }
    }
    V.popup_rects = now
    V.popup_shape = shape_key
  }
  let panels = view_panel_rects()
  let names = view_panel_names()
  let painted = false
  let parts = []
  for (let i = 0; i < len(names); i = i + 1) {
    let name = names[i]
    let key = view_panel_key(name)
    if (V.force[name] == true || V.keys[name] != key) {
      let r = panels[name]
      g_ui()
      fb.unclip()
      g_clip(r[0], r[1], r[2], r[3])
      let part = view_panel_paint(name, V.force[name] == true)
      g_ui()
      fb.unclip()
      if (part != null) {
        r = part
      }
      if (r[2] > 0 && r[3] > 0) {
        g_dirty(r[0], r[1], r[2], r[3])
        push(parts, [name, r, part != null])
      }
      V.keys[name] = key
      painted = true
    }
  }
  V.force = {}
  tut_overlay(parts)
  let pk = popup_content_key()
  if (painted || pk != V.popup_content) {
    V.popup_content = pk
    if (len(now) > 0) {
      popup_paint()
      for (let i = 0; i < len(now); i = i + 1) {
        let r = now[i][1]
        g_dirty(r[0], r[1], r[2], r[3])
      }
    }
  }
  g_ui()
  fb.unclip()
  tr_after_paint()
  V.paints = V.paints + 1
  V.painted_ms = time.ms() - t0
  if (V.tip_due == 0 && LC.hide_due == 0 && !ed_note_active() && !route_wants_tick() && !tr_wants_paint() && !zoom_busy()) {
    app.needs_paint = false
  }
}

-~> The code panel's width for a window: 320 up to 840 wide, then 38% of it up
-~> to 560, so a big window gets a bigger code panel and a bigger drawing; a
-~> small one gives the panel 5/8. Until the user drags the split it follows the
-~> window; after that it only stays inside the limits.
function view_auto_split(w) {
  if (w < 480) {
    return w * 5 // 8
  }
  math.min(560, math.max(320, w * 38 // 100))
}

function view_fit_split() {
  if (mode_artist()) {
    -~> the drawer is as wide as the canvas column (view_geom sets it)
    view_geom()
    return null
  }
  let lo = math.min(160, V.w * 5 // 8)
  if (V.pw_user) {
    V.pw = math.max(lo, math.min(V.pw, V.w - 120 - color_reserved()))
  } else {
    V.pw = math.max(lo, math.min(color_split(view_auto_split(V.w)), V.w - 120 - color_reserved()))
  }
}

-~> == Events and start ==

-~> A refusal belongs to the action that caused it: the next click or key (or
-~> backdoor command) starts clean.
function view_clear_refusal() {
  if (ed.refusal != null) {
    if (ed.status == ed.refusal.message) {
      ed.status = ""
    }
    ed.refusal = null
    V.flash = 0
    app.needs_paint = true
  }
}

function view_event(e) {
  let ty = e.type
  iso_note(e)
  if (iso_is_alt_key(e)) {
    -~> Alt on its own only changes the isolation: it keeps the card open
    return null
  }
  if (ty == "keyup") {
    -~> Space let go ends the pan key, whatever is open
    if (text.lower(e.key) == "space") {
      canvas_space_up()
    }
    return null
  }
  if (ty == "chosen" && export_chosen(e)) {
    -~> the answer of the Export PNG save dialog (the trace picker's is "open")
    return null
  }
  if (tr_is_open() && ty != "resize") {
    -~> the Trace image dialog is modal: it gets every event
    tr_editor_event(e)
    return null
  }
  if (ty == "drop") {
    view_drop(e)
    return null
  }
  if (ty == "down" || ty == "key") {
    view_clear_refusal()
  }
  if (ty == "resize") {
    V.w = e.size.x
    V.h = e.size.y
    view_fit_split()
    view_touch()
    view_force_all()
    if (tr_is_open()) {
      tr_editor_event(e)
    }
  } elif (ty == "down") {
    if (e.button == 2) {
      canvas_middle_down(e)
    } elif (e.button == 1 || (e.button == 0 && e.mods != null && e.mods.ctrl == true)) {
      shape_context(e)
    } elif (e.button == 0) {
      view_down(e)
    }
  } elif (ty == "up") {
    if (e.button == 0) {
      view_up(e)
    } elif (e.button == 2) {
      canvas_pan_end()
    }
  } elif (ty == "move") {
    view_move(e)
  } elif (ty == "wheel") {
    view_wheel(e)
  } elif (ty == "pinch") {
    if (V.dialog == null && !V.picker) {
      canvas_pinch(e)
    }
  } elif (ty == "key") {
    view_key(e)
  } elif (ty == "text") {
    view_text(e)
  } elif (ty == "leave" || (ty == "focus" && !e.focused)) {
    view_cursor_gone()
  }
}

-~> Files dropped on the editor: a PNG or JPEG opens the Trace image dialog
-~> with it, a .lzdraw opens as the drawing (after the unsaved-changes
-~> question), anything else is said in the status bar.
function view_drop(e) {
  let pick = drop_pick(e.paths)
  if (pick == null) {
    return null
  }
  if (pick.kind == "image") {
    tr_editor_open()
    T.d.text = pick.path
    tr_apply_path()
    tr_editor_changed()
  } elif (pick.kind == "drawing") {
    let path = pick.path
    view_confirm(function() { show_screen("editor", {"path": path}) })
  } else {
    ed.status = t("drop.cant_open", {"file": trace_base(pick.path)})
  }
  app.needs_paint = true
}

-~> The pointer left the window (or the window lost focus): the mouse readout
-~> in the status bar goes away until the next move.
function view_cursor_gone() {
  lc_leave()
  canvas_space_up()
  if (V.mouse_draw != null) {
    V.mouse_draw = null
    app.needs_paint = true
  }
}

-~> Opens the editor screen. args: null keeps what is open; {"path": p} opens that
-~> file (a new drawing for a path that is not there yet, or ""); {"new": true} starts
-~> an empty drawing.
function view_enter(args) {
  let sz = fb.size()
  V.w = sz.x
  V.h = sz.y
  view_fit_split()
  if (args != null && args.path != null) {
    if (args.path != "" && fs.exists(args.path)) {
      ed_open(args.path)
      home_note_opened(args.path)
    } else {
      ed_reset("", args.path)
    }
    V.top = 0
    V.focus = null
    V.tool = ""
    V.picker = false
    canvas_zoom_reset()
  } elif (args != null && args.new == true) {
    canvas_zoom_reset()
    ed_reset("", "")
    V.top = 0
    V.focus = null
  }
  if (args == null) {
    V.top = 0
    V.focus = null
  }
  V.keys = {}
  art_enter()
  V.popup_shape = null
  V.popup_rects = null
  V.tip = null
  V.hover = ""
  ed.pending = true
  pen_lib_load()
  view_touch()
  view_force_all()
  tut_enter()
}

-~> == The backdoor ==

function view_rect_hash(r) {
  {"x": r[0], "y": r[1], "w": r[2], "h": r[3]}
}

-~> The editor's state plus where things are on screen.
function view_debug_state() {
  view_prepare()
  let st = editor_debug_state()
  let gm = view_geom()
  let rows = []
  let vis = view_visible()
  for (let i = 0; i < len(vis); i = i + 1) {
    let it = vis[i].item
    push(rows, {"item": it.t, "line": it.line, "kind": it.row.kind, "x": 0, "y": vis[i].y, "w": gm.pw, "h": it.h})
  }
  let fields = []
  let lay = view_props_cached()
  for (let i = 0; i < len(lay.boxes); i = i + 1) {
    let b = lay.boxes[i]
    push(fields, {
      "name": b.field,
      "sub": b.sub,
      "kind": b.kind,
      "text": b.text,
      "focus": b.focus,
      "x": b.x,
      "y": b.y,
      "w": b.w,
      "h": b.h
    })
  }
  let tools = []
  let bs = view_toolbar()
  for (let i = 0; i < len(bs); i = i + 1) {
    push(tools, {"id": bs[i].group + ":" + bs[i].id, "x": bs[i].x, "y": bs[i].y, "w": bs[i].w, "h": bs[i].h})
  }
  for (let i = 0; i < len(vis); i = i + 1) {
    if (vis[i].item.t == "strip") {
      let ss = view_strip(vis[i].y, vis[i].item.depth)
      for (let k = 0; k < len(ss); k = k + 1) {
        push(tools, {"id": "strip:" + ss[k].id, "x": ss[k].x, "y": ss[k].y, "w": ss[k].w, "h": ss[k].h})
      }
    }
  }
  let cl = view_canvas_layout()
  let tip = null
  if (V.tip != null) {
    tip = {"x": V.tip.x, "y": V.tip.y, "w": V.tip.w, "h": V.tip.h, "key": V.tip.key}
  }
  let focus = null
  if (V.focus != null) {
    focus = {"field": V.focus.field, "sub": V.focus.sub, "text": V.focus.text, "caret": V.focus.caret}
  }
  st.view = {
    "size": (V.w, V.h),
    "split": V.pw,
    "top": V.top,
    "rows": rows,
    "fields": fields,
    "tools": tools,
    "props_title": lay.title,
    "props_msg": lay.msg,
    "canvas": {
      "area": view_rect_hash([gm.cx, gm.cy, gm.cw, gm.ch]),
      "drawing": view_rect_hash(cl.frame),
      "zoom": cl.zoom,
      "buffer": view_rect_hash(cl.crect)
    },
    "tool": V.tool,
    "picker": V.picker,
    "hover": V.hover,
    "tip": tip,
    "focus": focus,
    "dialog": V.dialog != null,
    "pen": ed.pen,
    "pen_window": pen_route_debug(),
    "artist": art_debug(),
    "tutorial": tut_debug(),
    "paint_ms": V.painted_ms,
    "paints": V.paints
  }
  st
}

-~> Clicks the middle of a row of code (scrolling it into view first).
function view_click_row_cmd(line) {
  view_prepare()
  view_reveal(line)
  let vis = view_visible()
  for (let i = 0; i < len(vis); i = i + 1) {
    if (vis[i].item.t == "row" && vis[i].item.line == line) {
      let r = vis[i].item.row
      let x = view_code_x(r) + 2
      view_event({"type": "down", "button": 0, "pos": (x, vis[i].y + 9), "mods": {"shift": false, "alt": false, "cmd": false, "ctrl": false}})
      view_event({"type": "up", "button": 0, "pos": (x, vis[i].y + 9), "mods": {"shift": false, "alt": false, "cmd": false, "ctrl": false}})
      return true
    }
  }
  false
}

function view_commands() {
  let own = editor_debug_commands()
  let cmds = {}
  let names = keys(own)
  for (let i = 0; i < len(names); i = i + 1) {
    let name = names[i]
    let fn = own[name]
    cmds[name] = function(args) {
      view_clear_refusal()
      view_commit_focus()
      let r = fn(args)
      if (name == "Open" || name == "SetCode") {
        V.top = 0
        V.folded_seen = null
      }
      -~> opening a file from the Home screen shows it
      if (name == "Open" && r.ok == true && screen_state.current != "editor") {
        show_screen("editor", null)
      }
      view_prepare()
      view_after()
      if (name == "Language") {
        view_force_all()
      }
      r
    }
  }
  cmds["Undo"] = function(_args) {
    {"ok": view_undo(), "text": ed_undo_text(), "status": ed.note}
  }
  cmds["Redo"] = function(_args) {
    {"ok": view_redo(), "text": ed_redo_text(), "status": ed.note}
  }
  cmds["Tool"] = function(args) {
    let name = ""
    if (len(args) > 0) {
      name = str(args[0])
    }
    if (name == "" || list.index(view_tool_ids, name) < 0) {
      return {"ok": false, "error": "unknown tool: " + name, "tool": V.tool}
    }
    view_clear_refusal()
    view_commit_focus()
    view_prepare()
    view_press("tool:" + str(args[0]))
    view_prepare()
    {"ok": true, "tool": V.tool, "status": ed.status}
  }
  cmds["ClickRow"] = function(args) {
    {"ok": view_click_row_cmd(args[0])}
  }
  cmds["Export"] = function(_args) {
    {"ok": view_export(), "status": ed.status, "path": view_png_path()}
  }
  cmds["Hover"] = function(args) {
    view_prepare()
    V.mouse = point(args[0], args[1])
    view_update_hover(V.mouse)
    V.tip_due = 0
    V.tip = null
    if (view_tippable(V.hover)) {
      V.tip = tip_for(V.hover)
    }
    app.needs_paint = true
    let lines = null
    if (V.tip != null) {
      lines = len(V.tip.lines)
    }
    {"hover": V.hover, "tip_lines": lines}
  }
  cmds["Home"] = function(_args) {
    view_go_home()
    {"ok": view_has_home()}
  }
  cmds["Confirm"] = function(args) {
    view_dialog_choose(str(args[0]))
    {"ok": true}
  }
  cmds["Pen"] = function(args) {
    view_choose_pen(str(args[0]))
    {"ok": true, "pen": ed.pen}
  }
  cmds["Picker"] = function(_args) {
    V.picker = !V.picker
    view_touch()
    {"ok": true, "picker": V.picker}
  }
  cmds["Focus"] = function(args) {
    view_prepare()
    let lay = view_props_layout_build()
    for (let i = 0; i < len(lay.boxes); i = i + 1) {
      if (lay.boxes[i].field == str(args[0])) {
        view_focus_box(lay.boxes[i])
        return {"ok": true}
      }
    }
    {"ok": false}
  }
  -~> PenSettings [key | close]: opens the pen settings (see pen_route.liz)
  cmds["PenSettings"] = function(args) { pen_route_command(args) }
  -~> Tutorial [start | next | back | skip | again | state] (see tutorial.liz)
  cmds["Tutorial"] = function(args) { tut_command(args) }
  cmds
}

let editor_screen = {
  "wants_hover": true,
  "cursor": view_cursor_name,
  "enter": view_enter,
  "event": view_event,
  "paint": view_paint,
  "debug_state": view_debug_state
}
