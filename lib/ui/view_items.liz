-~> view_items: the items of the layers panel, top to bottom: {"t": row|gap|add|strip|err,
-~> "line", "row", "h", "gap" (extra room above), "y" (offset from the first item),
-~> "depth"}. A run of blank lines is one 4 pixel gap; the canvas row is pinned
-~> at the bottom so it is not here (V.pinned); an empty row with the caret is
-~> the tool strip.
-~> They are made again only when the rows change, or the caret goes onto or
-~> off an empty row (the only rows whose items depend on the caret). After an
-~> edit that rescanned a few statements (editor_rows.liz), only their items
-~> are made again, when the item after them comes out the same; the items
-~> after them are moved where they are (the lines and the room the edit added
-~> or took away), as their rows were. The rows whose error or caret changed
-~> are made again the same way, one by one (with the row before them, whose
-~> ⊕ item looks at them). Only a change of folds or language, or too many of
-~> those rows, makes every item again.
-~> V.items_at keeps, per row, the index of its first item (and one more
-~> entry: the number of items), which is what that needs.

use "doc_cache"
use "editor_rows"
use "editor_state"
use "editor_undo"
use "i18n"
use "perf"
use "view_layout"

-~> More error rows than this make all the items again.
let view_items_max_rows = 8

function view_items() {
  let rows = view_rows()
  let m = ed_model()
  let caret = 0
  if (m.line <= len(rows) && rows[m.line - 1].kind == "empty") {
    caret = m.line
  }
  let key = ed_rows_key() + "|" + str(caret)
  if (V.items != null && V.items_key == key) {
    return V.items
  }
  perf_begin("rows")
  let looks = lang_get() + "|" + rows_folds_key(ed.folded)
  let errs = view_items_errors(len(rows))
  let done = false
  if (V.items != null && V.items_looks == looks) {
    done = view_items_update(rows, m, caret, errs)
  }
  if (!done) {
    view_items_build(rows, m)
  }
  perf_end()
  V.items_key = key
  V.items_id = doc_id(m)
  V.items_looks = looks
  V.items_caret = caret
  V.items_errs = errs
  V.visible = null
  V.items
}

-~> The lines of the rows that show an error (ed.errors, as rows_decorate puts them).
function view_items_errors(n) {
  let out = []
  for (let i = 0; i < len(ed.errors); i += 1) {
    let k = ed.errors[i].line
    if (type(k) == "INTEGER" && k >= 1 && k <= n) {
      push(out, k)
    }
  }
  out
}

-~> Brings the items from the last text (V.items_id) to this one, when the
-~> rows are its rows with a rescanned part (rows_from) or the very same,
-~> making again only that part and the rows whose error or caret changed.
-~> False when it can't: then everything is made again.
function view_items_update(rows, m, caret, errs) {
  let from = null
  if (V.items_id != doc_id(m)) {
    from = m.cache.rows_from
    if (from == null || from.base != V.items_id) {
      return false
    }
  }
  -~> the rows that changed outside the rescanned part, at their new lines
  let lines = []
  let old = V.items_errs
  if (V.items_caret > 0) {
    old = old + [V.items_caret]
  }
  for (let i = 0; i < len(old); i += 1) {
    let l = old[i]
    if (from != null) {
      if (l >= from.from && l <= from.old_to) {
        continue
      }
      if (l > from.old_to) {
        l += from.delta
      }
    }
    push(lines, l)
  }
  lines = lines + errs
  if (caret > 0) {
    push(lines, caret)
  }
  if (len(lines) > view_items_max_rows) {
    return false
  }
  if (from != null && !view_items_splice(rows, m, from)) {
    return false
  }
  lines = list.sort(lines)
  let done = 0
  for (let i = 0; i < len(lines); i += 1) {
    let l = lines[i]
    if (l > done) {
      let a = math.max(math.max(1, l - 1), done + 1)
      if (!view_items_splice(rows, m, {"from": a, "to": l, "old_to": l, "delta": 0})) {
        return false
      }
      done = l
    }
  }
  true
}

-~> The layer rows that get a ⊕ item after one of the rows i0 .. i1 - 1, by
-~> the line they end on, outermost first: the layers among those rows and
-~> the ones around them (a row can end a layer that starts above it).
function view_items_adds(rows, i0, i1) {
  let adds = {}
  let seen = {}
  for (let i = i0; i < i1; i = i + 1) {
    let n = i + 1
    while (n > 0 && seen[n] == null) {
      seen[n] = true
      let r = rows[n - 1]
      if (r.kind == "layer" && r.visible && !r.collapsed && r.end_line > i0 && r.end_line <= i1) {
        if (adds[r.end_line] == null) {
          adds[r.end_line] = []
        }
        push(adds[r.end_line], r)
      }
      n = r.parent
    }
  }
  let ends = keys(adds)
  for (let i = 0; i < len(ends); i += 1) {
    if (len(adds[ends[i]]) > 1) {
      adds[ends[i]] = list.sort(adds[ends[i]], function(a, b) { a.line < b.line })
    }
  }
  adds
}

-~> Every item again.
function view_items_build(rows, m) {
  V.pinned = null
  for (let i = 0; i < len(rows); i = i + 1) {
    if (rows[i].kind == "canvas") {
      V.pinned = rows[i]
      break
    }
  }
  let items = []
  let at = []
  view_items_fill(rows, m, view_items_adds(rows, 0, len(rows)), 0, len(rows), items, at, 0, "", 0)
  push(at, len(items))
  V.items = items
  V.items_at = at
}

-~> Only the items of the rows from.from .. from.to (from.old_to before the
-~> edit) made again; the rest of the rows are the same ones, the ones after
-~> moved by from.delta lines. False when the items after them would not come
-~> out the same: then everything is made again.
function view_items_splice(rows, m, from) {
  let old = V.items
  let at = V.items_at
  let d = from.delta
  let i0 = from.from - 1
  let i1 = from.to
  let old_i1 = from.old_to
  if (at == null || len(at) != len(rows) - d + 1) {
    return false
  }
  for (let i = i0; i < i1; i = i + 1) {
    if (rows[i].kind == "canvas") {
      return false
    }
  }
  if (V.pinned != null && V.pinned.line >= from.from && V.pinned.line <= from.to) {
    return false
  }
  let a = at[i0]
  let b = at[old_i1]
  let prev = ""
  let off = 0
  if (a > 0) {
    prev = old[a - 1].t
    off = old[a - 1].y + old[a - 1].h
  }
  let mid = []
  let mid_at = []
  let end = view_items_fill(rows, m, view_items_adds(rows, i0, i1), i0, i1, mid, mid_at, a, prev, off)
  let old_end = off
  let old_last = prev
  if (b > a) {
    old_end = old[b - 1].y + old[b - 1].h
    old_last = old[b - 1].t
  }
  let new_last = prev
  if (len(mid) > 0) {
    new_last = mid[len(mid) - 1].t
  }
  if (new_last != old_last) {
    return false
  }
  let after = list.slice(old, b, len(old))
  let dy = end - old_end
  if (d != 0) {
    -~> a row with an error or a fold is a copy of its own (rows_decorate): the
    -~> moved items take the rows of this text
    for (let i = 0; i < len(after); i += 1) {
      let it = after[i]
      it.line += d
      it.y += dy
      it.row = rows[it.line - 1]
    }
  } elif (dy != 0) {
    for (let i = 0; i < len(after); i += 1) {
      after[i].y += dy
    }
  }
  let after_at = list.slice(at, old_i1, len(at))
  let dn = len(mid) - (b - a)
  if (dn != 0) {
    let moved = []
    for (let i = 0; i < len(after_at); i += 1) {
      push(moved, after_at[i] + dn)
    }
    after_at = moved
  }
  V.items = list.slice(old, 0, a) + mid + after
  V.items_at = list.slice(at, 0, i0) + mid_at + after_at
  true
}

-~> Puts the items of rows i0 .. i1 - 1 at the end of `items` and, per row, the
-~> index its items start at into `at` (`base` is the index of items[0]).
-~> `last` is the kind of the item before them ("" for none) and `off` where
-~> they start. Returns where they end.
function view_items_fill(rows, m, adds, i0, i1, items, at, base, last, off) {
  for (let i = i0; i < i1; i = i + 1) {
    push(at, base + len(items))
    let r = rows[i]
    let item = null
    if (r.visible && r.kind != "canvas") {
      if (r.kind == "empty") {
        if (r.line == m.line) {
          item = {"t": "strip", "line": r.line, "row": r, "h": 22, "gap": 0, "depth": r.depth}
        } elif (last != "" && last != "gap") {
          item = {"t": "gap", "line": r.line, "row": r, "h": 4, "gap": 0, "depth": 0}
        }
      } else {
        let gap = 0
        if (r.kind == "layer") {
          gap = 4
        }
        item = {"t": "row", "line": r.line, "row": r, "h": 18, "gap": gap, "depth": r.depth}
      }
    }
    if (item != null) {
      item.y = off + item.gap
      off = item.y + item.h
      push(items, item)
      last = item.t
      if (item.t == "row" && r.error != null) {
        push(items, {"t": "err", "line": r.line, "row": r, "h": 16, "gap": 0, "depth": r.depth, "y": off})
        off = off + 16
        last = "err"
      }
    }
    let ends = adds[r.line]
    if (ends != null) {
      for (let k = len(ends) - 1; k >= 0; k = k - 1) {
        if (i + 1 < len(rows) && rows[i + 1].kind == "empty" && rows[i + 1].line == m.line) {
          continue
        }
        push(items, {
          "t": "add",
          "line": ends[k].line,
          "row": ends[k],
          "h": 10,
          "gap": 0,
          "depth": ends[k].depth + 1,
          "y": off
        })
        off = off + 10
        last = "add"
      }
    }
  }
  off
}
