-~> app: what the host calls. It hands every event and every paint to the
-~> current screen (see app_screens.liz); the editor is the screen "editor".
-~> The host reads these keys of `app`: needs_paint, wants_hover, cursor, start, event,
-~> paint, debug_state, debug_commands.

use "app_screens"
use "home_view"
use "perf"
use "view_main"
use "lang_en"
use "lang_es"

let app = {
  "needs_paint": true,
  "wants_hover": true,
  "cursor": "default",
  "path": ""
}

screens.editor = editor_screen
home_register()

function app_start(path) {
  app["path"] = path
  if (path == "") {
    show_screen("home", null)
  } else {
    show_screen("editor", {"path": path})
  }
}

function app_event(e) {
  let s = current_screen()
  if (s != null) {
    s.event(e)
  }
  screen_sync()
  screen_sync_cursor()
  if (s != null && screen_value(s.needs_paint) == true) {
    app.needs_paint = true
  }
}

function app_paint() {
  let s = current_screen()
  if (s != null) {
    s.paint()
  }
  perf_tick_end()
  screen_sync()
  if (s != null && screen_value(s.needs_paint) == true) {
    app.needs_paint = true
  }
}

function app_debug_state() {
  let s = current_screen()
  let st = {}
  if (s != null && s.debug_state != null) {
    st = s.debug_state()
  }
  st.screen = screen_state.current
  st.home = home_debug_state()
  st
}

function app_ping(args) {
  {"pong": true, "args": args}
}

-~> The backdoor's commands: the current screen's own, plus Ping, Screen and Show.
function app_commands() {
  let cmds = {}
  let names = keys(screens)
  for (let i = 0; i < len(names); i = i + 1) {
    let own = screens[names[i]].debug_commands
    if (own != null) {
      let ks = keys(own)
      for (let k = 0; k < len(ks); k = k + 1) {
        cmds[ks[k]] = own[ks[k]]
      }
    }
  }
  let hc = home_debug_commands()
  let hk = keys(hc)
  for (let i = 0; i < len(hk); i = i + 1) {
    if (cmds[hk[i]] == null) {
      cmds[hk[i]] = hc[hk[i]]
    }
  }
  cmds["Ping"] = app_ping
  cmds["Screen"] = function(_args) {
    {"screen": screen_state.current, "screens": keys(screens)}
  }
  cmds["Show"] = function(args) {
    {"ok": show_screen(str(args[0]), null)}
  }
  cmds
}

screens.editor.debug_commands = view_commands()

app["start"] = app_start
app["event"] = app_event
app["paint"] = app_paint
app["debug_state"] = app_debug_state
app["debug_perf"] = perf_last
app["debug_commands"] = app_commands()
