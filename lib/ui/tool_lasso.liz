-~> tool_lasso: the Lasso tool (L). A drag draws a freehand loop (marching
-~> ants, a bevel line back to the start), through the stabilizer of its
-~> options strip. What the loop does depends on the strip's mode:
-~>   select   the shapes fully inside become the selection (Shift adds);
-~>            the rows they would take are lit while drawing. A drag on a
-~>            selected shape or a handle then moves, scales or turns it, like
-~>            the Select tool
-~>   fill     the loop becomes a new `polygon([...], color)` row in the
-~>            current color, at the end of the current layer (the points
-~>            simplified to whole pixels); it is selected and marked `new`
-~> The new row is one undo step. The gesture is V.gest {"owner": "lasso"}.

use "../draw/geometry"
use "editor_doc"
use "editor_rows"
use "editor_state"
use "editor_twoway"
use "editor_undo"
use "i18n"
use "select_model"
use "stabilize"
use "tool_select"
use "tool_stabilizer"
use "view_canvas"
use "view_gfx"
use "view_layout"
use "view_tools"

-~> The options strip's mode. Its stabilizer is the lasso's own in
-~> tool_stabilizer ("@lasso", length in drawing pixels): a pulled string
-~> until the strip changes it.
let lasso_cfg = {"mode": "select", "stab_set": false}

-~> The row the last fill made and when (ms), for its `new` badge.
let lasso_badge = {"line": 0, "at": 0}
let lasso_badge_ms = 3000

-~> How far apart (drawing pixels) the kept points of a fill can stray from the loop.
let lasso_tolerance = 1.5

-~> The stabilizer's settings for the strip's choices.
function lasso_steady() {
  if (!lasso_cfg.stab_set) {
    lasso_cfg.stab_set = true
    tool_stab_set("@lasso", {"mode": "string", "length": 24, "catch_up": true})
  }
  tool_stab_get("@lasso")
}

-~> Changes one of the stabilizer's settings ("mode", "length", "catch_up").
function lasso_set_steady(name, value) {
  let s = hash.merge(lasso_steady(), {})
  s[name] = value
  tool_stab_set("@lasso", s)
}

-~> == The press ==

function lasso_down(e, cl) {
  pick_set_canvas_keys(true)
  V.drag = {"kind": "canvas"}
  let shift = e.mods != null && e.mods.shift == true
  if (lasso_cfg.mode == "select") {
    let h = select_handle_at(cl, e.pos.x, e.pos.y)
    if (h != null) {
      return select_begin_handle(e, cl, h)
    }
    let s = view_hit_shape(cl, view_to_drawing(cl, e.pos.x, e.pos.y))
    if (!shift && s != null && type(s.line) == "INTEGER" && pick_has(s.line)) {
      return select_begin_move(e, cl, s.line, false)
    }
  }
  let base = []
  if (shift) {
    base = pick_lines()
  }
  let p = tools_pointer(cl, e)
  let g = {"owner": "lasso", "mode": "loop", "pts": [], "state": stabilize_new(), "cursor": p, "phase": 0, "base": base, "checked": 0}
  lasso_add(g, p)
  V.gest = g
  sel_ui.hot = []
  view_touch()
}

-~> Takes a pointer sample through the stabilizer.
function lasso_add(g, p) {
  g.cursor = p
  let laid = stabilize(g.state, {"pos": p}, lasso_steady())
  for (let i = 0; i < len(laid); i += 1) {
    let n = len(g.pts)
    if (n == 0 || math.dist(g.pts[n - 1], laid[i].pos) >= 0.5) {
      push(g.pts, laid[i].pos)
    }
  }
}

-~> == Moves ==

function lasso_move(g, e, cl) {
  if (e.samples != null && len(e.samples) > 0) {
    for (let i = 0; i < len(e.samples); i += 1) {
      let s = e.samples[i]
      if (s.canvas_pos != null) {
        lasso_add(g, tools_draw_pt(cl, s.canvas_pos))
      } else {
        lasso_add(g, view_to_drawing(cl, s.pos.x, s.pos.y))
      }
    }
  } else {
    lasso_add(g, view_to_drawing(cl, e.pos.x, e.pos.y))
  }
  g.phase += 1
  if (lasso_cfg.mode == "select" && len(g.pts) - g.checked >= 4) {
    g.checked = len(g.pts)
    sel_ui.hot = lasso_lines_in(cl, g.pts)
  }
  view_touch()
}

-~> == Release ==

function lasso_up(g, cl) {
  let laid = stabilize_end(g.state, lasso_steady())
  for (let i = 0; i < len(laid); i += 1) {
    push(g.pts, laid[i].pos)
  }
  sel_ui.hot = []
  if (lasso_cfg.mode == "fill") {
    if (len(g.pts) >= 3) {
      lasso_fill(g.pts)
    }
  } elif (len(g.pts) >= 3) {
    pick_set(g.base + lasso_lines_in(cl, g.pts))
  } else {
    pick_set(g.base)
  }
  view_touch()
}

-~> The loop becomes a polygon row in the current color and layer.
function lasso_fill(pts) {
  let m = ed_model()
  let r = lasso_insert(m, pts, doc_current_layer(m), ed.color)
  if (is_refusal(r)) {
    ed_refuse(r.refused)
    return false
  }
  ed_label("lasso_fill")
  ed_apply(r, null)
  let line = ed_model().line
  pick_set([line])
  lasso_badge.line = line
  lasso_badge.at = time.ms()
  true
}

-~> The model with the loop `pts` (drawing points) as a `polygon(points, color)`
-~> row at the end of the layer on line `layer` (or first in the file when it
-~> is null), the caret on it; a refusal when the loop has no area.
function lasso_insert(m, pts, layer, color) {
  let kept = simplify(pts, lasso_tolerance)
  let points = []
  for (let i = 0; i < len(kept); i += 1) {
    let q = (math.round(kept[i].x), math.round(kept[i].y))
    if (len(points) == 0 || points[len(points) - 1] != q) {
      push(points, q)
    }
  }
  if (len(points) > 1 && points[0] == points[len(points) - 1]) {
    pop(points)
  }
  if (len(points) < 3 || polygon_area2(points) == 0) {
    return {"refused": t("refuse.lasso_small")}
  }
  let code = "polygon(" + fmt_points(points) + ", " + color + ")"
  if (layer == null) {
    return twoway_new_row(m, code, null)
  }
  let at = doc_row(m, layer, null, null).end_line
  let row = " " * (leading_ws(m.lines[layer - 1]) + 2) + code
  let lines = list.slice(m.lines, 0, at) + [row] + list.slice(m.lines, at, len(m.lines))
  doc_with(m, lines, at + 1, len(row))
}

-~> == What is inside ==

-~> Whether p is inside the loop (nonzero winding, the loop closed).
function lasso_holds(pts, p) {
  let n = len(pts)
  let winding = 0
  for (let j = 0; j < n; j += 1) {
    let a = pts[j]
    let b = pts[(j + 1) % n]
    let side = (b.x - a.x) * (p.y - a.y) - (p.x - a.x) * (b.y - a.y)
    if (a.y <= p.y) {
      if (b.y > p.y && side > 0) {
        winding += 1
      }
    } elif (b.y <= p.y && side < 0) {
      winding -= 1
    }
  }
  winding != 0
}

-~> The lines of the shapes (visible, unlocked, made by a row) fully inside the loop.
function lasso_lines_in(cl, pts) {
  if (len(pts) < 3) {
    return []
  }
  let lo = pts[0]
  let hi = pts[0]
  for (let i = 1; i < len(pts); i += 1) {
    lo = (math.min(lo.x, pts[i].x), math.min(lo.y, pts[i].y))
    hi = (math.max(hi.x, pts[i].x), math.max(hi.y, pts[i].y))
  }
  let loop = simplify(pts, 0.75)
  let candidates = select_lines_in(cl, lo, hi, false)
  let out = []
  for (let i = 0; i < len(candidates); i += 1) {
    if (lasso_line_inside(loop, candidates[i])) {
      push(out, candidates[i])
    }
  }
  out
}

-~> Whether every shape of a line has its outline inside the loop.
function lasso_line_inside(loop, line) {
  let shapes = ed_shapes_of(line)
  for (let i = 0; i < len(shapes); i += 1) {
    let subs = flatten_path(shapes[i].path, 2.0)
    for (let k = 0; k < len(subs); k += 1) {
      let ps = subs[k].points
      for (let j = 0; j < len(ps); j += 1) {
        if (!lasso_holds(loop, ps[j])) {
          return false
        }
      }
    }
  }
  len(shapes) > 0
}

-~> == Painting ==

-~> The loop being drawn: marching ants (bright 3, void 2, moving while it
-~> grows), a bevel line back to the start, and with the string stabilizer
-~> the tip, the string to the pointer and the dotted circle of its length.
function lasso_paint(cl) {
  let g = V.gest
  if (g == null || g.owner != "lasso" || len(g.pts) == 0) {
    return null
  }
  let pts = g.pts
  let ph = g.phase
  let k = 0
  for (let i = 0; i + 1 < len(pts); i += 1) {
    let a = view_to_window(cl, pts[i]) / 2
    let b = view_to_window(cl, pts[i + 1]) / 2
    k = sel_line(a, b, k, function(x, y, n) {
      if ((n + ph) % 5 < 3) {
        sel_dot(x, y, P.bright)
      } else {
        sel_dot(x, y, P.void)
      }
    })
  }
  let first = view_to_window(cl, pts[0]) / 2
  let last = view_to_window(cl, pts[len(pts) - 1]) / 2
  sel_line(last, first, 0, function(x, y, _n) { sel_dot(x, y, P.bevel) })
  let st = lasso_steady()
  if (st.mode == "string" && g.state.tip != null) {
    let tip = view_to_window(cl, g.state.tip) / 2
    let cur = view_to_window(cl, g.cursor) / 2
    sel_line(tip, cur, 0, function(x, y, _n) { sel_dot(x, y, P.sky) })
    let r = st.length * cl.zoom / 2
    let steps = math.max(16, math.round(r * 2))
    for (let i = 0; i < steps; i += 2) {
      let a = math.tau * i / steps
      sel_dot(math.round(cur.x + math.cos(a) * r), math.round(cur.y + math.sin(a) * r), P.sky)
    }
    let tx = math.round(tip.x)
    let ty = math.round(tip.y)
    g_rect(tx - 2, ty - 2, 5, 5, P.void)
    g_rect(tx - 1, ty - 1, 3, 3, P.bright)
  }
}

-~> The part of the window (full pixels) the loop covers, or null.
function lasso_overlay_win(cl) {
  let g = V.gest
  if (g == null || g.owner != "lasso" || len(g.pts) == 0) {
    return null
  }
  let lo = g.cursor
  let hi = g.cursor
  for (let i = 0; i < len(g.pts); i += 1) {
    lo = (math.min(lo.x, g.pts[i].x), math.min(lo.y, g.pts[i].y))
    hi = (math.max(hi.x, g.pts[i].x), math.max(hi.y, g.pts[i].y))
  }
  let m = lasso_steady().length + 4
  let a = view_to_window(cl, lo - (m, m))
  let b = view_to_window(cl, hi + (m, m))
  [a.x - 6, a.y - 6, b.x + 6, b.y + 6]
}

-~> A text that changes when the loop does (for the canvas panel's key).
function lasso_canvas_key() {
  let g = V.gest
  if (g == null || g.owner != "lasso") {
    return ""
  }
  str(len(g.pts)) + "|" + str(g.phase) + "|" + str(g.cursor)
}

-~> Whether the `new` badge of a fill is still shown on a row.
function lasso_badge_on(line) {
  line == lasso_badge.line && lasso_badge_live()
}

function lasso_badge_live() {
  lasso_badge.line > 0 && time.ms() - lasso_badge.at < lasso_badge_ms
}

-~> The `new` badge at the right end of a row at y: lizard, the word in void.
function lasso_paint_badge(y) {
  let word = t("lasso.new")
  let w = g_text_w(word) + 4
  let x = V.pw - w - 6
  g_rect(x, y + 3, w, 13, P.lizard)
  g_text(word, x + 2, y + 2, P.void)
}
