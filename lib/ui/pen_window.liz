-~> pen_window: the brush creator, the floating window that replaced the
-~> R002 pen settings pop-up (style guide R005, layout A): where each of its
-~> parts is, and how it is painted. 500 wide, over the editor at the left:
-~>   title    BRUSH CREATOR · the name, "from ink" (the built-in it started
-~>            from), Reset, close; drag it to move the window
-~>   rail     the eight tabs in a column (brush_tabs.liz), an amber dot on
-~>            the ones changed from the pen it opened on
-~>   content  the tab: Shape and Grain (brush_tiles.liz: tiles, preview,
-~>            settings), Pressure (brush_tab_pressure.liz), the others a
-~>            settings column (brush_controls.liz)
-~>   pad      the test pad (pen_pad.liz), 488x70, its three buttons
-~>   footer   the name field, Export… and Save brush (brush_store.liz)
-~>   code     coder mode only: the pen hash it writes, 4 lines at a time,
-~>            scrolled to the line of the last change
-~> What it edits is pw (pen_edit.liz, brush_edit.liz). Every place is in UI
-~> pixels of the window, so painting and clicking agree.

use "brush_controls"
use "brush_edit"
use "brush_tab_pressure"
use "brush_tabs"
use "brush_tiles"
use "i18n"
use "icons_brush"
use "icons_shape"
use "mode_state"
use "pen_code"
use "pen_edit"
use "pen_library"
use "pen_pad"
use "view_code"
use "view_gfx"
use "view_layout"

let pw_w = 500
let pw_code_lines = 4
let pw_rail_w = 92

-~> Coder mode's window has the code block: 326 high under the toolbar.
-~> Artist mode's has none (264 high) and stays under the context bar.
function pw_height() {
  if (mode_artist()) {
    return 264
  }
  326
}

function pw_top() {
  if (mode_artist()) {
    return 52
  }
  18
}

-~> The window's box [x, y, w, h], kept inside the editor's window.
function pw_rect() {
  let h = pw_height()
  let x = math.max(0, math.min(pw.x, V.w - pw_w))
  let y = math.max(pw_top(), math.min(pw.y, V.h - h))
  return [x, y, pw_w, h]
}

-~> Moves the window so it stays inside the editor's window.
function pw_move_to(x, y) {
  pw.x = math.round(x)
  pw.y = math.round(y)
  let r = pw_rect()
  pw.x = r[0]
  pw.y = r[1]
  pw.ver += 1
}

-~> The x of a value along a track (the sliders' own, brush_controls.liz).
function pw_track_x(track, v, lo, hi) {
  bc_track_x(track, v, lo, hi)
}

function pw_track_value(track, x, lo, hi) {
  bc_track_value(track, x, lo, hi)
}

-~> Where everything is: a hash of rects [x, y, w, h] and lists. `tab` is
-~> the open tab's own layout: {"id", "x", "y", "w", "rows", "tiles"
-~> (Shape, Grain), "pressure" (Pressure), "note_y", "sx", "sw"}.
function pw_layout() {
  let r = pw_rect()
  let ox = r[0]
  let oy = r[1]
  let top = oy + 16
  let reset = t("pen.reset")
  let rx = ox + pw_w - 12 - 8 - g_text_w(reset)
  let tabs = []
  for (let i = 0; i < len(bt_tabs); i = i + 1) {
    push(tabs, {"id": bt_tabs[i], "rect": [ox + 1, top + 1 + i * 18, pw_rail_w, 18]})
  }
  let py = top + 151
  let fy = py + 74
  let name_x = ox + 11 + g_text_w(text.lower(t("props.name")))
  let save_w = g_text_w(t("brush.save")) + 22
  let save_x = ox + pw_w - 6 - save_w
  let exp_w = g_text_w(t("brush.export")) + 22
  let pad = [ox + 6, py, pw_w - 12, 70]
  let bx = pad[0] + pad[2] - 15
  let code = [ox + 6, fy + 22, pw_w - 12, pw_code_lines * 13 + 6]
  if (mode_artist()) {
    code = null
  }
  {
    "win": r,
    "title": [ox, oy, pw_w, 15],
    "close": [ox + pw_w - 14, oy + 2, 12, 12],
    "reset": [rx - 2, oy + 1, g_text_w(reset) + 4, 13],
    "rail": [ox + 1, top, pw_rail_w, 147],
    "tabs": tabs,
    "tab": pw_tab_layout(pw.tab, ox + pw_rail_w + 8, top + 3, pw_w - pw_rail_w - 14),
    "pad": pad,
    "sample": [bx - 28, pad[1] + 2, 13, 13],
    "paper": [bx - 14, pad[1] + 2, 13, 13],
    "trash": [bx, pad[1] + 2, 13, 13],
    "name": [name_x, fy, 120, 18],
    "export": [save_x - 4 - exp_w, fy, exp_w, 18],
    "save": [save_x, fy, save_w, 18],
    "code": code
  }
}

-~> The open tab's layout from (x0, y0), w wide.
function pw_tab_layout(tab, x0, y0, w) {
  let out = {"id": tab, "x": x0, "y": y0, "w": w, "rows": [], "tiles": null, "pressure": null}
  if (tab == "pressure") {
    out.pressure = bpr_layout(x0, y0)
    out.rows = out.pressure.rows
    return out
  }
  let sx = x0 + 100
  if (tab == "shape" || tab == "grain") {
    out.tiles = bti_layout(tab, x0, y0)
    sx = x0 + 192
  }
  out.sx = sx
  out.sw = x0 + w - sx
  let placed = bc_rows(bt_controls(tab), sx, y0, out.sw)
  out.rows = placed.rows
  out.note_y = placed.end
  out
}

-~> == Painting ==

function pw_draw() {
  let lay = pw_layout()
  let r = lay.win
  let x = r[0]
  let y = r[1]
  -~> the 3 pixel hard shadow, the outline, the face and its left highlight
  g_rect(x + 3, y + 3, r[2], r[3], P.void)
  g_frame(x, y, r[2], r[3], P.void)
  g_rect(x + 1, y + 1, r[2] - 2, r[3] - 2, P.panel)
  g_rect(x + 1, y + 1, 1, r[3] - 2, P.bevel)
  pw_draw_title(lay)
  pw_draw_rail(lay)
  pw_draw_tab(lay.tab)
  pw_draw_pad(lay)
  pw_draw_footer(lay)
  pw_draw_code(lay)
}

-~> The hover id without its "pw:", or "".
function pw_hover_id() {
  if (text.starts(V.hover, "pw:")) {
    return text.slice(V.hover, 3, len(V.hover))
  }
  ""
}

function pw_draw_title(lay) {
  let tr = lay.title
  let x = tr[0]
  let y = tr[1]
  g_rect(x + 1, y + 1, tr[2] - 2, 13, P.raised)
  g_rect(x + 1, y + 14, tr[2] - 2, 1, P.void)
  g_rect(x + 1, y + 1, tr[2] - 2, 1, P.lizard)
  g_icon("grip", x + 4, y + 4, P.dim)
  let head = text.upper(t("brush.title"))
  let tx = x + 14
  g_text(head, tx, y + 1, P.mute)
  g_text("·", tx + g_text_w(head) + 5, y + 1, P.mute)
  let name = pw_title_name()
  let nx = tx + g_text_w(head) + 17
  g_text(name, nx, y + 1, P.bright)
  if (pen_is_builtin(pw.key)) {
    g_text(t("brush.from", {"name": pen_display_name(pw.orig)}), nx + g_text_w(name) + 7, y + 1, P.dim)
  }
  let rs = lay.reset
  g_rect(rs[0] - 3, y + 4, 1, 8, P.bevel)
  let rc = P.mute
  if (V.hover == "pw:reset") {
    rc = P.bright
  }
  g_text(t("pen.reset"), rs[0] + 2, y + 1, rc)
  let cl = lay.close
  if (V.hover == "pw:close") {
    g_rect(cl[0], cl[1], cl[2], cl[3], P.bevel)
  }
  g_icon("close", x + tr[2] - 12, y + 4, P.mute)
}

-~> The name the title shows: the name field's, or the pen's while it is empty.
function pw_title_name() {
  if (text.trim(pw.name) != "") {
    return text.trim(pw.name)
  }
  pen_display_name(pw.draft)
}

-~> The tab rail: `coal`, a `void` line on its right, a row per tab.
function pw_draw_rail(lay) {
  let rr = lay.rail
  g_rect(rr[0], rr[1], rr[2], rr[3], P.coal)
  g_rect(rr[0] + rr[2], rr[1], 1, rr[3], P.void)
  for (let i = 0; i < len(lay.tabs); i = i + 1) {
    let tb = lay.tabs[i]
    let r = tb.rect
    let sel = tb.id == pw.tab
    let ic = P.mute
    let tc = P.text
    if (sel) {
      g_rect(r[0], r[1], r[2], r[3], P.moss)
      g_rect(r[0], r[1], 2, r[3], P.lizard)
      ic = P.lizard
      tc = P.bright
    } elif (V.hover == "pw:tab:" + tb.id) {
      g_rect(r[0], r[1], r[2], r[3], P.row)
    }
    g_icon(bt_icons[tb.id], r[0] + 6, r[1] + 5, ic)
    g_text(t(prefixed("brush.tab.", tb.id)), r[0] + 18, r[1] + 3, tc)
    if (bt_changed(tb.id)) {
      g_rect(r[0] + r[2] - 5, r[1] + 8, 3, 3, P.amber)
    }
  }
}

function pw_draw_tab(tl) {
  let hover = pw_hover_id()
  if (tl.pressure != null) {
    bpr_draw(tl.pressure, tl.x, tl.y, hover)
    return null
  }
  if (tl.tiles != null) {
    bti_draw(tl.id, tl.tiles, tl.x, tl.y, hover)
  } else {
    g_text(text.upper(t(prefixed("brush.tab.", tl.id))), tl.x, tl.y, P.mute)
  }
  bc_draw(tl.rows, hover)
  bc_draw_note(tl.sx, tl.note_y, tl.sw, be_note(tl.id), P.mute)
}

-~> The pad: paper, frame, its strokes, the labels and the three buttons.
function pw_draw_pad(lay) {
  let p = lay.pad
  g_frame(p[0], p[1], p[2], p[3], P.void)
  g_rect(p[0] + 1, p[1] + 1, p[2] - 2, p[3] - 2, pad_paper())
  if (!pw.pad_dark) {
    g_rect(p[0] + 1, p[1] + 1, p[2] - 2, 1, #e4dfd0)
  }
  pad_paint(p)
  if (pw.pad_sample) {
    g_text(t("brush.sample"), p[0] + 5, p[1] + p[3] - 15, P.mute)
  } elif (len(pw.pad) == 0 && pw.pad_live == null) {
    let hint = t("pen.pad_hint")
    g_text(hint, p[0] + (p[2] - g_text_w(hint)) // 2, p[1] + p[3] // 2 - 7, P.dim)
  }
  let note = t("brush.test_only")
  g_text(note, p[0] + p[2] - 5 - g_text_w(note), p[1] + p[3] - 15, P.dim)
  pw_pad_button(lay.sample, "stroke", "sample", pw.pad_sample)
  pw_pad_button(lay.paper, "fill", "paper", pw.pad_dark)
  pw_pad_button(lay.trash, "trash", "trash", false)
}

function pw_pad_button(r, icon, id, on) {
  let state = "normal"
  if (on) {
    state = "active"
  } elif (V.hover == "pw:" + id) {
    state = "hover"
  }
  g_button(r[0], r[1], r[2], r[3], icon, "", state)
}

-~> The footer: name, a note (what Save or Export said), Export… and Save brush.
function pw_draw_footer(lay) {
  let nr = lay.name
  g_text(text.lower(t("props.name")), lay.win[0] + 6, nr[1] + 2, P.mute)
  g_field(nr[0], nr[1], nr[2], nr[3], pw.name_focus)
  g_text(pw.name, nr[0] + 4, nr[1] + 3, P.text)
  if (pw.name_focus) {
    g_rect(nr[0] + 4 + pw.name_caret * 7, nr[1] + 3, 1, 12, P.amber)
  }
  if (pw.note != "") {
    let room = lay.export[0] - (nr[0] + nr[2]) - 12
    g_text(g_fit_words(pw.note, room), nr[0] + nr[2] + 6, nr[1] + 2, P.amber)
  }
  let er = lay.export
  let state = "normal"
  if (V.hover == "pw:export") {
    state = "hover"
  }
  g_button(er[0], er[1], er[2], er[3], "export", t("brush.export"), state)
  let sr = lay.save
  g_frame(sr[0], sr[1], sr[2], sr[3], P.void)
  let face = P.moss
  if (V.hover == "pw:save") {
    face = #1f4c2b
  }
  g_rect(sr[0] + 1, sr[1] + 1, sr[2] - 2, sr[3] - 2, face)
  g_bevel(sr[0] + 1, sr[1] + 1, sr[2] - 2, sr[3] - 2, P.lizard, P.void)
  g_icon("save", sr[0] + 6, sr[1] + 5, P.lizard)
  g_text(t("brush.save"), sr[0] + 16, sr[1] + 2, P.bright)
}

-~> == The code block ==

-~> How many characters a line of the code view holds before it wraps.
let pw_code_chars = 66

-~> The key the code block writes the pen under: the name field's for a
-~> built-in's copy, else the pen's own.
function pw_code_key() {
  if (pen_is_builtin(pw.key)) {
    let k = pen_lib_key(pw.name)
    if (k != "") {
      return k
    }
  }
  pen_key_of(pw.draft)
}

-~> The pen as Save brush writes it: the draft under the name field's name.
function pw_code_pen() {
  let pen = pen_deep_copy(pw.draft)
  if (text.trim(pw.name) != "") {
    pen.name = text.trim(pw.name)
  }
  pen
}

-~> The lines the code view shows now and the ones to mark: {"lines",
-~> "mark", "mark_end"} (mark -1 for none). The hash is written as
-~> `pens.<key> = {...}` with its keys packed into lines of at most
-~> pw_code_chars, in the order pen_code writes them (style guide R005: the
-~> flat keys, a block such as "grain" on one line); a key too long for a
-~> line goes on lines of its own, cut after a ", ". The marked lines hold
-~> the key of the last change.
function pw_code_view() {
  let pen = pw_code_pen()
  let ks = pen_code_keys(pen, pen_code_order)
  let first_max = pw_code_chars - len(pw_code_label(99)) - 3
  let changed = text.split(pw.changed, ".")[0]
  let lines = []
  let mark = -1
  let mark_end = -1
  let cur = "pens." + pw_code_key() + " = {"
  let cur_keys = []
  for (let i = 0; i < len(ks); i = i + 1) {
    let item = pen_code_string(ks[i]) + ": " + pen_code_value(pen[ks[i]])
    if (i < len(ks) - 1) {
      item = item + ","
    } else {
      item = item + "}"
    }
    let max = pw_code_chars
    if (len(lines) == 0) {
      max = first_max
    }
    if (len(cur) + 1 + len(item) > max && len(cur_keys) > 0) {
      push(lines, {"s": cur, "keys": cur_keys})
      cur = " "
      cur_keys = []
    }
    let gap = " "
    if (text.ends(cur, "{")) {
      gap = ""
    }
    let pieces = pw_code_pieces(cur + gap + item, pw_code_chars)
    for (let k = 0; k < len(pieces) - 1; k = k + 1) {
      push(lines, {"s": pieces[k], "keys": cur_keys + [ks[i]]})
    }
    cur = pieces[len(pieces) - 1]
    cur_keys = cur_keys + [ks[i]]
  }
  push(lines, {"s": cur, "keys": cur_keys})
  for (let i = 0; i < len(lines); i = i + 1) {
    if (changed != "" && list.index(lines[i].keys, changed) >= 0) {
      if (mark < 0) {
        mark = i
      }
      mark_end = i
    }
  }
  {"lines": lines, "mark": mark, "mark_end": mark_end}
}

-~> A line of code cut into pieces of at most max characters, after a ", "
-~> when it can; the pieces after the first are indented two more.
function pw_code_pieces(s, max) {
  let out = []
  let indent = ""
  while (len(indent) < len(s) && text.slice(s, len(indent), len(indent) + 1) == " ") {
    indent = indent + " "
  }
  let rest = s
  let lead = ""
  while (len(lead) + len(rest) > max) {
    let room = max - len(lead)
    let cut = room
    let k = room - 1
    while (k > 1 && text.slice(rest, k - 1, k + 1) != ", ") {
      k = k - 1
    }
    if (k > 1) {
      cut = k + 1
    }
    push(out, lead + text.slice(rest, 0, cut))
    rest = text.slice(rest, cut, len(rest))
    lead = indent + "  "
  }
  push(out, lead + rest)
  out
}

-~> Scrolls the code view so the marked line shows (it stays put otherwise).
function pw_code_follow() {
  let v = pw_code_view()
  let top = pw.code_top
  if (v.mark >= 0) {
    if (v.mark < top) {
      top = v.mark
    } elif (v.mark_end >= top + pw_code_lines) {
      top = math.max(v.mark, v.mark_end - pw_code_lines + 1)
    }
  }
  pw.code_top = math.max(0, math.min(top, len(v.lines) - pw_code_lines))
}

-~> The label at the code block's top right: `pens.chalk · 1-4 / 9`.
function pw_code_label(n) {
  let last = math.min(n, pw.code_top + pw_code_lines)
  "pens." + pw_code_key() + " · " + str(pw.code_top + 1) + "-" + str(last) + " / " + str(n)
}

function pw_draw_code(lay) {
  let cr = lay.code
  if (cr == null) {
    return null
  }
  g_frame(cr[0], cr[1], cr[2], cr[3], P.void)
  g_rect(cr[0] + 1, cr[1] + 1, cr[2] - 2, cr[3] - 2, P.coal)
  let v = pw_code_view()
  let n = len(v.lines)
  let label = pw_code_label(n)
  g_clip(cr[0] + 1, cr[1] + 1, cr[2] - 6, cr[3] - 2)
  for (let i = 0; i < pw_code_lines; i = i + 1) {
    let k = pw.code_top + i
    if (k < n) {
      let y = cr[1] + 3 + i * 13
      if (k >= v.mark && k <= v.mark_end) {
        g_rect(cr[0] + 1, y, cr[2] - 8, 13, P.row)
        g_rect(cr[0] + 1, y, 2, 13, P.amber)
      }
      code_draw(code_render(v.lines[k].s, 0, false), cr[0] + 5, y)
    }
  }
  fb.unclip()
  -~> on the first line, when its code leaves room for it
  let first = v.lines[math.min(pw.code_top, n - 1)].s
  if (5 + g_text_w(first) + 16 < cr[2] - g_text_w(label) - 10) {
    g_text(label, cr[0] + cr[2] - 10 - g_text_w(label), cr[1] + 3, P.dim)
  }
  -~> the 3 pixel scrollbar
  let track = cr[3] - 4
  g_rect(cr[0] + cr[2] - 5, cr[1] + 2, 3, track, P.coal)
  if (n > pw_code_lines) {
    let th = math.max(6, track * pw_code_lines // n)
    let ty = cr[1] + 2 + (track - th) * pw.code_top // math.max(1, n - pw_code_lines)
    g_rect(cr[0] + cr[2] - 5, ty, 3, th, P.bevel)
  }
}
