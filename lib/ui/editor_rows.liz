-~> editor_rows: the rows of the layers panel, made from a model.
-~> Every line of the file is a row. A row is a hash:
-~>   line, text, depth    where it is and how far it is indented (in layers/blocks)
-~>   kind     layer shape call value definition block canvas code comment cont empty
-~>   callee   the function a call row calls, else ""
-~>   name     the trailing comment (without the flags), else the callee or the name
-~>   hidden, locked       the [hidden] and [locked] flags of the comment
-~>   error    the message of the last run's error on this line, or null
-~>   layer    the line of the layer this row sits in, 0 when it is loose
-~>   parent   the line of the statement this row belongs to, 0 at the top
-~>   end_line the last line of its statement (more than `line` for a layer with a body)
-~>   foldable, collapsed, visible   whether it can fold, is folded, is shown
-~>   stmt     the src.parse statement that starts on this line, or null

let shape_calls = ["circle", "ellipse", "rect", "line", "polygon", "stroke", "brush"]

function is_shape_call(name) {
  list.index(shape_calls, name) >= 0
}

-~> Walks the statements and records, per start line, the statement, the layer
-~> it is in and its parent; `inside` gets, per line within a statement but not
-~> starting one, the innermost statement around it.
function rows_walk(stmts, layer, parent, starts, inside) {
  for (let i = 0; i < len(stmts); i = i + 1) {
    let s = stmts[i]
    if (starts[s.line] == null) {
      starts[s.line] = {"stmt": s, "layer": layer, "parent": parent}
    }
    for (let l = s.line + 1; l <= s.end_line; l += 1) {
      inside[l] = s
    }
    let inner = layer
    if (s.kind == "layer") {
      inner = s.line
    }
    rows_walk(s.children, inner, s.line, starts, inside)
  }
}

function row_kind(s, li) {
  if (s == null) {
    if (is_blank(li.text)) {
      return "empty"
    }
    if (text.starts(text.trim(li.text), "-~>")) {
      return "comment"
    }
    return "cont"
  }
  if (s.kind == "layer") {
    return "layer"
  }
  if (s.kind == "call") {
    if (is_shape_call(s.callee)) {
      return "shape"
    }
    return "call"
  }
  if (s.kind == "let") {
    return "value"
  }
  if (s.kind == "function") {
    return "definition"
  }
  if (s.kind == "block") {
    return "block"
  }
  if (s.kind == "assign" && s.name == "canvas") {
    return "canvas"
  }
  "code"
}

function row_name(s, li) {
  if (li.name != "") {
    return li.name
  }
  if (s == null) {
    return ""
  }
  s.name
}

-~> What folding remembers a row by: the layer's name, else its header text.
function fold_key(s, li) {
  if (s.kind == "layer") {
    return "layer:" + s.name
  }
  "text:" + text.trim(comment_split(li.text)[0])
}

-~> The rows of a model. `errors` is the last run's error list and `folded` the
-~> editor's hash of folded keys (both may be null). The rows come from the
-~> model's cache: worked out once per text, and once more per set of errors
-~> and folds. Don't change them, they are shared.
function doc_rows(m, errors, folded) {
  let base = rows_base(m)
  let key = rows_key(errors, folded)
  if (key == "") {
    return base
  }
  let c = m.cache
  if (c.shown == null || c.shown.key != key) {
    perf_begin("rows")
    c.shown = {"key": key, "rows": rows_decorate(m, base, errors, folded)}
    perf_end()
  }
  c.shown.rows
}

function doc_row(m, line, errors, folded) {
  doc_rows(m, errors, folded)[line - 1]
}

-~> The rows without errors and folds: none has an error, none is folded, all
-~> are visible. After an edit only the rescanned lines are made again (and the
-~> ones after them when the edit added or took away lines).
function rows_base(m) {
  let c = m.cache
  if (c.rows == null) {
    let p = doc_parsed(m)
    perf_begin("rows")
    let sp = c.splice
    if (sp != null && sp.rows != null) {
      c.rows = rows_spliced(p, sp)
      if (sp.delta == 0) {
        c.rows_from = {"base": sp.base, "from": sp.from, "to": sp.new_to}
      }
    } else {
      c.rows = rows_build(p, p.statements, 1, len(p.lines))
    }
    doc_cache_tidy(c)
    perf_end()
  }
  c.rows
}

-~> The rows of a spliced parse: the old ones before the scan, new ones for it,
-~> and after it the old ones again (or new ones when the lines moved).
function rows_spliced(p, sp) {
  let st = p.statements
  let mid = rows_build(p, list.slice(st, sp.i0, sp.i0 + sp.count), sp.from, sp.new_to)
  let after = []
  if (sp.delta == 0) {
    after = list.slice(sp.rows, sp.old_to, len(sp.rows))
  } else {
    after = rows_build(p, list.slice(st, sp.i0 + sp.count, len(st)), sp.new_to + 1, len(p.lines))
  }
  list.slice(sp.rows, 0, sp.from - 1) + mid + after
}

-~> The rows of the lines from..to, which hold exactly the top-level statements
-~> `stmts` (and the blank or comment lines between them).
function rows_build(p, stmts, from, to) {
  let starts = {}
  let inside = {}
  rows_walk(stmts, 0, 0, starts, inside)
  let rows = []
  for (let n = from; n <= to; n = n + 1) {
    let li = p.lines[n - 1]
    let at = starts[n]
    let s = null
    let layer = 0
    let parent = 0
    if (at != null) {
      s = at.stmt
      layer = at.layer
      parent = at.parent
    } else {
      let c = inside[n]
      if (c != null) {
        parent = c.line
        if (starts[c.line] != null) {
          layer = starts[c.line].layer
        }
        if (c.kind == "layer") {
          layer = c.line
        }
      }
    }
    let depth = li.indent // 2
    let end_line = n
    let foldable = false
    let callee = ""
    if (s != null) {
      depth = s.depth
      end_line = s.end_line
      foldable = len(s.children) > 0
      if (s.kind == "call") {
        callee = s.callee
      }
    }
    let flags = li.flags
    push(rows, {"line": n, "text": li.text, "depth": depth, "kind": row_kind(s, li), "callee": callee,
                "name": row_name(s, li), "comment": li.comment, "hidden": list.index(flags, "hidden") >= 0,
                "locked": list.index(flags, "locked") >= 0, "error": null, "follow": false, "layer": layer,
                "parent": parent, "end_line": end_line, "foldable": foldable, "collapsed": false, "visible": true,
                "stmt": s})
  }
  rows
}

-~> What the errors and folds change in the rows, as a text: "" for nothing.
function rows_key(errors, folded) {
  let ek = rows_errors_key(errors)
  let fk = rows_folds_key(folded)
  if (ek == "" && fk == "") {
    return ""
  }
  lang_get() + "|" + ek + "|" + fk
}

-~> A text that is the same exactly when doc_rows gives the same rows.
function doc_rows_key(m, errors, folded) {
  str(doc_id(m)) + "|" + rows_key(errors, folded)
}

-~> What an error list changes in the rows, as a text ("" for none).
function rows_errors_key(errors) {
  if (errors == null || len(errors) == 0) {
    return ""
  }
  let parts = []
  for (let i = 0; i < len(errors); i = i + 1) {
    let e = errors[i]
    push(parts, str(e.line) + ":" + str(e.follow == true) + ":" + str(e.message))
  }
  text.join(parts, "\n")
}

-~> The folded keys, as a text ("" for none).
function rows_folds_key(folded) {
  if (folded == null) {
    return ""
  }
  let on = []
  let ks = keys(folded)
  for (let i = 0; i < len(ks); i = i + 1) {
    if (folded[ks[i]] == true) {
      push(on, ks[i])
    }
  }
  text.join(on, "\n")
}

-~> The rows that can fold, as [{"line", "end_line", "key"}], once per text.
function rows_folds(m) {
  let c = m.cache
  if (c.folds == null) {
    let rows = rows_base(m)
    let lines = doc_parsed(m).lines
    let out = []
    for (let i = 0; i < len(rows); i = i + 1) {
      let r = rows[i]
      if (r.foldable) {
        push(out, {"line": r.line, "end_line": r.end_line, "key": fold_key(r.stmt, lines[i])})
      }
    }
    c.folds = out
  }
  c.folds
}

-~> The rows with the errors on their lines and the folds applied: a folded
-~> row is collapsed and every line inside it is hidden. Only the rows that
-~> change are copied.
function rows_decorate(m, base, errors, folded) {
  let rows = list.copy(base)
  let n = len(rows)
  if (errors != null) {
    let seen = {}
    for (let i = 0; i < len(errors); i = i + 1) {
      let k = errors[i].line
      if (type(k) == "INTEGER" && k >= 1 && k <= n && seen[k] == null) {
        seen[k] = true
        let r = hash_copy(rows[k - 1])
        r.error = errors[i].message
        if (errors[i].follow == true) {
          r.error = t("err.follow") + ": " + errors[i].message
          r.follow = true
        }
        rows[k - 1] = r
      }
    }
  }
  if (folded != null) {
    let folds = rows_folds(m)
    for (let i = 0; i < len(folds); i = i + 1) {
      let f = folds[i]
      if (folded[f.key] == true) {
        let r = hash_copy(rows[f.line - 1])
        r.collapsed = true
        rows[f.line - 1] = r
        for (let l = f.line + 1; l <= f.end_line && l <= n; l += 1) {
          if (rows[l - 1].visible) {
            let h = hash_copy(rows[l - 1])
            h.visible = false
            rows[l - 1] = h
          }
        }
      }
    }
  }
  rows
}

-~> The key under which a row's fold state is kept, or null if it can't fold.
function row_fold_key(m, line) {
  let r = doc_row(m, line, null, null)
  if (!r.foldable) {
    return null
  }
  fold_key(r.stmt, doc_parsed(m).lines[line - 1])
}

-~> True when the row or any layer around it carries the flag ("hidden" or "locked").
function row_has_flag(rows, line, flag) {
  let n = line
  while (n > 0) {
    let r = rows[n - 1]
    if (flag == "hidden" && r.hidden) {
      return true
    }
    if (flag == "locked" && r.locked) {
      return true
    }
    n = r.parent
  }
  false
}

-~> The shapes of a run that should be painted, back to front: the ones in
-~> hidden rows or hidden layers are left out.
function shapes_to_paint(shapes, rows) {
  let out = []
  let ordered = paint_order(shapes)
  for (let i = 0; i < len(ordered); i = i + 1) {
    let s = ordered[i]
    let skip = false
    if (type(s.line) == "INTEGER" && s.line >= 1 && s.line <= len(rows)) {
      skip = row_has_flag(rows, s.line, "hidden")
    }
    if (!skip) {
      push(out, s)
    }
  }
  out
}

-~> The layer rows of a model, outermost first, as [{"line", "name", "depth"}].
function doc_layers(m) {
  let rows = doc_rows(m, null, null)
  let out = []
  for (let i = 0; i < len(rows); i = i + 1) {
    if (rows[i].kind == "layer") {
      push(out, {"line": rows[i].line, "name": rows[i].stmt.name, "depth": rows[i].depth})
    }
  }
  out
}

-~> The line of the layer the caret is in (or on), or null when it is loose.
function doc_current_layer(m) {
  let r = doc_row(m, m.line, null, null)
  if (r.kind == "layer") {
    return r.line
  }
  if (r.layer > 0) {
    return r.layer
  }
  null
}
