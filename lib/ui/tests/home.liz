-~> Trash: the file goes, and leaves recent.
let uno = home_list(dir)
let u = null
for (let i = 0; i < len(uno); i = i + 1) { if (uno[i].name == "uno.lzdraw") { u = uno[i] } }
puts(home_trash(u), trashed, fake_files[u.path], home_recent_load()[0] != u.path, home.status)

-~> == Layout at 512 x 360 ==
times = {}
fake_files = {}
let order = ["layers", "strokes", "night-city", "hello", "mountains", "lily", "badge", "waves", "poster", "grid", "bird", "tree"]
for (let i = 0; i < len(order); i = i + 1) { add(order[i] + ".lzdraw", 1000 - i) }
home_scan()
home.recent = []
home.size = (512, 360)
let lay = home_layout()
puts(lay.new.x, lay.new.y, lay.new.w, lay.new.h)
puts(len(lay.cards), lay.titles[0].y, lay.titles[1].y, lay.grid_y)
let c = lay.cards
puts([c[0].x, c[0].y, c[0].w, c[0].h], [c[2].x, c[2].y], c[0].file.name)
puts([c[3].x, c[3].y, c[3].w, c[3].h], [c[7].x, c[7].y], [c[8].x, c[8].y], [c[14].x, c[14].y])
puts(lay.height, home_max_scroll())
home.scroll = 100
puts(home_layout().cards[3].y, home_layout().new.y)
home.scroll = 0
home.query = "r"
lay = home_layout()
puts(len(lay.cards), lay.new, lay.titles[0].key, lay.grid_y)
home.query = "zzz"
puts(home_layout().none)
home.query = ""
home.size = (400, 300)
puts(home_cols(400), home_cols(512), home_cols(100), home_work_count(400), home_work_count(512), home_work_count(900))
home.size = (512, 360)
puts(home_layout().empty)
times = {}
fake_files = {}
home_scan()
puts(home_layout().empty, len(home.cards))
