puts(names(home_working(files, [dir + "/a.lzdraw"], 2)))
puts(names(home_working(files, [dir + "/a.lzdraw", dir + "/a.lzdraw"], 4)))
puts(names(home_working(files, [], 0)))

-~> == How long ago ==
-~> now is Wednesday 2026-11-04 12:00 UTC
let now = 1793793600
let ago = [30, 60, 300, 3599, 3600, 7200, 82800, 86399 + 1, 129600, 172800, 259200, 345600, 518400, 604800, 1036800, 1209600, 1900800, 2419200, 3024000, 5184000, 31536000, 70000000]
puts("-- en")
lang_use("en")
for (let i = 0; i < len(ago); i = i + 1) {
  puts(ago[i], home_when(now - ago[i], now, 0))
}
puts("-- es")
lang_use("es")
for (let i = 0; i < len(ago); i = i + 1) {
  puts(ago[i], home_when(now - ago[i], now, 0))
}
lang_use("en")
puts("-- midnight and the time zone")
-~> 01:00 UTC on the 4th is still the 3rd in Bogota (UTC-5)
let early = 1793754000 + 0
puts(home_days_between(early - 7200, early, 0), home_days_between(early - 7200, early, -18000))
puts(home_weekday(now, 0), home_weekday(now - 86400 * 3, 0))

