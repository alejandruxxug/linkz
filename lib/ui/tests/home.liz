fake_files[dir + "/notes.txt"] = "x"
times[dir + "/notes.txt"] = 999
let files = home_list(dir)
puts(names(files))
puts(files[0].stem, files[0].path)
puts(names(home_sort(files, "name")))
puts(names(home_sort(files, "edited")))
puts(home_next_sort("edited"), home_next_sort("name"), home_next_sort("x"))
puts(len(home_list("/nowhere")))

