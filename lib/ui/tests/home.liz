-~> The home screen's logic on in-memory files: the folder, the list, sort,
-~> search, recent.liz, how long ago in English and Spanish, wrapping labels,
-~> and the actions that change files.
let dir = "/home/u/Documents/Linkz"
let times = {}
os.home = function() { "/home/u" }
fs.list = function(d, ext) {
  let out = []
  let ks = keys(times)
  for (let i = 0; i < len(ks); i = i + 1) {
    let k = ks[i]
    if (text.starts(k, d + "/") && text.ends(k, ext)) {
      push(out, {"name": text.slice(k, len(d) + 1, len(k)), "path": k, "mtime": times[k], "size": 10})
    }
  }
  out
}
fs.mkdir = function(p) { null }
fs.write = function(p, body) {
  fake_files[p] = body
  if (times[p] == null) { times[p] = 500 }
  null
}
fs.rename = function(a, b) {
  if (fake_files[b] != null) { error(b + " already exists") }
  fake_files[b] = fake_files[a]
  times[b] = times[a]
  delete(fake_files, a)
  delete(times, a)
  null
}
fs.copy = function(a, b) {
  if (fake_files[b] != null) { error(b + " already exists") }
  fake_files[b] = fake_files[a]
  times[b] = 1
  null
}
let trashed = []
fs.trash = function(p) { push(trashed, p); delete(fake_files, p); delete(times, p); null }
let shown = []
function show_screen(name, args) { push(shown, name) }
function add(name, mtime) {
  let p = dir + "/" + name
  fake_files[p] = "canvas = {\"size\": (100, 50), \"background\": #ffffff}\nrect((0, 0), (50, 50), #ff0000)\n"
  times[p] = mtime
}
function names(files) {
  let out = []
  for (let i = 0; i < len(files); i = i + 1) { push(out, files[i].name) }
  text.join(out, " ")
}

