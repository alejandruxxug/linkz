puts(home_recent_parse(body) == paths)
puts(home_recent_parse("-~> hand edit\nlet recent = [\n  \"/p/q.lzdraw\",   \n\n  \"/p/r.lzdraw\"\n]\n"))
puts(home_recent_parse(""), home_recent_text([]))
puts(home_recent_add(["a", "b", "c"], "b"))
puts(home_recent_add(["a", "b"], "z"))
let long = ["1", "2", "3", "4", "5", "6", "7", "8"]
puts(home_recent_add(long, "9"))
puts(len(home_recent_add(long, "9")), len(home_recent_add(long, "3")))
puts(home_recent_remove(["a", "b", "a"], "a"))
puts(home_recent_replace(["a", "b"], "b", "c"))
