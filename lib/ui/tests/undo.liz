-~> The editor state: undo and redo of edits, gestures and strokes; running and errors.
use "../editor_doc"
use "../editor_state"
use "../editor_undo"
use "../lang_en"
use "../lang_es"
ed_reset("circle((100, 100), 30, #3fa34d)\n", "")
puts(ed_dirty(), len(ed.undo))
-~> Typing along one row is one step.
ed_set_caret(1, 0)
ed_type("a")
ed_type("b")
ed_type("ñ")
puts(doc_text(ed_model()), len(ed.undo), ed_dirty())
ed_undo()
puts(doc_text(ed_model()) == "circle((100, 100), 30, #3fa34d)\n", ed_model().col)
puts(ed_redo(), doc_cur(ed_model()))
ed_undo()
-~> A caret move is not a step; a new edit clears redo.
ed_set_caret(1, 5)
ed_move_caret("right", false)
puts(len(ed.undo), len(ed.redo))
ed_key("Enter", {"shift": false})
puts(len(ed.undo), len(ed.redo), ed_model().line)
ed_undo()
puts(ed_model().line, ed_model().col, len(ed_model().lines))
-~> Keys: Backspace, Cmd+Z, Shift+Cmd+Z, Tab, Alt+Down.
ed_set_caret(1, 3)
ed_key("Backspace", null)
puts(doc_cur(ed_model()))
ed_key("Z", {"cmd": true})
puts(doc_cur(ed_model()))
ed_key("Z", {"cmd": true, "shift": true})
puts(doc_cur(ed_model()))
ed_key("Z", {"cmd": true})
ed_key("Tab", null)
puts("[" + doc_cur(ed_model()) + "]")
ed_key("Tab", {"shift": true})
puts(doc_cur(ed_model()), ed_key("F13", null))
-~> A gesture (a drag) is one step however many edits it makes.
ed_reset("circle((10, 10), 5, #fff)\n", "")
ed_run()
let c = ed.shapes[0]
let anchor = c.anchors[0]
let before = len(ed.undo)
ed_begin_gesture()
for (let i = 1; i <= 5; i = i + 1) {
  ed_move_anchor(c, anchor, (10 + i * 10, 10 + i * 5))
}
ed_end_gesture()
puts(doc_cur(ed_model()), len(ed.undo) - before)
ed_undo()
puts(doc_cur(ed_model()))
-~> A refused drag leaves the text alone and says why.
ed_reset("let y = 4\ncircle((10, y * 2), 5, #fff)\n", "")
ed_run()
let before2 = len(ed.undo)
puts(ed_move_anchor(ed.shapes[0], ed.shapes[0].anchors[0], (50, 50)))
puts(ed.status, ed.refusal.line, len(ed.undo) == before2, ed_dirty())
-~> Running: errors map to rows and the last good drawing stays.
ed_reset("circle((100, 100), 30, #3fa34d)\n", "")
ed_settle()
puts(len(ed.shapes), ed.stale, len(ed.errors))
ed_set_code("circle((100, 100), 30, #3fa34d)\nnope(1)\n")
ed_settle()
puts(len(ed.shapes), ed.stale, len(ed.errors), ed.errors[0].line)
let rows = ed_rows()
puts(rows[0].error, "|", rows[1].error)
ed_set_code("circle((100, 100), 30, #3fa34d\n")
ed_settle()
puts(len(ed.shapes), ed.stale, len(ed.errors) > 0)
ed_set_code("circle((100, 100), 30, #3fa34d)\ncircle((5, 5), 3, #fff)\n")
ed_settle()
puts(len(ed.shapes), ed.stale, len(ed.errors), ed.stats.steps >= 0)
-~> Folding is editor-only: it survives undo and isn't in the text.
ed_reset("layer a\n  circle((1, 1), 2, #fff)\nlayer b\n", "")
puts(ed_toggle_fold(1), ed_toggle_fold(2), ed_rows()[1].visible)
ed_set_caret(3, 0)
ed_type("x")
ed_undo()
puts(ed_rows()[1].visible, ed_toggle_fold(1), ed_rows()[1].visible)
-~> Hidden layers are not painted.
ed_reset("layer a -~> [hidden]\n  circle((1, 1), 2, #fff)\ncircle((9, 9), 2, #000)\n", "")
ed_settle()
puts(len(ed.shapes), len(ed_paint_shapes()))
