-~> Every parse error goes to its own row. The parser recovers at the end of a
-~> statement, so a mistake on one row leaves the valid rows after it alone,
-~> and two mistakes are two errors.
use "../editor_state"
use "../editor_undo"
use "../i18n"
use "../view_panels"
use "../lang_en"
use "../lang_es"
ed_reset("-~> lzdraw 1\n-~> A sunset in layers. Layers higher in the file are in front, and so are\n-~> the objects higher inside a layer. The loop is one object.\n\ncanvas = {\"size\": (480, 320), \"background\": #f6d9a8}\n\nlet horizon = 200\n\nlayer sun\n  circle((360, 90), 34, #zzz)\n  circle((360, 90), 56, #f2a65a66)\n\nlayer boat\n  polygon([(120, 214), (180, 214), (165, 232), (135, 232)], #3b2a6b)\n  line((150, 214), (150, 170), #3b2a6b 3)\n  polygon([(152, 174), (152, 208), (182, 208)], #fbf8ef)\n\nlayer sky\n  rect((0, 0), (480, horizon), #f2a65a)\n", "/d.lzdraw")
ed_run()
let rows = ed_rows()
for (let i = 0; i < len(rows); i = i + 1) {
  if (rows[i].error != null) {
    puts(rows[i].line, rows[i].error)
  }
}
puts(view_status_parts()[0][1][1])
lang_use("es")
puts(view_status_parts()[0][1][1])
lang_use("en")

-~> One error, and a runtime error, are counted alone.
ed_reset("circle((10, 10), #fff)\n", "/d.lzdraw")
ed_run()
puts(view_status_parts()[0][1][1])
ed_reset("circle((10, 10), 5, #fff)\nlet x = nothing_here\n", "/d.lzdraw")
ed_run()
puts(len(ed.errors), view_status_parts()[0][1][1])
