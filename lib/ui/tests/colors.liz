-~> The color pickers' math and the color variables: hsv and back (exact
-~> with hex), the wheel's ring and triangle, the harmonies, and the
-~> `let colors = {...}` hash read and changed as code.
use "../color_harmony"
use "../color_hsv"
use "../color_vars"
use "../color_wheel"
use "../editor_doc"
use "../lang_en"

function show_hsv(h) {
  str(math.round(h.h)) + "° " + str(math.round(h.s * 100)) + "% " + str(math.round(h.v * 100)) + "% a" + str(h.a)
}

puts("-- hsv")
puts(show_hsv(hsv_of(#3fa34d)), show_hsv(hsv_of(#ff0000)), show_hsv(hsv_of(#808080)), show_hsv(hsv_of(#f2a65a66)))
puts(hsv_color({"h": 0, "s": 1, "v": 1, "a": 255}), hsv_color({"h": 120, "s": 1, "v": 1}), hsv_color({"h": 240, "s": 0.5, "v": 0.5, "a": 128}))
puts(hsv_color({"h": 360, "s": 1, "v": 1, "a": 255}), hsv_color({"h": -60, "s": 1, "v": 1, "a": 255}))

puts("-- every color comes back the same")
let bad = 0
let tried = 0
for (let r = 0; r < 256; r = r + 15) {
  for (let gr = 0; gr < 256; gr = gr + 17) {
    for (let b = 0; b < 256; b = b + 13) {
      let c = rgba(r, gr, b, (r + b) % 256)
      tried = tried + 1
      if (hsv_color(hsv_of(c)) != c || color_parse(color_hex(c)) != c) {
        bad = bad + 1
      }
    }
  }
}
puts(tried, "colors,", bad, "changed")

puts("-- hex and alpha fields")
puts(color_parse("#3fa34d"), color_parse("3fa"), color_parse("#3fa34d80"), color_parse("#zzz"), color_parse("12345"))
puts(alpha_text(#ffffff), alpha_text(#ffffff80), alpha_parse("40%"), alpha_parse("100"), alpha_parse("x"))
puts(color_with_alpha(#3fa34d, 102))

puts("-- a grey keeps the picker's hue")
let was = {"h": 200.0, "s": 0.7, "v": 0.5, "a": 255}
puts(show_hsv(hsv_keep_hue(#808080, was)), show_hsv(hsv_keep_hue(#000000, was)), show_hsv(hsv_keep_hue(hsv_color(was), was)))

puts("-- harmonies")
for (let i = 0; i < len(harmony_modes); i = i + 1) {
  let mode = harmony_modes[i]
  let cs = harmony_colors(#3fa34d, mode)
  let hues = []
  for (let k = 0; k < len(cs); k = k + 1) {
    push(hues, str(math.round(hsv_of(cs[k]).h)))
  }
  puts(mode, cs, text.join(hues, " "))
}
puts("complementary of #3fa34d is hue + 180:", math.round(hsv_of(harmony_colors(#3fa34d, "complementary")[1]).h - hsv_of(#3fa34d).h))
puts(harmony_colors(#f2a65a80, "triadic"))
puts(harmony_names("sky", 2, ["sky", "sky_2"]), harmony_names("color", 3, []))

puts("-- the wheel")
let wh = {"cx": 100.0, "cy": 100.0, "r": 44.0, "w": 7.0}
let cs = wheel_corners(wh, 0)
puts(math.round(cs[0].x), math.round(cs[0].y), math.round(cs[1].x), math.round(cs[1].y), math.round(cs[2].x), math.round(cs[2].y))
let pts = [{"h": 30.0, "s": 0.63, "v": 0.95, "a": 255}, {"h": 200.0, "s": 0.0, "v": 1.0, "a": 255}, {"h": 75.0, "s": 1.0, "v": 1.0, "a": 255}, {"h": 300.0, "s": 0.3, "v": 0.2, "a": 255}]
for (let i = 0; i < len(pts); i = i + 1) {
  let p = wheel_point(wh, pts[i])
  let sv = wheel_sv_at(wh, pts[i].h, p, null)
  puts(show_hsv(pts[i]), "->", math.round(sv[0] * 100), math.round(sv[1] * 100), wheel_part_at(wh, pts[i].h, p))
}
puts(math.round(wheel_angle(wh, wheel_hue_point(wh, 123))), wheel_part_at(wh, 30, wheel_hue_point(wh, 123)), wheel_part_at(wh, 30, (1, 1)))
let outside = wheel_sv_at(wh, 0, (100, 300), null)
puts("below the triangle:", math.round(outside[0] * 100), math.round(outside[1] * 100))
let sq = [10, 10, 97, 53]
let sp = square_point(sq, {"h": 0, "s": 0.25, "v": 0.75})
puts(sp, square_sv_at(sq, sp), strip_t([0, 0, 101, 6], 50))

puts("-- the variables")
let code = "-~> lzdraw 1
-~> a note

canvas = {\"size\": (480, 320), \"background\": #f6d9a8}
circle((360, 90), 34, #fff3c4)
"
let m = doc_new(code)
puts(colors_find(m))
let m1 = colors_add(m, "sun", "#fff3c4")
puts(text.join(m1.lines, "\n"))
let m2 = colors_add(m1, "dusk", "gradient([#3b2a6b, #e0607a], 90deg)")
let cv = colors_find(m2)
puts(colors_names(cv), colors_entry(cv, "dusk").text, cv.line, cv.end_line)
puts(colors_add(m2, "sun", "#000"), colors_add(m2, "2x", "#000"))
let m3 = doc_with(m2, span_replace(m2.lines, 7, 23, 7, 30, "colors.sun"), 1, 0)
puts(m3.lines[6], colors_uses(m3, "sun"), colors_uses(m3, "dusk"))
let m4 = colors_set(m3, "sun", "#ffeeaa80")
puts(m4.lines[3])
let m5 = colors_rename(m4, "sun", "glow")
puts(m5.lines[3], "|", m5.lines[6])
puts(colors_rename(m5, "glow", "dusk"), colors_rename(m5, "nope", "x"))
puts(colors_remove(m5, "glow", false).uses)
let m6 = colors_remove(m5, "glow", true)
puts(m6.lines[3], colors_find(m6).entries[0].name)
puts(colors_remove(m6, "dusk", false).lines[3])
puts(colors_free_name(colors_find(m5), "glow"), colors_free_name(colors_find(m5), "sky"))
puts(colors_clean_name(" my color-2 "), colors_clean_name("9lives"), colors_valid_name("a_b2"), colors_valid_name("a b"))

puts("-- a hash on many lines")
let many = doc_new("let colors = {
  \"sky\": #f2a65a,  -~> the sky
  \"dusk\": gradient([#3b2a6b,
    #e0607a], 90deg)
}
rect((0, 0), (10, 10), colors.sky)
")
let cvm = colors_find(many)
puts(colors_names(cvm), colors_entry(cvm, "dusk").text, cvm.end_line)
let a1 = colors_add(many, "sea", "#2d6a8f")
puts(text.join(list.slice(a1.lines, 0, 6), "|"))
let r1 = colors_remove(a1, "dusk", true)
puts(text.join(list.slice(r1.lines, 0, 5), "|"))
let r2 = colors_remove(r1, "sea", true)
puts(text.join(list.slice(r2.lines, 0, 4), "|"))
puts(colors_rename(many, "sky", "dawn").lines[5], colors_refs_in("x(colors.sky, \"colors.sky\", mycolors.sky, colors.skyline) -~> colors.sky", "sky"))
