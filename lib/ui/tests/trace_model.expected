-~> lzdraw 1
canvas = {"size": (480, 320), "background": #ffffff}
pens.traced = {"name": "traced", "min": 2.5, "max": 3}
layer traced
  layer lines
    brush([(48, 61), (35, 61)], [0, 0.4], #3d3456, pens.traced)
    brush([(49, 61), (50, 33)], [0.1, 0], #3d3456, pens.traced)
  layer fills
    path([(35, 62), (45, 62), (48, 63)], #f6d9c8)
layer sun
  circle((360, 90), 34, #fff3c4)
layer sky
  rect((0, 0), (480, 200), #f2a65a)

