-~> == The document's own names ==
fresh("-~> A wave.\nfunction wave(a, b) {\n  a\n}\nlet horizon = 200\nlayer sun\n  circle((1, 2), 3, #fff)\n")
ed_set_caret(8, 0)
typed("wa")
puts("wa:", first(2), cmp.items[0].item.kind, cmp.items[0].item.sig)
fresh("-~> A wave.\nfunction wave(a, b) {\n  a\n}\nlet horizon = 200\nlayer sun\n  circle((1, 2), 3, #fff)\n")
ed_set_caret(8, 0)
typed("ho")
puts("ho:", first(2), cmp.items[0].item.kind)
fresh("-~> A wave.\nfunction wave(a, b) {\n  a\n}\nlet horizon = 200\nlayer sun\n  circle((1, 2), 3, #fff)\n")
ed_set_caret(8, 0)
typed("su")
puts("su:", first(2), cmp.items[0].item.kind)
ed_reset("function circle(q) {\n  q\n}\n", "")
cmp_reset()
ed_set_caret(4, 0)
typed("circ")
puts("own function hides the library's:", len(cmp.items), cmp.items[0].item.kind, cmp.items[0].item.sig)

-~> == Accepting: the call, the first argument selected, Tab on ==
fresh("")
typed("ci")
puts(cmp_accept_selected(), cmp.open)
show(ed_model())
puts("selected:", cmp.ph.cur, cmp.ph.fresh, text.slice(row_now(), cmp.ph.spans[0][0], cmp.ph.spans[0][1]))
puts("undo text:", ed_undo_text(), len(ed.undo))
typed("(10, 20)")
puts(row_now(), cmp.ph.fresh)
press("Tab", null)
puts("tab ->", cmp.ph.cur, text.slice(row_now(), cmp.ph.spans[1][0], cmp.ph.spans[1][1]), ed_model().col)
typed("9")
press("Tab", null)
puts("tab ->", cmp.ph.cur, text.slice(row_now(), cmp.ph.spans[2][0], cmp.ph.spans[2][1]))
press("Tab", {"shift": true})
puts("shift+tab ->", cmp.ph.cur, text.slice(row_now(), cmp.ph.spans[1][0], cmp.ph.spans[1][1]))
press("Tab", null)
press("Tab", null)
puts("past the last:", cmp.ph, row_now(), ed_model().col == len(row_now()))
puts("typing steps:", ed_undo_text())
fresh("")
typed("ci")
cmp_accept_selected()
puts("one step:", ed_undo_text(), len(ed.undo))
ed_undo()
puts("undo accept:", row_now())
ed_redo()
puts("redo accept:", row_now(), ed_model().col)
-~> backspace on a selected argument empties it
fresh("")
typed("rect")
cmp_accept_selected()
press("Backspace", null)
puts("backspace:", row_now(), cmp.ph.fresh)
-~> a call that already has a "(" after the word gets only its name
fresh("ci(1)")
ed_set_caret(1, 2)
cmp_refresh(false)
puts(first(1))
cmp_accept_selected()
puts(row_now(), cmp.ph)
-~> a user function becomes its call with its parameters; a keyword and a member only a name
fresh("function wave(a, b) {\n  a\n}\n")
ed_set_caret(4, 0)
typed("wa")
cmp_accept_selected()
puts(row_now(), cmp.ph.cur, len(cmp.ph.spans))
fresh("")
typed("fu")
cmp_accept_selected()
puts(row_now(), cmp.ph)
fresh("")
typed("math.sq")
cmp_accept_selected()
puts(row_now(), cmp.ph)
-~> the indented row of a layer keeps its indent
fresh("layer a\n  ")
typed("ell")
cmp_accept_selected()
puts(row_now())

-~> == Enter ==
fresh("")
typed("ci")
puts("list open, Enter accepts:", press("Enter", null), len(ed_model().lines), row_now())
puts("list closed, Enter is a new row:", press("Enter", null), len(ed_model().lines), ed_model().line)
puts("undo text:", ed_undo_text())
fresh("")
typed("let r = 5")
puts("no word, Enter:", cmp.open)
press("Enter", null)
puts(len(ed_model().lines), ed_model().line)
fresh("")
typed("ci")
press("Escape", null)
puts("esc:", cmp.open)
typed("r")
puts("same word stays closed:", cmp.open)
typed(" ")
typed("ci")
puts("next word opens:", cmp.open)
-~> Tab with no list and no arguments is the editor's indent
fresh("let a = 1")
press("Tab", null)
puts(row_now())
-~> Up and Down move; wraps; a long list scrolls
fresh("")
typed("c")
press("ArrowDown", null)
puts("down:", cmp.sel)
press("ArrowUp", null)
press("ArrowUp", null)
puts("up wraps:", cmp.sel, cmp.top)
fresh("")
typed("math.")
for (let i = 0; i < 9; i = i + 1) {
  press("ArrowDown", null)
}
puts("scroll:", cmp.sel, cmp.top)
press("Enter", null)
puts(row_now())
-~> moving the caret off the word closes the list
fresh("")
typed("ci")
ed_move_caret("left", false)
ed_move_caret("left", false)
cmp_sync()
puts("caret moved off:", cmp.open)
-~> the Complete command opens it with nothing typed
let cmds = editor_debug_commands()
fresh("")
cmds["Complete"]([])
puts("forced:", cmp.open, len(cmp.items) > 20, editor_debug_state().complete.open)

-~> == Signature hint ==
function call_at(s) {
  let c = cmp_call_at(s, len(s))
  if (c == null) {
    return "none"
  }
  c.callee + "#" + str(c.index)
}
puts(call_at("circle("))
puts(call_at("circle((10, 20), "))
puts(call_at("circle((10, "))
puts(call_at("circle((10, 20), 5, "))
puts(call_at("polygon([(1, 2), "))
puts(call_at("polygon([(1, 2)], "))
puts(call_at("polygon([(1, 2), (3, 4)], #fff"))
puts(call_at("line(circle((1, 2), 3), "))
puts(call_at("line(rect((1, 2), (3, 4), #fff), (5, "))
puts(call_at("circle(\"a,b\", "))
puts(call_at("circle((1, 2), 3, #fff)"))
puts(call_at("let x = 3"))
puts(call_at("if (x"))
puts(call_at("function foo(a, b"))
puts(call_at("circle(1, 2) -~> circle("))
puts(call_at("let g = {\"k\": circle(1, "))
fresh("circle((10, 20), ")
let h = cmp_hint_at(ed_model(), ed_docs())
puts(h.callee, h.index, h.param, "|", h.doc)
fresh("circle((10, ")
h = cmp_hint_at(ed_model(), ed_docs())
puts("in a point:", h.index, h.param)
fresh("circle((10, 20), 5, #fff, 7, ")
h = cmp_hint_at(ed_model(), ed_docs())
puts("too many:", h.index, "[" + h.param + "]")
fresh("math.max(1, ")
puts("not a library function:", cmp_hint_at(ed_model(), ed_docs()))
fresh("function wave(a, b) {\n  a\n}\nwave(1, ")
h = cmp_hint_at(ed_model(), ed_docs())
puts("user function:", h.callee, h.param)
cmp_sync()
puts("sync:", cmp.hint.callee, cmp.hint.param)

-~> == The Dump ==
fresh("")
typed("ci")
let d = editor_debug_state().complete
puts(d.open, d.selected, list.slice(d.items, 0, 2), d.hint)
cmp_accept_selected()
d = editor_debug_state().complete
puts(d.open, d.hint.callee, d.hint.param, d.arg)

-~> == Languages ==
set_language("es")
fresh("")
typed("ci")
cmp_accept_selected()
puts(ed_undo_text())
puts(t("complete.header"), t("complete.member", {"owner": "math"}))
set_language("en")
puts(ed_undo_text())

-~> == The approved list (R002-20, 22): kind column, icons, doc block ==
function shown_rows() {
  let out = []
  for (let i = 0; i < len(cmp.items); i = i + 1) {
    let it = cmp.items[i].item
    push(out, it.name + " " + cmp_icon(it) + cmp_icon_letter(it) + " " + cmp_kind_label(ed_model(), it))
  }
  text.join(out, " | ")
}
function block_now() {
  let b = cmp_doc_block(cmp.items[cmp.sel].item)
  let sig = b.name
  if (b.call) {
    sig = b.name + "(" + b.params + ")"
  }
  sig + " / " + b.doc
}
fresh("function circle_ring(c, r) {\n  circle(c, r, #fff)\n}\nlet city_glow = 3\nlayer city\n  rect((0, 0), (1, 1), #000)\n")
typed("ci")
puts(shown_rows())
puts(block_now())
fresh("")
typed("math.s")
puts(shown_rows())
puts(block_now())
fresh("")
typed("pens.c")
puts(shown_rows(), "/", block_now())
fresh("let colors = {\"sun\": #fff3c4}\n")
typed("colors.s")
puts(shown_rows(), "/", block_now())
fresh("")
typed("conti")
puts(shown_rows(), "/", block_now())
set_language("es")
fresh("")
typed("math.s")
puts(shown_rows(), "/", block_now(), "/", t("complete.footer"))
set_language("en")

-~> == Typing a row keeps the last good drawing ==
-~> A half-typed name or call breaks the run; while the caret stays on the row
-~> its errors wait and the drawing stays as it was (no error state).
fresh("circle((10, 10), 5, #fff)\n")
ed_settle()
typed("ci")
ed_settle()
puts("typing ci:", len(ed.shapes), len(ed.errors), ed.stale, ed_holding(), cmp_typing())
press("Escape", null)
puts("list closed, still held:", ed_holding(), cmp_typing(), len(ed.errors))
typed("rcle((20, 20), ")
ed_settle()
cmp_sync()
puts("half a call:", len(ed.errors), ed.stale, ed_holding(), cmp.hint.param)
ed_move_caret("up", false)
cmp_sync()
puts("caret left the row:", len(ed.errors), ed.stale, ed_holding(), ed.errors[0].line)
ed_move_caret("down", false)
cmp_sync()
puts("back on it:", len(ed.errors), ed.stale, ed_holding())
-~> Finishing the row runs it as usual.
fresh("circle((10, 10), 5, #fff)\n")
ed_settle()
typed("rect((1, 1), (2, 2), #000)")
ed_settle()
puts("finished:", len(ed.shapes), len(ed.errors), ed.stale, ed_holding())
-~> Enter on a broken row shows its errors.
fresh("circle((10, 10), 5, #fff)\n")
ed_settle()
typed("ci")
ed_settle()
press("Escape", null)
press("Enter", null)
ed_settle()
cmp_sync()
puts("enter:", len(ed.errors), ed.stale, ed_holding())
-~> A drawing that was broken already shows a new error at once.
fresh("nope(1)\n")
ed_settle()
typed("ci")
ed_settle()
puts("already broken:", len(ed.errors), ed.stale, ed_holding())
-~> Typing on a row while another row changed since the last good run: shown.
fresh("circle((10, 10), 5, #fff)\n")
ed_settle()
ed_set_code("circle((10, 10), 5, #fff)\nzz\n")
ed_settle()
puts("set code:", len(ed.errors), ed.stale, ed_holding())
-~> Undo after a held error: the good text again, nothing held.
fresh("circle((10, 10), 5, #fff)\n")
ed_settle()
typed("ci")
ed_settle()
ed_undo()
ed_settle()
cmp_sync()
puts("undo:", len(ed.errors), ed.stale, ed_holding(), editor_debug_state().complete.held)
-~> The properties panel's line while typing, cut at a space when the panel is narrow.
let wide = cmp_props_typing("P", 400)
let narrow = cmp_props_typing("P", 244)
puts(wide.msg, "|", wide.hint)
puts(narrow.msg, "|", narrow.hint)
