-~> Autocomplete: ranking, members, the document's own names, the inserted call with
-~> its first argument selected, Tab between arguments, the signature hint, Enter, undo.
use "../complete_info"
use "../complete_model"
use "../complete_state"
use "../editor_commands"
use "../editor_doc"
use "../editor_state"
use "../editor_undo"
use "../i18n"
use "../lang_en"
use "../lang_es"
function typed(s) {
  for (let i = 0; i < len(s); i = i + 1) {
    cmp_ed_type(s[i])
  }
}
-~> What the view does with a key: the list and the arguments first, then the editor.
function press(name, mods) {
  if (cmp_intercept(text.lower(name), mods)) {
    return true
  }
  cmp_ed_key(name, mods)
}
function first(n) {
  let out = []
  for (let i = 0; i < len(cmp.items) && i < n; i = i + 1) {
    push(out, cmp.items[i].item.name)
  }
  text.join(out, " ")
}
function row_now() {
  doc_cur(ed_model())
}
function fresh(code) {
  ed_reset(code, "")
  cmp_reset()
  cmp.recent = []
  let m = ed_model()
  ed_set_caret(len(m.lines), len(m.lines[len(m.lines) - 1]))
}

-~> == Ranking ==
fresh("")
typed("ci")
puts("ci:", cmp.open, first(3))
cmp_close()
fresh("function stroke_width(w) {\n  w\n}\nlet sunrise = 1\n")
ed_set_caret(5, 0)
typed("sw")
puts("sw:", first(3), cmp.items[0].tier, cmp.items[0].hits)
fresh("")
typed("crc")
puts("crc:", first(2), cmp.items[0].tier, cmp.items[0].hits)
fresh("")
typed("c")
puts("c (by length):", first(4))
typed("xq")
puts("cxq closes:", cmp.open)
fresh("")
typed("zzq")
puts("nothing matches:", cmp.open)
-~> a name typed in full without a call to insert is not suggested; a function still is
fresh("")
typed("let")
puts("let typed:", cmp.open)
fresh("")
typed("circle")
puts("circle typed:", first(2))
-~> recently accepted goes first among equals
fresh("")
typed("co")
puts("co before:", first(3))
press("Tab", null)
puts(row_now())
fresh("")
cmp.recent = ["catch"]
typed("c")
puts("c after recent catch:", first(2))
-~> no list for numbers, comments, strings, colors, or where a name is made
fresh("")
typed("12")
puts("number:", cmp.open)
fresh("")
typed("-~> cir")
puts("comment:", cmp.open)
fresh("")
typed("let ci")
puts("let name:", cmp.open)
fresh("")
typed("\"ci")
puts("string:", cmp.open)
fresh("")
typed("#fff")
puts("color:", cmp.open)

