-~> Stand-ins for the host's fs, clip and os, all in memory, so the tests are
-~> hermetic. (The host's own are not exported to other packages.)
let fake_files = {}
-~> The host gives the UI the evaluated settings.liz as this hash.
let settings = {}
let fake_time = {"now": 0}
let time = {"ms": function() { fake_time.now }}
let fake_clip = {"text": ""}
let fake_os = {"locale": "en"}
let fs = {
  "read": function(p) { fake_files[p] },
  "write": function(p, body) { fake_files[p] = body; null },
  "exists": function(p) { fake_files[p] != null }
}
let clip = {"get": function() { fake_clip.text }, "set": function(s) { fake_clip.text = s; null }}
let os = {"locale": function() { fake_os.locale }}
let linkz = {"config_dir": function() { "/cfg" }}

-~> Empty the in-memory files and the settings, in place: the editor keeps
-~> the same hashes.
function reset_files() {
  let ks = keys(fake_files)
  for (let i = 0; i < len(ks); i += 1) {
    delete(fake_files, ks[i])
  }
}

function reset_settings() {
  let ks = keys(settings)
  for (let i = 0; i < len(ks); i += 1) {
    delete(settings, ks[i])
  }
}

-~> Prints a model compactly: its text with the caret as ‸ and the row selection.
function show(m) {
  let out = []
  for (let i = 0; i < len(m.lines); i = i + 1) {
    let s = m.lines[i]
    if (i + 1 == m.line) {
      s = text.slice(s, 0, m.col) + "|" + text.slice(s, m.col, len(s))
    }
    push(out, str(i + 1) + ": " + s)
  }
  let sel = ""
  if (m.sel != null) {
    sel = " sel " + str(m.sel.from) + "-" + str(m.sel.to)
  }
  puts(text.join(out, "\n") + sel)
}
