-~> home_example: the text of examples/layers.lzdraw, what "Open an example"
-~> copies into the drawings folder. (The binary carries no example files.)
-~> A test keeps it equal to the file.

let home_example = {"name": "layers.lzdraw", "text": "-~> lzdraw 1\n-~> A sunset in layers. Layers higher in the file are in front, and so are\n-~> the objects higher inside a layer. The loop is one object.\n\ncanvas = {\"size\": (480, 320), \"background\": #f6d9a8}\n\nlet horizon = 200\n\nlayer sun\n  circle((360, 90), 34, #fff3c4)\n  circle((360, 90), 56, #f2a65a66)\n\nlayer boat\n  polygon([(120, 214), (180, 214), (165, 232), (135, 232)], #3b2a6b)\n  line((150, 214), (150, 170), #3b2a6b, 3)\n  polygon([(152, 174), (152, 208), (182, 208)], #fbf8ef)\n\nlayer sea\n  layer waves\n    for (let i = 0; i < 5; i = i + 1) {\n      stroke([(40 + i * 20, horizon + 30 + i * 18), (140 + i * 30, horizon + 24 + i * 18), (240 + i * 20, horizon + 32 + i * 18), (440 - i * 10, horizon + 26 + i * 18)], #a9d3e4, 3)\n    }\n  rect((0, horizon), (480, 120), #2d6a8f)\n\nlayer sky\n  rect((0, 0), (480, horizon), #f2a65a)\n"}
