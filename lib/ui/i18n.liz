-~> i18n: the words of the interface, one table per language.
-~> Every label, button, status message and tooltip frame goes through
-~>   t("key")                       a plain text
-~>   t("key", {"file": name})       a text with {file} placeholders filled in
-~> (tf is the old name of the two-argument form and still works.)
-~> A language is one file, lib/ui/lang_<code>.liz, that calls lang_register.
-~> A key missing in the current language falls back to English; a key missing
-~> everywhere shows the key itself, which is easy to spot.

let i18n = {"lang": "en", "tables": {}}

function lang_register(code, table) {
  i18n.tables[code] = table
}

-~> The codes of the languages that are loaded.
function lang_codes() {
  keys(i18n.tables)
}

function lang_get() {
  i18n.lang
}

function lang_known(code) {
  type(code) == "STRING" && i18n.tables[code] != null
}

-~> Switches the language for the rest of the session. False for an unknown code.
function lang_use(code) {
  if (!lang_known(code)) {
    return false
  }
  i18n.lang = code
  true
}

function t(key, values = null) {
  let s = null
  let table = i18n.tables[i18n.lang]
  if (table != null) {
    s = table[key]
  }
  if (s == null && i18n.tables["en"] != null) {
    s = i18n.tables["en"][key]
  }
  if (s == null) {
    return key
  }
  if (values != null) {
    let ks = keys(values)
    for (let i = 0; i < len(ks); i = i + 1) {
      s = text.replace(s, "{" + ks[i] + "}", str(values[ks[i]]))
    }
  }
  s
}

-~> The old name of t(key, values), kept so nothing breaks.
function tf(key, values) {
  t(key, values)
}

function settings_path() {
  os.config_dir() + "/settings.liz"
}

-~> settings.liz is lizard code, e.g. `let language = "es"`. The host runs it
-~> once at startup and gives its variables to the UI as the hash `settings`
-~> (empty when there is no file or it has an error). Reading goes through
-~> that hash; writing edits the file's text and keeps its other lines.

-~> The settings text with `let language = "code"` set: that line replaced if
-~> the file has one, else added at the end. Always valid lizard.
function settings_with_language(body, code) {
  let line = "let language = \"" + code + "\""
  if (body == null || text.trim(body) == "") {
    return "-~> Linkz settings\n" + line + "\n"
  }
  let lines = text.split(body, "\n")
  for (let i = 0; i < len(lines); i = i + 1) {
    if (text.starts(text.trim(lines[i]), "let language")) {
      lines[i] = line
      return text.join(lines, "\n")
    }
  }
  if (!text.ends(body, "\n")) {
    body = body + "\n"
  }
  body + line + "\n"
}

-~> The language to start in: settings.liz, else the system's, else English.
function lang_detect() {
  let code = settings.language
  if (lang_known(code)) {
    return code
  }
  let sys = os.locale()
  if (lang_known(sys)) {
    return sys
  }
  "en"
}

function lang_init() {
  i18n.lang = lang_detect()
  i18n.lang
}

-~> Switches the language and remembers it in settings.liz. False for an unknown code.
function set_language(code) {
  if (!lang_use(code)) {
    return false
  }
  let path = settings_path()
  let body = null
  if (fs.exists(path)) {
    body = fs.read(path)
  }
  fs.write(path, settings_with_language(body, code))
  settings.language = code
  true
}
