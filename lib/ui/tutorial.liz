-~> tutorial: the first-run tutorial (style guide R002 10–14, "Spotlight",
-~> "Coach-mark"). Four steps, each pointing at a live part of the editor
-~> and waiting for the real action there (or Next):
-~>   1  the tool strip (the tool column in artist mode): a first shape
-~>   2  the palette's variables and the fill field: a new color
-~>   3  the brush and the canvas, with a dotted stroke to trace: a brush row
-~>   4  the new code rows (artist mode opens the code drawer): Let's draw!
-~> It shows the first time the editor opens, until it is finished or
-~> skipped; settings.liz then says `let tutorial_done = true`, and
-~> `let tutorial_step = n` remembers where it was, so a new start resumes
-~> there. The Home screen's ⚙ menu shows it again (tutorial_home.liz).
-~>
-~> This file is the state and the steps; tutorial_view.liz places and
-~> paints the spotlight and the coach-mark. view_main, view_input and
-~> view_popups call them, one line each.

use "artist_layout"
use "artist_route"
use "color_state"
use "editor_undo"
use "i18n"
use "mode_state"
use "palette_view"
use "tutorial_view"
use "view_input"
use "view_layout"

-~> on: showing. step: 1 to 4. base: the drawing when the step began (its
-~> action is a change from it). first: the code's lines when the tutorial
-~> began (step 4 rings the rows made since). drawer: step 4 opened the
-~> code drawer (it closes again at the end). closed: finished or skipped
-~> in this session. lay: the last paint's layout (tutorial_view.liz).
-~> spot: what the spotlight covered at the last paint.
let TUT = {"on": false, "step": 1, "base": null, "first": {}, "drawer": false, "closed": false, "lay": null, "spot": ""}

let tut_last_step = 4

-~> == What the drawing is now ==

-~> The code as one text.
function tut_text() {
  text.join(ed_model().lines, "\n")
}

-~> How many brush rows the code has.
function tut_brushes() {
  let n = 0
  let lines = ed_model().lines
  for (let i = 0; i < len(lines); i += 1) {
    if (text.starts(text.trim(lines[i]), "brush(")) {
      n += 1
    }
  }
  n
}

-~> Remembers the drawing as the step begins (run first, so its shapes
-~> are the code's).
function tut_snapshot() {
  view_prepare()
  TUT.base = {"shapes": len(ed.shapes), "text": tut_text(), "brushes": tut_brushes()}
}

-~> What happened since the step began: "done" when its own action did
-~> (1: a shape more; 2: the code changed with the same shapes, a new
-~> color; 3: a brush row more), "again" when the step must start over
-~> from now (a shape or a brush row less, or step 2's shapes changed),
-~> else "".
function tut_progress() {
  let b = TUT.base
  if (b == null) {
    return ""
  }
  let n = len(ed.shapes)
  if (TUT.step == 1 && n != b.shapes) {
    if (n > b.shapes) {
      return "done"
    }
    return "again"
  }
  if (TUT.step == 2) {
    if (n != b.shapes) {
      return "again"
    }
    if (tut_text() != b.text) {
      return "done"
    }
  }
  if (TUT.step == 3 && tut_brushes() != b.brushes) {
    if (tut_brushes() > b.brushes) {
      return "done"
    }
    return "again"
  }
  ""
}

-~> == Settings ==

-~> Writes `let <name> = <code>` into settings.liz (a file that can't be
-~> written only loses the memory) and into `settings`.
function tut_store(name, value) {
  settings[name] = value
  try {
    let path = settings_path()
    let body = null
    if (fs.exists(path)) {
      body = fs.read(path)
    }
    fs.write(path, mode_settings_with(body, name, str(value)))
  } catch (e) {
    null
  }
}

-~> The step to start at: the one settings.liz remembers, else the first.
function tut_saved_step() {
  let s = settings.tutorial_step
  if (type(s) == "INTEGER" && s >= 1 && s <= tut_last_step) {
    return s
  }
  1
}

-~> == Going through the steps ==

-~> Remembers the code's lines as the tutorial starts on a drawing.
function tut_remember_lines() {
  TUT.first = {}
  let lines = ed_model().lines
  for (let i = 0; i < len(lines); i += 1) {
    TUT.first[text.trim(lines[i])] = true
  }
}

-~> Shows the tutorial at a step. The palette sidebar opens (step 2 points
-~> at its variables; the approved frames have it open from step 1).
function tut_start(step) {
  TUT.on = true
  TUT.closed = false
  if (!mode_artist() && !pal_is_open(V.w)) {
    pal_set_open(true)
  }
  tut_remember_lines()
  tut_go(step)
}

-~> Moves to a step: what the drawing is now is its starting point.
function tut_go(step) {
  TUT.step = math.max(1, math.min(tut_last_step, step))
  tut_snapshot()
  if (TUT.step == tut_last_step && mode_artist() && !mode_drawer()) {
    art_toggle_drawer()
    TUT.drawer = true
  }
  if (settings.tutorial_step != TUT.step) {
    tut_store("tutorial_step", TUT.step)
  }
  view_force_all()
}

function tut_next() {
  if (TUT.step >= tut_last_step) {
    return tut_finish()
  }
  tut_go(TUT.step + 1)
}

function tut_back() {
  if (TUT.step > 1) {
    tut_go(TUT.step - 1)
  }
}

-~> Finished or skipped: it doesn't show again (settings.liz remembers),
-~> and the drawer step 4 opened closes.
function tut_finish() {
  TUT.on = false
  TUT.closed = true
  TUT.lay = null
  if (TUT.drawer && mode_drawer()) {
    art_toggle_drawer()
  }
  TUT.drawer = false
  -~> the brush step's tool doesn't stay picked (the next drawing opens with
  -~> nothing selected, R002 14)
  if (V.tool == "brush") {
    V.tool = ""
    V.picker = false
    view_touch()
  }
  tut_store("tutorial_done", true)
  tut_store("tutorial_step", 1)
  view_force_all()
}

-~> The editor opened: a tutorial under way goes on from where it was (the
-~> drawing may be another one); the first time, it starts.
function tut_enter() {
  if (TUT.on) {
    tut_remember_lines()
    tut_snapshot()
    view_force_all()
  } elif (!TUT.closed && settings.tutorial_done != true) {
    tut_start(tut_saved_step())
  }
}

-~> "Show tutorial again": it shows from the first step the next time the
-~> editor opens.
function tut_again() {
  TUT.closed = false
  TUT.on = false
  tut_store("tutorial_done", false)
  tut_store("tutorial_step", 1)
}

-~> Called at the start of each paint: a step whose action happened moves
-~> on (never in the middle of a gesture), and the layout is worked out
-~> again; when the spotlight's places change, every panel is painted again.
function tut_frame() {
  if (!TUT.on) {
    return null
  }
  if (V.drag == null) {
    let now = tut_progress()
    if (now == "done") {
      tut_next()
    } elif (now == "again") {
      tut_snapshot()
    }
  }
  if (!TUT.on) {
    return null
  }
  TUT.lay = tut_layout()
  let spot = str(TUT.lay.targets) + "|" + str(V.w) + "x" + str(V.h)
  if (spot != TUT.spot) {
    TUT.spot = spot
    view_force_all()
  }
}

-~> == Where each step points ==

-~> The union of rectangles [x, y, w, h], or null for none.
function tut_union(rects) {
  if (len(rects) == 0) {
    return null
  }
  let x0 = rects[0][0]
  let y0 = rects[0][1]
  let x1 = x0 + rects[0][2]
  let y1 = y0 + rects[0][3]
  for (let i = 1; i < len(rects); i += 1) {
    let r = rects[i]
    x0 = math.min(x0, r[0])
    y0 = math.min(y0, r[1])
    x1 = math.max(x1, r[0] + r[2])
    y1 = math.max(y1, r[1] + r[3])
  }
  [x0, y0, x1 - x0, y1 - y0]
}

-~> The shape tools: the toolbar's (those not in the » menu), or the column's.
function tut_tools_rect() {
  let bs = view_toolbar()
  if (mode_artist()) {
    bs = art_column().buttons
  }
  let rs = []
  for (let i = 0; i < len(bs); i += 1) {
    if (bs[i].group == "tool" && (mode_artist() || bs[i].y < 16)) {
      push(rs, [bs[i].x, bs[i].y, bs[i].w, bs[i].h])
    }
  }
  if (len(rs) == 0) {
    return view_hit_rect("bar:more")
  }
  tut_union(rs)
}

-~> The brush button (the » button when the brush is in that menu).
function tut_brush_rect() {
  let r = view_hit_rect("tool:brush")
  if (r == null || (!mode_artist() && r[1] >= 16)) {
    return view_hit_rect("bar:more")
  }
  r
}

-~> The palette's variables, or the whole palette when it has none (or is
-~> folded, or is the compact one).
function tut_palette_rect() {
  let r = pal_rect()
  if (mode_artist() || !pal_is_open(V.w)) {
    return r
  }
  let lay = pal_layout()
  if (len(lay.cells) == 0) {
    return r
  }
  [r[0] + 1, lay.vars_y - 1, r[2] - 2, lay.uses_y - lay.vars_y + 1]
}

-~> The selected shape's fill field (a color field), or artist mode's fill
-~> chip, or null.
function tut_fill_rect() {
  let lay = view_props_cached()
  let found = null
  for (let i = 0; i < len(lay.boxes); i += 1) {
    let b = lay.boxes[i]
    if (b.kind == "color" && (found == null || b.field == "fill")) {
      found = [b.x, b.y, b.w, b.h]
      if (!mode_artist()) {
        -~> its label too, at the panel's left
        let left = view_panel_rects().props[0] + 2
        found = [left, b.y, b.x + b.w - left, b.h]
      }
    }
  }
  if (found == null && mode_artist()) {
    let chips = art_chips(view_geom())
    if (chips != null) {
      found = chips.fill
    }
  }
  found
}

-~> The canvas: the drawing with a margin around it.
function tut_canvas_rect() {
  let fr = view_canvas_layout().frame
  let gm = view_geom()
  let x0 = math.max(gm.cx + 1, fr[0] - 6)
  let y0 = math.max(gm.cy + 1, fr[1] - 6)
  let x1 = math.min(gm.cx + gm.cw - 1, fr[0] + fr[2] + 6)
  let y1 = math.min(gm.cy + gm.ch - 1, fr[1] + fr[3] + 6)
  [x0, y0, x1 - x0, y1 - y0]
}

-~> Rectangles one under the other joined into one.
function tut_join(rects) {
  let out = []
  for (let i = 0; i < len(rects); i += 1) {
    let r = rects[i]
    let n = len(out)
    if (n > 0 && out[n - 1][1] + out[n - 1][3] == r[1]) {
      out[n - 1] = tut_union([out[n - 1], r])
    } else {
      push(out, r)
    }
  }
  out
}

-~> The rows of code made since the tutorial began (all the shape rows
-~> when there are none; the code panel when it shows no rows), runs of
-~> rows one under the other as one rectangle.
function tut_rows_rects() {
  let gm = view_geom()
  let vis = view_visible()
  let made = []
  let shapes = []
  for (let i = 0; i < len(vis); i += 1) {
    let it = vis[i].item
    if (it.t == "row" && it.row.kind == "shape") {
      let r = [0, vis[i].y, gm.pw - 1, it.h]
      push(shapes, r)
      if (TUT.first[text.trim(ed_model().lines[it.line - 1])] != true) {
        push(made, r)
      }
    }
  }
  if (len(made) > 0) {
    return tut_join(made)
  }
  if (len(shapes) > 0) {
    return tut_join(shapes)
  }
  let pr = view_panel_rects().rows
  [[pr[0], gm.rows_y, pr[2] - 1, math.max(14, gm.lim - gm.rows_y)]]
}

-~> The step's targets, ringed and lit: {"rects", "anchor"}; the coach-mark
-~> points at the anchor.
function tut_targets(step) {
  if (step == 1) {
    let r = tut_tools_rect()
    return {"rects": [r], "anchor": r}
  }
  if (step == 2) {
    let pal = tut_palette_rect()
    let fill = tut_fill_rect()
    if (fill == null) {
      return {"rects": [pal], "anchor": pal}
    }
    return {"rects": [pal, fill], "anchor": fill}
  }
  if (step == 3) {
    let b = tut_brush_rect()
    return {"rects": [b, tut_canvas_rect()], "anchor": b}
  }
  let rs = tut_rows_rects()
  {"rects": rs, "anchor": tut_union(rs)}
}

-~> The step's words: [title, body].
function tut_words(step) {
  let k = "tut." + str(step) + "."
  let body = t(k + "body")
  if (mode_artist() && step != 3) {
    body = t(k + "body_artist")
  }
  [t(k + "title"), body]
}

-~> == The backdoor ==

-~> What the tutorial shows, for Dump.
function tut_debug() {
  let lay = TUT.lay
  if (!TUT.on || lay == null) {
    return {"on": TUT.on, "step": TUT.step, "done": settings.tutorial_done == true}
  }
  let buttons = []
  for (let i = 0; i < len(lay.buttons); i += 1) {
    let b = lay.buttons[i]
    push(buttons, {"id": b.id, "x": b.x, "y": b.y, "w": b.w, "h": b.h, "label": b.label})
  }
  let box = null
  if (lay.shown) {
    box = [lay.x, lay.y, lay.w, lay.h]
  }
  {
    "on": true,
    "step": TUT.step,
    "done": settings.tutorial_done == true,
    "targets": lay.targets,
    "box": box,
    "place": lay.place,
    "title": lay.title,
    "body": lay.body,
    "buttons": buttons
  }
}

-~> Tutorial [start | next | back | skip | again | state]: start shows it
-~> from the first step; skip ends it as Skip does; again is Home's "Show
-~> tutorial again". It answers with the tutorial's state.
function tut_command(args) {
  let what = "state"
  if (len(args) > 0) {
    what = str(args[0])
  }
  if (what == "start") {
    tut_start(1)
  } elif (what == "next" && TUT.on) {
    tut_next()
  } elif (what == "back" && TUT.on) {
    tut_back()
  } elif (what == "skip" && TUT.on) {
    tut_finish()
  } elif (what == "again") {
    tut_again()
  } elif (what != "state") {
    return {"ok": false, "error": "Tutorial takes start, next, back, skip, again or state"}
  }
  if (TUT.on) {
    TUT.lay = tut_layout()
  }
  hash.merge({"ok": true}, tut_debug())
}
