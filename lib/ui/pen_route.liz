-~> pen_route: where the brush creator and the picker's gears meet the
-~> editor's view. view_input, view_popups and view_main call these hooks
-~> (one line each) so the window's own code stays in its files:
-~> pen_window.liz (places, painting), pen_window_input.liz (the pointer and
-~> keys), pen_pad.liz (the test pad). A gear (on a picker row, in the brush
-~> inspector) opens the creator on its Pressure tab.

use "../draw/pens"
use "brush_tabs"
use "editor_undo"
use "pen_edit"
use "pen_library"
use "pen_props"
use "pen_window"
use "pen_window_input"
use "view_popups"
use "view_layout"

let pen_route_double_ms = 450
let pen_route_state = {"brush_at": -100000}

-~> == The pointer ==

-~> What is under a point when it is the window's or a picker gear's: an id,
-~> "" (the window's face), or null when it is neither.
function pen_route_hover(x, y) {
  if (pw.open) {
    let id = pw_hit(x, y)
    if (id != null) {
      return id
    }
  }
  if (V.picker) {
    let i = picker_gear_at(x, y)
    if (i >= 0) {
      return "pengear:" + str(i)
    }
  }
  null
}

-~> A press: in the window, or on a gear of the picker (opens the window on
-~> that pen). True when it was used.
function pen_route_down(e) {
  if (V.picker) {
    let i = picker_gear_at(e.pos.x, e.pos.y)
    if (i >= 0) {
      pen_route_show(pen_key_of(pens.list[i]), "pressure")
      return true
    }
  }
  if (pw.open) {
    return pw_down(e)
  }
  false
}

-~> A drag that started in the window. True when it was the window's.
function pen_route_move(e) {
  if (V.drag != null && V.drag.kind == "pw") {
    pw_move(e)
    return true
  }
  if (V.drag != null && V.drag.kind == "pen_props") {
    pen_props_drag(e)
    return true
  }
  false
}

function pen_route_up(e, d) {
  if (d != null && d.kind == "pen_props") {
    return true
  }
  if (d != null && d.kind == "pw") {
    V.drag = d
    pw_up(e)
    V.drag = null
    return true
  }
  false
}

-~> The pointer moved without a button: the curve point under it.
function pen_route_hover_move(p) {
  if (pw.open) {
    pw_hover(p.x, p.y)
  }
}

function pen_route_wheel(e) {
  pw.open && pw_wheel(e)
}

-~> == Keys ==

function pen_route_key(e) {
  pw.open && pw_key(e)
}

function pen_route_text(s) {
  pw_text(s)
}

-~> == Opening ==

-~> Opens the window on a pen key, on a tab (null: the last one).
function pen_route_show(key, tab = null) {
  pen_lib_load()
  pw_show(key, tab)
}

-~> A press of the brush button: a second one soon after the first is a
-~> double-click, which opens the brush pen's settings. True when it was one.
function pen_route_brush_press() {
  let now = time.ms()
  let double = now - pen_route_state.brush_at < pen_route_double_ms
  pen_route_state.brush_at = now
  if (!double) {
    return false
  }
  pen_route_state.brush_at = -100000
  V.tool = "brush"
  pen_route_show(ed.pen)
  true
}

-~> == Painting ==

function pen_route_popup_open() {
  pw.open
}

-~> The window's box with its 3 pixel shadow, as a popup.
function pen_route_popup_rects() {
  if (!pw.open) {
    return []
  }
  let r = pw_rect()
  [["pen", [r[0], r[1], r[2] + 3, r[3] + 3]]]
}

-~> A text that changes when what the window shows changes.
function pen_route_popup_key() {
  if (!pw.open) {
    return ""
  }
  let hover = ""
  if (text.starts(V.hover, "pw:")) {
    hover = V.hover
  }
  "|pw" + str(pw.ver) + hover + ed.color
}

function pen_route_popup_draw() {
  pw_draw()
}

-~> == The backdoor ==

-~> The window as the backdoor's Dump shows it: open, the pen, where its parts are.
function pen_route_debug() {
  if (!pw.open) {
    return {"open": false}
  }
  let lay = pw_layout()
  let tl = lay.tab
  let tracks = {}
  let segs = {}
  let checks = {}
  let rows = tl.rows
  if (tl.pressure != null) {
    rows = rows + [tl.pressure.override, {"kind": "seg", "segs": tl.pressure.inputs}]
  }
  for (let i = 0; i < len(rows); i = i + 1) {
    let r = rows[i]
    if (r.kind == "seg") {
      for (let k = 0; k < len(r.segs); k = k + 1) {
        segs[r.segs[k].id + ":" + r.segs[k].option] = r.segs[k].rect
      }
    } elif (r.kind == "check") {
      checks[r.id] = r.box
    } else {
      tracks[r.id] = r.track
    }
  }
  let tabs = {}
  for (let i = 0; i < len(lay.tabs); i = i + 1) {
    tabs[lay.tabs[i].id] = lay.tabs[i].rect
  }
  let tiles = {}
  if (tl.tiles != null) {
    for (let i = 0; i < len(tl.tiles.tiles); i = i + 1) {
      tiles[tl.tiles.tiles[i].name] = tl.tiles.tiles[i].rect
    }
  }
  let changed = []
  for (let i = 0; i < len(bt_tabs); i = i + 1) {
    if (bt_changed(bt_tabs[i])) {
      push(changed, bt_tabs[i])
    }
  }
  let r = {
    "win": lay.win,
    "title": lay.title,
    "close": lay.close,
    "reset": lay.reset,
    "pad": lay.pad,
    "sample": lay.sample,
    "paper": lay.paper,
    "trash": lay.trash,
    "name": lay.name,
    "export": lay.export,
    "save": lay.save,
    "code": lay.code,
    "tabs": tabs,
    "tiles": tiles,
    "tracks": tracks,
    "segs": segs,
    "checks": checks
  }
  if (tl.pressure != null) {
    r.graph = tl.pressure.graph
    r.preset = tl.pressure.preset
  }
  {
    "open": true,
    "key": pw.key,
    "name": pw.name,
    "tab": pw.tab,
    "draft": pw.draft,
    "source": pw.source,
    "pad_strokes": len(pw.pad),
    "changed": pw.changed,
    "changed_tabs": changed,
    "note": pw.note,
    "rects": r
  }
}

-~> The backdoor's command PenSettings [key [tab]]: opens the window (on the
-~> brush's pen when no key is given, on the last tab when no tab is);
-~> PenSettings close closes it.
function pen_route_command(args) {
  let key = ed.pen
  let tab = null
  if (len(args) > 0) {
    key = str(args[0])
  }
  if (len(args) > 1) {
    tab = str(args[1])
  }
  if (key == "close") {
    pw_close()
    pw_force_all()
    view_touch()
    return {"ok": true, "open": false}
  }
  {"ok": pen_route_show(key, tab), "open": pw.open, "key": pw.key, "tab": pw.tab}
}
