-~> trace_cmd: linkz trace in.png out.lzdraw [--colors 8] [--detail 1.5]
-~> [--min-area 8] [--max-side 256] [--scale 1] [--corner 55] turns a picture
-~> into drawing code (lib/trace) and says what it made. --mode lineart traces
-~> inked drawings as strokes and fills (--line-threshold, --line-min,
-~> --continuation, --radius, --fills, --solid, --parallel). --focus x,y,w,h[,f] (any
-~> number of times, line art) asks for more detail (f above 1, default 2) or
-~> less (below 1) inside a box of the picture, in its own pixels. --quality
-~> light|balanced|detailed|max (line art) takes a preset of options
-~> (lib/trace/trace_quality); options given too win over it. --quality auto
-~> traces three presets in parallel tasks and keeps the best (trace_auto).

use "host_img"
use "libs"
use "trace_auto"
use "../trace/trace_quality"

let trace_usage = "usage: linkz trace in.png out.lzdraw [--colors 8] [--detail 1.5] [--min-area 8] [--max-side 256] [--scale 1] [--corner 55] [--mode photo|lineart] [--line-threshold 0.5] [--line-min 6] [--continuation 35] [--radius 0] [--fills true|false] [--parallel true|false] [--solid 0] [--quality light|balanced|detailed|max|auto] [--focus x,y,w,h[,f]]..."

-~> The options the command takes, by flag, and the key of trace's options.
let trace_flags = {
  "colors": "colors",
  "detail": "detail",
  "min-area": "min_area",
  "max-side": "max_side",
  "scale": "scale",
  "corner": "corner",
  "line-threshold": "line_threshold",
  "line-min": "line_min",
  "continuation": "continuation",
  "radius": "radius",
  "solid": "solid"
}

-~> A number as trace takes it: a whole number is an INTEGER.
function trace_number(v) {
  if (type(v) == "FLOAT" && v == math.floor(v) && math.abs(v) < 1000000000000000) {
    return math.floor(v)
  }
  v
}

-~> One --focus value, "x,y,w,h" or "x,y,w,h,f", as a focus box (f is 2
-~> without it).
function trace_focus_flag(value) {
  let parts = text.split(value, ",")
  if (len(parts) != 4 && len(parts) != 5) {
    error("--focus needs x,y,w,h or x,y,w,h,f, got " + json.write(value))
  }
  let nums = []
  for (let i = 0; i < len(parts); i += 1) {
    let n = text.number(text.trim(parts[i]))
    if (n == null) {
      error("--focus needs numbers, got " + json.write(value))
    }
    push(nums, trace_number(n))
  }
  let f = 2
  if (len(nums) == 5) {
    f = nums[4]
  }
  {"box": [nums[0], nums[1], nums[2], nums[3]], "detail": f}
}

-~> {"files": [in, out], "options": {...}} from the arguments.
function trace_args(args) {
  let files = []
  let options = {}
  for (let i = 0; i < len(args); i += 1) {
    if (!text.starts(args[i], "--")) {
      push(files, args[i])
      continue
    }
    let name = text.slice(args[i], 2, len(args[i]))
    let key = trace_flags[name]
    let word = name == "mode" || name == "fills" || name == "parallel" || name == "focus" || name == "quality"
    if ((key == null && !word) || i + 1 >= len(args)) {
      error("bad option " + args[i] + "\n" + trace_usage)
    }
    i += 1
    if (name == "mode") {
      if (args[i] != "photo" && args[i] != "lineart") {
        error("--mode must be photo or lineart, got " + json.write(args[i]))
      }
      options.mode = args[i]
      continue
    }
    if (name == "quality") {
      if (args[i] != "auto" && list.index(quality_names, args[i]) < 0) {
        error("--quality must be one of " + text.join(quality_names, ", ") + " or auto, got " + json.write(args[i]))
      }
      options.quality = args[i]
      continue
    }
    if (name == "focus") {
      if (options.focus == null) {
        options.focus = []
      }
      push(options.focus, trace_focus_flag(args[i]))
      continue
    }
    if (name == "fills") {
      if (args[i] != "true" && args[i] != "false") {
        error("--fills must be true or false, got " + json.write(args[i]))
      }
      options.fills = args[i] == "true"
      continue
    }
    if (name == "parallel") {
      if (args[i] != "true" && args[i] != "false") {
        error("--parallel must be true or false, got " + json.write(args[i]))
      }
      options.parallel = args[i] == "true"
      continue
    }
    let n = text.number(args[i])
    if (n == null) {
      error("--" + name + " needs a number, got " + json.write(args[i]))
    }
    options[key] = trace_number(n)
  }
  if (len(files) != 2) {
    error(trace_usage)
  }
  if (options.quality != null) {
    if (options.mode == null) {
      options.mode = "lineart"
    }
    if (options.mode != "lineart") {
      error("--quality is for --mode lineart")
    }
  }
  {"files": files, "options": options}
}

-~> The code and the stats of tracing the picture at path.
function trace_file(path, options) {
  if (options.quality == "auto") {
    return trace_auto(path, options)
  }
  let names = libs_load(libs_draw + libs_trace, {"img": host_img(), "time": time, "task": task})
  names.trace(path, options)
}

-~> A number of the stats as the old Go host printed it: whole floats without ".0".
function trace_show(v) {
  str(trace_number(v))
}

function trace_command(args) {
  let a = trace_args(args)
  let result = trace_file(a.files[0], a.options)
  fs.write(a.files[1], result.code)
  let st = result.stats
  if (st.picked != null) {
    let p = st.picked
    puts("auto picked " + p.quality + ": " + str(p.less_error) + "% less error than balanced, " + str(p.more_mb) + " MB more code")
  }
  if (st.mode == "lineart") {
    puts("wrote " + a.files[1] + ": " + trace_show(st.strokes) + " strokes, " + trace_show(st.fills) + " fills, " +
      trace_show(st.tips) + " tips, " + trace_show(st.junctions) + " junctions, " + str(math.round(st.ms)) + " ms")
    let s = st.stages
    puts("  mask " + str(math.round(s.mask)) + ", distance " + str(math.round(s.distance)) + ", fills " +
      str(math.round(s.fills)) + ", outlines " + str(math.round(s.outlines)) + ", thin " + str(math.round(s.thin)) +
      ", graph " + str(math.round(s.graph)) + ", strokes " + str(math.round(s.strokes)) + ", code " +
      str(math.round(s.code)) + " ms (load " + str(math.round(s.load)) + ")")
    return null
  }
  puts("wrote " + a.files[1] + ": " + trace_show(st.colors) + " colors, " + trace_show(st.regions) + " regions (" +
    trace_show(st.holes) + " holes), " + trace_show(st.points) + " points, " + str(math.round(st.ms)) + " ms")
  let s = st.stages
  if (type(s) == "HASH") {
    puts("  load " + str(math.round(s.load)) + ", quantize " + str(math.round(s.quantize)) + ", clean " +
      str(math.round(s.clean)) + ", rings " + str(math.round(s.rings)) + ", simplify " +
      str(math.round(s.simplify)) + ", code " + str(math.round(s.code)) + " ms")
  }
}
