-~> clock: the wall clock as the home screen counts it, in seconds since
-~> 1970 (UTC), and the offset of the local time from UTC in seconds.
-~>
-~> The Terrarium gives the local date and time (time.now()) but neither
-~> the seconds since 1970 nor the offset (a language need, see the
-~> Language Needs doc). Until it does, the offset is measured once: the
-~> local time of now, counted as if it were UTC, minus the time the system
-~> stamps on a file written now (fs.info(...).mtime, in seconds since
-~> 1970), rounded to a quarter of an hour.

let _clock = {"offset": null}

-~> Days from 1970-01-01 to a date of the Gregorian calendar.
function clock_days(year, month, day) {
  let y = year
  if (month <= 2) {
    y -= 1
  }
  let era = y // 400
  let yoe = y - era * 400
  let m = month + 9
  if (month > 2) {
    m = month - 3
  }
  let doy = (153 * m + 2) // 5 + day - 1
  let doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
  era * 146097 + doe - 719468
}

-~> The local time now, in seconds since 1970 as if the local time were UTC.
function clock_local() {
  let n = time.now()
  clock_days(n.year, n.month, n.day) * 86400 + n.hour * 3600 + n.minute * 60 + n.second
}

-~> The offset of the local time from UTC, in seconds (-18000 in Colombia).
-~> dir: a folder the clock may write a small file in.
function clock_offset(dir) {
  if (_clock.offset == null) {
    let probe = fs.join(dir, ".clock")
    fs.write(probe, "")
    let stamped = fs.info(probe).mtime
    let quarter = 900
    _clock.offset = math.round((clock_local() - stamped) / float(quarter)) * quarter
  }
  _clock.offset
}

-~> Seconds since 1970, UTC.
function clock_unix(dir) {
  clock_local() - clock_offset(dir)
}
