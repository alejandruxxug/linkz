-~> drawing: runs a .lzdraw program with the drawing libraries around it.
-~> Each run starts fresh (its own libraries, step count and random numbers)
-~> and is stopped after drawing_steps steps, so a loop that never ends is an
-~> error and not a frozen editor.
-~>
-~> While it runs, every shape is tagged with where it was drawn: the line of
-~> the innermost statement of the drawing that is running (the top level, or
-~> inside a layer, a loop or an if, never a function body) and the path of
-~> layers around it. The libraries read both through here().
-~>
-~> An error raised inside a library has a position in the library, which
-~> means nothing to the user: it is reported at that statement of the
-~> drawing instead.

use "engine"
use "libs"
use "pen_files"

-~> The step limit of a drawing.
let drawing_steps = 2000000

-~> A tracker for one run: the hooks of lizard.run and the here() the
-~> libraries call. Its line and column are those of the drawing's statement
-~> running now (0 before the first one; the run calls the hook only for the
-~> drawing's own statements outside function bodies), layers the layers it
-~> is in. With lines
-~> false, here() gives no line: render and paint follow the statements only
-~> to place errors, and their shapes have a layer but no line.
function drawing_tracker(lines = true) {
  let tr = {"line": 0, "column": 0, "seen": false, "layers": []}
  tr.on_statement = function(line, column, _source) {
    tr.line = line
    tr.column = column
    tr.seen = true
  }
  tr.on_layer = function(name, enter, _line) {
    if (enter) {
      push(tr.layers, name)
    } elif (len(tr.layers) > 0) {
      pop(tr.layers)
    }
  }
  tr.here = function() {
    let line = null
    if (lines) {
      line = tr.line
    }
    {"line": line, "layer": list.copy(tr.layers)}
  }
  tr
}

-~> The source name of a drawing while it runs: a file in lib/, so that the
-~> libraries are found from it, and its errors tell themselves apart from
-~> the libraries' by it.
function drawing_source() {
  fs.join(libs_dir(), "drawing.lzdraw")
}

-~> Runs code with the libraries `specs` (paths under lib/, see libs.liz)
-~> alive around it, the names of `around` (the host's primitives) and the
-~> tracker's hooks. It gives what lizard.run gives, with the drawing's
-~> shapes and canvas as r.drawing and r.canvas (null when it didn't load).
-~> The pens saved in ~/.linkz/pens are there too (pen_files.liz).
function drawing_exec(code, around, tr, specs = libs_draw) {
  let hooks = {"here": tr.here, "results": null, "pens": pen_files_load()}
  let names = hash.merge(around, {"drawing_run_hooks": hooks, "src": {"here": tr.here}})
  let name = drawing_source()
  let r = lizard.run(code, {
    "engine": engine_name(),
    "steps": drawing_steps,
    "name": name,
    "globals": names,
    "use": specs + ["app/drawing_bridge"],
    "on_statement": tr.on_statement,
    "hook_source": name,
    "hook_functions": false,
    "on_layer": tr.on_layer
  })
  r.drawing = null
  r.canvas = null
  if (hooks.results != null) {
    let got = hooks.results()
    r.drawing = got.drawing
    r.canvas = got.canvas
  }
  r
}

-~> The message of an error with its position and kind, the way the language
-~> prints it: "[line 3, column 5] runtime error: ...".
function drawing_message(e) {
  "[line " + str(e.line) + ", column " + str(e.column) + "] " + e.kind + " error: " + e.message
}

-~> Whether an error of lizard.run stopped the code before it ran.
function drawing_is_syntax(e) {
  e != null && (e.kind == "syntax" || e.kind == "lexical")
}

-~> The syntax errors of a run (r.errors), as the language prints them, one
-~> per line.
function drawing_syntax_text(errors) {
  let lines = []
  for (let i = 0; i < len(errors); i += 1) {
    push(lines, drawing_message(errors[i]))
  }
  text.join(lines, "\n")
}

-~> The message of a runtime error for the user: an error in the drawing keeps
-~> its own; one from a library gets the position of the drawing's statement
-~> that was running (none before the first one).
function drawing_attributed(e, tr) {
  if (e.source == drawing_source()) {
    return drawing_message(e)
  }
  if (!tr.seen) {
    return e.message
  }
  "[line " + str(tr.line) + ", column " + str(tr.column) + "] runtime error: " + e.message
}

-~> Runs a drawing for the editor (the old src.run): {"errors", "ms",
-~> "printed", "shapes", "steps", "canvas"}. Each error is {"column", "line",
-~> "message"}, its message with the kind ("runtime error: ..."); an error
-~> from a library is at the drawing's line, column 0, with the library's
-~> message alone. around: the host's primitives the drawing may use.
function drawing_run(code, around = {}) {
  let start = time.ms()
  let out = {"errors": [], "ms": 0, "printed": "", "shapes": [], "steps": 0, "canvas": null}
  let tr = drawing_tracker()
  let r = null
  try {
    r = drawing_exec(code, around, tr)
  } catch (e) {
    out.errors = [{"column": 0, "line": 0, "message": e.message}]
  }
  if (r != null && drawing_is_syntax(r.error)) {
    for (let i = 0; i < len(r.errors); i += 1) {
      let e = r.errors[i]
      push(out.errors, {"column": e.column, "line": e.line, "message": e.kind + " error: " + e.message})
    }
  } elif (r != null) {
    out.shapes = r.drawing
    out.canvas = r.canvas
    out.printed = r.output
    out.steps = r.steps
    if (r.error != null) {
      out.errors = [drawing_error(r.error, tr)]
    }
  }
  out.ms = time.ms() - start
  out
}

-~> An error of a run as the editor shows it.
function drawing_error(e, tr) {
  if (e.source == drawing_source()) {
    return {"column": e.column, "line": e.line, "message": e.kind + " error: " + e.message}
  }
  {"column": 0, "line": tr.line, "message": e.message}
}
