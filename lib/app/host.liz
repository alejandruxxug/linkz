-~> host: the names the libraries get from the host, for one run: the
-~> Terrarium's os, time, clip and io (copies, so a test can replace a
-~> function of one); fb (drawing on a target),
-~> fs, img and src, made of the Terrarium (see host_*.liz); and linkz, what
-~> Linkz adds (host_linkz.liz). A library loaded with libs_load(specs,
-~> host_globals(...)) sees them like builtins. lib/lizard-check.liz lists them
-~> for `lizardscript check`.

use "host_fb"
use "host_fs"
use "host_img"
use "host_linkz"
use "host_src"

-~> The primitives, with fb drawing on target (an image, or a window when
-~> on_window is true).
function host_globals(target, on_window = false) {
  {
    "fb": host_fb(target, on_window),
    "fs": host_fs(),
    "os": hash.copy(os),
    "time": hash.copy(time),
    "clip": hash.copy(clip),
    "img": host_img(),
    "io": hash.copy(io),
    "src": host_src(),
    "linkz": host_linkz()
  }
}
