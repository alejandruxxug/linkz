-~> fingerprint: a short hash of a text, 16 hex digits, the same for the same
-~> text wherever it comes from. The home screen names a drawing's thumbnail
-~> after it, so a file that didn't change is never painted again.
-~>
-~> It is two polynomial hashes of the character codes, each modulo a prime
-~> below 2^31 (so no step goes past what an integer holds), written as 8
-~> hex digits each. The Go host used the first 16 hex digits of SHA-256; a
-~> thumbnail made by it is simply made again.

let _fingerprint_primes = [2147483647, 2147483629]
let _fingerprint_bases = [131, 137]
let _hex_digits = "0123456789abcdef"

-~> n (0 or more) as hex with at least `width` digits.
function fingerprint_hex(n, width) {
  let out = ""
  while (n > 0 || len(out) < width) {
    out = _hex_digits[n % 16] + out
    n = n // 16
  }
  out
}

function fingerprint(s) {
  let chars = text.split(s, "")
  let a = 0
  let b = 0
  let pa = _fingerprint_primes[0]
  let pb = _fingerprint_primes[1]
  let ba = _fingerprint_bases[0]
  let bb = _fingerprint_bases[1]
  for (let i = 0; i < len(chars); i += 1) {
    let c = text.code(chars[i], 0)
    a = (a * ba + c) % pa
    b = (b * bb + c) % pb
  }
  fingerprint_hex(a, 8) + fingerprint_hex(b, 8)
}
