-~> tiles: a picture kept as square tiles in host buffers (fb.keep), so that a
-~> change repaints only the part of each tile it touches and the rest is
-~> copied from the buffers as it is. The picture is size (w, h) pixels; tile
-~> (col, row) covers [col * side, (col + 1) * side) and the same for y (the
-~> last ones are cut to the picture).
-~>   tiles_new(name, size, side)   no tile painted yet: every tile is dirty
-~>   tiles_mark(t, box)            box [x0, y0, x1, y1] (picture pixels) must be repainted
-~>   tiles_mark_all(t)             the whole picture must be repainted
-~>   tiles_render(t, paint)        repaints what is dirty: for each tile it calls
-~>                                 paint(box, offset) with the target being the tile's
-~>                                 buffer, clipped to box and cleared there; a picture
-~>                                 pixel (x, y) is (x, y) + offset in that buffer
-~>   tiles_blit(t, pos)            draws every tile on the current target, the picture's
-~>                                 top left at pos
-~> After tiles_render, t.painted is how many tiles it repainted and t.area how
-~> many pixels.

function tiles_new(name, size, side) {
  let t = {"name": name, "size": size, "side": side, "cols": math.ceil(size.x / float(side)),
           "rows": math.ceil(size.y / float(side)), "dirty": {}, "made": {}, "painted": 0, "area": 0}
  tiles_mark_all(t)
  t
}

-~> The number of a tile, and the name of its buffer.
function tiles_key(t, col, row) {
  row * t.cols + col
}

function tiles_buffer(t, key) {
  "tiles:" + t.name + ":" + str(key)
}

-~> The picture pixels of a tile, as [x0, y0, x1, y1].
function tiles_rect(t, col, row) {
  let x0 = col * t.side
  let y0 = row * t.side
  return [x0, y0, math.min(x0 + t.side, t.size.x), math.min(y0 + t.side, t.size.y)]
}

-~> The smallest box holding both (null is empty).
function tiles_union(a, b) {
  if (a === null) {
    return b
  }
  if (b === null) {
    return a
  }
  return [math.min(a[0], b[0]), math.min(a[1], b[1]), math.max(a[2], b[2]), math.max(a[3], b[3])]
}

function tiles_mark(t, box) {
  -~> whole pixels: a box that touches a pixel at all repaints it
  let x0 = math.max(0, math.floor(box[0]))
  let y0 = math.max(0, math.floor(box[1]))
  let x1 = math.min(t.size.x, math.ceil(box[2]))
  let y1 = math.min(t.size.y, math.ceil(box[3]))
  if (x1 <= x0 || y1 <= y0) {
    return null
  }
  for (let row = y0 // t.side; row <= (y1 - 1) // t.side; row += 1) {
    for (let col = x0 // t.side; col <= (x1 - 1) // t.side; col += 1) {
      let r = tiles_rect(t, col, row)
      let part = [math.max(x0, r[0]), math.max(y0, r[1]), math.min(x1, r[2]), math.min(y1, r[3])]
      let k = tiles_key(t, col, row)
      t.dirty[k] = tiles_union(t.dirty[k], part)
    }
  }
  null
}

function tiles_mark_all(t) {
  tiles_mark(t, [0, 0, t.size.x, t.size.y])
}

function tiles_render(t, paint) {
  t.painted = 0
  t.area = 0
  let ks = keys(t.dirty)
  for (let i = 0; i < len(ks); i += 1) {
    let k = ks[i]
    let col = k % t.cols
    let row = k // t.cols
    let r = tiles_rect(t, col, row)
    let box = t.dirty[k]
    let at = (r[0], r[1])
    fb.offscreen((r[2] - r[0], r[3] - r[1]))
    -~> the new buffer starts as a copy of the old one, then only box is repainted
    if (t.made[k] == true && box != r) {
      fb.blit(tiles_buffer(t, k), (0, 0))
    }
    fb.clip((box[0], box[1]) - at, (box[2] - box[0], box[3] - box[1]))
    fb.clear((box[0], box[1]) - at, (box[2] - box[0], box[3] - box[1]))
    paint(box, -at)
    fb.unclip()
    fb.keep(tiles_buffer(t, k))
    t.made[k] = true
    t.painted += 1
    t.area += (box[2] - box[0]) * (box[3] - box[1])
  }
  t.dirty = {}
  null
}

function tiles_blit(t, pos) {
  for (let row = 0; row < t.rows; row += 1) {
    for (let col = 0; col < t.cols; col += 1) {
      let r = tiles_rect(t, col, row)
      fb.blit(tiles_buffer(t, tiles_key(t, col, row)), pos + (r[0], r[1]))
    }
  }
  null
}
