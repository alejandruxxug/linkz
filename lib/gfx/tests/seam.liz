-~> A stroke through many points is one piece: no two spans of a row only touch
-~> (their soft ends would blend twice and leave a light hairline).
use "../raster"
function tools_path_of(p) {
  let path = [["M", p[0]]]
  for (let i = 1; i < len(p); i += 1) {
    push(path, ["L", p[i]])
  }
  path
}
let pts = []
for (let i = 0; i < 40; i += 1) {
  push(pts, (10 + i * 3.7, 20 + (i % 2) * 0.3))
}
let spans = raster_stroke(tools_path_of(pts), 9.0)
let touching = 0
for (let i = 1; i < len(spans); i += 1) {
  if (spans[i][0] == spans[i - 1][0] && spans[i][1] <= spans[i - 1][2]) {
    touching += 1
  }
}
puts("spans touching:", touching)
