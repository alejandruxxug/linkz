-~> recommend() and friendly_number() with fixed inputs.
-~> Run by TestRecommend; the output is compared with recommend.expected.

puts(friendly_number(7), friendly_number(87), friendly_number(100), friendly_number(1234), friendly_number(99999), friendly_number(123456))

function mach(free, warm, cold, run, bytes) {
  recommend({"free": free, "warm_ms_per_object": warm, "cold_ms_per_object": cold,
             "run_ms_per_object": run, "bytes_per_object": bytes})
}

-~> speed: (100 - 2 x 1.0) / (0.25 + 0.05) = 326, x 0.8 = 261, friendly 260
puts(mach(8000000000, 0.25, 1.0, 0.05, 20000))
-~> memory is the lower cap: 10% of 1 GB / 50000 = 2000, x 0.8 = 1600
puts(mach(1000000000, 0.01, 0.5, 0.0, 50000))
-~> edits that cost more than the budget leave nothing: the floor of 10
puts(mach(8000000000, 0.25, 60.0, 0.05, 20000).max_objects)
-~> a very slow machine never goes under 10
puts(mach(8000000000, 50.0, 90.0, 5.0, 20000).max_objects)
-~> the same cold cost but a cheaper repaint gives a higher number
puts(mach(8000000000, 0.1, 1.0, 0.05, 20000).max_objects > mach(8000000000, 0.25, 1.0, 0.05, 20000).max_objects)
-~> the writers
let m = mach(8000000000, 0.25, 1.0, 0.05, 20000)
m.measured_at = 5
m.app_version = "1.0"
puts(machine_source(m))
puts(machine_json(m))
