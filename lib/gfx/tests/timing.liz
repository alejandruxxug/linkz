-~> Timings, in milliseconds, for the speed table in Language Needs.
-~> Run it with: linkz paint lib/gfx/tests/timing.liz out.png 512x512
let pts = []
for (let i = 0; i < 200; i = i + 1) {
  push(pts, (20 + i * 2.4, 256 + math.sin(i / 8.0) * 120))
}
let path = [["M", pts[0]]]
for (let i = 1; i < 200; i = i + 1) {
  push(path, ["L", pts[i]])
}
let t0 = time.ms()
let s = raster.stroke(path, 8)
let t1 = time.ms()
puts("stroke 200 points: ", t1 - t0, "ms,", len(s), "spans")
let t2 = time.ms()
let c = raster.fill(ellipse_path((256, 256), (250, 250)), "nonzero")
let t3 = time.ms()
puts("circle 512x512: ", t3 - t2, "ms,", len(c), "spans")
let t4 = time.ms()
raster.draw(c, (0, 0), #3fa34d)
raster.draw(s, (0, 0), #000000)
puts("fb.spans of both: ", time.ms() - t4, "ms")
let b = []
for (let i = 0; i < 40; i = i + 1) {
  push(b, (20 + i * 12.0, 256 + math.sin(i / 3.0) * 100))
}
let t5 = time.ms()
let bs = raster.brush(b, [4, 12, 6, 12, 4, 12, 6, 12, 4, 12, 6, 12, 4, 12, 6, 12, 4, 12, 6, 12, 4, 12, 6, 12, 4, 12, 6, 12, 4, 12, 6, 12, 4, 12, 6, 12, 4, 12, 6, 12])
puts("brush 40 points: ", time.ms() - t5, "ms,", len(bs), "spans")
