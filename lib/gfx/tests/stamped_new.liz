-~> The shapes and grains added by B067, one stroke each: spray, leaf, a
-~> bitmap heart, then fat strokes with the paper, canvas, chalk, hatch and
-~> bitmap grains. Golden picture: lib/draw/tests/golden/stamped_new.png
-~> (linkz paint lib/gfx/tests/stamped_new.liz lib/draw/tests/golden/stamped_new.png 240x170).
fb.fill((0, 0), (240, 170), #ffffff)

-~> Runs of equal alphas, [count, alpha, ...] (the same as stamp_bitmap_encode,
-~> which painted programs do not see).
function runs_of(alphas) {
  let out = []
  let i = 0
  while (i < len(alphas)) {
    let j = i
    while (j < len(alphas) && alphas[j] == alphas[i]) {
      j += 1
    }
    push(out, j - i)
    push(out, alphas[i])
    i = j
  }
  out
}

-~> A bitmap from rows of text: "#" is opaque, anything else clear.
function bitmap_of(rows) {
  let alphas = []
  for (let y = 0; y < len(rows); y += 1) {
    for (let x = 0; x < len(rows[y]); x += 1) {
      if (rows[y][x] == "#") {
        push(alphas, 255)
      } else {
        push(alphas, 0)
      }
    }
  }
  {"bitmap": runs_of(alphas), "w": len(rows[0]), "h": len(rows)}
}

let heart = bitmap_of([".##..##.", "########", "########", "########", ".######.", "..####..", "...##...", "........"])
let checker = bitmap_of(["#.#.", ".#.#", "#.#.", ".#.#"])

function sample_row(i, pen, color) {
  let y = 10 + i * 19
  let pts = [(12, y), (70, y - 5), (130, y + 5), (190, y - 3), (228, y)]
  raster.paint([brush(pts, [0.8, 0.8, 0.8, 0.8, 0.8], color, pen)], (0, 0))
}

function sample_pen(extra) {
  hash.merge({"name": "t", "render": "stamped", "min": 14, "max": 14, "taper": 0, "opacity": [1, 1], "nib": null, "grain": 0, "spacing": 0.35}, extra)
}

function sample_grained(kind) {
  sample_pen({"min": 16, "max": 16, "size": 1, "grain": {"kind": kind, "scale": 4, "depth": 0.9}})
}

sample_row(0, sample_pen({"shape": "spray", "min": 16, "max": 16, "spacing": 0.5, "rotation": "random"}), #aa2200)
sample_row(1, sample_pen({"shape": "leaf", "rotation": "follow", "spacing": 1.1}), #2a7a3a)
sample_row(2, sample_pen({"shape": heart, "spacing": 1.2}), #cc2266)
sample_row(3, sample_grained("paper"), #223344)
sample_row(4, sample_grained("canvas"), #115599)
sample_row(5, sample_grained("chalk"), #cc8800)
sample_row(6, sample_grained("hatch"), #552277)
sample_row(7, sample_pen({"min": 16, "max": 16, "grain": {"kind": "bitmap", "data": checker.bitmap, "w": checker.w, "h": checker.h, "scale": 3, "depth": 0.9}}), #226655)
