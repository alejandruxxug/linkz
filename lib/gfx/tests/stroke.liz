-~> A stroked zigzag (round joins and caps), a curve, and a 1 pixel line.
fb.fill((0, 0), (200, 100), #ffffff)
let z = [["M", (20, 70)], ["L", (60, 20)], ["L", (100, 70)], ["L", (140, 20)], ["L", (180, 70)]]
raster.draw(raster.stroke(z, 12), (0, 0), #223344)
let c = [["M", (20, 90)], ["C", (60, 60), (140, 120), (180, 90)]]
raster.draw(raster.stroke(c, 1), (0, 0), #cc2200)
-~> A dot is a round cap with no segment.
raster.draw(raster.stroke([["M", (100, 50)], ["L", (100, 50)]], 10), (0, 0), #228833)
