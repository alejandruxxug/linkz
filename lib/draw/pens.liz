-~> pens: styles for brush(), which turns raw pressures into a shape.
-~> A pen is a hash, and you can write your own. Its keys:
-~>   name     the name shown in the editor's picker
-~>   min      width in pixels at pressure 0
-~>   max      width in pixels at pressure 1 (min == max gives a constant width)
-~>   taper    0 to 0.5: the share of the stroke's length, at each end, where
-~>            the width shrinks towards the tip (0 = flat ends)
-~>   opacity  [low, high]: the opacity (0 to 1) at pressure 0 and at pressure 1
-~>   nib      null, or an angle in radians: the width then comes from the angle
-~>            between the stroke's direction and the nib, not from the pressure
-~>   grain    0, or the roughness of the edge in pixels (deterministic noise)

let pens = {}

-~> ink: crisp line, pressure changes the width a lot, both ends taper to a
-~> point. Uses min, max, taper.
pens.ink = {"name": "ink", "min": 1, "max": 10, "taper": 0.3, "opacity": [1, 1], "nib": null, "grain": 0}

-~> pencil: thin and light, pressure changes the opacity more than the width,
-~> and the edge is slightly grainy. Uses min, max, opacity, grain.
pens.pencil = {"name": "pencil", "min": 1, "max": 2.5, "taper": 0.1, "opacity": [0.3, 0.95], "nib": null, "grain": 0.4}

-~> marker: constant width, see-through, flat ends. Uses min (= max), opacity.
pens.marker = {"name": "marker", "min": 10, "max": 10, "taper": 0, "opacity": [0.55, 0.55], "nib": null, "grain": 0}

-~> brush: wide width range, soft taper, fades out at low pressure. Uses min,
-~> max, taper, opacity.
pens.brush = {"name": "brush", "min": 2, "max": 28, "taper": 0.4, "opacity": [0.35, 1], "nib": null, "grain": 0}

-~> calligraphy: a flat nib held at 45 degrees; strokes along the nib are thin
-~> and across it are thick, whatever the pressure. Uses min, max, nib.
pens.calligraphy = {"name": "calligraphy", "min": 1.5, "max": 14, "taper": 0, "opacity": [1, 1], "nib": 45deg, "grain": 0}

-~> The pens for the editor's picker, in order.
pens.list = [pens.ink, pens.pencil, pens.marker, pens.brush, pens.calligraphy]

-~> What a pen does at one point of a stroke: [width, opacity] from the
-~> pressure (0 to 1) and the direction of the stroke there, in radians. The
-~> taper and the grain are applied later, along the outline.
function pen_response(pen, pressure, angle) {
  let p = math.max(0.0, math.min(1.0, pressure))
  let f = p
  if (type(pen.nib) == "FLOAT" || type(pen.nib) == "INTEGER") {
    f = math.abs(math.sin(angle - pen.nib))
  }
  let width = pen.min + (pen.max - pen.min) * f
  let opacity = pen.opacity[0] + (pen.opacity[1] - pen.opacity[0]) * p
  return [width, opacity]
}

-~> How much of its width a pen keeps at `along` (0 at the start of the
-~> stroke to 1 at the end): 1 in the middle, 0.15 at the very tips.
function pen_taper(pen, along) {
  if (!(pen.taper > 0)) {
    return 1.0
  }
  let edge = math.min(along, 1 - along) / pen.taper
  0.15 + 0.85 * math.min(1.0, edge)
}

-~> A repeatable number from 0 up to 1 for each whole number k (the pencil's
-~> grain). The same k always gives the same number.
function pen_noise(k) {
  let x = math.sin(k * 12.9898) * 43758.5453
  x - math.floor(x)
}
