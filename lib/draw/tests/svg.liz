-~> The SVG writer: helpers and a whole document.
use "../gradient"
use "../shapes"
use "../svg"

puts(svg_hex2(0), svg_hex2(255), svg_hex2(63), color_hex(#3fa34d))
puts(svg_num(3), svg_num(3.0), svg_num(2.5), svg_num(0.123456), svg_num(-0.004), svg_num(1234.5678))
puts(path_data([["M", (1, 2)], ["L", (3.5, 4)], ["C", (1, 1), (2, 2), (3, 3)], ["Z"]]))
puts(path_data([["M", (1, 2)], ["Q", (5, 6.5), (9, 2)], ["Z"]]))
puts(paint_attrs("fill", #3fa34d))
puts(paint_attrs("fill", #3fa34d80))
puts(paint_attrs("stroke", null))

-~> Without lines from a host, a document paints the last shape drawn first.
canvas = {"size": (100, 60), "background": #f4f1e8}
rect((0, 0), (50, 50), #ff0000)
circle((50, 30), 10, #0000ff)
line((0, 0), (100, 60), #000000aa, 2.5)
puts(svg_document(canvas, drawing))

-~> One relative gradient on two shapes of different sizes: two pinned
-~> gradients in <defs>; the same size shares one.
let dusk = gradient([#3d1c4f, #f4d35e])
canvas = {"size": (100, 100), "background": gradient([#fff, #ccc])}
circle((20, 20), 10, dusk)
rect((0, 40), (100, 50), dusk)
rect((0, 40), (100, 50), dusk)
puts(svg_document(canvas, drawing))

-~> Curve items are written as real C and Q commands.
puts(svg_document({"size": (50, 50), "background": #ffffff},
  [path([(5, 5), ["c", (5, 30), (40, 30), (40, 5)], ["q", (20, -10), (5, 5)]], #3fa34d)]))
