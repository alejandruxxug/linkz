-~> fit: Schneider's least-squares fitting of a line of points with cubic
-~> Beziers. The tracer fits its centerlines and outlines with it
-~> (lineart_curves.liz), and a brush stroke with curves fits the two sides
-~> of its outline with it, so SVG gets real curves.

use "geometry"

-~> The unit vector along v, (0, 0) when v has no length.
function fit_dir(v) {
  let l = math.sqrt(float(v.x * v.x + v.y * v.y))
  if (l == 0) {
    return (0.0, 0.0)
  }
  v / l
}

-~> Schneider's fit of the points a to b of `pts` with one cubic whose ends
-~> leave along t1 and arrive along t2 (pointing back), split at the worst
-~> point and fitted again while the error is over `tol` px (a fit within
-~> four times `tol` first gets two Newton rounds on its parameters). Adds the
-~> pieces [p0, c1, c2, p3] to `out` and their ranges [a, b] to `spans`.
function fit_schneider(pts, a, b, t1, t2, tol, out, spans) {
  let p0 = pts[a]
  let p3 = pts[b]
  let seg = math.dist(p0, p3)
  if (b - a < 2) {
    push(out, [p0, p0 + t1 * (seg / 3.0), p3 + t2 * (seg / 3.0), p3])
    push(spans, [a, b])
    return null
  }
  let u = fit_chord_params(pts, a, b)
  let bez = fit_bezier(pts, a, b, u, t1, t2)
  let e = fit_error(pts, a, b, u, bez)
  if (e[0] <= tol) {
    push(out, bez)
    push(spans, [a, b])
    return null
  }
  if (e[0] <= tol * 4) {
    for (let k = 0; k < 2; k += 1) {
      u = fit_reparam(pts, a, b, u, bez)
      bez = fit_bezier(pts, a, b, u, t1, t2)
      e = fit_error(pts, a, b, u, bez)
      if (e[0] <= tol) {
        push(out, bez)
        push(spans, [a, b])
        return null
      }
    }
  }
  let s = e[1]
  let tc = fit_dir(pts[math.max(a, s - 2)] - pts[math.min(b, s + 2)])
  if (tc.x == 0 && tc.y == 0) {
    tc = fit_dir(pts[a] - pts[b])
  }
  fit_schneider(pts, a, s, t1, tc, tol, out, spans)
  fit_schneider(pts, s, b, tc * -1.0, t2, tol, out, spans)
}

-~> The chord-length parameter (0 to 1) of each point a to b.
function fit_chord_params(pts, a, b) {
  let u = [0.0]
  for (let i = a + 1; i <= b; i += 1) {
    push(u, u[i - a - 1] + math.dist(pts[i - 1], pts[i]))
  }
  let total = u[b - a]
  if (total == 0) {
    total = 1.0
  }
  for (let i = 0; i < len(u); i += 1) {
    u[i] = u[i] / total
  }
  u
}

-~> The least-squares cubic through the points a to b at parameters u, its
-~> ends fixed and leaving along t1, arriving along t2; the handles fall
-~> back to a third of the chord when the fit gives none.
function fit_bezier(pts, a, b, u, t1, t2) {
  let p0 = pts[a]
  let p3 = pts[b]
  let c00 = 0.0
  let c01 = 0.0
  let c11 = 0.0
  let x0 = 0.0
  let x1 = 0.0
  for (let i = a; i <= b; i += 1) {
    let t = u[i - a]
    let s = 1.0 - t
    let b0 = s * s * s
    let b1 = 3.0 * t * s * s
    let b2 = 3.0 * t * t * s
    let b3 = t * t * t
    let ax = t1.x * b1
    let ay = t1.y * b1
    let bx = t2.x * b2
    let by = t2.y * b2
    c00 += ax * ax + ay * ay
    c01 += ax * bx + ay * by
    c11 += bx * bx + by * by
    let tx = pts[i].x - (p0.x * (b0 + b1) + p3.x * (b2 + b3))
    let ty = pts[i].y - (p0.y * (b0 + b1) + p3.y * (b2 + b3))
    x0 += ax * tx + ay * ty
    x1 += bx * tx + by * ty
  }
  let seg = math.dist(p0, p3)
  let det = c00 * c11 - c01 * c01
  let al = seg / 3.0
  let ar = seg / 3.0
  if (math.abs(det) > 0.000000001) {
    let l = (c11 * x0 - c01 * x1) / det
    let r = (c00 * x1 - c01 * x0) / det
    if (l > seg * 0.000001 && r > seg * 0.000001 && l < seg * 2 && r < seg * 2) {
      al = l
      ar = r
    }
  }
  [p0, p0 + t1 * al, p3 + t2 * ar, p3]
}

-~> The farthest point a to b is from the cubic at its parameter: [distance,
-~> its index] (the middle point when none is inside).
function fit_error(pts, a, b, u, bez) {
  let worst = 0.0
  let at = (a + b) // 2
  let p0 = bez[0]
  let p1 = bez[1]
  let p2 = bez[2]
  let p3 = bez[3]
  for (let i = a + 1; i < b; i += 1) {
    let t = u[i - a]
    let s = 1.0 - t
    let k0 = s * s * s
    let k1 = 3.0 * t * s * s
    let k2 = 3.0 * t * t * s
    let k3 = t * t * t
    let dx = k0 * p0.x + k1 * p1.x + k2 * p2.x + k3 * p3.x - pts[i].x
    let dy = k0 * p0.y + k1 * p1.y + k2 * p2.y + k3 * p3.y - pts[i].y
    let d = dx * dx + dy * dy
    if (d > worst) {
      worst = d
      at = i
    }
  }
  [math.sqrt(worst), at]
}

-~> The parameters moved one Newton step towards the nearest point of the
-~> cubic to each point.
function fit_reparam(pts, a, b, u, bez) {
  let out = []
  let d1 = [(bez[1] - bez[0]) * 3.0, (bez[2] - bez[1]) * 3.0, (bez[3] - bez[2]) * 3.0]
  let d2 = [(d1[1] - d1[0]) * 2.0, (d1[2] - d1[1]) * 2.0]
  for (let i = a; i <= b; i += 1) {
    let t = u[i - a]
    let s = 1.0 - t
    let q = bezier_point(bez[0], bez[1], bez[2], bez[3], t)
    let q1 = d1[0] * (s * s) + d1[1] * (2.0 * s * t) + d1[2] * (t * t)
    let q2 = d2[0] * s + d2[1] * t
    let diff = q - pts[i]
    let num = diff.x * q1.x + diff.y * q1.y
    let den = q1.x * q1.x + q1.y * q1.y + diff.x * q2.x + diff.y * q2.y
    if (den != 0) {
      t = math.max(0.0, math.min(1.0, t - num / den))
    }
    push(out, t)
  }
  out
}

-~> The first point of a line `reach` px or more from its first point (or the
-~> last one, for a short line): where an end of the line is heading.
function fit_ahead(pts, reach) {
  let j = 1
  while (j < len(pts) - 1 && math.dist(pts[0], pts[j]) < reach) {
    j = j + 1
  }
  pts[j]
}

-~> A line of points (at least two, an open line) as cubic Beziers, each
-~> point within `tol` px of the curves. Returns [[p0, c1, c2, p3]...], one
-~> after the other, the first from the first point to the last point's end.
-~> The curves leave and arrive along the line's own ends, and meet smoothly.
function fit_line(pts, tol) {
  let n = len(pts)
  let t1 = fit_dir(fit_ahead(pts, 2.0) - pts[0])
  let t2 = fit_dir(fit_ahead(list.reverse(pts), 2.0) - pts[n - 1])
  let out = []
  fit_schneider(pts, 0, n - 1, t1, t2, tol, out, [])
  out
}
