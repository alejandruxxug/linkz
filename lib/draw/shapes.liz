-~> shapes: the things a drawing is made of.
-~> Every call draws a shape and also returns it, so it can be changed
-~> afterwards. A shape is a hash:
-~>   kind     "circle", "rect", ...
-~>   args     the values the call got
-~>   path     [["M", p], ["L", p], ["C", c1, c2, p], ["Z"]] with absolute points
-~>   fill     a color or null     stroke  a color or null     width  a number
-~>   widths, opacities   per point, only for brush (from the pen), else null
-~>   stamps, stamp_key   only for a brush of a stamped pen (see stamps.liz): the
-~>            stamps to draw, and a text that changes when they would; else null
-~>   anchors  [{"pos": p, "arg": i, "item": j or null, "role": ...}]: which
-~>            argument (and which element of an array argument) a handle edits
-~>   line, layer   where the call is in the file, when the host says so
-~> Positions are points and colors are colors: circle((256, 256), 40, #3fa34d).

use "check"
use "fit"
use "geometry"
use "gradient"
use "here"
use "pens"
use "stamps"

let drawing = []

-~> The canvas. A drawing sets it with canvas = {"size": (400, 200), "background": #f4f1e8}.
let canvas = {"size": (512, 512), "background": #ffffff}

-~> Adds a shape to the drawing, tagging it with the line and layer the host
-~> reports through here(). Returns the shape.
function draw(shape) {
  let where = here()
  if (type(where) == "HASH") {
    shape.line = where.line
    shape.layer = where.layer
  }
  push(drawing, add_styles(shape, where))
  shape
}

function make_shape(kind, args, path, fill, stroke_color, width, anchors) {
  draw({
    "kind": kind,
    "args": args,
    "path": path,
    "fill": fill,
    "stroke": stroke_color,
    "width": width,
    "widths": null,
    "opacities": null,
    "anchors": anchors,
    "line": null,
    "layer": null
  })
}

function make_anchor(pos, arg, item, role) {
  {"pos": pos, "arg": arg, "item": item, "role": role}
}

function anchors_of(points) {
  let out = []
  for (let i = 0; i < len(points); i = i + 1) {
    if (type(points[i]) == "POINT") {
      push(out, make_anchor(points[i], 0, i, "point"))
    }
  }
  out
}

-~> The closed path of an ellipse as four cubic Beziers (0.5523 is the
-~> constant that makes them round).
function ellipse_path(center, radii) {
  let k = 0.5522847498
  let cx = center.x
  let cy = center.y
  let rx = radii.x
  let ry = radii.y
  return [["M", (cx + rx, cy)],
    ["C", (cx + rx, cy + ry * k), (cx + rx * k, cy + ry), (cx, cy + ry)],
    ["C", (cx - rx * k, cy + ry), (cx - rx, cy + ry * k), (cx - rx, cy)],
    ["C", (cx - rx, cy - ry * k), (cx - rx * k, cy - ry), (cx, cy - ry)],
    ["C", (cx + rx * k, cy - ry), (cx + rx, cy - ry * k), (cx + rx, cy)],
    ["Z"]]
}

-~> The shapes in the order they are painted, back to front. Rows lower in the
-~> file are behind, so a larger `line` paints first; shapes from the same row
-~> (a loop, or a user function) keep their creation order, so later ones land
-~> on top. Without lines from the host it is the plain reverse of draw order.
function paint_order(shapes) {
  for (let i = 0; i < len(shapes); i = i + 1) {
    if (type(shapes[i].line) != "INTEGER") {
      return list.reverse(shapes)
    }
  }
  list.sort(shapes, function(a, b) { a.line > b.line })
}

-~> Draws a filled circle.
-~> center: the middle of the circle, a point
-~> r: the radius in pixels
-~> fill: the color inside
-~> example: circle((256, 256), 40, #3fa34d)
function circle(center, r, fill) {
  need_point("circle", "center", center)
  need_number("circle", "r", r)
  need_paint("circle", "fill", fill)
  make_shape("circle", [center, r, fill], ellipse_path(center, (r, r)), fill, null, 0,
    [make_anchor(center, 0, null, "move"), make_anchor(center + (r, 0), 1, null, "radius")])
}

-~> Draws a filled ellipse.
-~> center: the middle of the ellipse, a point
-~> radii: half the width and half the height, a point like (60, 30)
-~> fill: the color inside
-~> example: ellipse((256, 256), (60, 30), #e0a526)
function ellipse(center, radii, fill) {
  need_point("ellipse", "center", center)
  need_point("ellipse", "radii", radii)
  need_paint("ellipse", "fill", fill)
  make_shape("ellipse", [center, radii, fill], ellipse_path(center, radii), fill, null, 0,
    [make_anchor(center, 0, null, "move"), make_anchor(center + radii, 1, null, "corner")])
}

-~> Draws a filled rectangle.
-~> pos: the top-left corner, a point
-~> size: width and height, a point like (120, 60)
-~> fill: the color inside
-~> example: rect((20, 20), (120, 60), #2d6a8f)
function rect(pos, size, fill) {
  need_point("rect", "pos", pos)
  need_point("rect", "size", size)
  need_paint("rect", "fill", fill)
  let outline = [["M", pos], ["L", (pos.x + size.x, pos.y)], ["L", pos + size], ["L", (pos.x, pos.y + size.y)], ["Z"]]
  make_shape("rect", [pos, size, fill], outline, fill, null, 0,
    [make_anchor(pos, 0, null, "move"), make_anchor(pos + size, 1, null, "corner")])
}

-~> Draws a straight line with round ends.
-~> a: where the line starts, a point
-~> b: where the line ends, a point
-~> color: the color of the line
-~> width: the thickness in pixels
-~> example: line((20, 100), (380, 100), #1d1d1f, 2)
function line(a, b, color, width) {
  need_point("line", "a", a)
  need_point("line", "b", b)
  need_paint("line", "color", color)
  need_number("line", "width", width)
  make_shape("line", [a, b, color, width], [["M", a], ["L", b]], null, color, width,
    [make_anchor(a, 0, null, "point"), make_anchor(b, 1, null, "point")])
}

-~> Draws a filled shape with straight sides.
-~> points: the corners in order, a list of points
-~> fill: the color inside
-~> example: polygon([(100, 20), (180, 120), (20, 120)], #c0392b)
function polygon(points, fill) {
  need_points("polygon", "points", points)
  need_paint("polygon", "fill", fill)
  let outline = [["M", points[0]]]
  for (let i = 1; i < len(points); i = i + 1) {
    push(outline, ["L", points[i]])
  }
  push(outline, ["Z"])
  make_shape("polygon", [points, fill], outline, fill, null, 0, anchors_of(points))
}

-~> Draws a filled shape with a smooth outline, and holes if you give them.
-~> The outline is a curve through the points; a point where the line turns
-~> by more than `corner` degrees stays a sharp corner, and the pieces
-~> between two sharp corners are straight. It is what a traced picture is
-~> made of.
-~> The list may also hold curve items, drawn exactly (no smoothing through
-~> them, and SVG gets real C and Q commands): ["c", c1, c2, p] is a cubic
-~> from the point before it to p with controls c1 and c2, ["q", c, p] a
-~> quadratic. The first item must be a point. Plain points between two curve
-~> items are smoothed as usual, with the points next to a curve as sharp ends.
-~> points: the outline, a list of points and curve items
-~> fill: the color inside
-~> closed: true to join the last point to the first (needed for holes)
-~> smooth: false for straight sides, like polygon
-~> holes: a list of such lists, each one cut out of the shape
-~> corner: the turn in degrees from which a point stays sharp
-~> example: path([(100, 40), (200, 60), (180, 160), (80, 140)], #3fa34d)
-~> example: path([(40, 100), ["c", (40, 20), (160, 20), (160, 100)], (100, 160)], #3fa34d)
function path(points, fill, closed = true, smooth = true, holes = [], corner = 55) {
  need_path_items("path", "points", points)
  need_paint("path", "fill", fill)
  if (!is_number(corner)) {
    reject("path", "corner must be a number of degrees, not " + type(corner))
  }
  if (type(holes) != "ARRAY") {
    reject("path", "holes must be a list of point lists")
  }
  if (len(holes) > 0 && !closed) {
    reject("path", "holes need closed = true")
  }
  let turn = corner
  if (!smooth) {
    turn = 0
  }
  let outline = ring_outline(points, closed, turn)
  let sign = polygon_area2(items_points(points)) > 0
  for (let h = 0; h < len(holes); h = h + 1) {
    need_path_items("path", "holes item " + str(h), holes[h])
    let ring = holes[h]
    if ((polygon_area2(items_points(ring)) > 0) == sign) {
      ring = reverse_items(ring)
    }
    let sub = ring_outline(ring, true, turn)
    for (let i = 0; i < len(sub); i = i + 1) {
      push(outline, sub[i])
    }
  }
  make_shape("path", [points, fill, closed, smooth, holes, corner], outline, fill, null, 0, anchors_of(points))
}

-~> The commands of one ring of path(): the old smoothing for plain points,
-~> mixed_outline when the list holds curve items.
function ring_outline(items, closed, corner) {
  for (let i = 0; i < len(items); i = i + 1) {
    if (type(items[i]) != "POINT") {
      return mixed_outline(items, closed, corner)
    }
  }
  smooth_outline(items, closed, corner)
}

-~> Draws a smooth curve that passes through every point. One point is a
-~> dot and two are a straight line. The ends are round.
-~> points: the spots the curve goes through, a list of points
-~> color: the color of the line
-~> width: the thickness in pixels
-~> example: stroke([(40, 300), (120, 210), (260, 240), (380, 120)], #1d1d1f, 4)
function stroke(points, color, width) {
  need_points("stroke", "points", points)
  need_paint("stroke", "color", color)
  need_number("stroke", "width", width)
  make_shape("stroke", [points, color, width], smooth_path(points), null, color, width, anchors_of(points))
}

-~> The on-curve points of a brush's items: the item itself for a point, else
-~> the end of the curve item. A brush has one width and pressure for each.
function brush_ends(items) {
  let out = []
  for (let i = 0; i < len(items); i = i + 1) {
    push(out, item_end(items[i]))
  }
  out
}

-~> Whether some item of a brush is a curve item.
function brush_has_curves(items) {
  for (let i = 0; i < len(items); i = i + 1) {
    if (type(items[i]) != "POINT") {
      return true
    }
  }
  false
}

-~> The slope of a number measured at each on-curve point (per piece, not
-~> per pixel), for a smooth blend between them: the average of the two
-~> slopes beside it, held back so the blend never overshoots a neighbour,
-~> and flat where the value turns round.
function brush_slopes(values) {
  let n = len(values)
  let out = []
  for (let i = 0; i < n; i = i + 1) {
    let before = 0.0
    let after = 0.0
    if (i > 0) {
      before = values[i] - values[i - 1]
    }
    if (i < n - 1) {
      after = values[i + 1] - values[i]
    }
    if (i == 0) {
      push(out, after)
    } elif (i == n - 1) {
      push(out, before)
    } elif (before * after <= 0) {
      push(out, 0.0)
    } else {
      let m = (before + after) / 2.0
      let cap = 3.0 * math.min(math.abs(before), math.abs(after))
      if (m > 0) {
        push(out, math.min(m, cap))
      } else {
        push(out, math.max(m, -cap))
      }
    }
  }
  out
}

-~> The value at t (0 to 1) between values[i] and values[i + 1], following the
-~> slopes (a cubic Hermite blend).
function brush_blend(values, slopes, i, t) {
  let t2 = t * t
  let t3 = t2 * t
  (2 * t3 - 3 * t2 + 1) * values[i] + (t3 - 2 * t2 + t) * slopes[i] + (3 * t2 - 2 * t3) * values[i + 1] + (t3 - t2) * slopes[i + 1]
}

-~> The two controls of the cubic a brush item is, from the point before it.
function brush_item_cubic(start, it) {
  if (it[0] == "c") {
    return [it[1], it[2]]
  }
  quad_cubic(start, it[1], it[2])
}

-~> The t values along a curve item where a brush takes samples: where the
-~> curve is flat enough (flatten_cubic), and at least 8 to a piece, so the
-~> width and opacity have places to follow.
function brush_curve_ts(p1, c1, c2, p2) {
  let out = []
  let ts = []
  flatten_cubic(p1, c1, c2, p2, flatten_tolerance, out, ts, 0.0, 1.0, 0)
  let all = []
  let last = 0.0
  for (let k = 0; k < len(ts); k = k + 1) {
    let extra = math.ceil((ts[k] - last) * 8) - 1
    for (let e = 1; e <= extra; e = e + 1) {
      push(all, last + (ts[k] - last) * e / (extra + 1))
    }
    push(all, ts[k])
    last = ts[k]
  }
  all
}

-~> Where the outline of a brush stroke gets its points: a list of
-~> {"pos", "w" (width), "op" (opacity)} along the stroke, which is a smooth
-~> curve through the points (8 samples per piece) and exactly the curve
-~> items among them (see path()), with the points next to a curve as sharp
-~> ends. `widths` and `opacities` have one entry for each on-curve point.
-~> A stroke with curve items blends them smoothly along each piece (so
-~> there is no kink where two pieces meet); one of plain points blends
-~> them in a straight line, as it always did.
-~> `extra` (optional) is one more number for each point, kept as "x".
function brush_samples(items, widths, opacities, extra = null) {
  let points = brush_ends(items)
  let n = len(points)
  let steps = 8
  let samples = []
  let smooth = brush_has_curves(items)
  let w_slopes = brush_slopes(widths)
  let o_slopes = brush_slopes(opacities)
  for (let i = 0; i < n - 1; i = i + 1) {
    let it = items[i + 1]
    let p1 = points[i]
    let p2 = points[i + 1]
    let controls = null
    let ts = []
    if (type(it) == "POINT") {
      let p0 = points[math.max(i - 1, 0)]
      if (i > 0 && type(items[i]) != "POINT") {
        p0 = p1
      }
      let p3 = points[math.min(i + 2, n - 1)]
      if (i + 2 < n && type(items[i + 2]) != "POINT") {
        p3 = p2
      }
      controls = [p1 + (p2 - p0) / 6.0, p2 - (p3 - p1) / 6.0]
      for (let s = 0; s < steps; s = s + 1) {
        push(ts, s / float(steps))
      }
    } else {
      controls = brush_item_cubic(p1, it)
      push(ts, 0.0)
      ts = ts + brush_curve_ts(p1, controls[0], controls[1], p2)
      pop(ts)
    }
    for (let k = 0; k < len(ts); k = k + 1) {
      let t = ts[k]
      let w = lerp(widths[i], widths[i + 1], t)
      let op = lerp(opacities[i], opacities[i + 1], t)
      if (smooth) {
        w = math.max(0.0, brush_blend(widths, w_slopes, i, t))
        op = math.max(0.0, brush_blend(opacities, o_slopes, i, t))
      }
      push(samples, {
        "pos": bezier_point(p1, controls[0], controls[1], p2, t),
        "w": w,
        "op": op,
        "x": stamp_extra(extra, i, i + 1, t)
      })
    }
  }
  push(samples, {"pos": points[n - 1], "w": widths[n - 1], "op": opacities[n - 1], "x": stamp_extra(extra, n - 1, n - 1, 0.0)})
  samples
}

-~> The unit vector along v, or (1, 0) when v has no length.
function unit_vector(v) {
  let l = math.sqrt(float(v.x * v.x + v.y * v.y))
  if (l == 0) {
    return (1.0, 0.0)
  }
  v / l
}

-~> Adds the rest of a side of an outline to it, after its first point: a line
-~> to each point, or (`fitted`) a few cubic Beziers within 0.3 px of them.
function brush_side(outline, line, fitted) {
  if (fitted) {
    let curves = fit_line(line, 0.3)
    for (let i = 0; i < len(curves); i = i + 1) {
      push(outline, ["C", curves[i][1], curves[i][2], curves[i][3]])
    }
    return null
  }
  for (let i = 1; i < len(line); i = i + 1) {
    push(outline, ["L", line[i]])
  }
}

-~> The filled outline of a variable-width stroke: down the left side, round
-~> around the end, back up the right side, round around the start.
-~> With `fitted` (a stroke with curve items; not a grainy pen, whose edge is
-~> rough on purpose) the two sides are cubic Beziers instead of lines.
function brush_outline(samples, pen, fitted = false) {
  fitted = fitted && !(is_number(pen.grain) && pen.grain > 0)
  let n = len(samples)
  let along = [0.0]
  for (let i = 1; i < n; i = i + 1) {
    push(along, along[i - 1] + math.dist(samples[i - 1].pos, samples[i].pos))
  }
  let total = along[n - 1]
  let left = []
  let right = []
  let tangents = []
  let halves = []
  for (let i = 0; i < n; i = i + 1) {
    let a = samples[math.max(i - 1, 0)].pos
    let b = samples[math.min(i + 1, n - 1)].pos
    let tan = unit_vector(b - a)
    let frac = 0.0
    if (total > 0) {
      frac = along[i] / total
    }
    let half = samples[i].w * pen_taper(pen, frac) / 2.0
    if (is_number(pen.grain) && pen.grain > 0) {
      half = half + pen.grain * (pen_noise(i) - 0.5)
    }
    half = math.max(0.1, half)
    let normal = (-tan.y, tan.x)
    push(tangents, tan)
    push(halves, half)
    push(left, samples[i].pos + normal * half)
    push(right, samples[i].pos - normal * half)
  }

  let outline = [["M", left[0]]]
  brush_side(outline, left, fitted)
  let end = samples[n - 1].pos
  let endn = (-tangents[n - 1].y, tangents[n - 1].x)
  for (let j = 1; j < 6; j = j + 1) {
    let a = j / 6.0 * math.pi
    push(outline, ["L", end + (endn * math.cos(a) + tangents[n - 1] * math.sin(a)) * halves[n - 1]])
  }
  push(outline, ["L", right[n - 1]])
  brush_side(outline, list.reverse(right), fitted)
  let begin = samples[0].pos
  let beginn = (-tangents[0].y, tangents[0].x)
  for (let j = 1; j < 6; j = j + 1) {
    let a = j / 6.0 * math.pi
    push(outline, ["L", begin - (beginn * math.cos(a) + tangents[0] * math.sin(a)) * halves[0]])
  }
  push(outline, ["Z"])
  outline
}

-~> The color with its opacity multiplied by `op` (0 to 1).
function fade_color(color, op) {
  rgba(color.r, color.g, color.b, math.round(color.a * math.max(0.0, math.min(1.0, op))))
}

-~> The direction a brush goes at on-curve point i, in radians: along the
-~> chord between its neighbours for plain points, else along the curves
-~> that arrive at it and leave it (their controls), blended.
function brush_angle(items, points, i) {
  let n = len(points)
  let back = points[i] - points[math.max(i - 1, 0)]
  let ahead = points[math.min(i + 1, n - 1)] - points[i]
  if (i > 0 && type(items[i]) != "POINT") {
    let c = items[i][len(items[i]) - 2]
    if (c != points[i]) {
      back = points[i] - c
    }
  }
  if (i < n - 1 && type(items[i + 1]) != "POINT") {
    let c = items[i + 1][1]
    if (c != points[i]) {
      ahead = c - points[i]
    }
  }
  let a = unit_vector(back) + unit_vector(ahead)
  if (a.x == 0 && a.y == 0) {
    return 0.0
  }
  math.atan2(a.y, a.x)
}

-~> Draws a smooth curve whose width and opacity follow the pressure of the
-~> pen that drew it. The raw pressures are kept, so a different pen restyles
-~> the same stroke.
-~> The list may also hold curve items like path() does (["c", c1, c2, p] and
-~> ["q", c, p]): they are drawn exactly, and the width between two points
-~> follows the curve smoothly. There is one pressure for each point or
-~> curve item (each ends at one on-curve point), so a curve item takes the
-~> pressure at its end. The taper and stamps follow the curves too.
-~> points: the spots the curve goes through, a list of points and curve items
-~> pressures: one number from 0 to 1 for each point or curve item
-~> color: the color of the ink
-~> pen: a pen style such as pens.ink, pens.pencil or pens.calligraphy
-~> example: brush([(40, 300), (120, 210), (260, 240)], [0.2, 0.9, 0.4], #1d1d1f, pens.ink)
-~> example: brush([(40, 300), ["c", (80, 200), (200, 200), (260, 240)]], [0.2, 0.8], #1d1d1f, pens.ink)
function brush(points, pressures, color, pen) {
  need_path_items("brush", "points", points)
  if (type(pressures) != "ARRAY" || len(pressures) != len(points)) {
    reject("brush", "pressures must be a list with one number for each point")
  }
  for (let i = 0; i < len(pressures); i = i + 1) {
    need_number("brush", "pressures item " + str(i), pressures[i])
  }
  need_color("brush", "color", color)
  if (type(pen) != "HASH" || !is_number(pen.min) || !is_number(pen.max)) {
    reject("brush", "pen must be a pen style like pens.ink")
  }

  let ends = brush_ends(points)
  let curved = brush_has_curves(points)
  let n = len(ends)
  let widths = []
  let opacities = []
  let ps = pen_prepare(pen, ends, pressures)
  for (let i = 0; i < n; i = i + 1) {
    let angle = 0.0
    if (curved) {
      angle = brush_angle(points, ends, i)
    } else {
      let a = ends[math.min(i + 1, n - 1)] - ends[math.max(i - 1, 0)]
      if (a.x != 0 || a.y != 0) {
        angle = math.atan2(a.y, a.x)
      }
    }
    let r = pen_response(pen, ps[i], angle)
    push(widths, r[0])
    push(opacities, r[1])
  }

  let mean = 0.0
  let widest = 0.0
  for (let i = 0; i < n; i = i + 1) {
    mean = mean + opacities[i] / n
    widest = math.max(widest, widths[i])
  }

  let outline = null
  if (n == 1) {
    outline = ellipse_path(ends[0], (math.max(0.1, widths[0] / 2.0), math.max(0.1, widths[0] / 2.0)))
  } else {
    outline = brush_outline(brush_samples(points, widths, opacities), pen, curved)
  }
  let shape = make_shape("brush", [points, pressures, color, pen], outline, fade_color(color, mean), null, widest, anchors_of(points))
  shape.widths = widths
  shape.opacities = opacities
  if (stamp_is(pen)) {
    -~> The outline stays as the shape's hit area; the stamps are what is drawn.
    shape.stamps = stamp_stroke(brush_samples(points, widths, opacities, stamp_speeds(ends)), color, pen, stamp_seed(ends))
    shape.stamp_key = str(points) + str(widths) + str(opacities) + str(color) + str(pen)
  }
  shape
}

-~> Shapes also carry `styles`: one {"mode", "opacity"} hash for each level of
-~> their `layer` path (see blend.liz). A fill or stroke is a color or a
-~> gradient value (see gradient.liz).

-~> Gives a shape the style hashes of its layer path. Returns the shape.
function add_styles(shape, where) {
  if (type(where) == "HASH" && type(where.layer) == "ARRAY") {
    shape.styles = styles_for(where.layer)
  }
  shape
}

-~> The look of each layer, kept by the layer's path: {"mode", "opacity"}.
-~> A shape holds the very same hashes, so blend() and opacity() reach a
-~> shape drawn before they were called.
let layer_styles = {}

-~> The key of a layer path in layer_styles: the first `depth` names joined by "/".
function layer_key(path, depth) {
  text.join(list.slice(path, 0, depth), "/")
}

-~> The style hashes of every level of a layer path, outermost first (made on first use).
function styles_for(path) {
  let out = []
  for (let i = 1; i <= len(path); i = i + 1) {
    let key = layer_key(path, i)
    if (layer_styles[key] === null) {
      layer_styles[key] = {"mode": "normal", "opacity": 1.0}
    }
    push(out, layer_styles[key])
  }
  out
}

-~> True when a layer style changes how the layer is mixed with what is below.
function layer_is_styled(style) {
  style.mode != "normal" || style.opacity < 1
}

-~> The styled layers a shape is inside, outermost first: [[key, style], ...].
function layer_chain(shape) {
  let out = []
  if (type(shape.styles) != "ARRAY") {
    return out
  }
  for (let i = 0; i < len(shape.styles); i = i + 1) {
    if (layer_is_styled(shape.styles[i])) {
      push(out, [layer_key(shape.layer, i + 1), shape.styles[i]])
    }
  }
  out
}

-~> True when any of the shapes sits in a layer with a blend mode or an opacity.
function any_styled(shapes) {
  for (let i = 0; i < len(shapes); i = i + 1) {
    if (len(layer_chain(shapes[i])) > 0) {
      return true
    }
  }
  false
}

-~> The shapes (already in paint order) as a flat list of events, so a writer
-~> can wrap each styled layer: ["open", style], ["shape", shape], ["close", style].
-~> Only layers with a blend mode or an opacity open a group.
function layer_events(ordered) {
  let events = []
  let open = []
  for (let i = 0; i < len(ordered); i = i + 1) {
    let chain = layer_chain(ordered[i])
    let keep = 0
    while (keep < len(open) && keep < len(chain) && open[keep][0] == chain[keep][0]) {
      keep = keep + 1
    }
    while (len(open) > keep) {
      push(events, ["close", open[len(open) - 1][1]])
      list.remove(open, len(open) - 1)
    }
    for (let k = keep; k < len(chain); k = k + 1) {
      push(events, ["open", chain[k][1]])
      push(open, chain[k])
    }
    push(events, ["shape", ordered[i]])
  }
  while (len(open) > 0) {
    push(events, ["close", open[len(open) - 1][1]])
    list.remove(open, len(open) - 1)
  }
  events
}

-~> A fill or stroke: a color, or a gradient value (linear, radial, gradient, radial_gradient).
function need_paint(call, name, v) {
  if (!is_gradient(v)) {
    need_color(call, name, v)
  }
}

-~> The object limit. A canvas may carry "max_objects" (a whole number): the
-~> limit its file was made with, written when the drawing was created.

-~> How many shapes a drawing has.
function object_count(shapes) {
  len(shapes)
}

-~> Where a drawing stands against the object limit.
-~>   count           shapes now
-~>   max             the limit that counts here: the file's own, else this
-~>                   machine's recommended one (0 when neither is known)
-~>   file_max        canvas["max_objects"], or null
-~>   state           "ok", "near" (80% or more of max) or "over" (more than max)
-~>   slower_machine  true when the file's limit is above this machine's, so
-~>                   the file may run slowly here (the file is not changed)
-~> machine is the hash with "max_objects" (see calibrate.liz); {} when unknown.
function object_budget(cnv, machine, shapes = drawing) {
  let count = object_count(shapes)
  let file_max = cnv["max_objects"]
  let here_max = machine["max_objects"]
  let max = 0
  if (file_max !== null) {
    max = file_max
  } elif (here_max !== null) {
    max = here_max
  }
  let state = "ok"
  if (max > 0) {
    if (count > max) {
      state = "over"
    } elif (count * 5 >= max * 4) {
      state = "near"
    }
  }
  let slower = file_max !== null && here_max !== null && file_max > here_max
  {"count": count, "max": max, "file_max": file_max, "state": state, "slower_machine": slower}
}
