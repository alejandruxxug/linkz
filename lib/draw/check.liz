-~> check: the argument checks every drawing function starts with. A wrong
-~> argument stops the drawing with a message that names the call.

-~> Stops the drawing with a message that names the call that went wrong.
function reject(call, message) {
  error(call + ": " + message)
}

function is_number(v) {
  type(v) == "INTEGER" || type(v) == "FLOAT"
}

function need_point(call, name, v) {
  if (type(v) != "POINT") {
    reject(call, name + " must be a point like (10, 20), not " + type(v))
  }
}

function need_color(call, name, v) {
  if (type(v) != "COLOR") {
    reject(call, name + " must be a color like #3fa34d, not " + type(v))
  }
}

function need_number(call, name, v) {
  if (!is_number(v)) {
    reject(call, name + " must be a number, not " + type(v))
  }
}

function need_points(call, name, v) {
  if (type(v) != "ARRAY" || len(v) == 0) {
    reject(call, name + " must be a list of points like [(0, 0), (10, 5)] with at least one")
  }
  for (let i = 0; i < len(v); i = i + 1) {
    if (type(v[i]) != "POINT") {
      reject(call, name + " must only hold points, but item " + str(i) + " is " + type(v[i]))
    }
  }
}

-~> Like need_points, for the points of a path(): the list may also hold curve
-~> items ["c", c1, c2, p] and ["q", c, p], each of points, after a first
-~> item that is a point.
function need_path_items(call, name, v) {
  if (type(v) != "ARRAY" || len(v) == 0) {
    reject(call, name + " must be a list of points like [(0, 0), (10, 5)] with at least one")
  }
  for (let i = 0; i < len(v); i = i + 1) {
    let it = v[i]
    if (type(it) == "POINT") {
      continue
    }
    if (i == 0) {
      reject(call, name + " must start with a point, but item 0 is " + type(it))
    }
    if (type(it) != "ARRAY") {
      reject(call, name + " must only hold points and curve items, but item " + str(i) + " is " + type(it))
    }
    let want = 0
    if (len(it) > 0 && it[0] == "c") {
      want = 4
    } elif (len(it) > 0 && it[0] == "q") {
      want = 3
    } else {
      reject(call, name + " item " + str(i) + " must be a point or [\"c\", c1, c2, p] or [\"q\", c, p]")
    }
    if (len(it) != want) {
      reject(call, name + " item " + str(i) + " (\"" + it[0] + "\") needs " + str(want - 1) + " points, not " + str(len(it) - 1))
    }
    for (let k = 1; k < want; k = k + 1) {
      if (type(it[k]) != "POINT") {
        reject(call, name + " item " + str(i) + " must only hold points, but its part " + str(k) + " is " + type(it[k]))
      }
    }
  }
}
