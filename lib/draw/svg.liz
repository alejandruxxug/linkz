-~> svg: turns the drawing into SVG text, one <path> for each shape.
-~> The shapes are painted in paint_order(): bottom row first, so a shape that
-~> is higher in the file ends up in front of the ones below it.

use "gradient"
use "shapes"

let hex_digits = "0123456789abcdef"

function svg_hex2(n) {
  hex_digits[n // 16] + hex_digits[n % 16]
}

-~> A color as "#rrggbb" (the alpha is written separately as an opacity).
function color_hex(c) {
  "#" + svg_hex2(c.r) + svg_hex2(c.g) + svg_hex2(c.b)
}

-~> A number with at most two decimals and no needless ".0".
function svg_num(n) {
  let r = math.round(n * 100) / 100.0
  if (r == math.floor(r)) {
    return str(math.floor(r))
  }
  str(r)
}

function point_text(p) {
  svg_num(p.x) + " " + svg_num(p.y)
}

-~> The d="..." text of a path.
function path_data(path) {
  let out = []
  for (let i = 0; i < len(path); i = i + 1) {
    let cmd = path[i]
    let op = cmd[0]
    if (op == "Z") {
      push(out, "Z")
    } elif (op == "C") {
      push(out, "C " + point_text(cmd[1]) + " " + point_text(cmd[2]) + " " + point_text(cmd[3]))
    } else {
      push(out, op + " " + point_text(cmd[1]))
    }
  }
  text.join(out, " ")
}

function svg_attr(name, value) {
  " " + name + "=\"" + value + "\""
}

-~> The gradients the document being written uses: {text of the gradient: id}
-~> and the gradients in the order they got their ids.
let svg_gradient_ids = {}
let svg_gradient_list = []

-~> The id of a gradient's <linearGradient> or <radialGradient> (made on first use).
function svg_gradient_id(g) {
  let key = str(g)
  if (svg_gradient_ids[key] === null) {
    svg_gradient_ids[key] = "g" + str(len(svg_gradient_list))
    push(svg_gradient_list, g)
  }
  svg_gradient_ids[key]
}

-~> The <stop> elements of a gradient.
function svg_stops(g) {
  let out = ""
  let stops = gradient_svg_stops(g)
  for (let i = 0; i < len(stops); i = i + 1) {
    let c = stops[i][1]
    out = out + "      <stop" + svg_attr("offset", svg_num(stops[i][0])) + svg_attr("stop-color", color_hex(c))
    if (c.a != 255) {
      out = out + svg_attr("stop-opacity", svg_num(c.a / 255.0))
    }
    out = out + "/>\n"
  }
  out
}

-~> The <linearGradient> or <radialGradient> element of one gradient.
function svg_gradient_def(g, id) {
  let head = ""
  let tag = ""
  if (g.kind == "linear") {
    tag = "linearGradient"
    head = svg_attr("x1", svg_num(g.from.x)) + svg_attr("y1", svg_num(g.from.y)) + svg_attr("x2", svg_num(g.to.x)) + svg_attr("y2", svg_num(g.to.y))
  } else {
    tag = "radialGradient"
    head = svg_attr("cx", svg_num(g.center.x)) + svg_attr("cy", svg_num(g.center.y)) + svg_attr("r", svg_num(g.r))
  }
  "    <" + tag + svg_attr("id", id) + svg_attr("gradientUnits", "userSpaceOnUse") + head + ">\n" + svg_stops(g) + "    </" + tag + ">\n"
}

-~> The fill or stroke attributes for one color or gradient: none when there is neither.
function paint_attrs(name, c) {
  if (is_gradient(c)) {
    return svg_attr(name, "url(#" + svg_gradient_id(c) + ")")
  }
  if (type(c) != "COLOR") {
    return svg_attr(name, "none")
  }
  let out = svg_attr(name, color_hex(c))
  if (c.a != 255) {
    out = out + svg_attr(name + "-opacity", svg_num(c.a / 255.0))
  }
  out
}

-~> One <path> element for a shape. A relative gradient is written as the
-~> pinned one it is for this shape (objectBoundingBox would bend the angle and
-~> stretch circles on a box that is not square); shapes that resolve the same
-~> share one <defs> entry.
function svg_shape(shape) {
  let out = "<path" + svg_attr("d", path_data(shape.path)) + paint_attrs("fill", resolve_paint(shape, "fill"))
  if (is_paint(shape.stroke)) {
    out = out + paint_attrs("stroke", resolve_paint(shape, "stroke")) + svg_attr("stroke-width", svg_num(shape.width))
    out = out + svg_attr("stroke-linecap", "round") + svg_attr("stroke-linejoin", "round")
  }
  out + "/>"
}

-~> The style of a <g> for a layer: its blend mode and opacity.
function svg_layer_style(style) {
  let parts = []
  if (style.mode != "normal") {
    push(parts, "mix-blend-mode: " + style.mode)
  }
  if (style.opacity < 1) {
    push(parts, "opacity: " + svg_num(style.opacity))
  }
  text.join(parts, "; ")
}

-~> The canvas background; a relative gradient fits the whole canvas.
function svg_background(canvas) {
  if (is_relative_gradient(canvas.background)) {
    return resolve_gradient(canvas.background, {"min": (0, 0), "max": canvas.size})
  }
  canvas.background
}

-~> The biggest width or height a canvas may have.
let canvas_max_side = 16384

-~> Checks a canvas: a hash whose "size" is a point with a width and a height
-~> from 1 to 16384, and whose "background" (when it has one) is a color or a
-~> gradient. Gives an error() if not, and null if it is fine.
function check_canvas(canvas) {
  if (type(canvas) != "HASH") {
    return error("canvas: must be a hash like {\"size\": (400, 200), \"background\": #ffffff}, got " + type(canvas))
  }
  let size = canvas["size"]
  if (type(size) != "POINT") {
    return error("canvas: size must be a point like (400, 200), got " + type(size))
  }
  let limits = "between (1, 1) and (" + str(canvas_max_side) + ", " + str(canvas_max_side) + ")"
  let ok = true
  for (let i = 0; i < 2; i = i + 1) {
    let side = size.x
    if (i == 1) {
      side = size.y
    }
    if (!(side >= 1 && side <= canvas_max_side)) {
      ok = false
    }
  }
  if (!ok) {
    return error("canvas: size must be " + limits + ", got " + str(size))
  }
  let bg = canvas["background"]
  if (bg !== null && !is_paint(bg)) {
    return error("canvas: background must be a color or a gradient, got " + type(bg))
  }
  null
}

-~> The whole SVG text of a canvas and a list of shapes.
function svg_document(canvas, shapes) {
  check_canvas(canvas)
  let w = canvas.size.x
  let h = canvas.size.y
  svg_gradient_ids = {}
  svg_gradient_list = []
  let nl = "\n"
  let out = "<svg xmlns=\"http://www.w3.org/2000/svg\"" + svg_attr("width", svg_num(w)) + svg_attr("height", svg_num(h))
  out = out + svg_attr("viewBox", "0 0 " + svg_num(w) + " " + svg_num(h)) + ">" + nl
  out = out + "  <rect" + svg_attr("width", svg_num(w)) + svg_attr("height", svg_num(h)) + paint_attrs("fill", svg_background(canvas)) + "/>" + nl
  let body = ""
  let events = layer_events(paint_order(shapes))
  let depth = 0
  for (let i = 0; i < len(events); i = i + 1) {
    let kind = events[i][0]
    if (kind == "close") {
      depth = depth - 1
    }
    let pad = "  "
    for (let d = 0; d < depth; d = d + 1) {
      pad = pad + "  "
    }
    if (kind == "shape") {
      body = body + pad + svg_shape(events[i][1]) + nl
    } elif (kind == "open") {
      body = body + pad + "<g" + svg_attr("style", svg_layer_style(events[i][1])) + ">" + nl
      depth = depth + 1
    } else {
      body = body + pad + "</g>" + nl
    }
  }
  if (len(svg_gradient_list) > 0) {
    out = out + "  <defs>" + nl
    for (let i = 0; i < len(svg_gradient_list); i = i + 1) {
      out = out + svg_gradient_def(svg_gradient_list[i], "g" + str(i))
    }
    out = out + "  </defs>" + nl
  }
  out + body + "</svg>" + nl
}
