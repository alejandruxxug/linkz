-~> lzdraw 1
canvas = {"size": (480, 320), "background": #1d2142}
circle((390, 60), 22, #f3efc9)
circle((400, 54), 20, #1d2142)
let xs = [[10, 70, 160], [85, 50, 210], [140, 80, 130], [225, 60, 230], [290, 90, 170], [385, 85, 200]]
for (let i = 0; i < len(xs); i = i + 1) {
  let b = xs[i]
  rect((b[0], 320 - b[2]), (b[1], b[2]), #2f355e)
  for (let wy = 320 - b[2] + 14; wy < 310; wy = wy + 22) {
    for (let wx = b[0] + 8; wx < b[0] + b[1] - 8; wx = wx + 16) {
      if ((wx * 7 + wy * 3) % 7 < 2) {
        rect((wx, wy), (7, 9), #f2c45a)
      }
    }
  }
}
