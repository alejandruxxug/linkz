-~> lzdraw 1
canvas = {"size": (400, 400), "background": #fbf8ef}
let cols = [#3fa34d, #e0a526, #2d6a8f, #d94a3a]
for (let i = 0; i < 5; i = i + 1) {
  for (let j = 0; j < 5; j = j + 1) {
    let c = cols[(i + j * 2) % 4]
    if ((i + j) % 2 == 1) {
      circle((40 + i * 80, 40 + j * 80), 28, c)
    } else {
      rect((14 + i * 80, 14 + j * 80), (52, 52), c)
    }
  }
}
